<!-- PROGRAM-YEAR BREAKDOWN -->
<div class="row mt-4">
    <div class="col-12">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-diagram-3-fill me-2 text-gold"></i> Paid/Unpaid by Program-Year
            </h5>
            @if (ViewBag.ProgramYearStats != null && ((IEnumerable<dynamic>)ViewBag.ProgramYearStats).Any())
            {
                @foreach (var stat in ViewBag.ProgramYearStats)
                {
                    var programYearTotal = (decimal)stat.TotalFees;
                    var programYearPaid = (decimal)stat.PaidFees;
                    var programYearUnpaid = programYearTotal - programYearPaid;

                    <div class="section-breakdown-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 text-white">@stat.ProgramYear</h6>
                        </div>
                        <div class="row text-center mt-3">
                            <div class="col-4">
                                <small class="text-muted d-block">Total Expected</small>
                                <h6 class="text-white mb-0">₱@programYearTotal.ToString("N2")</h6>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Paid</small>
                                <h6 class="text-success mb-0">₱@programYearPaid.ToString("N2")</h6>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Unpaid</small>
                                <h6 class="text-danger mb-0">₱@programYearUnpaid.ToString("N2")</h6>
                            </div>
                        </div>
                        @{
                            var paidPercent = programYearTotal > 0 ? (programYearPaid / programYearTotal * 100) : 0;
                            var unpaidPercent = programYearTotal > 0 ? (programYearUnpaid / programYearTotal * 100) : 0;
                        }
                        <div class="progress mt-3" style="height: 30px; position: relative; background-color: rgba(220, 53, 69, 0.3);">
                            <div class="progress-bar bg-success d-flex align-items-center justify-content-center" role="progressbar" style="width: @paidPercent.ToString("F1")%">
                                @if (paidPercent > 5)
                                {
                                    <span class="text-white fw-bold small">@paidPercent.ToString("F1")% Paid</span>
                                }
                            </div>
                            @if (unpaidPercent > 5)
                            {
                                <span class="position-absolute text-white fw-bold small" style="right: 10px; top: 50%; transform: translateY(-50%);">
                                    @unpaidPercent.ToString("F1")% Unpaid
                                </span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-muted py-4">No program-year data available.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- html2canvas - For capturing DOM elements as images -->
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    
    <!-- jsPDF - For PDF generation -->
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    
    <!-- SheetJS - For Excel export -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
    
    <script>
        // Monthly Trends Line Chart
        const trendsCtx = document.getElementById('trendsChart').getContext('2d');
        const monthlyTrends = @Html.Raw(Json.Serialize(ViewBag.MonthlyTrends ?? new List<object>()));
        
        // Debug: Log the data
        console.log('Initial Monthly Trends Data:', monthlyTrends);
        console.log('Number of months:', monthlyTrends.length);
        
        // Global chart variable
        let trendsChart = null;
        
        // Initialize chart
        function initializeTrendsChart(data) {
            // Destroy existing chart if any
            if (trendsChart) {
                trendsChart.destroy();
            }

            // Check if we have data
            if (!data || data.length === 0) {
                // Show no data message
                const canvas = document.getElementById('trendsChart');
                const ctx = canvas.getContext('2d');
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = '#fff';
                ctx.font = '16px Arial';
                ctx.textAlign = 'center';
                ctx.fillText('No collection data available for the selected period', canvas.width / 2, canvas.height / 2);
                return;
            }

            // Debug: Log raw data first
            console.log('Raw data received:', data);
            console.log('First item:', data[0]);
            console.log('Property names:', data[0] ? Object.keys(data[0]) : 'no data');

            // Calculate max value for Y-axis scale
            const feesData = data.map(t => t.feesCollected || t.FeesCollected || 0);
            const finesData = data.map(t => t.finesCollected || t.FinesCollected || 0);
            const labels = data.map(t => t.month || t.Month || 'Unknown');
            const maxFees = Math.max(...feesData);
            const maxFines = Math.max(...finesData);
            const maxValue = Math.max(maxFees, maxFines);
            const suggestedMaxValue = maxValue > 0 ? maxValue * 1.2 : 100;

            console.log('Processed Chart Data:', {
                labels: labels,
                feesData: feesData,
                finesData: finesData,
                maxValue: maxValue,
                suggestedMax: suggestedMaxValue
            });

            trendsChart = new Chart(trendsCtx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Fees Collected',
                            data: feesData,
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            borderWidth: 3,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 5,
                            pointHoverRadius: 8,
                            pointBackgroundColor: '#3b82f6',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2
                        },
                        {
                            label: 'Fines Collected',
                            data: finesData,
                            borderColor: '#f59e0b',
                            backgroundColor: 'rgba(245, 158, 11, 0.1)',
                            borderWidth: 3,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 5,
                            pointHoverRadius: 8,
                            pointBackgroundColor: '#f59e0b',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: { 
                                color: '#fff', 
                                font: { size: 14, weight: 'bold' },
                                padding: 20,
                                usePointStyle: true
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            borderColor: '#FFD700',
                            borderWidth: 1,
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ₱' + context.parsed.y.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            suggestedMax: suggestedMaxValue,
                            ticks: { 
                                color: '#fff',
                                font: { size: 12, weight: 'bold' },
                                padding: 10,
                                callback: function(value) {
                                    // Format large numbers with K/M suffix
                                    if (value >= 1000000) {
                                        return '₱' + (value / 1000000).toFixed(1) + 'M';
                                    } else if (value >= 1000) {
                                        return '₱' + (value / 1000).toFixed(1) + 'K';
                                    }
                                    return '₱' + value.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0});
                                }
                            },
                            grid: { 
                                color: 'rgba(255, 255, 255, 0.15)',
                                drawBorder: true,
                                borderColor: 'rgba(255, 255, 255, 0.3)',
                                borderWidth: 2
                            }
                        },
                        x: {
                            display: true,
                            position: 'bottom',
                            ticks: { 
                                color: '#fff',
                                font: { size: 12, weight: 'bold' },
                                padding: 10,
                                maxRotation: 0,
                                minRotation: 0,
                                autoSkip: false
                            },
                            grid: { 
                                display: false,
                                drawBorder: true,
                                borderColor: 'rgba(255, 255, 255, 0.3)',
                                borderWidth: 2
                            }
                        }
                    }
                }
            });
        }

        // Apply Filter Function
        function applyFilter() {
            // Determine which tab is active
            const activeTab = document.querySelector('#filterTabs .nav-link.active').id;
            let params = {};
            
            if (activeTab === 'quick-filter-tab') {
                // Quick Filter mode
                params = {
                    filterType: 'quick',
                    quickRange: document.getElementById('quickRange').value,
                    academicYear: document.getElementById('academicYear').value
                };
            } else if (activeTab === 'month-filter-tab') {
                // By Month mode
                params = {
                    filterType: 'month',
                    month: document.getElementById('monthSelect').value,
                    year: document.getElementById('yearSelect').value
                };
            } else if (activeTab === 'daterange-filter-tab') {
                // Date Range mode
                const fromDate = document.getElementById('fromDate').value;
                const toDate = document.getElementById('toDate').value;
                
                // Validation
                if (!fromDate || !toDate) {
                    alert('Please select both From Date and To Date');
                    return;
                }
                
                if (new Date(toDate) < new Date(fromDate)) {
                    alert('To Date must be after From Date');
                    return;
                }
                
                params = {
                    filterType: 'daterange',
                    fromDate: fromDate,
                    toDate: toDate
                };
            }
            
            // Show loading indicator
            document.getElementById('currentFilterLabel').innerHTML = '<i class="spinner-border spinner-border-sm me-1"></i> Loading...';
            
            // Make AJAX call
            fetch('/Officer/GetMonthlyTrends?' + new URLSearchParams(params))
                .then(response => response.json())
                .then(result => {
                    console.log('Filter Result:', result);
                    
                    if (result.success) {
                        // Update filter label
                        document.getElementById('currentFilterLabel').textContent = result.filterLabel;
                        
                        // Update chart
                        initializeTrendsChart(result.data);
                    } else {
                        alert('Error: ' + result.message);
                        document.getElementById('currentFilterLabel').textContent = 'Error loading data';
                    }
                })
                .catch(error => {
                    console.error('Error fetching trends:', error);
                    alert('Failed to load data. Please try again.');
                    document.getElementById('currentFilterLabel').textContent = 'Error';
                });
        }

        // Initialize chart with default data on page load
        initializeTrendsChart(monthlyTrends);

        // Financial Doughnut Chart
        const ctx = document.getElementById('financialChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Paid Fees', 'Paid Fines', 'Unpaid Fees', 'Unpaid Fines'],
                datasets: [{
                    data: [@totalFeesCollected, @totalFinesCollected, @pendingFees, @pendingFines],
                    backgroundColor: ['#3b82f6', '#f59e0b', '#ef4444', '#dc2626'],
                    borderWidth: 2,
                    borderColor: 'rgba(255, 255, 255, 0.1)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#fff',
                            padding: 20,
                            font: { size: 14 }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.label + ': ₱' + context.parsed.toLocaleString('en-US', {minimumFractionDigits: 2});
                            }
                        }
                    }
                }
            }
        });

        // ============================================================
        // EXPORT FUNCTIONS
        // ============================================================

        // Export Charts as Images (PNG)
        async function exportChartImages() {
            try {
                alert('Generating images... This may take a few seconds.');

                // Capture Collection Trends chart
                const trendsSection = document.querySelector('.glass-panel:has(#trendsChart)');
                const trendsCanvas = await html2canvas(trendsSection, {
                    backgroundColor: '#1a1a2e',
                    scale: 2
                });
                
                // Download Collection Trends image
                const trendsImg = trendsCanvas.toDataURL('image/png');
                const link1 = document.createElement('a');
                link1.href = trendsImg;
                link1.download = 'collection_trends_' + new Date().toISOString().split('T')[0] + '.png';
                document.body.appendChild(link1);
                link1.click();
                document.body.removeChild(link1);

                // Small delay before next export
                await new Promise(resolve => setTimeout(resolve, 500));

                // Capture Program-Year section
                const programYearSection = document.querySelectorAll('.glass-panel')[document.querySelectorAll('.glass-panel').length - 1];
                const pyCanvas = await html2canvas(programYearSection, {
                    backgroundColor: '#1a1a2e',
                    scale: 2
                });
                
                const pyImg = pyCanvas.toDataURL('image/png');
                const link2 = document.createElement('a');
                link2.href = pyImg;
                link2.download = 'program_year_stats_' + new Date().toISOString().split('T')[0] + '.png';
                document.body.appendChild(link2);
                link2.click();
                document.body.removeChild(link2);

                alert('Images exported successfully!');
            } catch (error) {
                console.error('Export error:', error);
                alert('Failed to export images: ' + error.message);
            }
        }

        // Export as PDF Report
        async function exportAsPDF() {
            try {
                alert('Generating PDF... This may take a few seconds.');

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('portrait', 'mm', 'a4');
                
                // Header
                pdf.setFontSize(20);
                pdf.setTextColor(255, 215, 0);
                pdf.text('Organization Treasury Dashboard', 20, 20);
                
                pdf.setFontSize(10);
                pdf.setTextColor(150, 150, 150);
                pdf.text('Generated: ' + new Date().toLocaleString(), 20, 28);
                
                // Quick Stats
                pdf.setFontSize(14);
                pdf.setTextColor(255, 215, 0);
                pdf.text('Financial Summary', 20, 40);
                
                pdf.setFontSize(10);
                pdf.setTextColor(0, 0, 0);
                pdf.text('Total Fees Collected: PHP ' + (@totalFeesCollected).toLocaleString(), 20, 48);
                pdf.text('Total Fines Collected: PHP ' + (@totalFinesCollected).toLocaleString(), 20, 55);
                pdf.text('Pending Fees: PHP ' + (@pendingFees).toLocaleString(), 20, 62);
                pdf.text('Pending Fines: PHP ' + (@pendingFines).toLocaleString(), 20, 69);
                pdf.text('Grand Total: PHP ' + (@(totalCollections + pendingFees + pendingFines)).toLocaleString(), 20, 76);

                // Add Collection Trends chart
                const trendsSection = document.querySelector('.glass-panel:has(#trendsChart)');
                const trendsCanvas = await html2canvas(trendsSection, { scale: 1 });
                const trendsImg = trendsCanvas.toDataURL('image/jpeg', 0.7);
                pdf.addImage(trendsImg, 'JPEG', 20, 85, 170, 80);

                // Page 2
                pdf.addPage();
                pdf.setFontSize(14);
                pdf.setTextColor(255, 215, 0);
                pdf.text('Program-Year Breakdown', 20, 20);

                const programYearSection = document.querySelectorAll('.glass-panel')[document.querySelectorAll('.glass-panel').length - 1];
                const pyCanvas = await html2canvas(programYearSection, { scale: 1 });
                const pyImg = pyCanvas.toDataURL('image/jpeg', 0.7);
                pdf.addImage(pyImg, 'JPEG', 20, 30, 170, 100);

                pdf.save('OrgTreasury_Report_' + new Date().toISOString().split('T')[0] + '.pdf');
                alert('PDF exported successfully!');
            } catch (error) {
                console.error('PDF export error:', error);
                alert('Failed to export PDF: ' + error.message);
            }
        }

        // Export to Excel
        function exportToExcel() {
            try {
                const wb = XLSX.utils.book_new();

                // Sheet 1: Quick Stats
                const statsData = [
                    ['Organization Treasury Dashboard'],
                    ['Generated: ' + new Date().toLocaleString()],
                    [],
                    ['Metric', 'Amount'],
                    ['Total Fees Collected', @totalFeesCollected],
                    ['Total Fines Collected', @totalFinesCollected],
                    ['Pending Fees', @pendingFees],
                    ['Pending Fines', @pendingFines],
                    ['Grand Total', @(totalCollections + pendingFees + pendingFines)]
                ];
                const ws1 = XLSX.utils.aoa_to_sheet(statsData);
                XLSX.utils.book_append_sheet(wb, ws1, 'Quick Stats');

                // Sheet 2: Monthly Trends
                if (monthlyTrends && monthlyTrends.length > 0) {
                    const monthlyData = monthlyTrends.map(item => ({
                        Month: item.Month || item.month || 'Unknown',
                        'Fees Collected': item.FeesCollected || item.feesCollected || 0,
                        'Fines Collected': item.FinesCollected || item.finesCollected || 0,
                        'Total': (item.FeesCollected || item.feesCollected || 0) + (item.FinesCollected || item.finesCollected || 0)
                    }));
                    const ws2 = XLSX.utils.json_to_sheet(monthlyData);
                    XLSX.utils.book_append_sheet(wb, ws2, 'Monthly Trends');
                }

                XLSX.writeFile(wb, 'OrgTreasury_Data_' + new Date().toISOString().split('T')[0] + '.xlsx');
                alert('Excel file exported successfully!');
            } catch (error) {
                console.error('Excel export error:', error);
                alert('Failed to export Excel: ' + error.message);
            }
        }
    </script>
}
