@* C:\Users\Dave\OneDrive\Desktop\copies of code bases from the iBITS Portal\OrgTreasurerDashboard.cshtml *@
@* FILE PATH: Views/Officer/OrgTreasurerDashboard.cshtml *@
@{
    ViewData["Title"] = "Organization Treasury Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var totalFeesCollected = ViewBag.TotalFeesCollected ?? 0m;
    var totalFinesCollected = ViewBag.TotalFinesCollected ?? 0m;
    var pendingFees = ViewBag.PendingFees ?? 0m;
    var pendingFines = ViewBag.PendingFines ?? 0m;
    var totalCollections = ViewBag.TotalCollections ?? 0m;
    var sectionStats = ViewBag.SectionStats as List<dynamic> ?? new List<dynamic>();
}

@section Styles {
    <style>
        .stats-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 15px;
            padding: 24px;
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .stats-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            }

        .stats-icon {
            font-size: 3rem;
            margin-bottom: 12px;
        }

        .section-breakdown-card {
            background: rgba(255,255,255,0.05);
            border-left: 4px solid var(--gold-primary);
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 12px;
            transition: transform 0.2s ease;
        }

            .section-breakdown-card:hover {
                transform: translateX(5px);
                background: rgba(255,255,255,0.08);
            }

        /* Notification Badge Pulse Animation */
        .pulse-notification {
            animation: pulse-glow 2s ease-in-out infinite;
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 1);
        }

        @@keyframes pulse-glow {
            0% {
                box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
            }
            50% {
                box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
            }
        }

        /* No Data Message Styles */
        .no-data-message {
            color: #fff;
            padding: 60px 20px;
            text-align: center;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            margin: 20px auto;
        }

        .no-data-message i {
            font-size: 64px;
            opacity: 0.5;
            color: #FFD700;
        }

        .no-data-message h5 {
            color: #FFD700;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .no-data-message p {
            color: #ccc;
            font-size: 14px;
            margin: 5px 0;
        }

        /* Collection Trends Styles */
        .period-btn {
            min-width: 110px;
        }

        .period-btn.active {
            background-color: #FFD700;
            color: #000;
            border-color: #FFD700;
        }

        /* Compact Summary Cards */
        .summary-card-compact {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 215, 0, 0.2);
            border-radius: 6px;
            padding: 10px;
            transition: all 0.3s ease;
            height: 100%;
        }

        .summary-card-compact:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 215, 0, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .summary-card-compact h6 {
            font-size: 16px;
            font-weight: bold;
        }

        .summary-card-compact small {
            font-size: 11px;
        }

        .top-days-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .top-days-list li {
            background: rgba(255, 255, 255, 0.05);
            border-left: 3px solid #FFD700;
            padding: 10px 15px;
            margin-bottom: 8px;
            border-radius: 4px;
        }

        .top-days-list .date {
            color: #FFD700;
            font-weight: bold;
        }

        .top-days-list .amount {
            color: #fff;
            font-size: 18px;
        }

        .top-days-list .breakdown {
            color: #999;
            font-size: 12px;
        }

        /* Custom Modal Styles */
        .custom-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .custom-modal-overlay.show {
            display: flex;
            animation: fadeIn 0.3s ease;
        }

        .custom-modal {
            background: linear-gradient(135deg, rgba(30, 30, 30, 0.98), rgba(20, 20, 20, 0.98));
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 15px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            animation: slideDown 0.3s ease;
        }

        .custom-modal-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }

        .custom-modal-icon {
            font-size: 2.5rem;
            margin-right: 15px;
        }

        .custom-modal-icon.error {
            color: #dc3545;
        }

        .custom-modal-icon.warning {
            color: #fbbf24;
        }

        .custom-modal-icon.info {
            color: #3b82f6;
        }

        .custom-modal-title {
            color: #fff;
            font-size: 1.5rem;
            font-weight: bold;
            margin: 0;
        }

        .custom-modal-body {
            color: #ccc;
            margin-bottom: 25px;
            line-height: 1.6;
        }

        .custom-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes slideDown {
            from { 
                transform: translateY(-50px);
                opacity: 0;
            }
            to { 
                transform: translateY(0);
                opacity: 1;
            }
        }
    </style>
}

<!-- Custom Modal -->
<div id="customModalOverlay" class="custom-modal-overlay" onclick="closeCustomModal(event)">
    <div class="custom-modal" onclick="event.stopPropagation()">
        <div class="custom-modal-header">
            <i id="customModalIcon" class="bi custom-modal-icon"></i>
            <h5 id="customModalTitle" class="custom-modal-title"></h5>
        </div>
        <div id="customModalBody" class="custom-modal-body"></div>
        <div class="custom-modal-footer">
            <button class="btn btn-sm" onclick="closeCustomModal()" 
                    style="background-color: #FFD700; color: #000; font-weight: bold; border: 2px solid #FFD700; padding: 8px 20px;">
                <i class="bi bi-check-circle me-1"></i> OK
            </button>
        </div>
    </div>
</div>

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="glass-header-title">
            <i class="bi bi-bank2 me-2 text-gold"></i> Organization Treasury Dashboard
        </h4>
        <p class="mb-0 small text-muted">Complete financial overview for all students</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("PaymentReminders", "Officer")" class="btn btn-warning">
            <i class="bi bi-megaphone me-1"></i> Post Reminder
        </a>
        <div class="dropdown">
            <button class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                    style="background-color: #FFD700; color: #000; font-weight: bold; border: 2px solid #FFD700;">
                <i class="bi bi-download me-2"></i> Export Dashboard
            </button>
            <ul class="dropdown-menu dropdown-menu-end" style="background-color: rgba(30, 30, 30, 0.95); border: 1px solid rgba(255, 215, 0, 0.3);">
                <li>
                    <a class="dropdown-item text-white" href="#" onclick="exportChartImages(); return false;">
                        <i class="bi bi-image me-2 text-info"></i> Export Charts as Images (PNG)
                    </a>
                </li>
                <li><hr class="dropdown-divider" style="border-color: rgba(255, 255, 255, 0.1);"></li>
                <li>
                    <a class="dropdown-item text-white" href="#" onclick="exportAsPDF(); return false;">
                        <i class="bi bi-file-pdf me-2 text-danger"></i> Export as PDF Report
                    </a>
                </li>
                <li><hr class="dropdown-divider" style="border-color: rgba(255, 255, 255, 0.1);"></li>
                <li>
                    <a class="dropdown-item text-white" href="#" onclick="exportToExcel(); return false;">
                        <i class="bi bi-file-excel me-2 text-success"></i> Export Data as Excel
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- QUICK ACCESS CARDS REMOVED -->

<!-- REMITTANCE MANAGEMENT CARDS -->
<div class="row mb-4">
    <div class="col-md-6">
        <a href="@Url.Action("PendingRemittances", "Officer")" class="text-decoration-none">
            <div class="glass-panel p-4 h-100 position-relative" style="transition: transform 0.2s ease, box-shadow 0.2s ease; cursor: pointer; background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(245, 158, 11, 0.05)); border: 1px solid rgba(245, 158, 11, 0.4);">
                @if (ViewBag.PendingRemittanceCount != null && ViewBag.PendingRemittanceCount > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger pulse-notification" 
                          style="font-size: 0.85rem; padding: 0.5em 0.75em; z-index: 10;">
                        @ViewBag.PendingRemittanceCount
                        <span class="visually-hidden">pending remittances</span>
                    </span>
                }
                <div class="d-flex align-items-center">
                    <div class="me-4" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; border-radius: 15px;">
                        <i class="bi bi-hourglass-split fs-1"></i>
                    </div>
                    <div>
                        <h5 class="text-white mb-1 fw-bold">Pending Remittances</h5>
                        <p class="text-muted mb-0 small">Review and validate remittances from Class Treasurers</p>
                    </div>
                    <div class="ms-auto">
                        <i class="bi bi-chevron-right fs-4" style="color: #fbbf24;"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="@Url.Action("ValidatedRemittances", "Officer")" class="text-decoration-none">
            <div class="glass-panel p-4 h-100" style="transition: transform 0.2s ease, box-shadow 0.2s ease; cursor: pointer; background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(16, 185, 129, 0.05)); border: 1px solid rgba(16, 185, 129, 0.3);">
                <div class="d-flex align-items-center">
                    <div class="me-4" style="background: rgba(16, 185, 129, 0.2); color: #34d399; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; border-radius: 15px;">
                        <i class="bi bi-check-all fs-1"></i>
                    </div>
                    <div>
                        <h5 class="text-white mb-1 fw-bold">Validated Remittances</h5>
                        <p class="text-muted mb-0 small">View history of all validated remittances</p>
                    </div>
                    <div class="ms-auto">
                        <i class="bi bi-chevron-right fs-4" style="color: #34d399;"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- STATISTICS CARDS -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-wallet-fill stats-icon text-success"></i>
            <h6 class="text-muted mb-1">Total Collections</h6>
            <h2 class="fw-bold text-success mb-0">₱@totalCollections.ToString("N2")</h2>
            <small class="text-muted">Fees + Fines</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-receipt-cutoff stats-icon text-primary"></i>
            <h6 class="text-muted mb-1">Fees Collected</h6>
            <h2 class="fw-bold text-primary mb-0">₱@totalFeesCollected.ToString("N2")</h2>
            <small class="text-muted">From all students</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-exclamation-octagon-fill stats-icon text-warning"></i>
            <h6 class="text-muted mb-1">Fines Collected</h6>
            <h2 class="fw-bold text-warning mb-0">₱@totalFinesCollected.ToString("N2")</h2>
            <small class="text-muted">From penalties</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-hourglass-split stats-icon text-danger"></i>
            <h6 class="text-muted mb-1">Total Pending</h6>
            <h2 class="fw-bold text-danger mb-0">₱@((pendingFees + pendingFines).ToString("N2"))</h2>
            <small class="text-muted">Outstanding balance</small>
        </div>
    </div>
</div>

<!-- CHARTS AND BREAKDOWN -->
<div class="row">
    <div class="col-md-8">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-pie-chart-fill me-2 text-gold"></i> Financial Overview
            </h5>
            <div id="financialChartContainer" style="position: relative; height: 400px;">
                <canvas id="financialChart"></canvas>
                <div id="financialNoData" class="no-data-message" style="display: none;">
                    <i class="bi bi-pie-chart"></i>
                    <h5>No Financial Data Available</h5>
                    <p>There are no fee or fine records to display.</p>
                    <p>Data will appear once students make payments.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-list-check me-2 text-gold"></i> Quick Stats
            </h5>
            <div class="table-responsive">
                <table class="table table-sm text-white">
                    <tbody>
                        <tr>
                            <td><i class="bi bi-check-circle-fill text-success me-2"></i> Total Collected</td>
                            <td class="text-end fw-bold text-success">₱@totalCollections.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-hourglass-split text-warning me-2"></i> Total Pending</td>
                            <td class="text-end fw-bold text-warning">₱@((pendingFees + pendingFines).ToString("N2"))</td>
                        </tr>
                        <tr class="table-active" style="background-color: rgba(255, 215, 0, 0.1);">
                            <td class="text-white"><i class="bi bi-calculator-fill me-2" style="color: #FFD700;"></i> <strong>Grand Total</strong></td>
                            <td class="text-end fw-bold" style="color: #FFD700; font-size: 1.1rem;">₱@((totalCollections + pendingFees + pendingFines).ToString("N2"))</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <hr class="my-3" />

            <h6 class="text-uppercase small fw-bold text-muted mb-3">Collection Rate</h6>
            <div class="progress" style="height: 30px;">
                @{
                    var grandTotal = totalCollections + pendingFees + pendingFines;
                    var collectionRate = grandTotal > 0 ? (totalCollections / grandTotal * 100) : 0;
                }
                <div class="progress-bar bg-success" role="progressbar" style="width: @collectionRate%" aria-valuenow="@collectionRate" aria-valuemin="0" aria-valuemax="100">
                    @collectionRate.ToString("F1")%
                </div>
            </div>
        </div>
    </div>
</div>

<!-- COLLECTION TRENDS -->
<div class="row mt-4">
    <div class="col-12">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-graph-up me-2 text-gold"></i> Collection Trends
                <span id="currentPeriodLabel" class="badge badge-gold ms-2">Last 30 Days</span>
            </h5>

            <!-- Period Selector -->
            <div class="mb-3">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <label class="text-muted small me-2">Quick Periods:</label>
                    <button class="btn btn-sm btn-outline-gold period-btn" data-period="thisweek">
                        <i class="bi bi-calendar-week me-1"></i> This Week
                    </button>
                    <button class="btn btn-sm btn-outline-gold period-btn" data-period="thismonth">
                        <i class="bi bi-calendar-month me-1"></i> This Month
                    </button>
                    <button class="btn btn-sm btn-outline-gold period-btn active" data-period="last30days">
                        <i class="bi bi-clock-history me-1"></i> Last 30 Days
                    </button>
                    <button class="btn btn-sm btn-outline-gold period-btn" data-period="last90days">
                        <i class="bi bi-calendar3-range me-1"></i> Last 90 Days
                    </button>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <label class="text-muted small me-2">Custom Range:</label>
                    <input type="date" id="customStartDate" class="form-control form-control-sm" style="width: 150px;">
                    <span class="text-muted">to</span>
                    <input type="date" id="customEndDate" class="form-control form-control-sm" style="width: 150px;">
                    <button class="btn btn-sm btn-gold" id="applyCustomRange">
                        <i class="bi bi-check-circle me-1"></i> Apply
                    </button>
                </div>
            </div>

            <!-- Bar Chart -->
            <div class="row">
                <div class="col-lg-8 mb-3">
                    <div style="position: relative; height: 400px;">
                        <canvas id="collectionTrendsChart"></canvas>
                        <div id="collectionTrendsNoData" class="no-data-message" style="display: none;">
                            <i class="bi bi-bar-chart"></i>
                            <h5>No Collection Data Available</h5>
                            <p>There are no validated collections for the selected period.</p>
                            <p>Try selecting a different date range or check back later.</p>
                        </div>
                    </div>
                </div>

                <!-- Top 5 Collection Days -->
                <div class="col-lg-4 mb-3">
                    <h6 class="text-gold mb-3"><i class="bi bi-trophy me-2"></i>Top Collection Days</h6>
                    <ul id="topDaysList" class="top-days-list">
                        <li style="text-align: center; color: #999;">Loading...</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PROGRAM-YEAR BREAKDOWN -->
<div class="row mt-4">
    <div class="col-12">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-diagram-3-fill me-2 text-gold"></i> Paid/Unpaid by Program-Year
            </h5>

            <!-- Tabs for Fees/Fines/Combined -->
            <ul class="nav nav-tabs mb-3" id="programYearTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="py-fees-tab" data-bs-toggle="tab" 
                            data-bs-target="#py-fees" type="button" role="tab">
                        <i class="bi bi-cash-coin me-1"></i> Fees
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="py-fines-tab" data-bs-toggle="tab" 
                            data-bs-target="#py-fines" type="button" role="tab">
                        <i class="bi bi-exclamation-triangle me-1"></i> Fines
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="py-combined-tab" data-bs-toggle="tab" 
                            data-bs-target="#py-combined" type="button" role="tab">
                        <i class="bi bi-collection me-1"></i> Combined
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="programYearTabContent">
                <!-- Fees Tab -->
                <div class="tab-pane fade show active" id="py-fees" role="tabpanel">
                    @if (ViewBag.ProgramYearStats != null && ((IEnumerable<dynamic>)ViewBag.ProgramYearStats).Any())
            {
                @foreach (var stat in ViewBag.ProgramYearStats)
                {
                    var programYearTotal = (decimal)stat.TotalFees;
                    var programYearPaid = (decimal)stat.PaidFees;
                    var programYearUnpaid = programYearTotal - programYearPaid;

                    <div class="section-breakdown-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 text-white">@stat.ProgramYear</h6>
                        </div>
                        <div class="row text-center mt-3">
                            <div class="col-4">
                                <small class="text-muted d-block">Total Expected</small>
                                <h6 class="text-white mb-0">₱@programYearTotal.ToString("N2")</h6>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Paid</small>
                                <h6 class="text-success mb-0">₱@programYearPaid.ToString("N2")</h6>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Unpaid</small>
                                <h6 class="text-danger mb-0">₱@programYearUnpaid.ToString("N2")</h6>
                            </div>
                        </div>
                        @{
                            var paidPercent = programYearTotal > 0 ? (programYearPaid / programYearTotal * 100) : 0;
                            var unpaidPercent = programYearTotal > 0 ? (programYearUnpaid / programYearTotal * 100) : 0;
                        }
                        <div class="progress mt-3" style="height: 30px; position: relative; background-color: rgba(220, 53, 69, 0.3);">
                            <div class="progress-bar bg-success d-flex align-items-center justify-content-center" role="progressbar" style="width: @paidPercent.ToString("F1")%">
                                @if (paidPercent > 5)
                                {
                                    <span class="text-white fw-bold small">@paidPercent.ToString("F1")% Paid</span>
                                }
                            </div>
                            @if (unpaidPercent > 5)
                            {
                                <span class="position-absolute text-white fw-bold small" style="right: 10px; top: 50%; transform: translateY(-50%);">
                                    @unpaidPercent.ToString("F1")% Unpaid
                                </span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-muted py-4">No program-year fees data available.</p>
            }
                </div>

                <!-- Fines Tab -->
                <div class="tab-pane fade" id="py-fines" role="tabpanel">
                    @if (ViewBag.ProgramYearFinesStats != null && ((IEnumerable<dynamic>)ViewBag.ProgramYearFinesStats).Any())
                    {
                        @foreach (var stat in ViewBag.ProgramYearFinesStats)
                        {
                            var programYearTotal = (decimal)stat.TotalFines;
                            var programYearPaid = (decimal)stat.PaidFines;
                            var programYearUnpaid = programYearTotal - programYearPaid;

                            <div class="section-breakdown-card">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0 text-white">@stat.ProgramYear</h6>
                                </div>
                                <div class="row text-center mt-3">
                                    <div class="col-4">
                                        <small class="text-muted d-block">Total Expected</small>
                                        <h6 class="text-white mb-0">₱@programYearTotal.ToString("N2")</h6>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block">Paid</small>
                                        <h6 class="text-success mb-0">₱@programYearPaid.ToString("N2")</h6>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block">Unpaid</small>
                                        <h6 class="text-danger mb-0">₱@programYearUnpaid.ToString("N2")</h6>
                                    </div>
                                </div>
                                <div class="progress mt-3" style="height: 20px; background-color: rgba(255, 255, 255, 0.1);">
                                    <div class="progress-bar bg-success" role="progressbar" 
                                         style="width: @((programYearTotal > 0 ? (programYearPaid / programYearTotal * 100) : 0).ToString("F2"))%"
                                         aria-valuenow="@programYearPaid" aria-valuemin="0" aria-valuemax="@programYearTotal">
                                        @((programYearTotal > 0 ? (programYearPaid / programYearTotal * 100) : 0).ToString("F1"))%
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-center text-muted py-4">No program-year fines data available.</p>
                    }
                </div>

                <!-- Combined Tab -->
                <div class="tab-pane fade" id="py-combined" role="tabpanel">
                    @if (ViewBag.ProgramYearCombinedStats != null && ((IEnumerable<dynamic>)ViewBag.ProgramYearCombinedStats).Any())
                    {
                        @foreach (var stat in ViewBag.ProgramYearCombinedStats)
                        {
                            var programYearTotal = (decimal)stat.TotalCombined;
                            var programYearPaid = (decimal)stat.PaidCombined;
                            var programYearUnpaid = programYearTotal - programYearPaid;

                            <div class="section-breakdown-card">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0 text-white">@stat.ProgramYear</h6>
                                </div>
                                <div class="row text-center mt-3">
                                    <div class="col-4">
                                        <small class="text-muted d-block">Total Expected</small>
                                        <h6 class="text-white mb-0">₱@programYearTotal.ToString("N2")</h6>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block">Paid</small>
                                        <h6 class="text-success mb-0">₱@programYearPaid.ToString("N2")</h6>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block">Unpaid</small>
                                        <h6 class="text-danger mb-0">₱@programYearUnpaid.ToString("N2")</h6>
                                    </div>
                                </div>
                                <div class="progress mt-3" style="height: 20px; background-color: rgba(255, 255, 255, 0.1);">
                                    <div class="progress-bar bg-success" role="progressbar" 
                                         style="width: @((programYearTotal > 0 ? (programYearPaid / programYearTotal * 100) : 0).ToString("F2"))%"
                                         aria-valuenow="@programYearPaid" aria-valuemin="0" aria-valuemax="@programYearTotal">
                                        @((programYearTotal > 0 ? (programYearPaid / programYearTotal * 100) : 0).ToString("F1"))%
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-center text-muted py-4">No program-year combined data available.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- html2canvas - For capturing DOM elements as images -->
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    
    <!-- jsPDF - For PDF generation -->
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    
    <!-- SheetJS - For Excel export -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
    
    <script>
        // Collection Trends Bar Chart Variables
        let collectionTrendsChart = null;
        let currentPeriod = 'last30days';

        // ============================================================
        // LOAD COLLECTION TRENDS DATA
        // ============================================================
        function loadCollectionTrendsData(period = null, startDate = null, endDate = null) {
            console.log('Loading Collection Trends:', period, startDate, endDate);
            
            // Update active button
            document.querySelectorAll('.period-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            
            if (period) {
                const activeBtn = document.querySelector(`[data-period="${period}"]`);
                if (activeBtn) activeBtn.classList.add('active');
                currentPeriod = period;
            }
            
            // Show loading
            document.getElementById('currentPeriodLabel').innerHTML = '<i class="spinner-border spinner-border-sm me-1"></i> Loading...';
            
            // Build query parameters
            let params = new URLSearchParams();
            
            if (period && period !== 'custom') {
                params.append('period', period);
            } else if (startDate && endDate) {
                params.append('period', 'custom');
                params.append('startDate', startDate);
                params.append('endDate', endDate);
            } else {
                params.append('period', 'last30days');
            }
            
            // Fetch data
            fetch(`/Officer/GetCollectionTrendsData?${params}`)
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.json();
                })
                .then(result => {
                    console.log('Collection Trends Result:', result);
                    
                    if (result.success) {
                        // Update period label
                        document.getElementById('currentPeriodLabel').textContent = result.periodLabel;
                        
                        // Update top days list
                        updateTopDaysList(result.topDays);
                        
                        // Update chart
                        updateCollectionTrendsChart(result.data, result.grouping);
                    } else {
                        showCustomModal('Error Loading Data', result.message || 'Failed to load collection trends.', 'error');
                        document.getElementById('currentPeriodLabel').textContent = 'Error';
                    }
                })
                .catch(error => {
                    console.error('Error loading collection trends:', error);
                    showCustomModal('Data Load Failed', 
                        'Unable to retrieve collection trends data. Please check your connection and try again.', 
                        'error');
                    document.getElementById('currentPeriodLabel').textContent = 'Error';
                });
        }

        // ============================================================
        // CUSTOM MODAL FUNCTIONS
        // ============================================================
        // UPDATE TOP DAYS LIST
        // ============================================================
        function updateTopDaysList(topDays) {
            const listContainer = document.getElementById('topDaysList');
            
            if (!topDays || topDays.length === 0) {
                listContainer.innerHTML = '<li style="text-align: center; color: #999;">No collection data available</li>';
                return;
            }
            
            listContainer.innerHTML = topDays.map((day, index) => `
                <li>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge badge-gold me-2">#${index + 1}</span>
                            <span class="date">${day.date}</span>
                        </div>
                        <div class="text-end">
                            <div class="amount">₱${day.amount.toLocaleString()}</div>
                            <div class="breakdown">Fees: ₱${day.fees.toLocaleString()} | Fines: ₱${day.fines.toLocaleString()}</div>
                        </div>
                    </div>
                </li>
            `).join('');
        }

        // ============================================================
        // UPDATE COLLECTION TRENDS CHART
        // ============================================================
        function updateCollectionTrendsChart(data, grouping) {
            const canvas = document.getElementById('collectionTrendsChart');
            const noDataDiv = document.getElementById('collectionTrendsNoData');
            
            if (!data || data.length === 0) {
                canvas.style.display = 'none';
                noDataDiv.style.display = 'block';
                if (collectionTrendsChart) {
                    collectionTrendsChart.destroy();
                    collectionTrendsChart = null;
                }
                return;
            }
            
            canvas.style.display = 'block';
            noDataDiv.style.display = 'none';
            
            const labels = data.map(d => d.label);
            const feesData = data.map(d => d.fees);
            const finesData = data.map(d => d.fines);
            
            if (collectionTrendsChart) {
                collectionTrendsChart.destroy();
            }
            
            const ctx = canvas.getContext('2d');
            collectionTrendsChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Fees',
                            data: feesData,
                            backgroundColor: 'rgba(255, 215, 0, 0.8)',
                            borderColor: 'rgba(255, 215, 0, 1)',
                            borderWidth: 1
                        },
                        {
                            label: 'Fines',
                            data: finesData,
                            backgroundColor: 'rgba(54, 162, 235, 0.8)',
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: { color: '#fff', font: { size: 12 } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ₱' + context.parsed.y.toLocaleString();
                                },
                                footer: function(tooltipItems) {
                                    let total = 0;
                                    tooltipItems.forEach(item => { total += item.parsed.y; });
                                    return 'Total: ₱' + total.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#fff' },
                            grid: { color: 'rgba(255, 255, 255, 0.1)' }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: '#fff',
                                callback: function(value) { return '₱' + value.toLocaleString(); }
                            },
                            grid: { color: 'rgba(255, 255, 255, 0.1)' }
                        }
                    }
                }
            });
        }

        // ============================================================
        function showCustomModal(title, message, type = 'error') {
            const modal = document.getElementById('customModalOverlay');
            const icon = document.getElementById('customModalIcon');
            const titleEl = document.getElementById('customModalTitle');
            const bodyEl = document.getElementById('customModalBody');
            
            // Set icon based on type
            icon.className = 'bi custom-modal-icon ' + type;
            switch(type) {
                case 'error':
                    icon.classList.add('bi-x-circle-fill');
                    break;
                case 'warning':
                    icon.classList.add('bi-exclamation-triangle-fill');
                    break;
                case 'info':
                    icon.classList.add('bi-info-circle-fill');
                    break;
                default:
                    icon.classList.add('bi-x-circle-fill');
            }
            
            titleEl.textContent = title;
            bodyEl.innerHTML = message;
            modal.classList.add('show');
        }
        
        function closeCustomModal(event) {
            if (event && event.target !== document.getElementById('customModalOverlay')) {
                return;
            }
            document.getElementById('customModalOverlay').classList.remove('show');
        }
        
        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeCustomModal();
            }
        });
        
        // Collection Trends removed - no initialization needed

        // ============================================================
        // LOAD AVAILABLE DATES AND DISABLE FILTERS WITHOUT DATA
        // ============================================================
        let availableMonthsData = [];
        let minAvailableDate = null;
        let maxAvailableDate = null;

        // Fetch available dates from server
        fetch('/Officer/GetAvailableDates')
            .then(response => {
                console.log('GetAvailableDates response status:', response.status);
                return response.json();
            })
            .then(result => {
                console.log('GetAvailableDates result:', result);
                
                if (result.success && result.hasData) {
                    availableMonthsData = result.availableMonths;
                    minAvailableDate = result.minDate;
                    maxAvailableDate = result.maxDate;

                    console.log('Available months:', availableMonthsData);
                    console.log('Date range:', minAvailableDate, 'to', maxAvailableDate);

                    // Set min/max for date range pickers
                    document.getElementById('fromDate').setAttribute('min', minAvailableDate);
                    document.getElementById('fromDate').setAttribute('max', maxAvailableDate);
                    document.getElementById('toDate').setAttribute('min', minAvailableDate);
                    document.getElementById('toDate').setAttribute('max', maxAvailableDate);

                    // Disable months without data
                    disableMonthsWithoutData();
                    
                    // Populate year dropdown with only years that have data
                    populateYearsWithData();

                    // Disable quick filters without data
                    disableQuickFiltersWithoutData(result.quickFilters);

                    // Populate academic years
                    populateAcademicYears(result.academicYears);
                } else if (result.success && !result.hasData) {
                    console.warn('No validated remittance data available');
                } else {
                    console.error('Error from server:', result.message);
                }
            })
            .catch(error => {
                console.error('Error loading available dates:', error);
            });

        // Function to disable months that don't have data
        function disableMonthsWithoutData() {
            const monthSelect = document.getElementById('monthSelect');
            const yearSelect = document.getElementById('yearSelect');

            // Listen to year changes to update month availability
            yearSelect.addEventListener('change', function() {
                updateMonthAvailability();
            });

            // Initial update
            updateMonthAvailability();
        }

        function updateMonthAvailability() {
            const selectedYear = parseInt(document.getElementById('yearSelect').value);
            const monthSelect = document.getElementById('monthSelect');
            
            // Get all month options
            const monthOptions = monthSelect.querySelectorAll('option');
            
            monthOptions.forEach(option => {
                const monthValue = parseInt(option.value);
                
                // Check if this year-month combination has data
                const hasData = availableMonthsData.some(m => m.year === selectedYear && m.month === monthValue);
                
                if (hasData) {
                    option.disabled = false;
                    option.style.color = '';
                } else {
                    option.disabled = true;
                    option.style.color = '#666';
                }
            });

            // If current selection is disabled, select the first enabled option
            if (monthSelect.selectedOptions[0]?.disabled) {
                const firstEnabled = Array.from(monthOptions).find(opt => !opt.disabled);
                if (firstEnabled) {
                    monthSelect.value = firstEnabled.value;
                }
            }
        }

        function populateYearsWithData() {
            // Get unique years from available months
            const uniqueYears = [...new Set(availableMonthsData.map(m => m.year))].sort((a, b) => b - a);
            
            const yearSelect = document.getElementById('yearSelect');
            yearSelect.innerHTML = ''; // Clear existing options
            
            uniqueYears.forEach(year => {
                const option = document.createElement('option');
                option.value = year;
                option.textContent = year;
                
                // Select current year if available
                if (year === new Date().getFullYear()) {
                    option.selected = true;
                }
                
                yearSelect.appendChild(option);
            });

            // If current year not in list, select the most recent
            if (!uniqueYears.includes(new Date().getFullYear()) && uniqueYears.length > 0) {
                yearSelect.value = uniqueYears[0];
            }

            // Update month availability after populating years
            updateMonthAvailability();
        }

        function disableQuickFiltersWithoutData(quickFilters) {
            const quickRangeSelect = document.getElementById('quickRange');
            const options = quickRangeSelect.querySelectorAll('option');

            options.forEach(option => {
                const value = option.value;
                let hasData = false;

                switch(value) {
                    case 'lastWeek':
                        hasData = quickFilters.lastWeek;
                        break;
                    case 'lastMonth':
                        hasData = quickFilters.lastMonth;
                        break;
                    case 'last3Months':
                        hasData = quickFilters.last3Months;
                        break;
                    case 'last6Months':
                        hasData = quickFilters.last6Months;
                        break;
                    case 'currentSemester':
                        hasData = quickFilters.currentSemester;
                        break;
                    case 'fullYear':
                        hasData = quickFilters.fullYear;
                        break;
                }

                if (!hasData) {
                    option.disabled = true;
                    option.style.color = '#666';
                } else {
                    option.disabled = false;
                    option.style.color = '';
                }
            });

            // If current selection is disabled, select the first enabled option
            if (quickRangeSelect.selectedOptions[0]?.disabled) {
                const firstEnabled = Array.from(options).find(opt => !opt.disabled);
                if (firstEnabled) {
                    quickRangeSelect.value = firstEnabled.value;
                }
            }
        }

        function populateAcademicYears(academicYears) {
            const academicYearSelect = document.getElementById('academicYear');
            academicYearSelect.innerHTML = ''; // Clear existing options

            if (academicYears && academicYears.length > 0) {
                academicYears.reverse().forEach(year => { // Reverse to show newest first
                    const option = document.createElement('option');
                    option.value = year;
                    option.textContent = year;
                    
                    // Select the most recent academic year
                    if (year === academicYears[academicYears.length - 1]) {
                        option.selected = true;
                    }
                    
                    academicYearSelect.appendChild(option);
                });
            } else {
                // Fallback if no academic years found
                const option = document.createElement('option');
                option.value = '2025-2026';
                option.textContent = '2025-2026';
                academicYearSelect.appendChild(option);
            }
        }

        // ============================================================
        // FINANCIAL OVERVIEW PIE CHART
        // ============================================================
        
        // Check if we have financial data
        const totalFeesCollected = @totalFeesCollected;
        const totalFinesCollected = @totalFinesCollected;
        const pendingFees = @pendingFees;
        const pendingFines = @pendingFines;
        
        const hasFinancialData = (totalFeesCollected + totalFinesCollected + pendingFees + pendingFines) > 0;
        
        const financialCanvas = document.getElementById('financialChart');
        const financialNoDataDiv = document.getElementById('financialNoData');
        
        if (!hasFinancialData) {
            // Hide canvas and show no-data message
            financialCanvas.style.display = 'none';
            financialNoDataDiv.style.display = 'block';
        } else {
            // Show canvas and hide no-data message
            financialCanvas.style.display = 'block';
            financialNoDataDiv.style.display = 'none';
            
            // Initialize the pie chart
            const ctx = financialCanvas.getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Paid Fees', 'Paid Fines', 'Unpaid Fees', 'Unpaid Fines'],
                    datasets: [{
                        data: [totalFeesCollected, totalFinesCollected, pendingFees, pendingFines],
                        backgroundColor: ['#3b82f6', '#f59e0b', '#ef4444', '#dc2626'],
                        borderWidth: 2,
                        borderColor: 'rgba(255, 255, 255, 0.1)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#fff',
                                padding: 20,
                                font: { size: 14 }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ₱' + context.parsed.toLocaleString('en-US', {minimumFractionDigits: 2});
                                }
                            }
                        }
                    }
                }
            });
        }

        // ============================================================
        // EXPORT FUNCTIONS
        // ============================================================

        // Export Charts as Images (PNG)
        async function exportChartImages() {
            try {
                alert('Generating images... This may take a few seconds.');

                // Collection Trends section removed from export

                // Capture Program-Year section
                const programYearSection = document.querySelectorAll('.glass-panel')[document.querySelectorAll('.glass-panel').length - 1];
                const pyCanvas = await html2canvas(programYearSection, {
                    backgroundColor: '#1a1a2e',
                    scale: 2
                });
                
                const pyImg = pyCanvas.toDataURL('image/png');
                const link2 = document.createElement('a');
                link2.href = pyImg;
                link2.download = 'program_year_stats_' + new Date().toISOString().split('T')[0] + '.png';
                document.body.appendChild(link2);
                link2.click();
                document.body.removeChild(link2);

                alert('Images exported successfully!');
            } catch (error) {
                console.error('Export error:', error);
                alert('Failed to export images: ' + error.message);
            }
        }

        // Export as PDF Report
        async function exportAsPDF() {
            try {
                alert('Generating PDF... This may take a few seconds.');

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('portrait', 'mm', 'a4');
                
                // Header
                pdf.setFontSize(20);
                pdf.setTextColor(255, 215, 0);
                pdf.text('Organization Treasury Dashboard', 20, 20);
                
                pdf.setFontSize(10);
                pdf.setTextColor(150, 150, 150);
                pdf.text('Generated: ' + new Date().toLocaleString(), 20, 28);
                
                // Quick Stats
                pdf.setFontSize(14);
                pdf.setTextColor(255, 215, 0);
                pdf.text('Financial Summary', 20, 40);
                
                pdf.setFontSize(10);
                pdf.setTextColor(0, 0, 0);
                pdf.text('Total Fees Collected: PHP ' + (@totalFeesCollected).toLocaleString(), 20, 48);
                pdf.text('Total Fines Collected: PHP ' + (@totalFinesCollected).toLocaleString(), 20, 55);
                pdf.text('Pending Fees: PHP ' + (@pendingFees).toLocaleString(), 20, 62);
                pdf.text('Pending Fines: PHP ' + (@pendingFines).toLocaleString(), 20, 69);
                pdf.text('Grand Total: PHP ' + (@(totalCollections + pendingFees + pendingFines)).toLocaleString(), 20, 76);

                // Collection Trends section removed from PDF export

                // Page 2
                pdf.addPage();
                pdf.setFontSize(14);
                pdf.setTextColor(255, 215, 0);
                pdf.text('Program-Year Breakdown', 20, 20);

                const programYearSection = document.querySelectorAll('.glass-panel')[document.querySelectorAll('.glass-panel').length - 1];
                const pyCanvas = await html2canvas(programYearSection, { scale: 1 });
                const pyImg = pyCanvas.toDataURL('image/jpeg', 0.7);
                pdf.addImage(pyImg, 'JPEG', 20, 30, 170, 100);

                pdf.save('OrgTreasury_Report_' + new Date().toISOString().split('T')[0] + '.pdf');
                alert('PDF exported successfully!');
            } catch (error) {
                console.error('PDF export error:', error);
                alert('Failed to export PDF: ' + error.message);
            }
        }

        // Export to Excel
        function exportToExcel() {
            try {
                const wb = XLSX.utils.book_new();

                // Sheet 1: Quick Stats
                const statsData = [
                    ['Organization Treasury Dashboard'],
                    ['Generated: ' + new Date().toLocaleString()],
                    [],
                    ['Metric', 'Amount'],
                    ['Total Fees Collected', @totalFeesCollected],
                    ['Total Fines Collected', @totalFinesCollected],
                    ['Pending Fees', @pendingFees],
                    ['Pending Fines', @pendingFines],
                    ['Grand Total', @(totalCollections + pendingFees + pendingFines)]
                ];
                const ws1 = XLSX.utils.aoa_to_sheet(statsData);
                XLSX.utils.book_append_sheet(wb, ws1, 'Quick Stats');

                
                // Monthly Trends sheet removed

                XLSX.writeFile(wb, 'OrgTreasury_Data_' + new Date().toISOString().split('T')[0] + '.xlsx');
                alert('Excel file exported successfully!');
            } catch (error) {
                console.error('Excel export error:', error);
                alert('Failed to export Excel: ' + error.message);
            }
        }

        // ============================================================
        // GROUPING HELPER FUNCTIONS
        // ============================================================
        
        // Collection Trends grouping functions removed

        // Add event listeners for grouping radio buttons
        document.addEventListener('DOMContentLoaded', function() {
            const groupingRadios = document.querySelectorAll('input[name="groupBy"]');
            groupingRadios.forEach(radio => {
                radio.addEventListener('change', function() {
                    applyFilter(); // Re-apply filter with new grouping
                });
            });
        });
        
        // ============================================================

          // Update sum

        // Collection Trends summary cards function removed

// Up

        // ============================================================
        // EVENT LISTENERS - COLLECTION TRENDS
        // ============================================================
        
        // Period button click handlers
        document.querySelectorAll('.period-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const period = this.getAttribute('data-period');
                loadCollectionTrendsData(period);
            });
        });
        
        // Custom date range apply button
        document.getElementById('applyCustomRange').addEventListener('click', function() {
            const startDate = document.getElementById('customStartDate').value;
            const endDate = document.getElementById('customEndDate').value;
            
            if (!startDate || !endDate) {
                showCustomModal('Invalid Date Selection', 'Please select both start and end dates.', 'warning');
                return;
            }
            
            if (new Date(endDate) < new Date(startDate)) {
                showCustomModal('Invalid Date Range', 'End date must be after start date.', 'warning');
                return;
            }
            
            if (new Date(endDate) > new Date()) {
                showCustomModal('Invalid Date Range', 'Cannot select future dates.', 'warning');
                return;
            }
            
            const daysDiff = (new Date(endDate) - new Date(startDate)) / (1000 * 60 * 60 * 24);
            if (daysDiff > 365) {
                showCustomModal('Invalid Date Range', 'Date range cannot exceed 1 year (365 days).', 'warning');
                return;
            }
            
            // Clear active buttons
            document.querySelectorAll('.period-btn').forEach(btn => btn.classList.remove('active'));
            
            loadCollectionTrendsData('custom', startDate, endDate);
        });
        
        // Load initial data on page load
        loadCollectionTrendsData('last30days');
    </script>
}
