@* FILE PATH: Views/Officer/OrgTreasurerDashboard.cshtml *@
@{
    ViewData["Title"] = "Organization Treasury Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var totalFeesCollected = ViewBag.TotalFeesCollected ?? 0m;
    var totalFinesCollected = ViewBag.TotalFinesCollected ?? 0m;
    var pendingFees = ViewBag.PendingFees ?? 0m;
    var pendingFines = ViewBag.PendingFines ?? 0m;
    var totalCollections = ViewBag.TotalCollections ?? 0m;
    var sectionStats = ViewBag.SectionStats as List<dynamic> ?? new List<dynamic>();
}

@section Styles {
    <style>
        .stats-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 15px;
            padding: 24px;
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .stats-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            }

        .stats-icon {
            font-size: 3rem;
            margin-bottom: 12px;
        }

        .section-breakdown-card {
            background: rgba(255,255,255,0.05);
            border-left: 4px solid var(--gold-primary);
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 12px;
            transition: transform 0.2s ease;
        }

            .section-breakdown-card:hover {
                transform: translateX(5px);
                background: rgba(255,255,255,0.08);
            }
    </style>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="glass-header-title">
            <i class="bi bi-bank2 me-2 text-gold"></i> Organization Treasury Dashboard
        </h4>
        <p class="mb-0 small text-muted">Complete financial overview for all students</p>
    </div>
    <div>
        <a href="@Url.Action("PaymentReminders", "Officer")" class="btn btn-warning">
            <i class="bi bi-megaphone me-1"></i> Post Reminder
        </a>
    </div>
</div>

<!-- SEMESTER FILTER -->
<div class="glass-panel p-3 mb-4">
    <form method="get" asp-action="OrgTreasurerDashboard" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label small text-muted">Semester</label>
            <select name="semesterFilter" class="form-select" onchange="this.form.submit()">
                <option value="">All Semesters</option>
                @if (ViewBag.Semesters != null)
                {
                    foreach (var sem in ViewBag.Semesters)
                    {
                        <option value="@sem.SemesterId" selected="@(ViewBag.SemesterFilter?.ToString() == sem.SemesterId.ToString())">
                            @sem.SemesterName (@sem.AcademicYear.YearName)
                        </option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <a class="btn btn-outline-light w-100" href="@Url.Action("OrgTreasurerDashboard")">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </a>
        </div>
    </form>
</div>

<!-- QUICK ACCESS CARDS -->
<div class="row mb-4">
    <div class="col-md-6">
        <a href="@Url.Action("OrgFees", "Officer", new { semesterFilter = ViewBag.SemesterFilter })" class="text-decoration-none">
            <div class="glass-panel p-4 h-100" style="transition: transform 0.2s ease, box-shadow 0.2s ease; cursor: pointer;">
                <div class="d-flex align-items-center">
                    <div class="me-4" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; border-radius: 15px;">
                        <i class="bi bi-cash-stack fs-1"></i>
                    </div>
                    <div>
                        <h5 class="text-white mb-1 fw-bold">Fees Management</h5>
                        <p class="text-muted mb-0 small">View all fees, create new fees, and track collections across all sections</p>
                    </div>
                    <div class="ms-auto">
                        <i class="bi bi-chevron-right text-gold fs-4"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="@Url.Action("OrgFines", "Officer", new { semesterFilter = ViewBag.SemesterFilter })" class="text-decoration-none">
            <div class="glass-panel p-4 h-100" style="transition: transform 0.2s ease, box-shadow 0.2s ease; cursor: pointer;">
                <div class="d-flex align-items-center">
                    <div class="me-4" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; border-radius: 15px;">
                        <i class="bi bi-exclamation-triangle fs-1"></i>
                    </div>
                    <div>
                        <h5 class="text-white mb-1 fw-bold">Fines Management</h5>
                        <p class="text-muted mb-0 small">View all fines, create new fines, and monitor penalty collections</p>
                    </div>
                    <div class="ms-auto">
                        <i class="bi bi-chevron-right text-gold fs-4"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- REMITTANCE MANAGEMENT CARDS -->
<div class="row mb-4">
    <div class="col-md-6">
        <a href="@Url.Action("PendingRemittances", "Officer")" class="text-decoration-none">
            <div class="glass-panel p-4 h-100" style="transition: transform 0.2s ease, box-shadow 0.2s ease; cursor: pointer; background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(245, 158, 11, 0.05)); border: 1px solid rgba(245, 158, 11, 0.4);">
                <div class="d-flex align-items-center">
                    <div class="me-4" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; border-radius: 15px;">
                        <i class="bi bi-hourglass-split fs-1"></i>
                    </div>
                    <div>
                        <h5 class="text-white mb-1 fw-bold">Pending Remittances</h5>
                        <p class="text-muted mb-0 small">Review and validate remittances from Class Treasurers</p>
                    </div>
                    <div class="ms-auto">
                        <i class="bi bi-chevron-right fs-4" style="color: #fbbf24;"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="@Url.Action("ValidatedRemittances", "Officer")" class="text-decoration-none">
            <div class="glass-panel p-4 h-100" style="transition: transform 0.2s ease, box-shadow 0.2s ease; cursor: pointer; background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(16, 185, 129, 0.05)); border: 1px solid rgba(16, 185, 129, 0.3);">
                <div class="d-flex align-items-center">
                    <div class="me-4" style="background: rgba(16, 185, 129, 0.2); color: #34d399; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; border-radius: 15px;">
                        <i class="bi bi-check-all fs-1"></i>
                    </div>
                    <div>
                        <h5 class="text-white mb-1 fw-bold">Validated Remittances</h5>
                        <p class="text-muted mb-0 small">View history of all validated remittances</p>
                    </div>
                    <div class="ms-auto">
                        <i class="bi bi-chevron-right fs-4" style="color: #34d399;"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- STATISTICS CARDS -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-wallet-fill stats-icon text-success"></i>
            <h6 class="text-muted mb-1">Total Collections</h6>
            <h2 class="fw-bold text-success mb-0">₱@totalCollections.ToString("N2")</h2>
            <small class="text-muted">Fees + Fines</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-receipt-cutoff stats-icon text-primary"></i>
            <h6 class="text-muted mb-1">Fees Collected</h6>
            <h2 class="fw-bold text-primary mb-0">₱@totalFeesCollected.ToString("N2")</h2>
            <small class="text-muted">From all students</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-exclamation-octagon-fill stats-icon text-warning"></i>
            <h6 class="text-muted mb-1">Fines Collected</h6>
            <h2 class="fw-bold text-warning mb-0">₱@totalFinesCollected.ToString("N2")</h2>
            <small class="text-muted">From penalties</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-hourglass-split stats-icon text-danger"></i>
            <h6 class="text-muted mb-1">Total Pending</h6>
            <h2 class="fw-bold text-danger mb-0">₱@((pendingFees + pendingFines).ToString("N2"))</h2>
            <small class="text-muted">Outstanding balance</small>
        </div>
    </div>
</div>

<!-- CHARTS AND BREAKDOWN -->
<div class="row">
    <div class="col-md-8">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-pie-chart-fill me-2 text-gold"></i> Financial Overview
            </h5>
            <div style="position: relative; height: 400px;">
                <canvas id="financialChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-list-check me-2 text-gold"></i> Quick Stats
            </h5>
            <div class="table-responsive">
                <table class="table table-sm text-white">
                    <tbody>
                        <tr>
                            <td><i class="bi bi-check-circle-fill text-success me-2"></i> Total Collected</td>
                            <td class="text-end fw-bold text-success">₱@totalCollections.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-hourglass-split text-warning me-2"></i> Total Pending</td>
                            <td class="text-end fw-bold text-warning">₱@((pendingFees + pendingFines).ToString("N2"))</td>
                        </tr>
                        <tr class="table-active">
                            <td><i class="bi bi-calculator me-2"></i> Grand Total</td>
                            <td class="text-end fw-bold text-white">₱@((totalCollections + pendingFees + pendingFines).ToString("N2"))</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <hr class="my-3" />

            <h6 class="text-uppercase small fw-bold text-muted mb-3">Collection Rate</h6>
            <div class="progress" style="height: 30px;">
                @{
                    var grandTotal = totalCollections + pendingFees + pendingFines;
                    var collectionRate = grandTotal > 0 ? (totalCollections / grandTotal * 100) : 0;
                }
                <div class="progress-bar bg-success" role="progressbar" style="width: @collectionRate%" aria-valuenow="@collectionRate" aria-valuemin="0" aria-valuemax="100">
                    @collectionRate.ToString("F1")%
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MONTHLY COLLECTION TRENDS -->
<div class="row mt-4">
    <div class="col-12">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-graph-up me-2 text-gold"></i> Collection Trends (Current Academic Year)
            </h5>
            <canvas id="trendsChart" style="max-height: 300px;"></canvas>
        </div>
    </div>
</div>

<!-- PROGRAM-YEAR BREAKDOWN -->
<div class="row mt-4">
    <div class="col-12">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-diagram-3-fill me-2 text-gold"></i> Paid/Unpaid by Program-Year
                <button class="btn btn-sm btn-outline-light float-end" onclick="exportProgramYearData()">
                    <i class="bi bi-download me-1"></i> Export
                </button>
            </h5>
            @if (ViewBag.ProgramYearStats != null && ((IEnumerable<dynamic>)ViewBag.ProgramYearStats).Any())
            {
                @foreach (var stat in ViewBag.ProgramYearStats)
                {
                    var programYearTotal = (decimal)stat.TotalFees;
                    var programYearPaid = (decimal)stat.PaidFees;
                    var programYearUnpaid = programYearTotal - programYearPaid;

                    <div class="section-breakdown-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 text-white">@stat.ProgramYear</h6>
                        </div>
                        <div class="row text-center mt-3">
                            <div class="col-4">
                                <small class="text-muted d-block">Total Expected</small>
                                <h6 class="text-white mb-0">₱@programYearTotal.ToString("N2")</h6>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Paid</small>
                                <h6 class="text-success mb-0">₱@programYearPaid.ToString("N2")</h6>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Unpaid</small>
                                <h6 class="text-danger mb-0">₱@programYearUnpaid.ToString("N2")</h6>
                            </div>
                        </div>
                        <div class="progress mt-3" style="height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @((programYearTotal > 0 ? (programYearPaid / programYearTotal * 100) : 0).ToString("F1"))%"></div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-muted py-4">No program-year data available.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Monthly Trends Line Chart
        const trendsCtx = document.getElementById('trendsChart').getContext('2d');
        const monthlyTrends = @Html.Raw(Json.Serialize(ViewBag.MonthlyTrends ?? new List<object>()));
        
        new Chart(trendsCtx, {
            type: 'line',
            data: {
                labels: monthlyTrends.map(t => t.Month),
                datasets: [
                    {
                        label: 'Fees Collected',
                        data: monthlyTrends.map(t => t.FeesCollected),
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    },
                    {
                        label: 'Fines Collected',
                        data: monthlyTrends.map(t => t.FinesCollected),
                        borderColor: '#f59e0b',
                        backgroundColor: 'rgba(245, 158, 11, 0.1)',
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        labels: { color: '#fff', font: { size: 12 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ₱' + context.parsed.y.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { 
                            color: '#fff',
                            callback: function(value) {
                                return '₱' + value.toLocaleString();
                            }
                        },
                        grid: { color: 'rgba(255, 255, 255, 0.1)' }
                    },
                    x: {
                        ticks: { color: '#fff' },
                        grid: { color: 'rgba(255, 255, 255, 0.1)' }
                    }
                }
            }
        });

        // Financial Doughnut Chart
        const ctx = document.getElementById('financialChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Paid Fees', 'Paid Fines', 'Unpaid Fees', 'Unpaid Fines'],
                datasets: [{
                    data: [@totalFeesCollected, @totalFinesCollected, @pendingFees, @pendingFines],
                    backgroundColor: ['#3b82f6', '#f59e0b', '#ef4444', '#dc2626'],
                    borderWidth: 2,
                    borderColor: 'rgba(255, 255, 255, 0.1)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#fff',
                            padding: 20,
                            font: { size: 14 }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.label + ': ₱' + context.parsed.toLocaleString('en-US', {minimumFractionDigits: 2});
                            }
                        }
                    }
                }
            }
        });
    </script>
}
