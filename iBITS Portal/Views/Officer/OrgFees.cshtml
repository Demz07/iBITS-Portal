@* FILE PATH: Views/Officer/OrgFees.cshtml *@
@* ORG TREASURER - FEES MANAGEMENT (Edit UNPAID only, no partial payments) *@
@model IEnumerable<iBITS_Portal.Models.Fee>
@using iBITS_Portal.Models
@{
    ViewData["Title"] = "Organization Fees Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var allFees = Model?.ToList() ?? new List<iBITS_Portal.Models.Fee>();
    var totalExp = ViewBag.TotalExpected ?? 0m;
    var totalCol = ViewBag.TotalCollected ?? 0m;
    var totalPending = ViewBag.TotalPending ?? 0m;
    var collectionRate = ViewBag.CollectionRate ?? 0m;
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/officer-treasury.css" asp-append-version="true" />

@section Styles {
<style>
    /* Chart No Data State */
    .chart-no-data {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 250px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
    }
    .chart-no-data i {
        font-size: 4rem;
        margin-bottom: 1rem;
        color: rgba(212, 175, 55, 0.2);
    }
    .chart-no-data p {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
    }
    .summary-card {
        height: 100%;
        min-height: 110px;
    }
    .info-banner {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 8px;
        padding: 12px 16px;
        color: #93c5fd;
        font-size: 0.9rem;
    }
    .info-banner i {
        color: #3b82f6;
    }
</style>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;">
            <i class="bi bi-cash-stack me-2"></i> Organization Fees Management
        </h3>
        <p class="text-muted small mb-0">View and create fees for all students across the organization</p>
    </div>
    <div>
        <a asp-action="OrgTreasurerDashboard" class="btn btn-outline-light btn-sm me-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FINANCIAL OVERVIEW -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> Fees Overview
    </h5>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Expected -->
        <div class="col-md-4">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(6, 182, 212, 0.15); color: #06b6d4; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collected -->
        <div class="col-md-4">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Paid</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Outstanding -->
        <div class="col-md-4">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(251, 191, 36, 0.15); color: #ef4444; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPendingCard">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Unpaid</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Pie Charts -->
    <div class="row g-4">
        <!-- Paid Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Paid Fees by Program & Year</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="collectedChart"></canvas>
                    <div id="collectedNoData" class="chart-no-data">
                        <i class="bi bi-inbox-fill"></i>
                        <p>No Payments Collected Yet</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Unpaid Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart me-2"></i>Unpaid Fees by Program & Year</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="pendingChart"></canvas>
                    <div id="pendingNoData" class="chart-no-data">
                        <i class="bi bi-check2-all"></i>
                        <p>No Pending Fees</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTERS SECTION -->
<div class="glass-panel p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-funnel me-2"></i> Filters
        </h5>
        <button class="btn btn-sm btn-outline-secondary" id="clearFiltersBtn">
            <i class="bi bi-x-circle me-1"></i> Clear Filters
        </button>
    </div>

    <div class="row g-3">
        <!-- Search Filter -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Search</label>
            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Ref ID, Student Name or ID...">
        </div>

        <!-- Fee Name Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Fee Name</label>
            <select id="filterFeeName" class="form-select form-select-sm">
                <option value="">All Fees</option>
                @if (ViewBag.FeeNames != null)
                {
                    foreach (var name in ViewBag.FeeNames)
                    {
                        <option value="@name">@name</option>
                    }
                }
            </select>
        </div>

        <!-- Program Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Program</label>
            <select id="filterProgram" class="form-select form-select-sm">
                <option value="">All Programs</option>
                <option value="BSIT">BSIT</option>
                <option value="DIT">DIT</option>
            </select>
        </div>

        <!-- Year Level Filter -->
        <div class="col-md-1">
            <label class="form-label small text-muted">Year</label>
            <select id="filterYear" class="form-select form-select-sm">
                <option value="">All</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
            </select>
        </div>

        <!-- Status Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Status</label>
            <select id="filterStatus" class="form-select form-select-sm">
                <option value="">All Status</option>
                <option value="paid">Paid</option>
                <option value="unpaid">Pending/Unpaid</option>
            </select>
        </div>
    </div>
</div>

<!-- INFO BANNER -->
<div class="info-banner mb-4">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Note:</strong> As Org Treasurer, you can <strong>VIEW</strong>, <strong>CREATE</strong> fees, and mark <strong>UNPAID</strong> records as paid. 
    You <strong>CANNOT</strong> edit records that are already <strong>PAID</strong> or <strong>REMITTED</strong>. 
    Class Treasurers collect payments and submit remittances for validation.
</div>

<!-- FEE RECORDS TABLE -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); margin: 0; font-weight: 700;">Fee Records</h5>
        <div>
            <button class="btn-gold-outline btn-sm me-2" data-bs-toggle="modal" data-bs-target="#exportFeesModal">
                <i class="bi bi-download me-1"></i> Export Filtered Data
            </button>
            <button class="btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#createFeeModal">
                <i class="bi bi-plus-lg me-1"></i> Create Fee
            </button>
        </div>
    </div>

    <!-- Bulk Actions Toolbar -->
    <div class="bulk-actions-toolbar" style="display: none; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 8px; padding: 12px; margin-bottom: 15px;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="text-white fw-bold"><span id="selectedCount">0</span> selected</span>
            </div>
            <div>
                <button type="button" class="btn btn-sm btn-success me-2" id="bulkMarkPaid">
                    <i class="bi bi-check-circle me-1"></i> Mark as Paid
                </button>
                <button type="button" class="btn btn-sm btn-warning me-2" id="bulkRevoke">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Revoke Selected
                </button>
                <button type="button" class="btn btn-sm btn-info" id="bulkLock">
                    <i class="bi bi-lock-fill me-1"></i> Lock Selected
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-glass" id="feesTable">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">
                        <input type="checkbox" class="form-check-input" id="selectAll" title="Select All">
                    </th>
                    <th>Ref ID</th>
                    <th>Student Name</th>
                    <th>Program</th>
                    <th>Year Level</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-center" style="width: 80px;">Action</th>
                </tr>
            </thead>
            <tbody id="feesTableBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var fee in Model)
                    {
                        var student = fee.StudentNumNavigation;
                        var dbStatus = fee.FeeStatus; // Use FeeStatus field
                        var isRemitted = fee.RemittanceStatus == FeeRemittanceStatus.Remitted;
                        var isPendingRemittance = fee.RemittanceStatus == FeeRemittanceStatus.PendingRemittance;
                        var isPaidByClassTreasurer = dbStatus?.ToUpper() == "PAID" && !isRemitted;

                        // LOGIC: It only reflects as PAID to Org Treasurer if it is Validated (Remitted)
                        var isOfficiallyPaid = dbStatus?.ToUpper() == "PAID" && isRemitted;
                        
                        // NEW: Payment Lock Status
                        var isPaymentLocked = fee.IsPaymentLocked;
                        var isPaidUnlocked = dbStatus?.ToUpper() == "PAID" && !isPaymentLocked && !isRemitted;

                        // Visual Data (What Org Treasurer Sees)
                        var displayAmountPaid = isOfficiallyPaid ? (fee.Amount ?? 0) : 0;
                        var displayBalance = isOfficiallyPaid ? 0 : (fee.Amount ?? 0);
                        
                        // SIMPLIFIED STATUS: Only Paid (when Remitted/Validated) or Unpaid
                        string displayStatus;
                        string statusBadgeClass;
                        string statusIcon;
                        
                        if (isRemitted)
                        {
                            // Only show as PAID if validated by Org Treasurer (Remitted)
                            displayStatus = "Paid";
                            statusBadgeClass = "badge-success";
                            statusIcon = "bi-check-circle-fill";
                        }
                        else
                        {
                            // Everything else is UNPAID (including pending remittance)
                            displayStatus = "Unpaid";
                            statusBadgeClass = "badge-danger";
                            statusIcon = "bi-x-circle-fill";
                        }

                        // Locking Logic:
                        var isLocked = isPaymentLocked || isPaidByClassTreasurer || isOfficiallyPaid;
                        var canEdit = !isLocked;
                        
                        // Action Permissions
                        var canRevoke = fee.CanOrgTreasurerRevoke;
                        var canLock = fee.CanOrgTreasurerLock;

                        var rowClass = isOfficiallyPaid ? "row-paid" : (isLocked ? "row-locked" : "");

                        // Extract year level and program from YearLevelSection (e.g., "BSIT 3-1" -> "3")
                        var yearLevel = "";
                        var program = student?.Course ?? "";
                        if (!string.IsNullOrEmpty(student?.YearLevelSection))
                        {
                            var match = System.Text.RegularExpressions.Regex.Match(student.YearLevelSection, @"\d+");
                            if (match.Success) yearLevel = match.Value;
                        }

                        <tr class="fee-row @rowClass"
                            data-fee-id="@fee.FeeId"
                            data-ref-id="@fee.FeeId"
                            data-student-name="@(student?.FullName?.ToLower() ?? "")"
                            data-student-id="@(fee.StudentNum?.ToLower() ?? "")"
                            data-fee-name="@(fee.FeeName?.ToLower() ?? "")"
                            data-section="@(student?.YearLevelSection ?? "")"
                            data-program="@program"
                            data-year="@yearLevel"
                            data-status="@(isRemitted ? "paid" : "unpaid")"
                            data-amount="@(fee.Amount ?? 0)"
                            data-paid="@displayAmountPaid"
                            data-balance="@displayBalance"
                            data-is-locked="@isLocked.ToString().ToLower()">

                            <!-- Checkbox Column -->
                            <td class="text-center">
                                @if (!isLocked)
                                {
                                    <input type="checkbox" class="form-check-input fee-checkbox" data-fee-id="@fee.FeeId">
                                }
                                else
                                {
                                    @if (fee.IsAwaitingValidation)
                                    {
                                        @* In Remittance Batch - Waiting for Validation *@
                                        <i class="bi bi-shield-lock-fill text-success" title="Waiting for Org Treasurer to Validate"></i>
                                    }
                                    else if (isOfficiallyPaid)
                                    {
                                        @* Validated & Remitted *@
                                        <i class="bi bi-lock-fill text-muted" title="Validated & Remitted - Cannot modify"></i>
                                    }
                                    else if (fee.RemittanceId == null && fee.RemittanceStatus != FeeRemittanceStatus.Remitted && dbStatus?.ToUpper() == "PAID")
                                    {
                                        @* Paid in Class Treasurer - no batch yet *@
                                        <i class="bi bi-cash-stack text-primary" title="Paid in Class Treasurer - Awaiting Remittance Batch"></i>
                                    }
                                    else if (isPaidByClassTreasurer)
                                    {
                                        <i class="bi bi-cash-stack text-primary" title="Paid in Class Treasurer - Awaiting Remittance Batch"></i>
                                    }
                                }
                            </td>

                            <td class="font-monospace text-muted">#@fee.FeeId</td>
                            <td>
                                @if (student != null)
                                {
                                    <div style="color: var(--text-strong); font-weight: 600;">@student.StudentFn @student.StudentLn</div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">@fee.StudentNum</div>
                                }
                                else
                                {
                                    <span class="text-danger">ID: @fee.StudentNum</span>
                                }
                            </td>
                            <td>@program</td>
                            <td class="text-center">@yearLevel</td>
                            <td>@fee.FeeName</td>
                            <td style="color: var(--gold-primary); font-weight: bold;">₱@(fee.Amount?.ToString("N2") ?? "0.00")</td>

                            <!-- Status Badge -->
                            <td>
                                @if (isRemitted)
                                {
                                    @* PAID: Only when validated by Org Treasurer (Remitted) *@
                                    <span class="status-badge status-paid">
                                        <i class="bi bi-check-circle-fill"></i> Paid
                                    </span>
                                }
                                else
                                {
                                    @* UNPAID: Everything else (including pending remittance) *@
                                    <span class="status-badge status-unpaid">
                                        <i class="bi bi-x-circle-fill"></i> Unpaid
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="text-center">
                                @if (canRevoke || canLock)
                                {
                                    <div class="btn-group btn-group-sm" role="group">
                                        @if (canLock)
                                        {
                                            <button type="button" class="btn btn-outline-info btn-sm" 
                                                    onclick="showLockModal(@fee.FeeId, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(student?.FullName ?? fee.StudentNum))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(fee.FeeName))', @(fee.Amount ?? 0))"
                                                    title="Lock Payment (Permanent)">
                                                <i class="bi bi-lock-fill"></i>
                                            </button>
                                        }
                                        @if (canRevoke)
                                        {
                                            <button type="button" class="btn btn-outline-warning btn-sm" 
                                                    onclick="showRevokeModal(@fee.FeeId, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(student?.FullName ?? fee.StudentNum))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(fee.FeeName))', @(fee.Amount ?? 0))"
                                                    title="Revoke Payment">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (canEdit)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="markOrgFeePaid(@fee.FeeId, '@student?.FullName?.Replace("'", "\\'")', '@fee.FeeName?.Replace("'", "\\'")', @(fee.Amount ?? 0))" title="Mark as Paid (Full Payment)">
                                        <i class="bi bi-check-circle"></i>
                                    </button>
                                }
                                else if (isPaymentLocked)
                                {
                                    <span class="text-success" title="Payment Locked & Verified">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                }
                                else if (fee.IsAwaitingValidation)
                                {
                                    @* In Remittance Batch - Waiting for Validation *@
                                    <span class="text-success" title="Waiting for Org Treasurer to Validate"><i class="bi bi-shield-lock-fill"></i></span>
                                }
                                else if (isOfficiallyPaid)
                                {
                                    @* Validated & Remitted *@
                                    <span class="text-success" title="Validated & Remitted"><i class="bi bi-shield-check"></i></span>
                                }
                                else if (fee.RemittanceId == null && fee.RemittanceStatus != FeeRemittanceStatus.Remitted && dbStatus?.ToUpper() == "PAID")
                                {
                                    @* Paid in Class Treasurer - no batch yet *@
                                    <span class="text-primary" title="Paid in Class Treasurer - Awaiting Remittance Batch"><i class="bi bi-cash-stack"></i></span>
                                }
                                else if (isPaidByClassTreasurer)
                                {
                                    <span class="text-primary" title="Paid in Class Treasurer - Awaiting Remittance Batch"><i class="bi bi-cash-stack"></i></span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted"><i class="bi bi-inbox fs-4 d-block mb-2"></i>No fee records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CREATE FEE MODAL -->
<div class="modal fade" id="createFeeModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title text-gold"><i class="bi bi-cash-coin me-2"></i> Create New Fee</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateOrgFee" asp-controller="Officer" method="post" id="createFeeForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <!-- Fee Details Section -->
                    <div class="fee-section">
                        <div class="fee-section-header">
                            <i class="bi bi-info-circle me-2"></i> Fee Details
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label">Fee Name / Description <span class="text-danger">*</span></label>
                                <input type="text" name="feeName" class="form-control" placeholder="e.g., Membership Fee, T-Shirt Payment" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Amount (₱) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0.01" name="amount" class="form-control" placeholder="0.00" required />
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Due Date</label>
                                <input type="date" name="feesDueDate" class="form-control" />
                                <small class="text-muted">Leave blank for default (30 days)</small>
                            </div>
                        </div>
                    </div>

                    <!-- Apply To Students Section -->
                    <div class="fee-section mt-4">
                        <div class="fee-section-header">
                            <i class="bi bi-people me-2"></i> Apply To Students
                        </div>

                        <!-- Program Filter -->
                        <div class="mb-3">
                            <label class="form-label">Program <span class="text-danger">*</span></label>
                            <div class="filter-options" id="programFilterOptions">
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programAll" value="all" checked>
                                    <label for="programAll">
                                        <i class="bi bi-grid-3x3-gap"></i>
                                        <span>All Programs</span>
                                        <small>BSIT & DIT</small>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programBSIT" value="bsit">
                                    <label for="programBSIT">
                                        <i class="bi bi-laptop"></i>
                                        <span>BSIT Only</span>
                                        <small>4-Year Program</small>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programDIT" value="dit">
                                    <label for="programDIT">
                                        <i class="bi bi-hdd-network"></i>
                                        <span>DIT Only</span>
                                        <small>3-Year Program</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Year Level Filter -->
