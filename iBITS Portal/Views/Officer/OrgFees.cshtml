@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Chart data from server
        window.feesChartsData = {
            collected: @Html.Raw(Json.Serialize(ViewBag.CollectedBreakdown ?? new Dictionary<string, decimal>())),
            pending: @Html.Raw(Json.Serialize(ViewBag.PendingBreakdown ?? new Dictionary<string, decimal>()))
        };

        // Store current balance for quick select buttons
        var currentFeeBalance = 0;

        // Open Fee Payment Modal
        function openFeePaymentModal(feeId, studentName, feeName, totalAmount, amountPaid, balance) {
            document.getElementById('paymentFeeId').value = feeId;
            document.getElementById('paymentStudentName').textContent = studentName || 'Unknown';
            document.getElementById('paymentFeeName').textContent = feeName || 'Fee';
            document.getElementById('paymentTotalAmount').textContent = totalAmount.toFixed(2);
            document.getElementById('paymentAlreadyPaid').textContent = amountPaid.toFixed(2);
            document.getElementById('paymentBalance').textContent = balance.toFixed(2);
            document.getElementById('maxPaymentAmount').textContent = balance.toFixed(2);
            document.getElementById('paymentAmount').max = balance;
            document.getElementById('paymentAmount').value = balance.toFixed(2);
            currentFeeBalance = balance;

            // Reset form
            document.getElementById('feePaymentMethod').value = '';
            document.getElementById('feeTransactionRef').value = '';
            document.getElementById('feePaymentNotes').value = '';

            new bootstrap.Modal(document.getElementById('recordFeePaymentModal')).show();
        }

        // Set payment amount based on percentage
        function setPaymentAmount(percentage) {
            var amount = currentFeeBalance * percentage;
            document.getElementById('paymentAmount').value = amount.toFixed(2);
        }

        // Form validation
        document.getElementById('recordFeePaymentForm').addEventListener('submit', function(e) {
            var amount = parseFloat(document.getElementById('paymentAmount').value);
            var method = document.getElementById('feePaymentMethod').value;
            
            if (!amount || amount <= 0) {
                e.preventDefault();
                alert('Please enter a valid payment amount.');
                return false;
            }
            
            if (amount > currentFeeBalance) {
                e.preventDefault();
                alert('Payment amount cannot exceed the remaining balance.');
                return false;
            }
            
            if (!method) {
                e.preventDefault();
                alert('Please select a payment method.');
                return false;
            }

            var submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';
        });

        // ============================================================
        // ORG TREASURER - MARK UNPAID AS PAID (Full Payment Only)
        // ============================================================
        var currentOrgFeeData = {};

        // Open confirmation modal for marking as paid
        function markOrgFeePaid(feeId, studentName, feeName, amount) {
            currentOrgFeeData = { feeId, studentName, feeName, amount };
            document.getElementById('confirmOrgFeeStudentName').textContent = studentName;
            document.getElementById('confirmOrgFeeFeeName').textContent = feeName;
            document.getElementById('confirmOrgFeeAmount').textContent = amount.toFixed(2);
            new bootstrap.Modal(document.getElementById('confirmOrgFeePaymentModal')).show();
        }

        // Execute mark as paid via AdminEditFee
        async function executeOrgFeePayment() {
            const btn = document.getElementById('confirmOrgFeePaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const formData = new FormData();
                formData.append('feeId', currentOrgFeeData.feeId);
                formData.append('newStatus', 'Paid');
                formData.append('__RequestVerificationToken', token);

                const response = await fetch('/Officer/AdminEditFee', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('confirmOrgFeePaymentModal')).hide();
                    showToast('success', result.message);
                    // Reload to reflect changes
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm Payment';
            }
        }

        function updateOrgFeeRowUI(feeId, newStatus, amountPaid, balance) {
            const row = document.querySelector(`tr[data-fee-id="${feeId}"]`);
            if (!row) return;

            const checkbox = row.querySelector('.payment-checkbox');
            const statusBadge = row.querySelector('.status-badge');
            const amountPaidCell = row.querySelector('.amount-paid');
            const balanceCell = row.querySelector('.balance');

            row.classList.remove('row-paid', 'row-partial');
            if (newStatus === 'Paid') row.classList.add('row-paid');
            else if (newStatus === 'Partial') row.classList.add('row-partial');

            checkbox.classList.remove('status-paid', 'status-partial', 'status-unpaid', 'no-revoke');
            checkbox.dataset.status = newStatus.toLowerCase();
            
            if (newStatus === 'Paid') {
                checkbox.classList.add('status-paid', 'no-revoke');
                checkbox.title = 'Payment completed';
                checkbox.onclick = null;
            } else if (newStatus === 'Partial') {
                checkbox.classList.add('status-partial');
                checkbox.title = 'Click to complete payment';
            } else {
                checkbox.classList.add('status-unpaid');
                checkbox.title = 'Click to mark as paid';
            }
            checkbox.dataset.balance = balance;

            if (newStatus === 'Paid') {
                statusBadge.className = 'status-badge status-paid';
                statusBadge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Paid';
            } else if (newStatus === 'Partial') {
                statusBadge.className = 'status-badge status-partial';
                statusBadge.innerHTML = '<i class="bi bi-pie-chart-fill"></i> Partial';
            } else {
                statusBadge.className = 'status-badge status-unpaid';
                statusBadge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Unpaid';
            }

            amountPaidCell.textContent = '₱' + amountPaid.toFixed(2);
            balanceCell.textContent = '₱' + balance.toFixed(2);
            balanceCell.style.color = balance > 0 ? '#ef4444' : '#10b981';
            row.dataset.status = newStatus.toLowerCase();
            row.dataset.paid = amountPaid;
            row.dataset.balance = balance;

            // Update action button
            const actionCell = row.querySelector('td:last-child');
            if (newStatus === 'Paid') {
                actionCell.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill"></i></span>';
            }
        }

        function showToast(type, message) {
            const bgClass = type === 'success' ? 'success' : (type === 'info' ? 'info' : 'danger');
            const icon = type === 'success' ? 'check-circle' : (type === 'info' ? 'info-circle' : 'exclamation-circle');
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${bgClass} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-${icon} me-2"></i>${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }

        // ============================================================
        // POPULATE PROGRAM-YEAR FILTER
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            const programYearFilter = document.getElementById('filterProgramYear');
            const programYears = new Set();
            
            // Extract unique program-years from table rows
            document.querySelectorAll('tbody tr').forEach(row => {
                const section = row.dataset.section || row.querySelector('td:nth-child(4)')?.textContent?.trim();
                if (section) {
                    // Extract program-year from section (e.g., "BSIT-1A" -> "BSIT-1")
                    const parts = section.split('-');
                    if (parts.length >= 2) {
                        const program = parts[0];
                        const yearWithSection = parts[1];
                        const year = yearWithSection.match(/\d+/)?.[0];
                        if (year) {
                            programYears.add(`${program}-${year}`);
                        }
                    }
                }
            });
            
            // Populate dropdown
            Array.from(programYears).sort().forEach(py => {
                const option = document.createElement('option');
                option.value = py;
                option.textContent = py;
                programYearFilter.appendChild(option);
            });
        });
    </script>
