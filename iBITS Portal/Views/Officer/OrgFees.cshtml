@* FILE PATH: Views/Officer/OrgFees.cshtml *@
@* ORG TREASURER - FEES MANAGEMENT (Edit UNPAID only, no partial payments) *@
@model IEnumerable<iBITS_Portal.Models.Fee>
@using iBITS_Portal.Models
@{
    ViewData["Title"] = "Organization Fees Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var allFees = Model?.ToList() ?? new List<iBITS_Portal.Models.Fee>();
    var totalExp = ViewBag.TotalExpected ?? 0m;
    var totalCol = ViewBag.TotalCollected ?? 0m;
    var totalPending = ViewBag.TotalPending ?? 0m;
    var collectionRate = ViewBag.CollectionRate ?? 0m;
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/officer-treasury.css" asp-append-version="true" />

@section Styles {
<style>
    /* Chart No Data State */
    .chart-no-data {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 250px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
    }
    .chart-no-data i {
        font-size: 4rem;
        margin-bottom: 1rem;
        color: rgba(212, 175, 55, 0.2);
    }
    .chart-no-data p {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
    }
    .summary-card {
        height: 100%;
        min-height: 110px;
    }
    .info-banner {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 8px;
        padding: 12px 16px;
        color: #93c5fd;
        font-size: 0.9rem;
    }
    .info-banner i {
        color: #3b82f6;
    }
</style>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;">
            <i class="bi bi-cash-stack me-2"></i> Organization Fees Management
        </h3>
        <p class="text-muted small mb-0">View and create fees for all students across the organization</p>
    </div>
    <div>
        <a asp-action="OrgTreasurerDashboard" class="btn btn-outline-light btn-sm me-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FINANCIAL OVERVIEW -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> Financial Overview
    </h5>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Expected -->
        <div class="col-md-3">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collected -->
        <div class="col-md-3">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Outstanding -->
        <div class="col-md-3">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(251, 191, 36, 0.15); color: #fbbf24; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPendingCard">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Outstanding</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collection Rate -->
        <div class="col-md-3">
            <div class="summary-card rate">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-percent fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white"><span id="collectionRateDisplay">@collectionRate</span>%</div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collection Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pie Charts -->
    <div class="row g-4">
        <!-- Collected Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Collected by Section</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="collectedChart"></canvas>
                    <div id="collectedNoData" class="chart-no-data">
                        <i class="bi bi-inbox-fill"></i>
                        <p>No Payments Collected Yet</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pending Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart me-2"></i>Pending by Section</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="pendingChart"></canvas>
                    <div id="pendingNoData" class="chart-no-data">
                        <i class="bi bi-check2-all"></i>
                        <p>No Pending Fees</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTERS SECTION -->
<div class="glass-panel p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-funnel me-2"></i> Filters
        </h5>
        <button class="btn btn-sm btn-outline-secondary" id="clearFiltersBtn">
            <i class="bi bi-x-circle me-1"></i> Clear Filters
        </button>
    </div>

    <div class="row g-3">
        <!-- Search Filter -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Search</label>
            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Ref ID, Student Name or ID...">
        </div>

        <!-- Fee Name Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Fee Name</label>
            <select id="filterFeeName" class="form-select form-select-sm">
                <option value="">All Fees</option>
                @if (ViewBag.FeeNames != null)
                {
                    foreach (var name in ViewBag.FeeNames)
                    {
                        <option value="@name">@name</option>
                    }
                }
            </select>
        </div>

        <!-- Program Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Program</label>
            <select id="filterProgram" class="form-select form-select-sm">
                <option value="">All Programs</option>
                <option value="BSIT">BSIT</option>
                <option value="DIT">DIT</option>
            </select>
        </div>

        <!-- Section Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Section</label>
            <select id="filterSection" class="form-select form-select-sm">
                <option value="">All Sections</option>
                @if (ViewBag.Sections != null)
                {
                    foreach (var sect in ViewBag.Sections)
                    {
                        <option value="@sect">@sect</option>
                    }
                }
            </select>
        </div>

        <!-- Status Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Status</label>
            <select id="filterStatus" class="form-select form-select-sm">
                <option value="">All Status</option>
                <option value="paid">Paid</option>
                <option value="unpaid">Pending/Unpaid</option>
            </select>
        </div>
    </div>
</div>

<!-- INFO BANNER -->
<div class="info-banner mb-4">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Note:</strong> As Org Treasurer, you can <strong>VIEW</strong>, <strong>CREATE</strong> fees, and mark <strong>UNPAID</strong> records as paid. 
    You <strong>CANNOT</strong> edit records that are already <strong>PAID</strong> or <strong>REMITTED</strong>. 
    Class Treasurers collect payments and submit remittances for validation.
</div>

<!-- FEE RECORDS TABLE -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); margin: 0; font-weight: 700;">Fee Records</h5>
        <div>
            <a asp-action="ExportOrgFees" class="btn-gold-outline btn-sm me-2">
                <i class="bi bi-download me-1"></i> Export Fees
            </a>
            <button class="btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#createFeeModal">
                <i class="bi bi-plus-lg me-1"></i> Create Fee
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-glass" id="feesTable">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">☐</th>
                    <th>Ref ID</th>
                    <th>Student Name</th>
                    <th>Section</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Paid</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th class="text-center" style="width: 80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var fee in Model)
                    {
                        var student = fee.StudentNumNavigation;
                        var paymentStatus = fee.PaymentStatus;
                        var isPaid = paymentStatus == "Paid";
                        var isUnpaid = paymentStatus == "Unpaid";
                        var remainingBalance = fee.RemainingBalance;
                        
                        // Check remittance status - CANNOT edit if PAID or REMITTED
                        var isRemitted = fee.RemittanceStatus == FeeRemittanceStatus.Remitted;
                        var isPendingRemit = fee.RemittanceStatus == FeeRemittanceStatus.PendingRemittance;
                        var isLocked = isPaid || isRemitted || isPendingRemit;
                        var canEdit = isUnpaid && !isLocked;
                        
                        var statusClass = isPaid ? "row-paid" : (isLocked ? "row-locked" : "");

                        <tr class="fee-row @statusClass"
                            data-fee-id="@fee.FeeId"
                            data-ref-id="@fee.FeeId"
                            data-student-name="@(student?.FullName?.ToLower() ?? "")"
                            data-student-id="@(fee.StudentNum?.ToLower() ?? "")"
                            data-fee-name="@(fee.FeeName?.ToLower() ?? "")"
                            data-section="@(student?.YearLevelSection ?? "")"
                            data-status="@paymentStatus.ToLower()"
                            data-amount="@(fee.Amount ?? 0)"
                            data-paid="@fee.AmountPaid"
                            data-balance="@remainingBalance">
                            
                            <!-- Row Number -->
                            <td class="text-center text-muted">
                                @if (isLocked)
                                {
                                    <i class="bi bi-lock-fill" style="color: #a78bfa;" title="Locked - Cannot edit"></i>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            
                            <td class="font-monospace text-muted">#@fee.FeeId</td>
                            <td>
                                @if (student != null)
                                {
                                    <div style="color: var(--text-strong); font-weight: 600;">@student.StudentFn @student.StudentLn</div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">@fee.StudentNum</div>
                                }
                                else
                                {
                                    <span class="text-danger">ID: @fee.StudentNum</span>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@(student?.YearLevelSection ?? "-")</span></td>
                            <td>@fee.FeeName</td>
                            <td style="color: var(--gold-primary); font-weight: bold;">₱@(fee.Amount?.ToString("N2") ?? "0.00")</td>
                            <td class="amount-paid" style="color: #10b981; font-weight: 600;">₱@fee.AmountPaid.ToString("N2")</td>
                            <td class="balance" style="color: @(remainingBalance > 0 ? "#ef4444" : "#10b981"); font-weight: 600;">₱@remainingBalance.ToString("N2")</td>
                            
                            <!-- Status Badge with Remittance Info -->
                            <td>
                                @if (isRemitted)
                                {
                                    <span class="status-badge" style="background: rgba(139, 92, 246, 0.2); color: #a78bfa;"><i class="bi bi-lock-fill"></i> Remitted</span>
                                }
                                else if (isPendingRemit)
                                {
                                    <span class="status-badge" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24;"><i class="bi bi-hourglass-split"></i> Pending</span>
                                }
                                else if (isPaid)
                                {
                                    <span class="status-badge status-paid"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                }
                                else
                                {
                                    <span class="status-badge status-unpaid"><i class="bi bi-x-circle-fill"></i> Unpaid</span>
                                }
                            </td>
                            
                            <!-- Actions - ONLY for UNPAID records -->
                            <td class="text-center">
                                @if (canEdit)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="markOrgFeePaid(@fee.FeeId, '@student?.FullName?.Replace("'", "\\'")', '@fee.FeeName?.Replace("'", "\\'")', @(fee.Amount ?? 0))" title="Mark as Paid (Full Payment)">
                                        <i class="bi bi-check-circle"></i>
                                    </button>
                                }
                                else if (isRemitted)
                                {
                                    <span class="text-purple" title="Remitted - Locked"><i class="bi bi-lock-fill"></i></span>
                                }
                                else if (isPendingRemit)
                                {
                                    <span class="text-warning" title="Pending Remittance"><i class="bi bi-hourglass-split"></i></span>
                                }
                                else
                                {
                                    <span class="text-success" title="Paid"><i class="bi bi-check-circle-fill"></i></span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="10" class="text-center py-4 text-muted"><i class="bi bi-inbox fs-4 d-block mb-2"></i>No fee records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CREATE FEE MODAL -->
<div class="modal fade" id="createFeeModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title text-gold"><i class="bi bi-cash-coin me-2"></i> Create New Fee</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateOrgFee" asp-controller="Officer" method="post" id="createFeeForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <!-- Fee Details Section -->
                    <div class="fee-section">
                        <div class="fee-section-header">
                            <i class="bi bi-info-circle me-2"></i> Fee Details
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label">Fee Name / Description <span class="text-danger">*</span></label>
                                <input type="text" name="feeName" class="form-control" placeholder="e.g., Membership Fee, T-Shirt Payment" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Amount (₱) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0.01" name="amount" class="form-control" placeholder="0.00" required />
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Due Date</label>
                                <input type="date" name="feesDueDate" class="form-control" />
                                <small class="text-muted">Leave blank for default (30 days)</small>
                            </div>
                        </div>
                    </div>

                    <!-- Apply To Students Section -->
                    <div class="fee-section mt-4">
                        <div class="fee-section-header">
                            <i class="bi bi-people me-2"></i> Apply To Students
                        </div>

                        <!-- Program Filter -->
                        <div class="mb-3">
                            <label class="form-label">Program <span class="text-danger">*</span></label>
                            <div class="filter-options" id="programFilterOptions">
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programAll" value="all" checked>
                                    <label for="programAll">
                                        <i class="bi bi-grid-3x3-gap"></i>
                                        <span>All Programs</span>
                                        <small>BSIT & DIT</small>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programBSIT" value="bsit">
                                    <label for="programBSIT">
                                        <i class="bi bi-laptop"></i>
                                        <span>BSIT Only</span>
                                        <small>4-Year Program</small>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programDIT" value="dit">
                                    <label for="programDIT">
                                        <i class="bi bi-hdd-network"></i>
                                        <span>DIT Only</span>
                                        <small>3-Year Program</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Year Level Filter -->
                        <div class="mb-3">
                            <label class="form-label">Year Level <span class="text-danger">*</span></label>
                            <div class="filter-options year-filter" id="yearFilterOptions">
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="yearAll" value="all" checked>
                                    <label for="yearAll"><span>All Years</span></label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year1" value="1">
                                    <label for="year1"><span>1st Year</span></label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year2" value="2">
                                    <label for="year2"><span>2nd Year</span></label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year3" value="3">
                                    <label for="year3"><span>3rd Year</span></label>
                                </div>
                                <div class="filter-option" id="year4Option">
                                    <input type="radio" name="yearFilter" id="year4" value="4">
                                    <label for="year4">
                                        <span>4th Year</span>
                                        <small class="bsit-only-badge">BSIT only</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Preview Section -->
                        <div class="fee-preview" id="feePreview">
                            <div class="preview-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="preview-content">
                                <div class="preview-title">This fee will be applied to:</div>
                                <div class="preview-count">
                                    <span id="previewTotal">0</span> students
                                </div>
                                <div class="preview-breakdown">
                                    <span class="preview-bsit"><i class="bi bi-circle-fill"></i> BSIT: <span id="previewBSIT">0</span></span>
                                    <span class="preview-dit"><i class="bi bi-circle-fill"></i> DIT: <span id="previewDIT">0</span></span>
                                </div>
                            </div>
                            <div class="preview-loading" id="previewLoading" style="display: none;">
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold" id="submitFeeBtn">
                        <i class="bi bi-check-lg me-1"></i> Create and Assign Fee
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CONFIRM PAYMENT MODAL (Org Treasurer Checkbox) -->
<div class="modal fade" id="confirmOrgFeePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="bi bi-check-circle text-success me-2"></i> Confirm Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div class="confirm-modal-icon success" style="width: 80px; height: 80px; border-radius: 50%; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                    <i class="bi bi-check-circle-fill" style="font-size: 2.5rem; color: #10b981;"></i>
                </div>
                <p class="mb-3">Mark this fee as <strong>PAID</strong>?</p>
                <div class="confirm-modal-details" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 15px; text-align: left;">
                    <div class="detail-row d-flex justify-content-between mb-2">
                        <span class="detail-label text-muted">Student</span>
                        <span class="detail-value fw-bold" id="confirmOrgFeeStudentName"></span>
                    </div>
                    <div class="detail-row d-flex justify-content-between mb-2">
                        <span class="detail-label text-muted">Fee</span>
                        <span class="detail-value fw-bold" id="confirmOrgFeeFeeName"></span>
                    </div>
                    <div class="detail-row d-flex justify-content-between">
                        <span class="detail-label text-muted">Amount</span>
                        <span class="detail-value text-gold fw-bold">₱<span id="confirmOrgFeeAmount"></span></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmOrgFeePaymentBtn" onclick="executeOrgFeePayment()">
                    <i class="bi bi-check-circle me-1"></i> Confirm Payment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- RECORD PAYMENT MODAL -->
<div class="modal fade" id="recordFeePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header" style="background: linear-gradient(135deg, #10b981, #059669);">
                <h5 class="modal-title text-white"><i class="bi bi-cash-coin me-2"></i> Record Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RecordFeePayment" asp-controller="Officer" method="post" id="recordFeePaymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="paymentFeeId" name="feeId" />
                <div class="modal-body">
                    <!-- Fee Info -->
                    <div class="fee-section p-3 mb-4">
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted">Student</small>
                                <div id="paymentStudentName" class="fw-bold text-white"></div>
                            </div>
                            <div class="col-6 text-end">
                                <small class="text-muted">Fee</small>
                                <div id="paymentFeeName" class="fw-bold text-gold"></div>
                            </div>
                        </div>
                        <hr class="my-2" style="border-color: rgba(255,255,255,0.1);" />
                        <div class="row text-center">
                            <div class="col-4">
                                <small class="text-muted d-block">Total Amount</small>
                                <div class="fw-bold text-white">₱<span id="paymentTotalAmount">0.00</span></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Already Paid</small>
                                <div class="fw-bold text-success">₱<span id="paymentAlreadyPaid">0.00</span></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Balance</small>
                                <div class="fw-bold text-danger">₱<span id="paymentBalance">0.00</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Amount -->
                    <div class="mb-3">
                        <label for="paymentAmount" class="form-label">Payment Amount (₱) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control" id="paymentAmount" name="paymentAmount" required />
                        <small class="text-muted">Enter the amount being paid (max: <span id="maxPaymentAmount">0.00</span>)</small>
                    </div>

                    <!-- Quick Amount Buttons -->
                    <div class="mb-3">
                        <small class="text-muted d-block mb-2">Quick Select:</small>
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-outline-gold btn-sm" onclick="setPaymentAmount(0.25)">25%</button>
                            <button type="button" class="btn btn-outline-gold btn-sm" onclick="setPaymentAmount(0.5)">50%</button>
                            <button type="button" class="btn btn-outline-gold btn-sm" onclick="setPaymentAmount(0.75)">75%</button>
                            <button type="button" class="btn btn-outline-gold btn-sm" onclick="setPaymentAmount(1)">Full</button>
                        </div>
                    </div>

                    <!-- Payment Method -->
                    <div class="mb-3">
                        <label for="feePaymentMethod" class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select class="form-select" id="feePaymentMethod" name="paymentMethod" required>
                            <option value="">-- Select --</option>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Online Banking">Online Banking</option>
                        </select>
                    </div>

                    <!-- Transaction Reference -->
                    <div class="mb-3">
                        <label for="feeTransactionRef" class="form-label">Transaction Reference</label>
                        <input type="text" class="form-control" id="feeTransactionRef" name="transactionRef" placeholder="e.g., GCash Ref #" />
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        <label for="feePaymentNotes" class="form-label">Notes</label>
                        <textarea class="form-control" id="feePaymentNotes" name="notes" rows="2" placeholder="Optional notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Record Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Chart data from server
        window.feesChartsData = {
            collected: @Html.Raw(Json.Serialize(ViewBag.CollectedBreakdown ?? new Dictionary<string, decimal>())),
            pending: @Html.Raw(Json.Serialize(ViewBag.PendingBreakdown ?? new Dictionary<string, decimal>()))
        };

        // Store current balance for quick select buttons
        var currentFeeBalance = 0;

        // Open Fee Payment Modal
        function openFeePaymentModal(feeId, studentName, feeName, totalAmount, amountPaid, balance) {
            document.getElementById('paymentFeeId').value = feeId;
            document.getElementById('paymentStudentName').textContent = studentName || 'Unknown';
            document.getElementById('paymentFeeName').textContent = feeName || 'Fee';
            document.getElementById('paymentTotalAmount').textContent = totalAmount.toFixed(2);
            document.getElementById('paymentAlreadyPaid').textContent = amountPaid.toFixed(2);
            document.getElementById('paymentBalance').textContent = balance.toFixed(2);
            document.getElementById('maxPaymentAmount').textContent = balance.toFixed(2);
            document.getElementById('paymentAmount').max = balance;
            document.getElementById('paymentAmount').value = balance.toFixed(2);
            currentFeeBalance = balance;

            // Reset form
            document.getElementById('feePaymentMethod').value = '';
            document.getElementById('feeTransactionRef').value = '';
            document.getElementById('feePaymentNotes').value = '';

            new bootstrap.Modal(document.getElementById('recordFeePaymentModal')).show();
        }

        // Set payment amount based on percentage
        function setPaymentAmount(percentage) {
            var amount = currentFeeBalance * percentage;
            document.getElementById('paymentAmount').value = amount.toFixed(2);
        }

        // Form validation
        document.getElementById('recordFeePaymentForm').addEventListener('submit', function(e) {
            var amount = parseFloat(document.getElementById('paymentAmount').value);
            var method = document.getElementById('feePaymentMethod').value;
            
            if (!amount || amount <= 0) {
                e.preventDefault();
                alert('Please enter a valid payment amount.');
                return false;
            }
            
            if (amount > currentFeeBalance) {
                e.preventDefault();
                alert('Payment amount cannot exceed the remaining balance.');
                return false;
            }
            
            if (!method) {
                e.preventDefault();
                alert('Please select a payment method.');
                return false;
            }

            var submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';
        });

        // ============================================================
        // ORG TREASURER - MARK UNPAID AS PAID (Full Payment Only)
        // ============================================================
        var currentOrgFeeData = {};

        // Open confirmation modal for marking as paid
        function markOrgFeePaid(feeId, studentName, feeName, amount) {
            currentOrgFeeData = { feeId, studentName, feeName, amount };
            document.getElementById('confirmOrgFeeStudentName').textContent = studentName;
            document.getElementById('confirmOrgFeeFeeName').textContent = feeName;
            document.getElementById('confirmOrgFeeAmount').textContent = amount.toFixed(2);
            new bootstrap.Modal(document.getElementById('confirmOrgFeePaymentModal')).show();
        }

        // Execute mark as paid via AdminEditFee
        async function executeOrgFeePayment() {
            const btn = document.getElementById('confirmOrgFeePaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const formData = new FormData();
                formData.append('feeId', currentOrgFeeData.feeId);
                formData.append('newStatus', 'Paid');
                formData.append('__RequestVerificationToken', token);

                const response = await fetch('/Officer/AdminEditFee', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('confirmOrgFeePaymentModal')).hide();
                    showToast('success', result.message);
                    // Reload to reflect changes
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm Payment';
            }
        }

        function updateOrgFeeRowUI(feeId, newStatus, amountPaid, balance) {
            const row = document.querySelector(`tr[data-fee-id="${feeId}"]`);
            if (!row) return;

            const checkbox = row.querySelector('.payment-checkbox');
            const statusBadge = row.querySelector('.status-badge');
            const amountPaidCell = row.querySelector('.amount-paid');
            const balanceCell = row.querySelector('.balance');

            row.classList.remove('row-paid', 'row-partial');
            if (newStatus === 'Paid') row.classList.add('row-paid');
            else if (newStatus === 'Partial') row.classList.add('row-partial');

            checkbox.classList.remove('status-paid', 'status-partial', 'status-unpaid', 'no-revoke');
            checkbox.dataset.status = newStatus.toLowerCase();
            
            if (newStatus === 'Paid') {
                checkbox.classList.add('status-paid', 'no-revoke');
                checkbox.title = 'Payment completed';
                checkbox.onclick = null;
            } else if (newStatus === 'Partial') {
                checkbox.classList.add('status-partial');
                checkbox.title = 'Click to complete payment';
            } else {
                checkbox.classList.add('status-unpaid');
                checkbox.title = 'Click to mark as paid';
            }
            checkbox.dataset.balance = balance;

            if (newStatus === 'Paid') {
                statusBadge.className = 'status-badge status-paid';
                statusBadge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Paid';
            } else if (newStatus === 'Partial') {
                statusBadge.className = 'status-badge status-partial';
                statusBadge.innerHTML = '<i class="bi bi-pie-chart-fill"></i> Partial';
            } else {
                statusBadge.className = 'status-badge status-unpaid';
                statusBadge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Unpaid';
            }

            amountPaidCell.textContent = '₱' + amountPaid.toFixed(2);
            balanceCell.textContent = '₱' + balance.toFixed(2);
            balanceCell.style.color = balance > 0 ? '#ef4444' : '#10b981';
            row.dataset.status = newStatus.toLowerCase();
            row.dataset.paid = amountPaid;
            row.dataset.balance = balance;

            // Update action button
            const actionCell = row.querySelector('td:last-child');
            if (newStatus === 'Paid') {
                actionCell.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill"></i></span>';
            }
        }

        function showToast(type, message) {
            const bgClass = type === 'success' ? 'success' : (type === 'info' ? 'info' : 'danger');
            const icon = type === 'success' ? 'check-circle' : (type === 'info' ? 'info-circle' : 'exclamation-circle');
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${bgClass} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-${icon} me-2"></i>${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }
    </script>
    <script src="~/js/officer-fees.js" asp-append-version="true"></script>
}
