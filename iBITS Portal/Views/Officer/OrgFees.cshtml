    <script>
        // ============================================================
        // EXPORT PROGRAM-YEAR DATA
        // ============================================================
        function exportProgramYearData() {
            const programYearStats = @Html.Raw(Json.Serialize(ViewBag.ProgramYearStats ?? new List<object>()));
            
            if (!programYearStats || programYearStats.length === 0) {
                alert('No data available to export.');
                return;
            }

            // Show export options modal
            const modal = document.createElement('div');
            modal.innerHTML = `
                <div class="modal fade" id="exportModal" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content glass-modal" style="background: rgba(30, 30, 30, 0.95); border: 1px solid rgba(212, 175, 55, 0.3);">
                            <div class="modal-header border-0">
                                <h5 class="modal-title text-white"><i class="bi bi-download me-2"></i> Export Data</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted">Choose export format:</p>
                                <div class="d-grid gap-2">
                                    <button class="btn btn-success" onclick="exportToExcel()">
                                        <i class="bi bi-file-earmark-excel me-2"></i> Export to Excel
                                    </button>
                                    <button class="btn btn-danger" onclick="exportToPDF()">
                                        <i class="bi bi-file-earmark-pdf me-2"></i> Export to PDF
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>`;
            document.body.appendChild(modal);
            const exportModal = new bootstrap.Modal(document.getElementById('exportModal'));
            exportModal.show();
            document.getElementById('exportModal').addEventListener('hidden.bs.modal', () => modal.remove());
        }

        function exportToExcel() {
            // WYSIWYG: Export only VISIBLE/FILTERED rows
            const visibleRows = document.querySelectorAll('#feesTableBody tr:not([style*="display: none"])');
            
            if (visibleRows.length === 0) {
                alert('No visible data to export. Please adjust your filters.');
                bootstrap.Modal.getInstance(document.getElementById('exportModal')).hide();
                return;
            }
            
            const data = [
                ['Fee ID', 'Student Name', 'Student ID', 'Program', 'Year', 'Fee Name', 'Amount', 'Status']
            ];
            
            visibleRows.forEach(row => {
                const cells = row.querySelectorAll('td');
                if (cells.length > 1) {
                    const feeId = cells[1]?.textContent?.trim() || '';
                    const studentInfo = cells[2];
                    const studentName = studentInfo?.querySelector('div:first-child')?.textContent?.trim() || '';
                    const studentId = studentInfo?.querySelector('.small')?.textContent?.trim() || '';
                    const program = cells[3]?.textContent?.trim() || '';
                    const year = cells[4]?.textContent?.trim() || '';
                    const feeName = cells[5]?.textContent?.trim() || '';
                    const amount = cells[6]?.textContent?.trim() || '';
                    const status = cells[7]?.textContent?.trim() || '';
                    
                    data.push([feeId, studentName, studentId, program, year, feeName, amount, status]);
                }
            });
            
            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.aoa_to_sheet(data);
            
            // Set column widths
            ws['!cols'] = [
                { wch: 10 }, // Fee ID
                { wch: 25 }, // Student Name
                { wch: 20 }, // Student ID
                { wch: 10 }, // Program
                { wch: 8 },  // Year
                { wch: 20 }, // Fee Name
                { wch: 12 }, // Amount
                { wch: 10 }  // Status
            ];
            
            XLSX.utils.book_append_sheet(wb, ws, 'Org Fees');
            XLSX.writeFile(wb, `OrgFees-Filtered-${new Date().toISOString().slice(0,10)}.xlsx`);
            
            bootstrap.Modal.getInstance(document.getElementById('exportModal')).hide();
            showToast('success', `Exported ${visibleRows.length} fee record(s)`);
        }

        function exportToPDF() {
            // WYSIWYG: Export only VISIBLE/FILTERED rows
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('l', 'mm', 'a4'); // Landscape orientation
            const visibleRows = document.querySelectorAll('#feesTableBody tr:not([style*="display: none"])');
            
            if (visibleRows.length === 0) {
                alert('No visible data to export. Please adjust your filters.');
                bootstrap.Modal.getInstance(document.getElementById('exportModal')).hide();
                return;
            }
            
            doc.setFontSize(18);
            doc.text('Organization Fees Report (Filtered)', 14, 15);
            
            doc.setFontSize(10);
            doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 22);
            doc.text(`Records: ${visibleRows.length}`, 14, 28);
            
            const tableData = [];
            visibleRows.forEach(row => {
                const cells = row.querySelectorAll('td');
                if (cells.length > 1) {
                    const feeId = cells[1]?.textContent?.trim() || '';
                    const studentInfo = cells[2];
                    const studentName = studentInfo?.querySelector('div:first-child')?.textContent?.trim() || '';
                    const studentId = studentInfo?.querySelector('.small')?.textContent?.trim() || '';
                    const program = cells[3]?.textContent?.trim() || '';
                    const year = cells[4]?.textContent?.trim() || '';
                    const feeName = cells[5]?.textContent?.trim() || '';
                    // Extract amount and format with proper Peso sign (use PHP instead of Unicode for PDF compatibility)
                    const amountText = cells[6]?.textContent?.trim() || '';
                    const amount = 'PHP ' + amountText.replace(/[^\d.,]/g, ''); // Use PHP instead of ₱ symbol
                    const status = cells[7]?.textContent?.trim() || '';
                    
                    tableData.push([feeId, studentName, studentId, program, year, feeName, amount, status]);
                }
            });
            
            doc.autoTable({
                head: [['Fee ID', 'Student Name', 'Student ID', 'Program', 'Year', 'Fee Name', 'Amount', 'Status']],
                body: tableData,
                startY: 35,
                theme: 'grid',
                headStyles: { fillColor: [212, 175, 55], textColor: [0, 0, 0] },
                styles: { fontSize: 8, cellPadding: 2 },
                columnStyles: {
                    0: { cellWidth: 15 },
                    1: { cellWidth: 45 },
                    2: { cellWidth: 35 },
                    3: { cellWidth: 20 },
                    4: { cellWidth: 15 },
                    5: { cellWidth: 40 },
                    6: { cellWidth: 25 },
                    7: { cellWidth: 20 }
                }
            });
            
            doc.save(`OrgFees-Filtered-${new Date().toISOString().slice(0,10)}.pdf`);
            
            bootstrap.Modal.getInstance(document.getElementById('exportModal')).hide();
            showToast('success', `Exported ${visibleRows.length} fee record(s) to PDF`);
        }

        // ============================================================
        // BULK SELECTION FUNCTIONALITY
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            const selectAll = document.getElementById('selectAll');
            const bulkToolbar = document.querySelector('.bulk-actions-toolbar');
            const selectedCountSpan = document.getElementById('selectedCount');
            const bulkMarkPaidBtn = document.getElementById('bulkMarkPaid');
            const bulkRevokeBtn = document.getElementById('bulkRevoke');

            // Select All functionality
            if (selectAll) {
                selectAll.addEventListener('change', function() {
                    const checkboxes = document.querySelectorAll('.fee-checkbox:not(:disabled)');
                    checkboxes.forEach(cb => cb.checked = this.checked);
                    updateBulkToolbar();
                });
            }

            // Individual checkbox change
            document.querySelectorAll('.fee-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    updateBulkToolbar();
                    updateSelectAllState();
                });
            });

            // Bulk Mark as Paid
            if (bulkMarkPaidBtn) {
                bulkMarkPaidBtn.addEventListener('click', async function() {
                    const selectedIds = getSelectedFeeIds();
                    
                    if (selectedIds.length === 0) {
                        showToast('warning', 'Please select fees to mark as paid');
                        return;
                    }

                    if (!confirm(`Mark ${selectedIds.length} fee(s) as paid?`)) return;

                    await bulkAction('BulkMarkOrgFeesAsPaid', selectedIds);
                });
            }

            // Bulk Revoke
            if (bulkRevokeBtn) {
                bulkRevokeBtn.addEventListener('click', async function() {
                    const selectedIds = getSelectedFeeIds();
                    
                    if (selectedIds.length === 0) {
                        showToast('warning', 'Please select fees to revoke');
                        return;
                    }

                    if (!confirm(`Revoke payment for ${selectedIds.length} fee(s)?`)) return;

                    await bulkAction('BulkRevokeOrgFees', selectedIds);
                });
            }

            function getSelectedFeeIds() {
                const selected = [];
                document.querySelectorAll('.fee-checkbox:checked').forEach(cb => {
                    selected.push(parseInt(cb.dataset.feeId));
                });
                return selected;
            }

            function updateBulkToolbar() {
                const selectedIds = getSelectedFeeIds();
                
                if (selectedCountSpan) {
                    selectedCountSpan.textContent = selectedIds.length;
                }

                if (bulkToolbar) {
                    bulkToolbar.style.display = selectedIds.length > 0 ? 'block' : 'none';
                }
            }

            function updateSelectAllState() {
                const checkboxes = document.querySelectorAll('.fee-checkbox');
                const checkedBoxes = document.querySelectorAll('.fee-checkbox:checked');
                
                if (!selectAll) return;

                if (checkboxes.length === 0) {
                    selectAll.checked = false;
                    selectAll.indeterminate = false;
                } else if (checkedBoxes.length === checkboxes.length) {
                    selectAll.checked = true;
                    selectAll.indeterminate = false;
                } else if (checkedBoxes.length > 0) {
                    selectAll.checked = false;
                    selectAll.indeterminate = true;
                } else {
                    selectAll.checked = false;
                    selectAll.indeterminate = false;
                }
            }

            async function bulkAction(action, feeIds) {
                try {
                    const response = await fetch(`/Officer/${action}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ feeIds })
                    });

                    const result = await response.json();

                    if (result.success) {
                        showToast('success', result.message);
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showToast('error', result.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showToast('error', 'An error occurred. Please try again.');
                }
            }

            function showToast(type, message) {
                const bgClass = type === 'success' ? 'success' : (type === 'warning' ? 'warning' : 'danger');
                const icon = type === 'success' ? 'check-circle' : (type === 'warning' ? 'exclamation-triangle' : 'exclamation-circle');
                const toastHtml = `
                    <div class="toast align-items-center text-white bg-${bgClass} border-0" role="alert">
                        <div class="d-flex">
                            <div class="toast-body"><i class="bi bi-${icon} me-2"></i>${message}</div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>`;
                let container = document.querySelector('.toast-container');
                if (!container) {
                    container = document.createElement('div');
                    container.className = 'toast-container position-fixed top-0 end-0 p-3';
                    container.style.zIndex = '9999';
                    document.body.appendChild(container);
                }
                container.insertAdjacentHTML('beforeend', toastHtml);
                const toast = container.lastElementChild;
                const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
                bsToast.show();
                toast.addEventListener('hidden.bs.toast', () => toast.remove());
            }
        });

        // ============================================================
        // REVOKE & LOCK PAYMENT FUNCTIONS
        // ============================================================
        
        function showRevokeModal(feeId, studentName, feeName, amount) {
            document.getElementById('revokeFeeId').value = feeId;
            document.getElementById('revokeStudentName').textContent = studentName;
            document.getElementById('revokeFeeName').textContent = feeName;
            document.getElementById('revokeFeeAmount').textContent = amount.toFixed(2);
            document.getElementById('revokeReason').value = '';
            
            new bootstrap.Modal(document.getElementById('revokePaymentModal')).show();
        }
        
        function showLockModal(feeId, studentName, feeName, amount) {
            document.getElementById('lockFeeId').value = feeId;
            document.getElementById('lockStudentName').textContent = studentName;
            document.getElementById('lockFeeName').textContent = feeName;
            document.getElementById('lockFeeAmount').textContent = amount.toFixed(2);
            document.getElementById('lockConfirmation').value = '';
            document.getElementById('lockPaymentBtn').disabled = true;
            
            new bootstrap.Modal(document.getElementById('lockPaymentModal')).show();
        }
        
        function toggleLockButton() {
            const confirmation = document.getElementById('lockConfirmation').value;
            const lockBtn = document.getElementById('lockPaymentBtn');
            lockBtn.disabled = confirmation.toUpperCase() !== 'LOCK';
        }
        
        function toggleBulkLockButton() {
            const confirmation = document.getElementById('bulkLockConfirmation').value;
            const bulkLockBtn = document.getElementById('bulkLockBtn');
            bulkLockBtn.disabled = confirmation.toUpperCase() !== 'LOCK ALL';
        }
        
        // Bulk revoke handler
        document.getElementById('bulkRevoke').addEventListener('click', function() {
            const selectedCheckboxes = document.querySelectorAll('.fee-checkbox:checked');
            if (selectedCheckboxes.length === 0) {
                alert('Please select at least one fee to revoke.');
                return;
            }
            
            // Show bulk revoke modal (simplified - just submit directly with confirmation)
            if (confirm(`Are you sure you want to revoke ${selectedCheckboxes.length} payment(s)? Locked payments will be skipped.`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("BulkRevokePayments", "Officer")';
                
                const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = antiforgeryToken;
                form.appendChild(tokenInput);
                
                selectedCheckboxes.forEach(cb => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'feeIds';
                    input.value = cb.getAttribute('data-fee-id');
                    form.appendChild(input);
                });
                
                document.body.appendChild(form);
                form.submit();
            }
        });
        
        // Bulk lock handler
        document.getElementById('bulkLock').addEventListener('click', function() {
            const selectedCheckboxes = document.querySelectorAll('.fee-checkbox:checked');
            if (selectedCheckboxes.length === 0) {
                alert('Please select at least one fee to lock.');
                return;
            }
            
            // Show confirmation prompt
            const confirmation = prompt(`⚠️ WARNING: You are about to PERMANENTLY lock ${selectedCheckboxes.length} payment(s).\n\nThis action CANNOT be undone!\n\nType "LOCK ALL" to confirm:`);
            
            if (confirmation && confirmation.toUpperCase() === 'LOCK ALL') {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("BulkLockPayments", "Officer")';
                
                const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = antiforgeryToken;
                form.appendChild(tokenInput);
                
                const confirmationInput = document.createElement('input');
                confirmationInput.type = 'hidden';
                confirmationInput.name = 'confirmation';
                confirmationInput.value = 'LOCK ALL';
                form.appendChild(confirmationInput);
                
                selectedCheckboxes.forEach(cb => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'feeIds';
                    input.value = cb.getAttribute('data-fee-id');
                    form.appendChild(input);
                });
                
                document.body.appendChild(form);
                form.submit();
            } else if (confirmation) {
                alert('You must type "LOCK ALL" exactly to confirm this action.');
            }
        });
    </script>
