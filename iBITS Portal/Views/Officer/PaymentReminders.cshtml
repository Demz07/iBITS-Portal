@{
    ViewData["Title"] = "Payment Reminders";
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";
    var yearSections = ViewBag.YearSections as List<string> ?? new List<string>();
    var existingReminders = ViewBag.ExistingReminders as List<iBITS_Portal.Models.Announcement> ?? new List<iBITS_Portal.Models.Announcement>();
}

<style>
    :root {
        --gold-primary: #D4AF37;
        --navy-bg: #0B1A33;
        --card-bg: rgba(255, 255, 255, 0.03);
    }

    .payment-reminders-container {
        padding: 20px;
    }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(212, 175, 55, 0.2);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 20px;
    }

    .section-header {
        color: var(--gold-primary);
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 20px;
        border-bottom: 2px solid var(--gold-primary);
        padding-bottom: 10px;
    }

    .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 15px;
    }

    .checkbox-item {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 8px;
        padding: 8px 15px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .checkbox-item:hover {
        background: rgba(212, 175, 55, 0.1);
        border-color: var(--gold-primary);
        transform: translateY(-2px);
    }

    .checkbox-item input[type="checkbox"] {
        cursor: pointer;
        width: 18px;
        height: 18px;
        accent-color: var(--gold-primary);
    }

    .checkbox-item label {
        cursor: pointer;
        margin: 0;
        color: #fff;
        font-size: 0.9rem;
    }

    .quick-select-btn {
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.2), rgba(212, 175, 55, 0.1));
        border: 1px solid var(--gold-primary);
        color: var(--gold-primary);
        padding: 10px 20px;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
    }

    .quick-select-btn:hover {
        background: var(--gold-primary);
        color: #000;
        transform: scale(1.05);
    }

    .recipient-count-badge {
        background: linear-gradient(135deg, var(--gold-primary), #c9a347);
        color: #000;
        padding: 12px 25px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1.1rem;
        display: inline-block;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    .reminder-card {
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.05), rgba(212, 175, 55, 0.02));
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 15px;
        transition: all 0.3s ease;
    }

    .reminder-card:hover {
        border-color: var(--gold-primary);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.2);
    }

    .reminder-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 10px;
    }

    .reminder-title {
        color: var(--gold-primary);
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
    }

    .reminder-meta {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.85rem;
        margin-bottom: 10px;
    }

    .reminder-content {
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 15px;
        line-height: 1.6;
    }

    .reminder-stats {
        display: flex;
        gap: 20px;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid rgba(212, 175, 55, 0.2);
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 5px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.85rem;
    }

    .reminder-actions {
        display: flex;
        gap: 10px;
    }

    .btn-action {
        padding: 6px 15px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-edit {
        background: rgba(59, 130, 246, 0.2);
        color: #3B82F6;
        border: 1px solid #3B82F6;
    }

    .btn-edit:hover {
        background: #3B82F6;
        color: #fff;
    }

    .btn-delete {
        background: rgba(239, 68, 68, 0.2);
        color: #EF4444;
        border: 1px solid #EF4444;
    }

    .btn-delete:hover {
        background: #EF4444;
        color: #fff;
    }

    .btn-gold {
        background: linear-gradient(135deg, var(--gold-primary), #c9a347);
        color: #000;
        font-weight: 700;
        padding: 12px 30px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(212, 175, 55, 0.4);
    }

    .form-control, .form-select {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: #fff;
        border-radius: 8px;
    }

    .form-control:focus, .form-select:focus {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--gold-primary);
        color: #fff;
        box-shadow: 0 0 0 0.2rem rgba(212, 175, 55, 0.25);
    }

    .form-label {
        color: var(--gold-primary);
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .year-section-group {
        margin-bottom: 15px;
    }

    .year-section-header {
        color: var(--gold-primary);
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 10px;
        padding-left: 5px;
        border-left: 3px solid var(--gold-primary);
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: rgba(255, 255, 255, 0.5);
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 15px;
        opacity: 0.6;
    }

    .badge-type {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-payment {
        background: rgba(234, 179, 8, 0.2);
        color: #EAB308;
        border: 1px solid #EAB308;
    }

    .badge-urgent {
        background: rgba(239, 68, 68, 0.2);
        color: #EF4444;
        border: 1px solid #EF4444;
    }

    .badge-general {
        background: rgba(59, 130, 246, 0.2);
        color: #3B82F6;
        border: 1px solid #3B82F6;
    }
</style>

<div class="payment-reminders-container">
    <div class="page-header mb-4">
        <h2 class="fw-bold text-white mb-2">
            <i class="bi bi-megaphone-fill me-2" style="color: var(--gold-primary);"></i>
            Payment Reminders
        </h2>
        <p class="text-muted mb-0">Send targeted payment reminders to specific groups of students</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- LEFT: Create Reminder -->
        <div class="col-lg-5 mb-4">
            <div class="glass-card">
                <h4 class="section-header">
                    <i class="bi bi-plus-circle-fill me-2"></i>Create New Reminder
                </h4>

                <form id="reminderForm" method="post" asp-action="PostPaymentReminder">
                    @Html.AntiForgeryToken()

                    <!-- Quick Selections -->
                    <div class="mb-4">
                        <label class="form-label">Quick Selections</label>
                        <div class="checkbox-group">
                            <div class="checkbox-item">
                                <input type="checkbox" id="allStudents" name="allStudents" value="true">
                                <label for="allStudents">All Students</label>
                            </div>
                            <div class="checkbox-item">
                                <input type="checkbox" id="outstandingBalance" name="outstandingBalance" value="true">
                                <label for="outstandingBalance">Outstanding Balance Only</label>
                            </div>
                        </div>
                    </div>

                    <!-- Programs -->
                    <div class="mb-4">
                        <label class="form-label">Programs</label>
                        <div class="checkbox-group">
                            <div class="checkbox-item">
                                <input type="checkbox" class="program-check" name="selectedPrograms" value="BSIT" id="prog-bsit">
                                <label for="prog-bsit">BSIT (4-Year)</label>
                            </div>
                            <div class="checkbox-item">
                                <input type="checkbox" class="program-check" name="selectedPrograms" value="DIT" id="prog-dit">
                                <label for="prog-dit">DIT (3-Year)</label>
                            </div>
                        </div>
                    </div>

                    <!-- Year & Sections (Dynamic from DB) -->
                    <div class="mb-4">
                        <label class="form-label">Year & Sections</label>
                        @{
                            var groupedSections = yearSections
                                .GroupBy(s => s.Split(new[] { " - " }, StringSplitOptions.None)[0])
                                .OrderBy(g => g.Key);
                        }

                        @foreach (var group in groupedSections)
                        {
                            <div class="year-section-group">
                                <div class="year-section-header">@group.Key</div>
                                <div class="checkbox-group">
                                    @foreach (var yearSection in group)
                                    {
                                        var sectionId = "section-" + yearSection.Replace(" ", "-").Replace(".", "");
                                        <div class="checkbox-item">
                                            <input type="checkbox" class="section-check" name="selectedYearSections" value="@yearSection" id="@sectionId">
                                            <label for="@sectionId">@yearSection</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Recipient Count Preview -->
                    <div class="mb-4 text-center">
                        <div class="recipient-count-badge" id="recipientCount">
                            <i class="bi bi-people-fill me-2"></i>
                            <span id="recipientNumber">0</span> Students
                        </div>
                    </div>

                    <!-- Reminder Type -->
                    <div class="mb-3">
                        <label class="form-label">Reminder Type</label>
                        <select class="form-select" name="reminderType" required>
                            <option value="Payment Reminder">💰 Payment Reminder</option>
                            <option value="Urgent Payment Notice">🔴 Urgent Payment Notice</option>
                            <option value="Final Notice">⚠️ Final Notice</option>
                            <option value="General Reminder">📝 General Reminder</option>
                        </select>
                    </div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label class="form-label">Reminder Title</label>
                        <input type="text" class="form-control" name="reminderTitle" placeholder="e.g., Monthly Dues Payment Deadline" required maxlength="200">
                    </div>

                    <!-- Message -->
                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea class="form-control" name="reminderContent" rows="5" placeholder="Enter your reminder message here..." required maxlength="1000"></textarea>
                    </div>

                    <!-- Expiry -->
                    <div class="mb-4">
                        <label class="form-label">Expires In (Optional)</label>
                        <select class="form-select" name="expiryDays">
                            <option value="">Never</option>
                            <option value="7">7 Days</option>
                            <option value="14">14 Days</option>
                            <option value="30">30 Days</option>
                            <option value="60">60 Days</option>
                        </select>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary flex-grow-1" onclick="clearForm()">
                            <i class="bi bi-x-circle me-2"></i>Clear
                        </button>
                        <button type="submit" class="btn btn-gold flex-grow-1">
                            <i class="bi bi-send-fill me-2"></i>Post Reminder
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT: Active Reminders -->
        <div class="col-lg-7">
            <div class="glass-card">
                <h4 class="section-header">
                    <i class="bi bi-list-check me-2"></i>Your Active Reminders (@existingReminders.Count)
                </h4>

                <div id="remindersContainer">
                    @if (existingReminders.Any())
                    {
                        foreach (var reminder in existingReminders)
                        {
                            var typeClass = reminder.AnnouncementType?.Contains("Urgent") == true ? "badge-urgent" 
                                : reminder.AnnouncementType?.Contains("Final") == true ? "badge-urgent"
                                : reminder.AnnouncementType == "Payment Reminder" ? "badge-payment" 
                                : "badge-general";

                            var icon = reminder.AnnouncementType?.Contains("Urgent") == true ? "🔴" 
                                : reminder.AnnouncementType?.Contains("Final") == true ? "⚠️"
                                : reminder.AnnouncementType == "Payment Reminder" ? "💰" 
                                : "📝";

                            var isExpired = reminder.ExpiryDate.HasValue && reminder.ExpiryDate.Value < DateTime.Now;

                            <div class="reminder-card" data-reminder-id="@reminder.Id">
                                <div class="reminder-header">
                                    <div>
                                        <h5 class="reminder-title">
                                            @icon @reminder.Title
                                            <span class="badge @typeClass ms-2">@reminder.AnnouncementType</span>
                                            @if (isExpired)
                                            {
                                                <span class="badge bg-secondary ms-1">Expired</span>
                                            }
                                        </h5>
                                        <div class="reminder-meta">
                                            <i class="bi bi-calendar3 me-1"></i>Posted: @reminder.Timestamp.ToString("MMM dd, yyyy hh:mm tt")
                                            @if (reminder.ExpiryDate.HasValue)
                                            {
                                                <span class="ms-3">
                                                    <i class="bi bi-hourglass-split me-1"></i>Expires: @reminder.ExpiryDate.Value.ToString("MMM dd, yyyy")
                                                </span>
                                            }
                                        </div>
                                        <div class="reminder-meta">
                                            <i class="bi bi-bullseye me-1"></i>Target: <strong>@reminder.TargetAudience</strong>
                                        </div>
                                    </div>
                                    <div class="reminder-actions">
                                        <button class="btn-action btn-edit" onclick="editReminder(@reminder.Id)" title="Edit">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="btn-action btn-delete" onclick="deleteReminder(@reminder.Id)" title="Delete">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="reminder-content">
                                    @reminder.Content
                                </div>

                                <div class="reminder-stats">
                                    <div class="stat-item">
                                        <i class="bi bi-eye-fill text-info"></i>
                                        <span>@reminder.ViewCount views</span>
                                    </div>
                                    <div class="stat-item">
                                        <i class="bi bi-people-fill" style="color: var(--gold-primary);"></i>
                                        <span>@reminder.RecipientCount recipients</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <h5>No Active Reminders</h5>
                            <p>Create your first payment reminder to get started!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Reminder Modal -->
<div class="modal fade" id="editReminderModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: var(--navy-bg); border: 1px solid var(--gold-primary);">
            <div class="modal-header" style="border-bottom: 1px solid rgba(212, 175, 55, 0.3);">
                <h5 class="modal-title text-gold">
                    <i class="bi bi-pencil-square me-2"></i>Edit Payment Reminder
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="editReminderForm" method="post" asp-action="EditPaymentReminder">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reminderId" id="edit_reminderId">
                
                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    <!-- Same fields as create form -->
                    <div class="mb-3">
                        <label class="form-label">Reminder Type</label>
                        <select class="form-select" name="reminderType" id="edit_reminderType" required>
                            <option value="Payment Reminder">💰 Payment Reminder</option>
                            <option value="Urgent Payment Notice">🔴 Urgent Payment Notice</option>
                            <option value="Final Notice">⚠️ Final Notice</option>
                            <option value="General Reminder">📝 General Reminder</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reminder Title</label>
                        <input type="text" class="form-control" name="reminderTitle" id="edit_reminderTitle" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea class="form-control" name="reminderContent" id="edit_reminderContent" rows="5" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Expires In (Optional)</label>
                        <select class="form-select" name="expiryDays" id="edit_expiryDays">
                            <option value="">Never</option>
                            <option value="7">7 Days</option>
                            <option value="14">14 Days</option>
                            <option value="30">30 Days</option>
                            <option value="60">60 Days</option>
                        </select>
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        Note: Target audience cannot be changed after creation. Create a new reminder if needed.
                    </div>
                </div>

                <div class="modal-footer" style="border-top: 1px solid rgba(212, 175, 55, 0.3);">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold">
                        <i class="bi bi-check-circle-fill me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
<script>
        // Live recipient count update
        function updateRecipientCount() {
            const programs = Array.from(document.querySelectorAll('.program-check:checked')).map(cb => cb.value);
            const yearSections = Array.from(document.querySelectorAll('.section-check:checked')).map(cb => cb.value);
            const allStudents = document.getElementById('allStudents').checked;
            const outstandingBalance = document.getElementById('outstandingBalance').checked;

            fetch('@Url.Action("GetRecipientCount", "Officer")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ programs, yearSections, allStudents, outstandingBalance })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('recipientNumber').textContent = data.count;
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Attach event listeners
        document.querySelectorAll('.program-check, .section-check, #allStudents, #outstandingBalance').forEach(checkbox => {
            checkbox.addEventListener('change', updateRecipientCount);
        });

        // All Students checkbox handler
        document.getElementById('allStudents').addEventListener('change', function() {
            const disabled = this.checked;
            document.querySelectorAll('.program-check, .section-check').forEach(cb => {
                cb.disabled = disabled;
                if (disabled) cb.checked = false;
            });
            updateRecipientCount();
        });

        // Clear form
        function clearForm() {
            document.getElementById('reminderForm').reset();
            document.querySelectorAll('.program-check, .section-check').forEach(cb => cb.disabled = false);
            updateRecipientCount();
        }

        // Edit reminder
        function editReminder(id) {
            fetch(`@Url.Action("GetReminderForEdit", "Officer")?id=${id}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('edit_reminderId').value = data.id;
                        document.getElementById('edit_reminderTitle').value = data.title;
                        document.getElementById('edit_reminderContent').value = data.content;
                        document.getElementById('edit_reminderType').value = data.reminderType;
                        
                        new bootstrap.Modal(document.getElementById('editReminderModal')).show();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => console.error('Error:', error));
        }

        // Delete reminder
        function deleteReminder(id) {
            if (!confirm('Are you sure you want to delete this reminder? It will be moved to trash.')) return;

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("DeletePaymentReminder", "Officer")';
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]').cloneNode();
            const idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'id';
            idInput.value = id;
            
            form.appendChild(token);
            form.appendChild(idInput);
            document.body.appendChild(form);
            
            fetch(form.action, {
                method: 'POST',
                body: new FormData(form)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.querySelector(`[data-reminder-id="${id}"]`).remove();
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Initial count
        updateRecipientCount();
    </script>
}
