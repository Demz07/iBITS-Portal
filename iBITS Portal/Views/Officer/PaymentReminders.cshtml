@* FILE PATH: Views/Officer/PaymentReminders.cshtml *@
@* OPTIMIZED VERSION with Expiry Date, Dynamic Targeting, Delete Functionality *@
@{
    ViewData["Title"] = "Payment Reminders";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

@section Styles {
    <style>
        .reminder-template {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .reminder-template:hover {
                background: rgba(255,255,255,0.1);
                border-color: rgba(255,255,255,0.3);
                transform: translateX(5px);
            }

            .reminder-template.active {
                border-color: var(--gold-primary) !important;
                background: rgba(212, 175, 55, 0.1) !important;
                box-shadow: 0 0 10px rgba(212, 175, 55, 0.2);
            }

        .text-orange {
            color: #fd7e14 !important;
        }

        #reminderMessage {
            resize: none;
            overflow: hidden;
            height: 114px !important;
            line-height: 1.5;
            padding: 12px;
            background: rgba(255,255,255,0.05);
            color: white;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .char-counter {
            font-size: 0.85rem;
            color: #6c757d;
        }

        .char-counter.warning {
            color: #ffc107;
        }

        .char-counter.danger {
            color: #dc3545;
        }

        .reminder-item {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 12px;
            transition: all 0.2s ease;
        }

        .reminder-item:hover {
            background: rgba(255,255,255,0.08);
            border-color: rgba(255,255,255,0.2);
        }

        .badge-expiry {
            font-size: 0.75rem;
        }

        .delete-btn {
            padding: 4px 8px;
            font-size: 0.85rem;
        }
    </style>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-panel d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="glass-header-title">
            <i class="bi bi-megaphone-fill me-2 text-warning"></i> Payment Reminders Management
        </h4>
        <p class="mb-0 small text-muted">Create, manage, and track payment reminders</p>
    </div>
    <a href="@Url.Action("OrgTreasurerDashboard", "Officer")" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<div class="row">
    <!-- LEFT COLUMN: REMINDER FORM -->
    <div class="col-lg-6 mb-4">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-4">
                <i class="bi bi-pencil-square me-2 text-gold"></i> Create Payment Reminder
            </h5>

            <form asp-action="PostPaymentReminder" method="post" onsubmit="return validateForm()">
                @Html.AntiForgeryToken()
                
                <!-- Hidden field for edit mode -->
                <input type="hidden" id="editingReminderId" name="reminderId" value="" />

                <!-- Target Audience - Checkbox Based -->
                <div class="mb-3">
                    <label class="form-label">
                        Target Audience <span class="text-danger">*</span>
                    </label>
                    <div id="targetAudienceBox" class="p-3 border rounded" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1) !important;">
                        <!-- Special Categories -->
                        <div class="mb-3">
                            <div class="text-muted mb-2" style="font-size: 0.9rem; font-weight: 500;">Special Categories:</div>
                            <div class="form-check">
                                <input class="form-check-input audience-checkbox" type="checkbox" value="All Students" 
                                       id="audience_all" name="targetAudiences" onchange="handleAllStudentsChange()">
                                <label class="form-check-label" for="audience_all">
                                    All Students
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input audience-checkbox" type="checkbox" 
                                       value="Students with Outstanding Balance" 
                                       id="audience_outstanding" name="targetAudiences">
                                <label class="form-check-label" for="audience_outstanding">
                                    Students with Outstanding Balance
                                </label>
                            </div>
                        </div>

                        <!-- Year Levels -->
                        <div class="mb-3">
                            <div class="text-muted mb-2" style="font-size: 0.9rem; font-weight: 500;">Year Levels:</div>
                            <div class="row">
                                @if (ViewBag.YearLevels != null)
                                {
                                    int yearIndex = 0;
                                    foreach (var year in ViewBag.YearLevels as List<string>)
                                    {
                                        <div class="col-6 col-md-3">
                                            <div class="form-check">
                                                <input class="form-check-input audience-checkbox" type="checkbox" 
                                                       value="@year" id="audience_year_@yearIndex" name="targetAudiences">
                                                <label class="form-check-label" for="audience_year_@yearIndex">
                                                    @year
                                                </label>
                                            </div>
                                        </div>
                                        yearIndex++;
                                    }
                                }
                            </div>
                        </div>

                        <!-- Programs -->
                        <div class="mb-3">
                            <div class="text-muted mb-2" style="font-size: 0.9rem; font-weight: 500;">Programs:</div>
                            <div class="row">
                                @if (ViewBag.Courses != null)
                                {
                                    int courseIndex = 0;
                                    foreach (var course in ViewBag.Courses as List<string>)
                                    {
                                        <div class="col-6 col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input audience-checkbox" type="checkbox" 
                                                       value="@course" id="audience_course_@courseIndex" name="targetAudiences">
                                                <label class="form-check-label" for="audience_course_@courseIndex">
                                                    @course (All Years)
                                                </label>
                                            </div>
                                        </div>
                                        courseIndex++;
                                    }
                                }
                            </div>
                        </div>

                        <!-- Program-Specific Year Levels -->
                        <div class="mb-0">
                            <div class="text-muted mb-2" style="font-size: 0.9rem; font-weight: 500;">Specific Program-Year Combinations:</div>
                            
                            <!-- BSIT Years -->
                            <div class="mb-2">
                                <small class="text-gold fw-bold">BSIT:</small>
                                <div class="row mt-1">
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input audience-checkbox" type="checkbox" 
                                                   value="BSIT 1st Year" id="audience_bsit_1" name="targetAudiences">
                                            <label class="form-check-label" for="audience_bsit_1">1st Year</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input audience-checkbox" type="checkbox" 
                                                   value="BSIT 2nd Year" id="audience_bsit_2" name="targetAudiences">
                                            <label class="form-check-label" for="audience_bsit_2">2nd Year</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input audience-checkbox" type="checkbox" 
                                                   value="BSIT 3rd Year" id="audience_bsit_3" name="targetAudiences">
                                            <label class="form-check-label" for="audience_bsit_3">3rd Year</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input audience-checkbox" type="checkbox" 
                                                   value="BSIT 4th Year" id="audience_bsit_4" name="targetAudiences">
                                            <label class="form-check-label" for="audience_bsit_4">4th Year</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- DIT Years -->
                            <div class="mb-2">
                                <small class="text-gold fw-bold">DIT:</small>
                                <div class="row mt-1">
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input audience-checkbox" type="checkbox" 
                                                   value="DIT 1st Year" id="audience_dit_1" name="targetAudiences">
                                            <label class="form-check-label" for="audience_dit_1">1st Year</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input audience-checkbox" type="checkbox" 
                                                   value="DIT 2nd Year" id="audience_dit_2" name="targetAudiences">
                                            <label class="form-check-label" for="audience_dit_2">2nd Year</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-check">
                                            <input class="form-check-input audience-checkbox" type="checkbox" 
                                                   value="DIT 3rd Year" id="audience_dit_3" name="targetAudiences">
                                            <label class="form-check-label" for="audience_dit_3">3rd Year</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Selection Counter Badge -->
                        <div class="mt-2">
                            <span id="audienceCounter" class="badge bg-secondary">
                                <i class="bi bi-info-circle me-1"></i>0 audiences selected
                            </span>
                            <span id="targetMemberCounter" class="badge bg-info ms-2" style="display: none;">
                                <i class="bi bi-people-fill me-1"></i>0 students will receive this
                            </span>
                        </div>
                    </div>
                    <small class="text-muted">Select one or more target audiences</small>
                    <input type="hidden" id="targetAudienceHidden" name="targetAudience" required>
                </div>

                <!-- Reminder Type (Hidden) -->
                <input type="hidden" name="reminderType" id="reminderType" value="" />

                <!-- Reminder Title -->
                <div class="mb-3">
                    <label for="reminderTitle" class="form-label">
                        Reminder Title <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="reminderTitle" id="reminderTitle" 
                           required placeholder="e.g., Monthly Dues Payment" maxlength="100">
                </div>

                <!-- Reminder Message -->
                <div class="mb-3">
                    <label for="reminderMessage" class="form-label">
                        Reminder Message <span class="text-danger">*</span>
                    </label>
                    <textarea class="form-control" id="reminderMessage" name="content" required
                              placeholder="Type your message here..." maxlength="500" oninput="updateCharCount()"></textarea>
                    <div class="d-flex justify-content-between mt-1">
                        <small class="text-muted">Be clear and concise</small>
                        <small class="char-counter" id="charCounter">0 / 500</small>
                    </div>
                </div>

                <!-- Expiry Date -->
                <div class="mb-3">
                    <label for="expiryDays" class="form-label">
                        <i class="bi bi-clock-history me-1"></i> Auto-Delete After
                    </label>
                    <select class="form-select" id="expiryDays" name="expiryDays">
                        <option value="7">7 Days</option>
                        <option value="14">14 Days</option>
                        <option value="30" selected>30 Days (Recommended)</option>
                        <option value="60">60 Days</option>
                        <option value="90">90 Days</option>
                        <option value="0">Never Expire</option>
                    </select>
                    <small class="text-muted">Reminder will be automatically hidden after this period</small>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary" onclick="clearForm()">
                        <i class="bi bi-x-circle me-1"></i> Clear
                    </button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-send-fill me-1"></i> Post Reminder
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- RIGHT COLUMN: TYPE SELECTION & EXISTING REMINDERS -->
    <div class="col-lg-6">
        <!-- Type of Reminder Selection -->
        <div class="glass-panel mb-4">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-clipboard-check me-2 text-gold"></i> Type of Reminder
            </h5>
            <p class="small text-muted mb-3">Click to select reminder type</p>

            <div class="reminder-template" onclick="useTemplate(this, 'General Reminder')">
                <h6 class="text-warning mb-1"><i class="bi bi-bell me-1"></i> General Reminder</h6>
                <small class="text-muted">Standard payment notice</small>
            </div>

            <div class="reminder-template" onclick="useTemplate(this, 'Urgent Notice')">
                <h6 class="text-danger mb-1"><i class="bi bi-exclamation-triangle me-1"></i> Urgent Notice</h6>
                <small class="text-muted">Approaching deadlines</small>
            </div>

            <div class="reminder-template" onclick="useTemplate(this, 'Final Notice')">
                <h6 class="text-orange mb-1"><i class="bi bi-hourglass-split me-1"></i> Final Notice</h6>
                <small class="text-muted">Last call for payments</small>
            </div>

            <div class="reminder-template" onclick="useTemplate(this, 'New Fee Posted')">
                <h6 class="text-info mb-1"><i class="bi bi-receipt me-1"></i> New Fee Posted</h6>
                <small class="text-muted">Announce new fees</small>
            </div>
        </div>

        <!-- Existing Active Reminders -->
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-list-check me-2 text-gold"></i> Your Active Reminders
            </h5>

            @if (ViewBag.ExistingReminders != null && ((List<iBITS_Portal.Models.Announcement>)ViewBag.ExistingReminders).Count > 0)
            {
                @foreach (var reminder in (List<iBITS_Portal.Models.Announcement>)ViewBag.ExistingReminders)
                {
                    <div class="reminder-item">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="mb-0 text-warning">@reminder.Title</h6>
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-warning delete-btn me-1" 
                                        onclick="editReminder(@reminder.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(reminder.Title.Replace("Payment Reminder: ", "")))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(reminder.Content))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(reminder.TargetAudience ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(reminder.AnnouncementType ?? ""))', @(reminder.ExpiryDate.HasValue ? Math.Max(0, (int)(reminder.ExpiryDate.Value - PhTime.Now).TotalDays) : 0))">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form asp-action="DeletePaymentReminder" method="post" style="display:inline;" 
                                      onsubmit="return confirmDelete('@reminder.Title')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@reminder.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger delete-btn">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <p class="mb-2 small text-muted">@reminder.Content</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-secondary badge-expiry">
                                    <i class="bi bi-people me-1"></i>@reminder.TargetAudience
                                </span>
                                <span class="badge bg-info badge-expiry ms-1">
                                    @reminder.AnnouncementType
                                </span>
                            </div>
                            <small class="text-muted">
                                @if (reminder.ExpiryDate.HasValue)
                                {
                                    var daysLeft = (reminder.ExpiryDate.Value - PhTime.Now).Days;
                                    <i class="bi bi-clock me-1"></i>
                                    @if (daysLeft > 0)
                                    {
                                        <span>Expires in @daysLeft days</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">Expires today</span>
                                    }
                                }
                                else
                                {
                                    <text><i class="bi bi-infinity"></i> No expiry</text>
                                }
                            </small>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-inbox display-4 text-muted"></i>
                    <p class="text-muted mt-2">No active reminders yet</p>
                    <small class="text-muted">Create your first reminder using the form</small>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // ===== CHECKBOX MANAGEMENT =====
        function updateAudienceSelection() {
            const checkboxes = document.querySelectorAll('.audience-checkbox:checked');
            const hiddenInput = document.getElementById('targetAudienceHidden');
            const counter = document.getElementById('audienceCounter');
            const memberCounter = document.getElementById('targetMemberCounter');
            
            // Collect selected values
            const selected = Array.from(checkboxes).map(cb => cb.value);
            const count = selected.length;
            
            // Update hidden input (comma-separated)
            hiddenInput.value = selected.join(', ');
            
            // Update counter badge
            if (count === 0) {
                counter.className = 'badge bg-danger';
                counter.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>Please select at least one audience';
                memberCounter.style.display = 'none';
            } else if (count === 1) {
                counter.className = 'badge bg-info';
                counter.innerHTML = `<i class="bi bi-check-circle me-1"></i>${count} audience selected`;
            } else {
                counter.className = 'badge bg-success';
                counter.innerHTML = `<i class="bi bi-check-circle me-1"></i>${count} audiences selected`;
            }
            
            // Fetch target member count via AJAX
            if (count > 0) {
                const targetAudience = selected.join(', ');
                fetch(`/Officer/GetTargetMemberCount?targetAudience=${encodeURIComponent(targetAudience)}`)
                    .then(response => response.json())
                    .then(data => {
                        // Update badge color and content based on count
                        if (data.count === 0) {
                            memberCounter.className = 'badge bg-warning ms-2';
                            memberCounter.innerHTML = `<i class="bi bi-exclamation-triangle me-1"></i>${data.count} students (no match)`;
                        } else {
                            memberCounter.className = 'badge bg-info ms-2';
                            memberCounter.innerHTML = `<i class="bi bi-people-fill me-1"></i>${data.count} student${data.count !== 1 ? 's' : ''} will receive this`;
                        }
                        memberCounter.style.display = 'inline-block';
                    })
                    .catch(error => {
                        console.error('Error fetching target count:', error);
                        memberCounter.style.display = 'none';
                    });
            }
        }

        function handleAllStudentsChange() {
            const allStudentsCheckbox = document.getElementById('audience_all');
            const otherCheckboxes = document.querySelectorAll('.audience-checkbox:not(#audience_all)');
            
            if (allStudentsCheckbox.checked) {
                // Disable and uncheck all other checkboxes
                otherCheckboxes.forEach(cb => {
                    cb.checked = false;
                    cb.disabled = true;
                    cb.parentElement.style.opacity = '0.5';
                });
            } else {
                // Re-enable all checkboxes
                otherCheckboxes.forEach(cb => {
                    cb.disabled = false;
                    cb.parentElement.style.opacity = '1';
                });
            }
            
            updateAudienceSelection();
        }

        // Attach change event to all audience checkboxes
        document.addEventListener('DOMContentLoaded', function() {
            const checkboxes = document.querySelectorAll('.audience-checkbox');
            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateAudienceSelection);
            });
            updateCharCount();
            updateAudienceSelection();
        });

        // ===== TEMPLATE SELECTION =====
        function useTemplate(element, typeName) {
            document.getElementById('reminderType').value = typeName;

            document.querySelectorAll('.reminder-template').forEach(box => {
                box.classList.remove('active');
            });
            element.classList.add('active');
        }

        // ===== FORM VALIDATION =====
        function validateForm() {
            const type = document.getElementById('reminderType').value;
            const audiences = document.getElementById('targetAudienceHidden').value;
            
            if (!type) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Selection Required',
                    text: "Please select a 'Type of Reminder' from the right side before posting.",
                    background: '#1a1a1a',
                    color: '#fff',
                    confirmButtonColor: '#D4AF37',
                    iconColor: '#D4AF37'
                });
                return false;
            }
            
            if (!audiences || audiences.trim() === '') {
                Swal.fire({
                    icon: 'warning',
                    title: 'Audience Required',
                    text: "Please select at least one target audience.",
                    background: '#1a1a1a',
                    color: '#fff',
                    confirmButtonColor: '#D4AF37',
                    iconColor: '#D4AF37'
                });
                return false;
            }
            
            return true;
        }

        // ===== CLEAR FORM =====
        function clearForm() {
            // Clear text inputs
            document.getElementById('reminderMessage').value = '';
            document.getElementById('reminderTitle').value = '';
            document.getElementById('reminderType').value = '';
            document.getElementById('expiryDays').value = '30';
            document.getElementById('editingReminderId').value = '';
            
            // Uncheck all audience checkboxes
            document.querySelectorAll('.audience-checkbox').forEach(cb => {
                cb.checked = false;
                cb.disabled = false;
                cb.parentElement.style.opacity = '1';
            });
            
            // Clear template selection
            document.querySelectorAll('.reminder-template').forEach(box => {
                box.classList.remove('active');
            });
            
            // Update UI
            updateCharCount();
            updateAudienceSelection();
            
            // Reset form header and button
            document.querySelector('.glass-panel h5').innerHTML = '<i class="bi bi-pencil-square me-2 text-gold"></i> Create Payment Reminder';
            document.querySelector('button[type="submit"]').innerHTML = '<i class="bi bi-send-fill me-1"></i> Post Reminder';
            document.querySelector('button[type="submit"]').className = 'btn btn-warning';
        }

        // ===== EDIT REMINDER =====
        function editReminder(id, title, content, targetAudience, reminderType, expiryDays) {
            // Set editing mode
            document.getElementById('editingReminderId').value = id;
            
            // Populate form fields
            document.getElementById('reminderTitle').value = title;
            document.getElementById('reminderMessage').value = content;
            document.getElementById('expiryDays').value = expiryDays || 30;
            document.getElementById('reminderType').value = reminderType;
            
            // Update form header and button
            document.querySelector('.glass-panel h5').innerHTML = '<i class="bi bi-pencil-square me-2 text-gold"></i> Edit Payment Reminder';
            document.querySelector('button[type="submit"]').innerHTML = '<i class="bi bi-save me-1"></i> Update Reminder';
            document.querySelector('button[type="submit"]').className = 'btn btn-success';
            
            // Handle target audience checkboxes
            // First, uncheck all
            document.querySelectorAll('.audience-checkbox').forEach(cb => {
                cb.checked = false;
                cb.disabled = false;
                cb.parentElement.style.opacity = '1';
            });
            
            // Parse and check the appropriate boxes
            if (targetAudience) {
                const audiences = targetAudience.split(',').map(a => a.trim());
                audiences.forEach(audience => {
                    const checkbox = Array.from(document.querySelectorAll('.audience-checkbox'))
                        .find(cb => cb.value === audience);
                    if (checkbox) {
                        checkbox.checked = true;
                    }
                });
                
                // Handle "All Students" special case
                if (audiences.includes('All Students')) {
                    handleAllStudentsChange();
                }
            }
            
            // Highlight the selected reminder type
            document.querySelectorAll('.reminder-template').forEach(box => {
                box.classList.remove('active');
            });
            const templateElement = Array.from(document.querySelectorAll('.reminder-template'))
                .find(el => el.textContent.includes(reminderType));
            if (templateElement) {
                templateElement.classList.add('active');
            }
            
            // Update UI
            updateCharCount();
            updateAudienceSelection();
            
            // Scroll to form
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ===== CHARACTER COUNTER =====
        function updateCharCount() {
            const textarea = document.getElementById('reminderMessage');
            const counter = document.getElementById('charCounter');
            const length = textarea.value.length;
            const maxLength = 500;

            counter.textContent = `${length} / ${maxLength}`;

            counter.classList.remove('warning', 'danger');
            if (length > maxLength * 0.9) {
                counter.classList.add('danger');
            } else if (length > maxLength * 0.75) {
                counter.classList.add('warning');
            }
        }

        // ===== DELETE CONFIRMATION =====
        function confirmDelete(title) {
            return confirm(`Are you sure you want to delete the reminder: "${title}"?\n\nThis action cannot be undone.`);
        }
    </script>
}

