@* Views/Officer/Payments.cshtml *@
@model IEnumerable<iBITS_Portal.Models.Fee>
@{
    ViewData["Title"] = "Payments & Fees";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var totalExp = (ViewBag.TotalExpected as decimal?) ?? 0;
    var totalCol = (ViewBag.TotalCollections as decimal?) ?? 0;
    var totalPending = totalExp - totalCol;
    var sectionFilter = ViewData["SectionFilter"] as string;

    bool isOrg = ViewBag.IsOrgTreasurer ?? false;
    bool isClass = ViewBag.IsClassTreasurer ?? false;
    bool canCreateFee = ViewBag.CanCreateFee ?? false;
}

<link rel="stylesheet" href="~/css/payments.css" asp-append-version="true" />
<style>
    .chart-no-data {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 250px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
    }

        .chart-no-data i {
            font-size: 4rem;
            margin-bottom: 1rem;
            color: rgba(212, 175, 55, 0.2);
        }

        .chart-no-data p {
            font-size: 1.1rem;
            font-weight: 600;
            margin: 0;
        }

    .summary-card {
        height: 100%;
        min-height: 110px;
    }
</style>

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;">
            <i class="bi bi-cash-stack me-2"></i> Payments & Fees
            @if (!string.IsNullOrEmpty(sectionFilter))
            {
                <span class="badge bg-warning text-dark ms-2">Section @sectionFilter</span>
            }
        </h3>
        <p class="text-muted small mb-0">
            @if (canCreateFee)
            {
                <span>Organization Oversight Mode</span>
            }
            else
            {

                <span>Section Treasurer Mode</span>
            }
        </p>
    </div>
</div>

<!-- FINANCIAL OVERVIEW DASHBOARD -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> Financial Overview
    </h5>

    <!-- Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(6, 182, 212, 0.15); color: #06B6D4; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;"><i class="bi bi-wallet2 fs-3"></i></div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(34, 197, 94, 0.15); color: #22C55E; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;"><i class="bi bi-check-circle-fill fs-3"></i></div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collected</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(249, 115, 22, 0.15); color: #F97316; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;"><i class="bi bi-clock-history fs-3"></i></div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPendingCard">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Pending</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Collected by Section</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="paymentsBreakdownChart"></canvas>
                    <div id="paymentsNoData" class="chart-no-data"><i class="bi bi-inbox-fill"></i><p>No Payments Collected</p></div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart me-2"></i>Pending by Section</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="pendingBreakdownChart"></canvas>
                    <div id="pendingNoData" class="chart-no-data"><i class="bi bi-check2-all"></i><p>No Pending Fees</p></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTERS -->
<div class="glass-panel p-4 mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label small text-muted">Fee Name</label>
            <select id="filterFeeName" class="form-select form-select-sm">
                <option value="">All Fees</option>
                @if (ViewBag.FeeNames != null)
                {
                    foreach (var name in ViewBag.FeeNames)
                    {
                        <option value="@name">@name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2"><label class="form-label small text-muted">Program</label><select id="filterProgram" class="form-select form-select-sm"><option value="">All</option><option value="BSIT">BSIT</option><option value="DIT">DIT</option></select></div>
        <div class="col-md-2"><label class="form-label small text-muted">Year</label><select id="filterYear" class="form-select form-select-sm"><option value="">All</option><option value="1">1st</option><option value="2">2nd</option><option value="3">3rd</option><option value="4">4th</option></select></div>
        <div class="col-md-2"><label class="form-label small text-muted">Status</label><select id="filterStatus" class="form-select form-select-sm"><option value="">All</option><option value="paid">Paid</option><option value="pending">Pending</option></select></div>
        <div class="col-md-3"><label class="form-label small text-muted">Academic Year</label><input type="text" id="filterAcadYear" class="form-control form-control-sm"></div>
    </div>
</div>

<!-- TABLE -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); margin: 0; font-weight: 700;"><i class="bi bi-receipt me-2"></i> Records</h5>
        @if (canCreateFee)
        {
            <button class="btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#createFeeModal"><i class="bi bi-plus-lg me-1"></i> Create Fee</button>
        }
    </div>
    <div class="table-responsive">
        <table class="table table-glass" id="feesTable">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Fee</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var fee in Model)
                    {
                        var status = fee.FeeStatus ?? "Unpaid";
                        <tr class="fee-row"
                            data-fee-name="@(fee.FeeName?.ToLower() ?? "")"
                            data-program="@(fee.StudentNumNavigation?.Course ?? "")"
                            data-year="@(fee.StudentNumNavigation?.YearLevelSection ?? "")"
                            data-status="@(status.ToLower())"
                            data-acad-year="@(fee.AcadYear ?? "")">
                            <td>
                                <div class="fw-bold text-white">@fee.StudentNumNavigation?.FullName</div>
                                <div class="small text-muted">@fee.StudentNum</div>
                            </td>
                            <td>@fee.FeeName</td>
                            <td class="text-gold fw-bold">₱ @(fee.Amount?.ToString("N2"))</td>
                            <td>
                                @if (status.ToLower() == "paid")
                                {
                                    <span class="badge-paid">Paid</span>
                                }
                                else
                                {

                                    <span class="badge-pending">Unpaid</span>
                                }
                            </td>
                            <td class="text-end">
                                <!-- UNIFIED ACTION: Mark as Paid (Direct Update) -->
                                @if (status.ToLower() != "paid")
                                {
                                    <form asp-action="MarkFeeAsPaid" method="post" style="display:inline;" onsubmit="return confirm('Mark this fee as PAID for @fee.StudentNumNavigation?.FullName?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="feeId" value="@fee.FeeId" />
                                        <button type="submit" class="btn btn-sm btn-success" title="Mark as Paid">
                                            <i class="bi bi-check-lg me-1"></i> Paid
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary disabled" disabled><i class="bi bi-check2-all"></i> Done</button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CREATE FEE MODAL -->
@if (canCreateFee)
{
    <div class="modal fade" id="createFeeModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content glass-modal">
                <div class="modal-header">
                    <h5 class="modal-title text-gold"><i class="bi bi-cash-coin me-2"></i> Create Fee</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="CreateOrganizationFee" method="post" id="createFeeForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="mb-3"><label>Fee Name</label><input type="text" name="feeName" class="form-control" required /></div>
                        <div class="row g-3">
                            <div class="col-md-6"><label>Amount</label><input type="number" step="0.01" name="amount" class="form-control" required /></div>
                            <div class="col-md-6"><label>Due Date</label><input type="date" name="dueDate" class="form-control" required /></div>
                        </div>
                    </div>
                    <div class="modal-footer"><button type="submit" class="btn btn-gold">Create</button></div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Updated Chart Logic: Handles generic label/value objects from controller
        const paidData = @Html.Raw(Json.Serialize(ViewBag.PaidChartData));
        const pendingData = @Html.Raw(Json.Serialize(ViewBag.PendingChartData));

        function renderDynamicChart(canvasId, noDataId, dataItems) {
            const canvas = document.getElementById(canvasId);
            const noData = document.getElementById(noDataId);

            if(!dataItems || dataItems.length === 0) {
                if(canvas) canvas.style.display = 'none';
                if(noData) noData.style.display = 'flex';
                return;
            }

            if(canvas) canvas.style.display = 'block';
            if(noData) noData.style.display = 'none';

            // Generate colors dynamically
            const baseColors = ['#D4AF37', '#3B82F6', '#22C55E', '#F59E0B', '#A855F7', '#EC4899', '#64748B'];
            const labels = dataItems.map(i => i.label);
            const values = dataItems.map(i => i.value);

            new Chart(canvas, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: baseColors.slice(0, values.length),
                        borderWidth: 1,
                        borderColor: 'rgba(11, 26, 51, 0.8)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { color: '#aaa', boxWidth: 12 } }
                    }
                }
            });
        }

        renderDynamicChart('paymentsBreakdownChart', 'paymentsNoData', paidData);
        renderDynamicChart('pendingBreakdownChart', 'pendingNoData', pendingData);
    </script>
    <script src="~/js/payments.js" asp-append-version="true"></script>
}