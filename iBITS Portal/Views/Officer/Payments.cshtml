@model IEnumerable<iBITS_Portal.Models.Fee>
@{
    ViewData["Title"] = "Payments & Fees Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var totalExp = (ViewBag.TotalExpected as decimal?) ?? 0;
    var totalCol = (ViewBag.TotalCollections as decimal?) ?? 0;
    var totalPending = totalExp - totalCol;
    var sectionFilter = ViewData["SectionFilter"] as string;

    bool isOrg = ViewBag.IsOrgTreasurer ?? false;
    bool isClass = ViewBag.IsClassTreasurer ?? false;
    bool canCreateFee = ViewBag.CanCreateFee ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/payments.css" asp-append-version="true" />
    <style>
        .nav-tabs .nav-link {
            color: #6c757d;
            border: none;
            border-bottom: 3px solid transparent;
            font-weight: 600;
        }

            .nav-tabs .nav-link.active {
                color: var(--gold-primary);
                border-bottom: 3px solid var(--gold-primary);
                background: transparent;
            }

            .nav-tabs .nav-link:hover {
                border-bottom: 3px solid var(--gold-primary);
                opacity: 0.8;
            }

        .table thead th {
            color: var(--gold-primary);
            font-weight: 700;
        }

        .table tbody td {
            color: var(--text-main);
            vertical-align: middle;
        }

        .badge-paid {
            background-color: #10b981;
            color: white;
        }

        .badge-unpaid {
            background-color: #ef4444;
            color: white;
        }

        .payment-modal .modal-content {
            border-radius: 15px;
        }

        .payment-modal .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px 15px 0 0;
        }
    </style>
}

<!-- TempData Messages -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="glass-header-title">
            <i class="bi bi-cash-coin me-2 text-gold"></i>
            @(isOrg ? "Organization Treasury" : isClass ? $"Section {sectionFilter} Treasury" : "Payment Management")
        </h4>
        <p class="mb-0 small text-muted">
            @(isOrg ? "Manage payments for all students" : isClass ? "Manage payments for your section" : "Process payments")
        </p>
    </div>
    @if (canCreateFee)
    {
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createFeeModal">
            <i class="bi bi-plus-circle me-1"></i> Create Fee
        </button>
    }
</div>

<!-- STATISTICS CARDS -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="glass-panel text-center">
            <i class="bi bi-wallet2 fs-2 text-success mb-2"></i>
            <h6 class="text-muted mb-1">Total Collections</h6>
            <h3 class="fw-bold text-success">₱@totalCol.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-panel text-center">
            <i class="bi bi-hourglass-split fs-2 text-warning mb-2"></i>
            <h6 class="text-muted mb-1">Pending Payments</h6>
            <h3 class="fw-bold text-warning">₱@totalPending.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-panel text-center">
            <i class="bi bi-graph-up-arrow fs-2 text-primary mb-2"></i>
            <h6 class="text-muted mb-1">Total Expected</h6>
            <h3 class="fw-bold text-primary">₱@totalExp.ToString("N2")</h3>
        </div>
    </div>
</div>

<!-- TABS FOR FEES AND FINES -->
<div class="glass-panel">
    <ul class="nav nav-tabs mb-4" id="paymentTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="fees-tab" data-bs-toggle="tab" data-bs-target="#fees-content" type="button" role="tab">
                <i class="bi bi-receipt me-2"></i> Fees
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="fines-tab" data-bs-toggle="tab" data-bs-target="#fines-content" type="button" role="tab">
                <i class="bi bi-exclamation-octagon me-2"></i> Fines
            </button>
        </li>
    </ul>

    <div class="tab-content" id="paymentTabsContent">
        <!-- FEES TAB -->
        <div class="tab-pane fade show active" id="fees-content" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Student Name</th>
                            <th>Student ID</th>
                            <th>Fee Description</th>
                            <th>Amount</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var fee in Model)
                            {
                                var isPaid = fee.FeeStatus?.ToUpper() == "PAID";
                                <tr class="@(isPaid ? "table-success" : "")">
                                    <td class="fw-bold">@fee.StudentNumNavigation?.StudentFn @fee.StudentNumNavigation?.StudentLn</td>
                                    <td class="font-monospace">@fee.StudentNum</td>
                                    <td>@fee.FeeName</td>
                                    <td class="fw-bold">₱@fee.Amount?.ToString("N2")</td>
                                    <td>@fee.FeesDueDate?.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (isPaid)
                                        {
                                            <span class="badge badge-paid"><i class="bi bi-check-circle-fill me-1"></i> Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-unpaid"><i class="bi bi-hourglass-split me-1"></i> Unpaid</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!isPaid)
                                        {
                                            <button class="btn btn-sm btn-success" onclick="openPaymentModal(@fee.FeeId, 'fee', '@fee.FeeName', @fee.Amount, '@fee.StudentNumNavigation?.FullName')">
                                                <i class="bi bi-check-circle me-1"></i> Mark as Paid
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-success"><i class="bi bi-check-circle-fill"></i> Completed</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-check2-circle fs-2"></i>
                                    <p class="mt-2 mb-0">No pending fees found.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- FINES TAB -->
        <div class="tab-pane fade" id="fines-content" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-hover" id="finesTable">
                    <thead>
                        <tr>
                            <th>Student Name</th>
                            <th>Student ID</th>
                            <th>Fine Reason</th>
                            <th>Amount</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2 text-muted">Loading fines data...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- PAYMENT MODAL -->
<div class="modal fade payment-modal" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-cash-coin me-2"></i> Process Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="paymentForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="paymentId" name="paymentId" />
                    <input type="hidden" id="paymentType" name="paymentType" />

                    <div class="alert alert-info">
                        <strong>Student:</strong> <span id="studentName"></span><br>
                        <strong>Item:</strong> <span id="itemDescription"></span><br>
                        <strong>Amount:</strong> <span id="itemAmount"></span>
                    </div>

                    <div class="mb-3">
                        <label for="paymentMethod" class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select class="form-select" id="paymentMethod" name="paymentMethod" required>
                            <option value="">-- Select Payment Method --</option>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Online Banking">Online Banking</option>
                            <option value="Check">Check</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="transactionRef" class="form-label">Transaction Reference</label>
                        <input type="text" class="form-control" id="transactionRef" name="transactionRef" placeholder="e.g., GCash Ref #, Check #">
                        <small class="form-text text-muted">Optional: Enter reference number if applicable</small>
                    </div>

                    <div class="mb-3">
                        <label for="notes" class="form-label">Notes</label>
                        <textarea class="form-control" id="notes" name="notes" rows="2" placeholder="Additional notes (optional)"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Confirm Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CREATE FEE MODAL (Org Treasurer Only) -->
@if (canCreateFee)
{
    <div class="modal fade" id="createFeeModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i> Create Organization Fee</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="CreateOrganizationFee" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="feeName" class="form-label">Fee Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="feeName" name="feeName" required placeholder="e.g., Membership Fee, Event Fee">
                        </div>
                        <div class="mb-3">
                            <label for="amount" class="form-label">Amount <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="amount" name="amount" required step="0.01" min="0.01" placeholder="0.00">
                        </div>
                        <div class="mb-3">
                            <label for="dueDate" class="form-label">Due Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="dueDate" name="dueDate" required>
                        </div>
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle me-2"></i> This fee will be created for <strong>all active students</strong> in the organization.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create Fee</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Open payment modal with data
        function openPaymentModal(id, type, description, amount, studentName) {
            document.getElementById('paymentId').value = id;
            document.getElementById('paymentType').value = type;
            document.getElementById('studentName').textContent = studentName;
            document.getElementById('itemDescription').textContent = description;
            document.getElementById('itemAmount').textContent = '₱' + parseFloat(amount).toFixed(2);

            // Set form action based on type
            const form = document.getElementById('paymentForm');
            if (type === 'fee') {
                form.action = '@Url.Action("MarkFeeAsPaid", "Officer")';
                document.getElementById('paymentId').name = 'feeId';
            } else if (type === 'fine') {
                form.action = '@Url.Action("MarkFineAsPaid", "Officer")';
                document.getElementById('paymentId').name = 'fineId';
            }

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('paymentModal'));
            modal.show();
        }

        // Load fines data when tab is clicked
        document.getElementById('fines-tab').addEventListener('click', function() {
            loadFinesData();
        });

        function loadFinesData() {
            const tbody = document.querySelector('#finesTable tbody');

            // Show loading spinner
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading fines data...</p>
                    </td>
                </tr>
            `;

            // Fetch fines data
            fetch('@Url.Action("GetFinesData", "Officer")')
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.fines && data.fines.length > 0) {
                        let html = '';
                        data.fines.forEach(fine => {
                            const isPaid = fine.finesStatus?.toUpperCase() === 'PAID';
                            html += `
                                <tr class="${isPaid ? 'table-success' : ''}">
                                    <td class="fw-bold">${fine.studentName || 'N/A'}</td>
                                    <td class="font-monospace">${fine.studentNum || 'N/A'}</td>
                                    <td>${fine.fineReason || 'Fine'}</td>
                                    <td class="fw-bold">₱${parseFloat(fine.amount || 0).toFixed(2)}</td>
                                    <td>${fine.finesDueDate ? new Date(fine.finesDueDate).toLocaleDateString() : 'N/A'}</td>
                                    <td>
                                        ${isPaid
                                            ? '<span class="badge badge-paid"><i class="bi bi-check-circle-fill me-1"></i> Paid</span>'
                                            : '<span class="badge badge-unpaid"><i class="bi bi-hourglass-split me-1"></i> Unpaid</span>'}
                                    </td>
                                    <td class="text-end">
                                        ${!isPaid
                                            ? `<button class="btn btn-sm btn-success" onclick="openPaymentModal(${fine.fineId}, 'fine', '${fine.fineReason || 'Fine'}', ${fine.amount || 0}, '${fine.studentName || 'N/A'}')">
                                                <i class="bi bi-check-circle me-1"></i> Mark as Paid
                                               </button>`
                                            : '<span class="text-success"><i class="bi bi-check-circle-fill"></i> Completed</span>'}
                                    </td>
                                </tr>
                            `;
                        });
                        tbody.innerHTML = html;
                    } else {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-check2-circle fs-2"></i>
                                    <p class="mt-2 mb-0">No pending fines found.</p>
                                </td>
                            </tr>
                        `;
                    }
                })
                .catch(error => {
                    console.error('Error loading fines:', error);
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" class="text-center py-4 text-danger">
                                <i class="bi bi-exclamation-triangle fs-2"></i>
                                <p class="mt-2 mb-0">Error loading fines data.</p>
                            </td>
                        </tr>
                    `;
                });
        }
    </script>
}
