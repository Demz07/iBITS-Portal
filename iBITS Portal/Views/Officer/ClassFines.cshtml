@* FILE PATH: Views/Officer/ClassFines.cshtml *@
@* CLASS TREASURER - FINES MANAGEMENT (Full Payment Only + Remittance) *@
@model IEnumerable<iBITS_Portal.Models.Fine>
@using iBITS_Portal.Models
@{
    ViewData["Title"] = $"Section {ViewBag.Section} Fines Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var sectionName = ViewBag.Section as string ?? "N/A";
    var allFines = Model?.ToList() ?? new List<iBITS_Portal.Models.Fine>();
    var totalExp = ViewBag.TotalExpected ?? 0m;
    var totalCol = ViewBag.TotalCollected ?? 0m;
    var totalPending = ViewBag.TotalPending ?? 0m;
    var collectionRate = ViewBag.CollectionRate ?? 0m;
    
    // Group fines by description/event for remittance
    var finesByCategory = allFines.GroupBy(f => f.Description ?? f.Attendance?.Event?.EventName ?? "Other").OrderBy(g => g.Key).ToList();
    
    // Count collected but not remitted
    var pendingRemittanceCount = allFines.Count(f => f.FinesStatus?.ToUpper() == "PAID" && f.RemittanceStatus == FeeRemittanceStatus.NotRemitted);
    var pendingRemittanceAmount = allFines.Where(f => f.FinesStatus?.ToUpper() == "PAID" && f.RemittanceStatus == FeeRemittanceStatus.NotRemitted).Sum(f => f.Amount ?? 0);
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/officer-treasury.css" asp-append-version="true" />

@section Styles{
<style>
    .chart-no-data { display: none; flex-direction: column; align-items: center; justify-content: center; height: 100%; min-height: 250px; color: rgba(255, 255, 255, 0.4); text-align: center; }
    .chart-no-data i { font-size: 4rem; margin-bottom: 1rem; color: rgba(212, 175, 55, 0.2); }
    .chart-no-data p { font-size: 1.1rem; font-weight: 600; margin: 0; }
    .summary-card { height: 100%; min-height: 110px; }
    .section-badge { background: linear-gradient(135deg, var(--gold-primary), #b8860b); color: #000; padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; }
    
    /* Remittance Styles */
    .btn-remit { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 600; transition: all 0.3s ease; }
    .btn-remit:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4); color: white; }
    .btn-remit:disabled { background: rgba(107, 114, 128, 0.3); cursor: not-allowed; transform: none; box-shadow: none; }
    
    .btn-mark-paid { background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; transition: all 0.2s ease; }
    .btn-mark-paid:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4); color: white; }
    .btn-mark-paid:disabled { background: rgba(107, 114, 128, 0.3); cursor: not-allowed; }
    
    .btn-revoke { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; border: none; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; }
    .btn-revoke:hover { box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4); color: white; }
    
    /* Status badges */
    .remittance-status { padding: 4px 10px; border-radius: 15px; font-size: 0.7rem; font-weight: 600; }
    .remittance-status.not-remitted { background: rgba(107, 114, 128, 0.2); color: #9ca3af; }
    .remittance-status.collected { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .remittance-status.pending-remit { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .remittance-status.remitted { background: rgba(139, 92, 246, 0.2); color: #a78bfa; }
    
    /* Fine category card */
    .fine-category-card { background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; margin-bottom: 1.5rem; overflow: hidden; }
    .fine-category-header { background: rgba(239, 68, 68, 0.08); border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding: 1rem 1.25rem; }
    .fine-category-body { padding: 0; }
    
    /* Lock indicator */
    .lock-indicator { color: #a78bfa; font-size: 0.8rem; }
    .row-locked { opacity: 0.7; background: rgba(139, 92, 246, 0.05); }
    
    /* Quick stats bar */
    .quick-stats { background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(139, 92, 246, 0.05)); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 10px; padding: 1rem; }
</style>
}

@Html.AntiForgeryToken()

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;">
            <i class="bi bi-exclamation-triangle me-2"></i> Section Fines Management
            <span class="section-badge ms-2">@sectionName</span>
        </h3>
        <p class="text-muted small mb-0">Collect FULL fine payments from your section classmates (No partial payments)</p>
    </div>
    <div>
        <a asp-action="ClassTreasuryDashboard" class="btn btn-outline-light btn-sm me-2">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
        <a asp-action="PendingCollections" asp-route-type="fines" class="btn btn-outline-warning btn-sm me-2">
            <i class="bi bi-collection me-1"></i> Pending Collections
            @if (pendingRemittanceCount > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@pendingRemittanceCount</span>
            }
        </a>
        <a asp-action="RemittanceHistory" class="btn btn-outline-info btn-sm">
            <i class="bi bi-clock-history me-1"></i> Remittance History
        </a>
    </div>
</div>

<!-- QUICK REMITTANCE STATS -->
@if (pendingRemittanceCount > 0)
{
    <div class="quick-stats mb-4 d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-piggy-bank me-2 text-purple"></i>
            <strong class="text-white">@pendingRemittanceCount fine payment(s)</strong>
            <span class="text-muted">ready for remittance</span>
            <span class="text-white fw-bold ms-2">(₱@pendingRemittanceAmount.ToString("N2"))</span>
        </div>
        <a asp-action="PendingCollections" asp-route-type="fines" class="btn btn-remit btn-sm">
            <i class="bi bi-send me-1"></i> Review & Remit to Org Treasurer
        </a>
    </div>
}

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #f59e0b; background: rgba(245, 158, 11, 0.2); color: #fbbf24;">
        <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FINANCIAL OVERVIEW -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> Section @sectionName - Fines Overview
    </h5>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Expected -->
        <div class="col-md-3">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collected -->
        <div class="col-md-3">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Outstanding -->
        <div class="col-md-3">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(249, 115, 22, 0.15); color: #F97316; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPending">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Outstanding</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collection Rate -->
        <div class="col-md-3">
            <div class="summary-card rate">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-percent fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white"><span id="collectionRate">@collectionRate</span>%</div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collection Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-4">
        <!-- Paid Fines Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Paid Fines by Type</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="paidChart"></canvas>
                    <div class="chart-no-data" id="paidNoData">
                        <i class="bi bi-inbox-fill"></i>
                        <p>No paid fines data available</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unpaid Fines Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart me-2"></i>Unpaid Fines by Type</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="unpaidChart"></canvas>
                    <div class="chart-no-data" id="unpaidNoData">
                        <i class="bi bi-check2-all"></i>
                        <p>No unpaid fines data available</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTERS SECTION -->
<div class="glass-panel p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-funnel me-2"></i> Filters
        </h5>
        <button class="btn btn-sm btn-outline-secondary" id="clearFiltersBtn">
            <i class="bi bi-x-circle me-1"></i> Clear Filters
        </button>
    </div>

    <div class="row g-3">
        <!-- Search -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Search Student</label>
            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Name or ID...">
        </div>

        <!-- Fine Type -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Fine Type</label>
            <select id="filterFineType" class="form-select form-select-sm">
                <option value="">All Types</option>
                <option value="event">Event Fines</option>
                <option value="manual">Manual Fines</option>
            </select>
        </div>

        <!-- Event/Reason -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Event/Reason</label>
            <select id="filterReason" class="form-select form-select-sm">
                <option value="">All</option>
                @if (ViewBag.Events != null)
                {
                    foreach (var evt in ViewBag.Events)
                    {
                        <option value="@evt.EventName">@evt.EventName</option>
                    }
                }
                @if (ViewBag.ManualFineReasons != null)
                {
                    foreach (var reason in ViewBag.ManualFineReasons)
                    {
                        <option value="@reason">@reason (Manual)</option>
                    }
                }
            </select>
        </div>

        <!-- Status -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Status</label>
            <select id="filterStatus" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="unpaid">Unpaid</option>
                <option value="paid">Paid</option>
                <option value="excused">Excused</option>
            </select>
        </div>
    </div>
</div>

<!-- FINE RECORDS BY CATEGORY (Remittance-Based UI) -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 style="color: var(--text-strong); margin: 0; font-weight: 700;">
            <i class="bi bi-list-check me-2"></i> Fine Records - Section @sectionName
        </h5>
        <div>
            <a asp-action="ExportClassFines" class="btn-gold-outline btn-sm">
                <i class="bi bi-download me-1"></i> Export
            </a>
        </div>
    </div>

    @if (finesByCategory.Any())
    {
        @foreach (var category in finesByCategory)
        {
            var categoryName = category.Key;
            var categoryFines = category.ToList();
            var categoryTotal = categoryFines.Sum(f => f.Amount ?? 0);
            var categoryPaid = categoryFines.Count(f => f.FinesStatus?.ToUpper() == "PAID");
            var categoryUnpaid = categoryFines.Count(f => f.FinesStatus?.ToUpper() != "PAID" && f.FinesStatus?.ToUpper() != "EXCUSED");
            var categoryExcused = categoryFines.Count(f => f.FinesStatus?.ToUpper() == "EXCUSED");
            var categoryCollectedNotRemitted = categoryFines.Count(f => f.FinesStatus?.ToUpper() == "PAID" && f.RemittanceStatus == FeeRemittanceStatus.NotRemitted);
            var categoryRemitted = categoryFines.Count(f => f.RemittanceStatus == FeeRemittanceStatus.Remitted);
            var canRemit = categoryCollectedNotRemitted > 0;

            // Check if this category is validated (closed)
            var validatedCategories = ViewBag.ValidatedCategories as List<string> ?? new List<string>();
            var isClosed = validatedCategories.Contains(categoryName);

            <div class="fine-category-card mb-4" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; overflow: hidden;">
                <!-- Category Header -->
                <div class="fine-category-header d-flex justify-content-between align-items-center" style="background: rgba(239, 68, 68, 0.08); border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding: 1rem 1.25rem;">
                    <div>
                        <h6 class="text-white mb-1 fw-bold">
                            @categoryName
                            @if (isClosed)
                            {
                                <span class="badge bg-purple ms-2"><i class="bi bi-lock-fill me-1"></i> CLOSED - Validated</span>
                            }
                        </h6>
                        <small class="text-muted">
                            @categoryFines.Count students • ₱@((categoryFines.FirstOrDefault()?.Amount ?? 0).ToString("N2")) each
                            <span class="mx-2">|</span>
                            <span class="text-success">@categoryPaid Paid</span> •
                            <span class="text-warning">@categoryUnpaid Unpaid</span>
                            @if (categoryExcused > 0)
                            {
                                <span class="mx-1">•</span>
                                <span class="text-info">@categoryExcused Excused</span>
                            }
                            @if (categoryRemitted > 0)
                            {
                                <span class="mx-1">•</span>
                                <span style="color: #a78bfa;">@categoryRemitted Remitted</span>
                            }
                        </small>
                    </div>
                    <div>
                        @if (isClosed)
                        {
                            <span class="badge bg-purple"><i class="bi bi-lock-fill me-1"></i> Category Closed</span>
                        }
                        else if (canRemit)
                        {
                            <a asp-action="InitiateRemittance" asp-route-feeName="@categoryName" asp-route-type="fine" class="btn btn-remit btn-sm">
                                <i class="bi bi-send me-1"></i> Remit @categoryCollectedNotRemitted to Org
                            </a>
                        }
                        else if (categoryRemitted == categoryPaid && categoryPaid > 0)
                        {
                            <span class="badge" style="background: rgba(139, 92, 246, 0.2); color: #a78bfa;"><i class="bi bi-check-all me-1"></i> All Remitted</span>
                        }
                    </div>
                </div>

                <!-- Category Table -->
                <div class="fine-category-body">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0" style="background: transparent;">
                            <thead>
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                                    <th style="width: 40px; color: var(--gold-primary);">#</th>
                                    <th style="color: var(--gold-primary);">Student</th>
                                    <th style="color: var(--gold-primary);">Amount</th>
                                    <th style="color: var(--gold-primary);">Payment Status</th>
                                    <th style="color: var(--gold-primary);">Remittance</th>
                                    <th style="color: var(--gold-primary); width: 150px;" class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var rowNum = 1; }
                                @foreach (var fine in categoryFines.OrderBy(f => f.StudentNumNavigation?.StudentLn ?? f.Attendance?.StudentNumNavigation?.StudentLn))
                                {
                                    var student = fine.StudentNumNavigation ?? fine.Attendance?.StudentNumNavigation;
                                    var isPaid = fine.FinesStatus?.ToUpper() == "PAID";
                                    var isExcused = fine.FinesStatus?.ToUpper() == "EXCUSED";
                                    var isLocked = fine.RemittanceStatus != FeeRemittanceStatus.NotRemitted || isClosed;
                                    var isRemitted = fine.RemittanceStatus == FeeRemittanceStatus.Remitted;
                                    var isPendingRemit = fine.RemittanceStatus == FeeRemittanceStatus.PendingRemittance;
                                    var rowClass = isLocked ? "row-locked" : "";

                                    <tr class="@rowClass fine-row" data-fine-id="@fine.FineId" data-student-name="@(student?.FullName ?? "")" data-student-id="@(student?.StudentNum ?? fine.StudentNum)" data-reason="@categoryName" data-fine-type="@(fine.AttendanceId != null ? "event" : "manual")" data-status="@(isPaid ? "paid" : (isExcused ? "excused" : "unpaid"))">
                                        <td class="text-muted">@rowNum</td>
                                        <td>
                                            <div class="text-white fw-semibold">@(student?.FullName ?? "Unknown")</div>
                                            <small class="text-muted">@(student?.StudentNum ?? fine.StudentNum)</small>
                                        </td>
                                        <td class="fw-bold" style="color: var(--gold-primary);">₱@((fine.Amount ?? 0).ToString("N2"))</td>
                                        <td>
                                            @if (isPaid)
                                            {
                                                <span class="status-badge status-paid"><i class="bi bi-check-circle-fill me-1"></i>Paid</span>
                                            }
                                            else if (isExcused)
                                            {
                                                <span class="status-badge status-excused"><i class="bi bi-shield-check me-1"></i>Excused</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-unpaid"><i class="bi bi-x-circle me-1"></i>Unpaid</span>
                                            }
                                        </td>
                                        <td>
                                            @if (isRemitted)
                                            {
                                                <span class="remittance-status remitted" style="background: rgba(139, 92, 246, 0.2); color: #a78bfa; padding: 4px 10px; border-radius: 15px; font-size: 0.7rem; font-weight: 600;"><i class="bi bi-lock-fill me-1"></i>Remitted</span>
                                            }
                                            else if (isPendingRemit)
                                            {
                                                <span class="remittance-status pending-remit" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; padding: 4px 10px; border-radius: 15px; font-size: 0.7rem; font-weight: 600;"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                            }
                                            else if (isPaid)
                                            {
                                                <span class="remittance-status collected" style="background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 4px 10px; border-radius: 15px; font-size: 0.7rem; font-weight: 600;"><i class="bi bi-piggy-bank me-1"></i>Collected</span>
                                            }
                                            else if (isExcused)
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (isExcused)
                                            {
                                                <span class="text-info" title="Excused by Secretary"><i class="bi bi-shield-check"></i></span>
                                            }
                                            else if (isLocked)
                                            {
                                                <span class="lock-indicator" title="Locked - Already remitted or pending" style="color: #a78bfa; font-size: 0.8rem;">
                                                    <i class="bi bi-lock-fill"></i> Locked
                                                </span>
                                            }
                                            else if (isPaid)
                                            {
                                                <button type="button" class="btn btn-revoke btn-sm" onclick="revokeFinePayment(@fine.FineId, '@student?.FullName?.Replace("'", "\\'")', '@categoryName?.Replace("'", "\\'")', @(fine.Amount ?? 0))" title="Revoke payment" style="background: linear-gradient(135deg, #ef4444, #dc2626); color: white; border: none; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600;">
                                                    <i class="bi bi-x-circle me-1"></i> Revoke
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-mark-paid btn-sm" onclick="markFinePaid(@fine.FineId, '@student?.FullName?.Replace("'", "\\'")', '@categoryName?.Replace("'", "\\'")', @(fine.Amount ?? 0))" title="Mark as fully paid" style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600;">
                                                    <i class="bi bi-check-circle me-1"></i> Mark Paid
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                    rowNum++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
            <h5 class="text-white">No Fine Records</h5>
            <p class="text-muted">No fine records found for this section.</p>
        </div>
    }
</div>


<!-- MARK FINE AS PAID MODAL -->
<div class="modal fade" id="markFinePaidModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0" style="background: linear-gradient(135deg, #10b981, #059669);">
                <h5 class="modal-title text-white"><i class="bi bi-check-circle me-2"></i> Mark Fine as Paid</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div class="confirm-modal-icon success mb-3" style="font-size: 4rem; color: #10b981;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <p class="mb-3 text-white">Mark this fine as <strong class="text-success">FULLY PAID</strong>?</p>
                <div class="confirm-modal-details" style="background: rgba(255,255,255,0.05); border-radius: 12px; padding: 1.5rem; text-align: left;">
                    <div class="detail-row d-flex justify-content-between mb-2">
                        <span class="detail-label text-muted">Student</span>
                        <span class="detail-value text-white fw-bold" id="markPaidStudentName"></span>
                    </div>
                    <div class="detail-row d-flex justify-content-between mb-2">
                        <span class="detail-label text-muted">Fine Description</span>
                        <span class="detail-value text-white fw-bold" id="markPaidDescription"></span>
                    </div>
                    <div class="detail-row d-flex justify-content-between">
                        <span class="detail-label text-muted">Amount</span>
                        <span class="detail-value text-gold fw-bold" style="font-size: 1.2rem;">₱<span id="markPaidAmount"></span></span>
                    </div>
                </div>
                <p class="text-muted small mt-3 mb-0">This will record the full payment and send a receipt notification to the student.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmMarkPaidBtn" onclick="confirmMarkFinePaid()">
                    <i class="bi bi-check-circle me-1"></i> Confirm Payment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- REVOKE FINE PAYMENT MODAL -->
<div class="modal fade" id="revokeFinePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
                <h5 class="modal-title text-white"><i class="bi bi-x-circle me-2"></i> Revoke Fine Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div class="confirm-modal-icon danger mb-3" style="font-size: 4rem; color: #ef4444;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <p class="mb-3 text-white">Revoke payment for this fine?</p>
                <div class="confirm-modal-details" style="background: rgba(255,255,255,0.05); border-radius: 12px; padding: 1.5rem; text-align: left;">
                    <div class="detail-row d-flex justify-content-between mb-2">
                        <span class="detail-label text-muted">Student</span>
                        <span class="detail-value text-white fw-bold" id="revokeStudentName"></span>
                    </div>
                    <div class="detail-row d-flex justify-content-between mb-2">
                        <span class="detail-label text-muted">Fine Description</span>
                        <span class="detail-value text-white fw-bold" id="revokeDescription"></span>
                    </div>
                    <div class="detail-row d-flex justify-content-between">
                        <span class="detail-label text-muted">Amount</span>
                        <span class="detail-value text-gold fw-bold" style="font-size: 1.2rem;">₱<span id="revokeAmount"></span></span>
                    </div>
                </div>
                <p class="text-warning small mt-3 mb-0"><i class="bi bi-exclamation-triangle me-1"></i> This will mark the fine as UNPAID and notify the student. Use this if payment was recorded by mistake.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmRevokeBtn" onclick="confirmRevokePayment()">
                    <i class="bi bi-x-circle me-1"></i> Revoke Payment
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Data passed from Controller
        window.finesChartsData = {
            paid: @Html.Raw(Json.Serialize(ViewBag.PaidBreakdown ?? new Dictionary<string, decimal>())),
            unpaid: @Html.Raw(Json.Serialize(ViewBag.UnpaidBreakdown ?? new Dictionary<string, decimal>()))
        };



        // ============================================================
        // MARK FINE AS PAID - Show Modal
        // ============================================================
        let currentFineData = {};

        function markFinePaid(fineId, studentName, description, amount) {
            currentFineData = {
                fineId: fineId,
                studentName: studentName,
                description: description,
                amount: amount
            };

            // Populate modal
            document.getElementById('markPaidStudentName').textContent = studentName;
            document.getElementById('markPaidDescription').textContent = description;
            document.getElementById('markPaidAmount').textContent = amount.toFixed(2);

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('markFinePaidModal'));
            modal.show();
        }

        // ============================================================
        // CONFIRM MARK AS PAID - AJAX
        // ============================================================
        async function confirmMarkFinePaid() {
            const btn = document.getElementById('confirmMarkPaidBtn');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';

            try {
                const formData = new FormData();
                formData.append('fineId', currentFineData.fineId);
                
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                const response = await fetch('/Officer/MarkClassFinePaid', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    // Close modal
                    bootstrap.Modal.getInstance(document.getElementById('markFinePaidModal')).hide();
                    
                    // Show success toast
                    showToast('success', result.message);
                    
                    // Reload page after short delay
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    showToast('error', result.message);
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An error occurred. Please try again.');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

        // ============================================================
        // REVOKE FINE PAYMENT - Show Modal
        // ============================================================
        function revokeFinePayment(fineId, studentName, description, amount) {
            currentFineData = {
                fineId: fineId,
                studentName: studentName,
                description: description,
                amount: amount
            };

            // Populate modal
            document.getElementById('revokeStudentName').textContent = studentName;
            document.getElementById('revokeDescription').textContent = description;
            document.getElementById('revokeAmount').textContent = amount.toFixed(2);

            // Show modal
            const modal = new bootstrap.Modal(document.getElementById('revokeFinePaymentModal'));
            modal.show();
        }

        // ============================================================
        // CONFIRM REVOKE PAYMENT - AJAX
        // ============================================================
        async function confirmRevokePayment() {
            const btn = document.getElementById('confirmRevokeBtn');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';

            try {
                const formData = new FormData();
                formData.append('fineId', currentFineData.fineId);
                
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                const response = await fetch('/Officer/RevokeClassFinePaid', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    // Close modal
                    bootstrap.Modal.getInstance(document.getElementById('revokeFinePaymentModal')).hide();
                    
                    // Show success toast
                    showToast('success', result.message);
                    
                    // Reload page after short delay
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    showToast('error', result.message);
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An error occurred. Please try again.');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

        function showToast(type, message) {
            const bgClass = type === 'success' ? 'success' : (type === 'info' ? 'info' : 'danger');
            const icon = type === 'success' ? 'check-circle' : (type === 'info' ? 'info-circle' : 'exclamation-circle');
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${bgClass} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-${icon} me-2"></i>${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }

        // ============================================================
        // FILTER AND SEARCH FUNCTIONALITY
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            const filterSearch = document.getElementById('filterSearch');
            const filterFineType = document.getElementById('filterFineType');
            const filterReason = document.getElementById('filterReason');
            const filterStatus = document.getElementById('filterStatus');
            const clearFiltersBtn = document.getElementById('clearFiltersBtn');

            function applyFilters() {
                const searchTerm = filterSearch.value.toLowerCase().trim();
                const selectedFineType = filterFineType.value.toLowerCase();
                const selectedReason = filterReason.value.toLowerCase();
                const selectedStatus = filterStatus.value.toLowerCase();

                const rows = document.querySelectorAll('.fine-row');
                const categoryCards = document.querySelectorAll('.fine-category-card');

                rows.forEach(row => {
                    const studentName = (row.getAttribute('data-student-name') || '').toLowerCase();
                    const studentId = (row.getAttribute('data-student-id') || '').toLowerCase();
                    const reason = (row.getAttribute('data-reason') || '').toLowerCase();
                    const fineType = (row.getAttribute('data-fine-type') || '').toLowerCase();
                    const status = (row.getAttribute('data-status') || '').toLowerCase();

                    let show = true;

                    // Search filter (student name or ID)
                    if (searchTerm && !studentName.includes(searchTerm) && !studentId.includes(searchTerm)) {
                        show = false;
                    }

                    // Fine type filter
                    if (selectedFineType && fineType !== selectedFineType) {
                        show = false;
                    }

                    // Reason/Event filter
                    if (selectedReason && reason !== selectedReason) {
                        show = false;
                    }

                    // Status filter
                    if (selectedStatus && status !== selectedStatus) {
                        show = false;
                    }

                    row.style.display = show ? '' : 'none';
                });

                // Hide empty category cards
                categoryCards.forEach(card => {
                    const visibleRows = card.querySelectorAll('.fine-row:not([style*="display: none"])');
                    card.style.display = visibleRows.length > 0 ? '' : 'none';
                });
            }

            // Event listeners
            filterSearch.addEventListener('input', applyFilters);
            filterFineType.addEventListener('change', applyFilters);
            filterReason.addEventListener('change', applyFilters);
            filterStatus.addEventListener('change', applyFilters);

            // Clear filters
            clearFiltersBtn.addEventListener('click', function() {
                filterSearch.value = '';
                filterFineType.value = '';
                filterReason.value = '';
                filterStatus.value = '';
                applyFilters();
            });
        });
    </script>
    <script src="~/js/officer-fines.js" asp-append-version="true"></script>
}
