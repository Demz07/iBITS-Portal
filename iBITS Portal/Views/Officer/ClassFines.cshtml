@* FILE PATH: Views/Officer/ClassFines.cshtml *@
@* CLASS TREASURER - FINES MANAGEMENT (Admin-style UI with Mark as Paid) *@
@model IEnumerable<iBITS_Portal.Models.Fine>
@{
    ViewData["Title"] = $"Section {ViewBag.Section} Fines Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var sectionName = ViewBag.Section as string ?? "N/A";
    var allFines = Model?.ToList() ?? new List<iBITS_Portal.Models.Fine>();
    var totalExp = ViewBag.TotalExpected ?? 0m;
    var totalCol = ViewBag.TotalCollected ?? 0m;
    var totalPending = ViewBag.TotalPending ?? 0m;
    var collectionRate = ViewBag.CollectionRate ?? 0m;
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/officer-treasury.css" asp-append-version="true" />

@section Styles {
<style>
    .chart-no-data {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 250px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
    }
    .chart-no-data i {
        font-size: 4rem;
        margin-bottom: 1rem;
        color: rgba(212, 175, 55, 0.2);
    }
    .chart-no-data p {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
    }
    .summary-card {
        height: 100%;
        min-height: 110px;
    }
    .section-badge {
        background: linear-gradient(135deg, var(--gold-primary), #b8860b);
        color: #000;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.85rem;
    }
    .btn-mark-paid {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .btn-mark-paid:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
        color: white;
    }
    .completed-badge {
        color: #10b981;
        font-weight: 600;
        font-size: 0.85rem;
    }
    .waived-badge {
        color: #3b82f6;
        font-weight: 600;
        font-size: 0.85rem;
    }
</style>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;">
            <i class="bi bi-exclamation-triangle me-2"></i> Section Fines Management
            <span class="section-badge ms-2">@sectionName</span>
        </h3>
        <p class="text-muted small mb-0">Manage fine payments for your section classmates</p>
    </div>
    <div>
        <a asp-action="ClassTreasuryDashboard" class="btn btn-outline-light btn-sm me-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #f59e0b; background: rgba(245, 158, 11, 0.2); color: #fbbf24;">
        <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FINANCIAL OVERVIEW -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> Section @sectionName - Fines Overview
    </h5>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Expected -->
        <div class="col-md-3">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collected -->
        <div class="col-md-3">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Outstanding -->
        <div class="col-md-3">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(249, 115, 22, 0.15); color: #F97316; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPending">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Outstanding</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collection Rate -->
        <div class="col-md-3">
            <div class="summary-card rate">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-percent fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white"><span id="collectionRate">@collectionRate</span>%</div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collection Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-4">
        <!-- Paid Fines Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Paid Fines by Type</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="paidChart"></canvas>
                    <div class="chart-no-data" id="paidNoData">
                        <i class="bi bi-inbox-fill"></i>
                        <p>No paid fines data available</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unpaid Fines Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart me-2"></i>Unpaid Fines by Type</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="unpaidChart"></canvas>
                    <div class="chart-no-data" id="unpaidNoData">
                        <i class="bi bi-check2-all"></i>
                        <p>No unpaid fines data available</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTERS SECTION -->
<div class="glass-panel p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-funnel me-2"></i> Filters
        </h5>
        <button class="btn btn-sm btn-outline-secondary" id="clearFiltersBtn">
            <i class="bi bi-x-circle me-1"></i> Clear Filters
        </button>
    </div>

    <div class="row g-3">
        <!-- Search -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Search Student</label>
            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Name or ID...">
        </div>

        <!-- Fine Type -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Fine Type</label>
            <select id="filterFineType" class="form-select form-select-sm">
                <option value="">All Types</option>
                <option value="event">Event Fines</option>
                <option value="manual">Manual Fines</option>
            </select>
        </div>

        <!-- Event/Reason -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Event/Reason</label>
            <select id="filterReason" class="form-select form-select-sm">
                <option value="">All</option>
                @if (ViewBag.Events != null)
                {
                    foreach (var evt in ViewBag.Events)
                    {
                        <option value="@evt.EventName">@evt.EventName</option>
                    }
                }
                @if (ViewBag.ManualFineReasons != null)
                {
                    foreach (var reason in ViewBag.ManualFineReasons)
                    {
                        <option value="@reason">@reason (Manual)</option>
                    }
                }
            </select>
        </div>

        <!-- Status -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Status</label>
            <select id="filterStatus" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="unpaid">Unpaid</option>
                <option value="paid">Paid</option>
                <option value="excused">Excused</option>
            </select>
        </div>
    </div>
</div>

<!-- FINES TABLE -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); margin: 0; font-weight: 700;">
            Fine Records - Section @sectionName
        </h5>
        <div>
            <a asp-action="ExportClassFines" class="btn-gold-outline btn-sm">
                <i class="bi bi-download me-1"></i> Export Fines
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-glass" id="finesTable">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">☐</th>
                    <th>REF ID</th>
                    <th>STUDENT NAME</th>
                    <th>DESCRIPTION</th>
                    <th>AMOUNT</th>
                    <th>PAID</th>
                    <th>BALANCE</th>
                    <th>STATUS</th>
                    <th class="text-center" style="width: 80px;">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var fine in Model)
                    {
                        var student = fine.StudentNumNavigation ?? fine.Attendance?.StudentNumNavigation;
                        var eventRecord = fine.Attendance?.Event;
                        var description = !string.IsNullOrEmpty(fine.Description) ? fine.Description : (eventRecord?.EventName ?? "Unknown");
                        var paymentStatus = fine.PaymentStatus;
                        var isPaid = paymentStatus == "Paid";
                        var isPartial = paymentStatus == "Partial";
                        var isExcused = paymentStatus == "Excused";
                        var remainingBalance = fine.RemainingBalance;
                        var isEventFine = fine.AttendanceId != null;
                        var statusClass = isPaid ? "row-paid" : (isPartial ? "row-partial" : (isExcused ? "row-excused" : ""));
                        var checkboxClass = isPaid ? "status-paid no-revoke" : (isPartial ? "status-partial" : (isExcused ? "status-excused" : "status-unpaid"));

                        <tr class="fine-row @statusClass"
                            data-fine-id="@fine.FineId"
                            data-student="@student?.FullName?.ToLower()"
                            data-studentnum="@student?.StudentNum?.ToLower()"
                            data-status="@paymentStatus.ToLower()"
                            data-finetype="@(isEventFine ? "event" : "manual")"
                            data-reason="@description?.ToLower()"
                            data-amount="@(fine.Amount ?? 0)"
                            data-paid="@fine.AmountPaid"
                            data-balance="@remainingBalance">

                            <!-- Checkbox Column -->
                            <td class="text-center">
                                <div class="payment-checkbox-wrapper">
                                    <div class="payment-checkbox @checkboxClass" 
                                         data-fine-id="@fine.FineId"
                                         data-student-name="@(student?.FullName ?? "Unknown")"
                                         data-description="@description"
                                         data-amount="@(fine.Amount ?? 0)"
                                         data-balance="@remainingBalance"
                                         data-status="@paymentStatus.ToLower()"
                                         onclick="@(isPaid || isExcused ? "" : "handleOfficerFineCheckbox(this)")"
                                         title="@(isExcused ? "This fine is excused" : (isPaid ? "Payment completed" : (isPartial ? "Click to complete payment" : "Click to mark as paid")))">
                                    </div>
                                </div>
                            </td>

                            <td class="font-monospace text-muted">#@fine.FineId</td>
                            <td>
                                @if (student != null)
                                {
                                    <div style="color: var(--text-strong); font-weight: 600;">@student.FullName</div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">@student.StudentNum</div>
                                }
                                else
                                {
                                    <span class="text-danger">Unknown Student</span>
                                }
                            </td>
                            <td>
                                @if (!isEventFine)
                                {
                                    <span class="text-gold"><i class="bi bi-pencil-fill me-1" style="font-size: 0.7rem;"></i> @description</span>
                                }
                                else
                                {
                                    <span>@description</span>
                                }
                            </td>
                            <td style="color: var(--gold-primary); font-weight: bold;">₱@fine.Amount?.ToString("N2")</td>
                            <td class="amount-paid" style="color: #10b981; font-weight: 600;">₱@fine.AmountPaid.ToString("N2")</td>
                            <td class="balance" style="color: @(remainingBalance > 0 ? "#ef4444" : "#10b981"); font-weight: 600;">₱@remainingBalance.ToString("N2")</td>
                            
                            <!-- Status Badge -->
                            <td>
                                @if (isPaid)
                                {
                                    <span class="status-badge status-paid"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                }
                                else if (isExcused)
                                {
                                    <span class="status-badge status-excused"><i class="bi bi-shield-check"></i> Excused</span>
                                }
                                else if (isPartial)
                                {
                                    <span class="status-badge status-partial"><i class="bi bi-pie-chart-fill"></i> Partial</span>
                                }
                                else
                                {
                                    <span class="status-badge status-unpaid"><i class="bi bi-x-circle-fill"></i> Unpaid</span>
                                }
                            </td>
                            
                            <!-- Actions -->
                            <td class="text-center">
                                @if (!isPaid && !isExcused)
                                {
                                    <button class="btn btn-sm btn-outline-success" onclick="openClassFinePaymentModal(@fine.FineId, '@student?.FullName?.Replace("'", "\\'")', '@description?.Replace("'", "\\'")', @(fine.Amount ?? 0), @fine.AmountPaid, @remainingBalance)" title="Record partial payment">
                                        <i class="bi bi-cash-coin"></i>
                                    </button>
                                }
                                else if (isPaid)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill"></i></span>
                                }
                                else
                                {
                                    <span class="text-info"><i class="bi bi-shield-check"></i></span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted"><i class="bi bi-inbox fs-4 d-block mb-2"></i>No fine records found for this section.</td></tr>
                }
            </tbody>
        </table>
    </div>

<!-- CONFIRM FINE PAYMENT MODAL (Class Treasurer) -->
<div class="modal fade" id="confirmClassFinePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="bi bi-check-circle text-success me-2"></i> Confirm Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div class="confirm-modal-icon success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <p class="mb-3">Mark this fine as <strong>PAID</strong>?</p>
                <div class="confirm-modal-details">
                    <div class="detail-row">
                        <span class="detail-label">Student</span>
                        <span class="detail-value" id="confirmClassFineStudentName"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Fine</span>
                        <span class="detail-value" id="confirmClassFineDescription"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Amount</span>
                        <span class="detail-value text-gold">₱<span id="confirmClassFineAmount"></span></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmClassFinePaymentBtn" onclick="executeClassFinePayment()">
                    <i class="bi bi-check-circle me-1"></i> Confirm Payment
                </button>
            </div>
        </div>
    </div>
</div>
</div>

<!-- RECORD FINE PAYMENT MODAL (Class Treasurer) -->
<div class="modal fade" id="classFinePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header" style="background: linear-gradient(135deg, #10b981, #059669);">
                <h5 class="modal-title text-white"><i class="bi bi-cash-coin me-2"></i> Record Fine Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RecordClassFinePayment" asp-controller="Officer" method="post" id="classFinePaymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="classFinePaymentId" name="fineId" />
                <div class="modal-body">
                    <div class="fee-section p-3 mb-4">
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted">Student</small>
                                <div id="classFineStudentName" class="fw-bold text-white"></div>
                            </div>
                            <div class="col-6 text-end">
                                <small class="text-muted">Fine</small>
                                <div id="classFineDescription" class="fw-bold text-gold"></div>
                            </div>
                        </div>
                        <hr class="my-2" style="border-color: rgba(255,255,255,0.1);" />
                        <div class="row text-center">
                            <div class="col-4">
                                <small class="text-muted d-block">Total</small>
                                <div class="fw-bold text-white">₱<span id="classFineTotal">0.00</span></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Paid</small>
                                <div class="fw-bold text-success">₱<span id="classFinePaid">0.00</span></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Balance</small>
                                <div class="fw-bold text-danger">₱<span id="classFineBalance">0.00</span></div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Payment Amount (₱) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control" id="classFinePaymentAmount" name="paymentAmount" required />
                        <small class="text-muted">Max: ₱<span id="classFineMaxAmount">0.00</span></small>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block mb-2">Quick Select:</small>
                        <div class="btn-group w-100">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setClassFineAmount(0.25)">25%</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setClassFineAmount(0.5)">50%</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setClassFineAmount(0.75)">75%</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setClassFineAmount(1)">Full</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select class="form-select" id="classFinePaymentMethod" name="paymentMethod" required>
                            <option value="">-- Select --</option>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reference #</label>
                        <input type="text" class="form-control" name="transactionRef" placeholder="Optional" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" name="notes" rows="2" placeholder="Optional"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Record Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Data passed from Controller
        window.finesChartsData = {
            paid: @Html.Raw(Json.Serialize(ViewBag.PaidBreakdown ?? new Dictionary<string, decimal>())),
            unpaid: @Html.Raw(Json.Serialize(ViewBag.UnpaidBreakdown ?? new Dictionary<string, decimal>()))
        };

        // Class Fine Payment Modal
        var classFineBalance = 0;
        function openClassFinePaymentModal(fineId, studentName, description, total, paid, balance) {
            document.getElementById('classFinePaymentId').value = fineId;
            document.getElementById('classFineStudentName').textContent = studentName || 'Unknown';
            document.getElementById('classFineDescription').textContent = description || 'Fine';
            document.getElementById('classFineTotal').textContent = total.toFixed(2);
            document.getElementById('classFinePaid').textContent = paid.toFixed(2);
            document.getElementById('classFineBalance').textContent = balance.toFixed(2);
            document.getElementById('classFineMaxAmount').textContent = balance.toFixed(2);
            document.getElementById('classFinePaymentAmount').max = balance;
            document.getElementById('classFinePaymentAmount').value = balance.toFixed(2);
            document.getElementById('classFinePaymentMethod').value = '';
            classFineBalance = balance;
            new bootstrap.Modal(document.getElementById('classFinePaymentModal')).show();
        }

        function setClassFineAmount(pct) {
            document.getElementById('classFinePaymentAmount').value = (classFineBalance * pct).toFixed(2);
        }

        // Form validation
        document.getElementById('classFinePaymentForm').addEventListener('submit', function(e) {
            var amount = parseFloat(document.getElementById('classFinePaymentAmount').value);
            var method = document.getElementById('classFinePaymentMethod').value;
            
            if (!amount || amount <= 0) {
                e.preventDefault();
                alert('Please enter a valid payment amount.');
                return false;
            }
            
            if (amount > classFineBalance) {
                e.preventDefault();
                alert('Payment amount cannot exceed the remaining balance.');
                return false;
            }
            
            if (!method) {
                e.preventDefault();
                alert('Please select a payment method.');
                return false;
            }

            var submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';
        });

        // ============================================================
        // CHECKBOX-BASED PAYMENT (Officer - No Revoke for Fines)
        // ============================================================
        var currentOfficerFineData = {};

        function handleOfficerFineCheckbox(checkbox) {
            const fineId = checkbox.dataset.fineId;
            const status = checkbox.dataset.status;
            const studentName = checkbox.dataset.studentName;
            const description = checkbox.dataset.description;
            const amount = parseFloat(checkbox.dataset.amount);
            const balance = parseFloat(checkbox.dataset.balance);

            if (status === 'paid') {
                showToast('info', 'This fine is already paid. Contact admin to revoke.');
                return;
            }

            if (status === 'excused') {
                showToast('info', 'This fine is excused and cannot be modified.');
                return;
            }

            currentOfficerFineData = { fineId, studentName, description, amount, balance };
            document.getElementById('confirmClassFineStudentName').textContent = studentName;
            document.getElementById('confirmClassFineDescription').textContent = description;
            document.getElementById('confirmClassFineAmount').textContent = balance.toFixed(2);
            new bootstrap.Modal(document.getElementById('confirmClassFinePaymentModal')).show();
        }

        async function executeClassFinePayment() {
            const btn = document.getElementById('confirmClassFinePaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Officer/ToggleFinePayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `fineId=${currentOfficerFineData.fineId}&markAsPaid=true`
                });

                const result = await response.json();
                
                if (result.success) {
                    updateOfficerFineRowUI(currentOfficerFineData.fineId, result.newStatus, result.amountPaid, result.balance);
                    bootstrap.Modal.getInstance(document.getElementById('confirmClassFinePaymentModal')).hide();
                    showToast('success', result.message);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm Payment';
            }
        }

        function updateOfficerFineRowUI(fineId, newStatus, amountPaid, balance) {
            const row = document.querySelector(`tr[data-fine-id="${fineId}"]`);
            if (!row) return;

            const checkbox = row.querySelector('.payment-checkbox');
            const statusBadge = row.querySelector('.status-badge');
            const amountPaidCell = row.querySelector('.amount-paid');
            const balanceCell = row.querySelector('.balance');

            row.classList.remove('row-paid', 'row-partial', 'row-excused');
            if (newStatus === 'Paid') row.classList.add('row-paid');
            else if (newStatus === 'Partial') row.classList.add('row-partial');

            checkbox.classList.remove('status-paid', 'status-partial', 'status-unpaid', 'status-excused', 'no-revoke');
            checkbox.dataset.status = newStatus.toLowerCase();
            
            if (newStatus === 'Paid') {
                checkbox.classList.add('status-paid', 'no-revoke');
                checkbox.title = 'Payment completed';
                checkbox.onclick = null;
            } else if (newStatus === 'Partial') {
                checkbox.classList.add('status-partial');
                checkbox.title = 'Click to complete payment';
            } else {
                checkbox.classList.add('status-unpaid');
                checkbox.title = 'Click to mark as paid';
            }
            checkbox.dataset.balance = balance;

            if (newStatus === 'Paid') {
                statusBadge.className = 'status-badge status-paid';
                statusBadge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Paid';
            } else if (newStatus === 'Partial') {
                statusBadge.className = 'status-badge status-partial';
                statusBadge.innerHTML = '<i class="bi bi-pie-chart-fill"></i> Partial';
            } else {
                statusBadge.className = 'status-badge status-unpaid';
                statusBadge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Unpaid';
            }

            amountPaidCell.textContent = '₱' + amountPaid.toFixed(2);
            balanceCell.textContent = '₱' + balance.toFixed(2);
            balanceCell.style.color = balance > 0 ? '#ef4444' : '#10b981';
            row.dataset.status = newStatus.toLowerCase();
            row.dataset.paid = amountPaid;
            row.dataset.balance = balance;

            // Update action button
            const actionCell = row.querySelector('td:last-child');
            if (newStatus === 'Paid') {
                actionCell.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill"></i></span>';
            }
        }

        function showToast(type, message) {
            const bgClass = type === 'success' ? 'success' : (type === 'info' ? 'info' : 'danger');
            const icon = type === 'success' ? 'check-circle' : (type === 'info' ? 'info-circle' : 'exclamation-circle');
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${bgClass} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-${icon} me-2"></i>${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }
    </script>
    <script src="~/js/officer-fines.js" asp-append-version="true"></script>
}
