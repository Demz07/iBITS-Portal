@* FILE PATH: Views/Officer/BatchManagement.cshtml *@
@model Tuple<List<iBITS_Portal.ViewModels.FeeBatchViewModel>, List<iBITS_Portal.ViewModels.FineBatchViewModel>>

@{
    ViewData["Title"] = "Batch Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var feeBatches = Model.Item1;
    var fineBatches = Model.Item2;
}

@section Styles {
    <link rel="stylesheet" href="~/css/officer-treasury.css" asp-append-version="true" />
    <style>
        .management-container {
            display: flex;
            gap: 1.5rem;
            height: calc(100vh - 180px); /* Adjust based on your header/footer height */
        }

        .master-panel {
            flex: 0 0 400px;
            overflow-y: auto;
            padding-right: 10px;
        }

        .detail-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .detail-panel-content {
            flex: 1;
            overflow-y: auto;
            padding: 5px;
        }

        .batch-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .batch-card:hover {
                background: rgba(255, 255, 255, 0.06);
                border-color: rgba(212, 175, 55, 0.4);
            }

            .batch-card.active {
                background: rgba(212, 175, 55, 0.1);
                border-color: var(--gold-primary);
            }

        .detail-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            text-align: center;
            color: rgba(255,255,255,0.3);
        }

            .detail-placeholder i {
                font-size: 4rem;
                color: rgba(212, 175, 55, 0.2);
                margin-bottom: 1rem;
            }

        .detail-header {
            border-bottom: 1px solid rgba(212, 175, 55, 0.2);
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
        }

        .progress-bar-custom {
            height: 8px;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
        }

            .progress-bar-custom .progress {
                height: 100%;
                background: linear-gradient(90deg, #10b981, #34d399);
                border-radius: 4px;
            }

        .student-table-container {
            max-height: 400px; /* Or adjust as needed */
            overflow-y: auto;
        }

        .btn-action-delete {
            background: rgba(239, 68, 68, 0.1); /* Subtle red background */
            color: #ef4444; /* Bright Red Text */
            font-weight: 600;
            border: 2px solid #ef4444; /* Solid Red Border */
            padding: 6px 16px;
            border-radius: 8px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-action-delete:hover {
                background: #ef4444; /* Solid Red on Hover */
                color: #ffffff; /* White Text on Hover */
                box-shadow: 0 0 20px rgba(239, 68, 68, 0.5); /* Red Glow */
                transform: translateY(-2px);
            }

            .btn-action-delete i {
                font-size: 1.1em;
            }

    </style>

    <style>
        /* High Visibility Delete Button Styles */
        .btn-danger-glow {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            font-weight: 800;
            letter-spacing: 0.5px;
            border: none;
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            text-transform: uppercase;
            padding: 12px 24px;
            border-radius: 8px;
        }

            .btn-danger-glow:hover:not(:disabled) {
                background: linear-gradient(135deg, #dc2626, #b91c1c);
                transform: translateY(-2px) scale(1.02);
                box-shadow: 0 8px 25px rgba(239, 68, 68, 0.6);
                color: white;
            }

            .btn-danger-glow:disabled {
                background: #4a1d1d;
                color: #999;
                cursor: not-allowed;
                box-shadow: none;
                opacity: 0.7;
            }
    </style>>

}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;">
            <i class="bi bi-pencil-square me-2"></i> Batch Management
        </h3>
        <p class="text-muted small mb-0">Edit or permanently delete fee & fine batches for unpaid students.</p>
    </div>
</div>

<!-- TABS -->
<div class="glass-panel p-4">
    <ul class="nav nav-tabs glass-tabs mb-4" id="managementTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="fees-tab" data-bs-toggle="tab" data-bs-target="#fees-panel" type="button" role="tab">
                <i class="bi bi-cash-stack me-2"></i> Fee Batches (@feeBatches.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="fines-tab" data-bs-toggle="tab" data-bs-target="#fines-panel" type="button" role="tab">
                <i class="bi bi-exclamation-triangle me-2"></i> Fine Batches (@fineBatches.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="myTabContent">
        <!-- FEE BATCHES PANEL -->
        <div class="tab-pane fade show active" id="fees-panel" role="tabpanel">
            <div class="management-container">
                <!-- Master Panel (Left) -->
                <div class="master-panel">
                    <input type="text" id="fee-search" class="form-control form-control-sm mb-3" placeholder="Search fee batches...">
                    <div id="fee-batch-list">
                        @foreach (var batch in feeBatches)
                        {
                            <div class="batch-card" data-batch-id="@batch.BatchId" data-batch-name="@batch.FeeName" data-batch-type="fee">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h6 class="text-white fw-bold mb-1">@batch.FeeName</h6>
                                    <span class="badge bg-primary">Fee</span>
                                </div>
                                <small class="text-muted d-block mb-2">Created: @batch.DateCreated?.ToString("MMM dd, yyyy")</small>
                                <div class="d-flex justify-content-between align-items-center text-muted small mb-1">
                                    <span>Students: @batch.StudentCount</span>
                                    <span>Collected: @batch.CollectionRate%</span>
                                </div>
                                <div class="progress-bar-custom">
                                    <div class="progress" style="width: @batch.CollectionRate%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Detail Panel (Right) -->
                <div class="detail-panel glass-panel p-4">
                    <div id="fee-detail-view">
                        <div class="detail-placeholder">
                            <i class="bi bi-list-ul"></i>
                            <h5 class="fw-bold">Select a Fee Batch</h5>
                            <p>Choose a batch from the left to view details and manage it.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FINE BATCHES PANEL -->
        <div class="tab-pane fade" id="fines-panel" role="tabpanel">
            <div class="management-container">
                <!-- Master Panel (Left) -->
                <div class="master-panel">
                    <input type="text" id="fine-search" class="form-control form-control-sm mb-3" placeholder="Search fine batches...">
                    <div id="fine-batch-list">
                        @foreach (var batch in fineBatches)
                        {
                            <div class="batch-card" data-batch-id="@batch.BatchId" data-batch-name="@batch.FineReason" data-batch-type="fine">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h6 class="text-white fw-bold mb-1">@batch.FineReason</h6>
                                    <span class="badge bg-danger">Fine</span>
                                </div>
                                <small class="text-muted d-block mb-2">Students: @batch.StudentCount</small>
                                <div class="d-flex justify-content-between align-items-center text-muted small mb-1">
                                    <span>Total: ₱@batch.TotalExpected.ToString("N2")</span>
                                    <span>Collected: @batch.CollectionRate%</span>
                                </div>
                                <div class="progress-bar-custom">
                                    <div class="progress" style="width: @batch.CollectionRate%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Detail Panel (Right) -->
                <div class="detail-panel glass-panel p-4">
                    <div id="fine-detail-view">
                        <div class="detail-placeholder">
                            <i class="bi bi-list-ul"></i>
                            <h5 class="fw-bold">Select a Fine Batch</h5>
                            <p>Choose a batch from the left to view details and manage it.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- EDIT BATCH MODAL -->
<div class="modal fade" id="editBatchModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title text-gold"><i class="bi bi-pencil-fill me-2"></i> Edit Batch</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateBatch" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editBatchId" name="batchId" />
                <input type="hidden" id="editBatchType" name="type" />
                <div class="modal-body">
                    <div class="alert alert-warning small"><i class="bi bi-exclamation-triangle me-2"></i>Changes will only apply to <strong>unpaid</strong> and <strong>unremitted</strong> students in this batch.</div>
                    <h6 class="text-white">Editing Batch: <strong id="editBatchName"></strong></h6>
                    <hr class="border-secondary my-3" />
                    <div class="mb-3">
                        <label class="form-label">New Amount (₱)</label>
                        <input type="number" step="0.01" min="0.01" name="newAmount" class="form-control" required />
                    </div>
                    <div>
                        <label class="form-label">New Due Date</label>
                        <input type="date" name="newDueDate" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DELETE BATCH MODAL -->
<div class="modal fade" id="deleteBatchModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal" style="border: 1px solid #ef4444; box-shadow: 0 0 20px rgba(239, 68, 68, 0.2);">
            <div class="modal-header" style="background: linear-gradient(135deg, #ef4444, #7f1d1d); border-bottom: 1px solid rgba(255,255,255,0.1);">
                <h5 class="modal-title text-white"><i class="bi bi-shield-lock-fill me-2"></i> Security Verification</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="DeleteBatch" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteBatchId" name="batchId" />
                <input type="hidden" id="deleteBatchType" name="type" />
                <div class="modal-body text-center p-4">

                    <div class="mb-4">
                        <div style="width: 80px; height: 80px; background: rgba(239, 68, 68, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                            <i class="bi bi-trash3-fill text-danger" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>

                    <h5 class="text-white fw-bold mb-3">Delete Batch Permanently?</h5>

                    <div class="alert alert-danger text-start small" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #fca5a5;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        This will delete <strong id="deleteBatchName" class="text-white"></strong> and all its unpaid records. <strong>This action cannot be undone.</strong>
                    </div>

                    <div class="mt-4 text-start">
                        <label for="password" class="form-label text-muted small text-uppercase fw-bold">Enter Org Treasurer Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-secondary text-danger"><i class="bi bi-key-fill"></i></span>
                            <input type="password" class="form-control border-secondary text-white"
                                   id="deletePassword" name="password"
                                   placeholder="Type your password to confirm" required
                                   oninput="toggleDeleteButton()" style="background: rgba(0,0,0,0.2) !important;">
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center border-0 pb-4">
                    <button type="button" class="btn btn-glass px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger-glow px-4" id="confirmDeleteBtn" disabled>
                        <i class="bi bi-trash-fill me-2"></i> CONFIRM DELETION
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/js/batch-management.js" asp-append-version="true"></script>
}