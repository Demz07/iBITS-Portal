@* FILE PATH: Views/Officer/InitiateRemittance.cshtml *@
@* CLASS TREASURER - Confirm remittance submission (Fees & Fines) *@
@model dynamic
@using iBITS_Portal.Models
@{
    ViewData["Title"] = "Initiate Remittance";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var feeName = ViewBag.FeeName as string ?? "Unknown";
    var currentSection = ViewBag.Section as string ?? "N/A";
    var totalAmount = ViewBag.TotalAmount as decimal? ?? 0;
    var totalStudents = ViewBag.TotalStudents as int? ?? 0;
    var treasurerName = ViewBag.TreasurerName as string ?? "Class Treasurer";
    var type = ViewBag.Type as string ?? "fee";
    var isFine = type == "fine";
    
    // Cast model to appropriate type
    var fees = !isFine ? (Model as IEnumerable<Fee>)?.ToList() ?? new List<Fee>() : new List<Fee>();
    var fines = isFine ? (Model as IEnumerable<Fine>)?.ToList() ?? new List<Fine>() : new List<Fine>();
}

<link rel="stylesheet" href="~/css/officer-treasury.css" asp-append-version="true" />

@section Styles{
<style>
    .remittance-summary {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.05));
        border: 2px solid rgba(16, 185, 129, 0.4);
        border-radius: 16px;
        padding: 2rem;
    }
    .warning-box {
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.4);
        border-radius: 10px;
        padding: 1rem;
    }
    .student-list-item {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.5rem;
    }
    .btn-confirm-remit {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.3s ease;
    }
    .btn-confirm-remit:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.5);
        color: white;
    }
    .checkmark-icon {
        width: 80px;
        height: 80px;
        background: rgba(16, 185, 129, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }
    .checkmark-icon i {
        font-size: 2.5rem;
        color: #10b981;
    }
</style>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-send-check me-2"></i> Confirm @(isFine ? "Fine" : "Fee") Remittance
        </h3>
        <p class="text-muted small mb-0">Review and submit this @(isFine ? "fine" : "fee") remittance to the Org Treasurer</p>
    </div>
    <a asp-action="PendingCollections" asp-route-type="@(isFine ? "fines" : null)" class="btn btn-outline-light btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<!-- REMITTANCE SUMMARY -->
<div class="remittance-summary mb-4">
    <div class="text-center mb-4">
        <div class="checkmark-icon">
            <i class="bi bi-send-check-fill"></i>
        </div>
        <h4 class="text-white mb-1">Ready to Remit</h4>
        <p class="text-muted">Section @currentSection • @feeName</p>
    </div>
    
    <div class="row text-center mb-4">
        <div class="col-md-4">
            <div class="fs-4 fw-bold" style="color: var(--gold-primary);">₱@totalAmount.ToString("N2")</div>
            <small class="text-muted">Total Amount</small>
        </div>
        <div class="col-md-4">
            <div class="fs-4 fw-bold text-white">@totalStudents</div>
            <small class="text-muted">Students Paid</small>
        </div>
        <div class="col-md-4">
            <div class="fs-4 fw-bold text-info">@PhTime.Now.ToString("MMM dd, yyyy")</div>
            <small class="text-muted">Submission Date</small>
        </div>
    </div>
    
    <!-- Warning Box -->
    <div class="warning-box mb-4">
        <div class="d-flex">
            <i class="bi bi-exclamation-triangle-fill text-warning me-3 fs-4"></i>
            <div>
                <strong class="text-warning">Important:</strong>
                <p class="text-muted mb-0 small">
                    Once submitted, you will <strong>no longer be able to edit or revoke</strong> these payments.
                    The remittance will be sent to the Org Treasurer for validation. The official payment date
                    will be set when the Org Treasurer validates this remittance.
                </p>
            </div>
        </div>
    </div>
    
    <!-- Confirm Button -->
    <form asp-action="ConfirmRemittance" method="post" class="text-center" id="remittanceForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="feeName" value="@feeName" />
        <input type="hidden" name="type" value="@type" />
        <button type="button" class="btn btn-confirm-remit" data-bs-toggle="modal" data-bs-target="#confirmRemittanceModal">
            <i class="bi bi-send-fill me-2"></i> Submit @(isFine ? "Fine" : "Fee") Remittance to Org Treasurer
        </button>
        <p class="text-muted small mt-2 mb-0">Submitted by: @treasurerName</p>
    </form>
</div>

<!-- STUDENT LIST -->
<div class="glass-panel p-4">
    <h5 class="text-white mb-3"><i class="bi bi-people me-2"></i> Included Payments (@totalStudents)</h5>
    
    <div class="row">
        @if (isFine)
        {
            @foreach (var fine in fines.OrderBy(f => f.StudentNumNavigation?.StudentLn))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="student-list-item d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white fw-semibold">@fine.StudentNumNavigation?.FullName</div>
                            <small class="text-muted">@fine.StudentNum</small>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold" style="color: var(--gold-primary);">₱@((fine.Amount ?? 0).ToString("N2"))</div>
                            <small class="text-muted">@(fine.CollectionDate?.ToString("MM/dd/yyyy") ?? "")</small>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            @foreach (var fee in fees.OrderBy(f => f.StudentNumNavigation?.StudentLn))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="student-list-item d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white fw-semibold">@fee.StudentNumNavigation?.FullName</div>
                            <small class="text-muted">@fee.StudentNum</small>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold" style="color: var(--gold-primary);">₱@((fee.Amount ?? 0).ToString("N2"))</div>
                            <small class="text-muted">@(fee.CollectionDate?.ToString("MM/dd/yyyy") ?? "")</small>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- CUSTOM CONFIRMATION MODAL -->
<div class="modal fade" id="confirmRemittanceModal" tabindex="-1" aria-labelledby="confirmRemittanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: linear-gradient(135deg, #1a1a2e, #16213e); border: 2px solid rgba(212, 175, 55, 0.3);">
            <div class="modal-header border-0">
                <h5 class="modal-title text-white fw-bold" id="confirmRemittanceModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                    Confirm @(isFine ? "Fine" : "Fee") Remittance Submission
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <div class="warning-icon-large mb-3">
                        <i class="bi bi-send-check-fill" style="font-size: 4rem; color: var(--gold-primary);"></i>
                    </div>
                    <h5 class="text-white mb-3">Are you absolutely sure?</h5>
                    <p class="text-muted mb-3">
                        You are about to submit the following remittance to the Org Treasurer:
                    </p>
                </div>
                
                <!-- Summary Box -->
                <div class="p-3 mb-3" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 10px;">
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="fw-bold text-white">@feeName</div>
                            <small class="text-muted">Category</small>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold" style="color: var(--gold-primary);">₱@totalAmount.ToString("N2")</div>
                            <small class="text-muted">Total Amount</small>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold text-info">@totalStudents</div>
                            <small class="text-muted">Students</small>
                        </div>
                    </div>
                </div>
                
                <!-- Warning Message -->
                <div class="alert alert-warning mb-0" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.4);">
                    <div class="d-flex">
                        <i class="bi bi-shield-exclamation me-2 mt-1"></i>
                        <div>
                            <strong>This action cannot be undone!</strong>
                            <ul class="mb-0 mt-2 small">
                                <li>You will no longer be able to edit or revoke these payments</li>
                                <li>The remittance will be sent to Org Treasurer for validation</li>
                                <li>Official payment date will be set upon validation</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-success" id="confirmSubmitBtn" style="background: linear-gradient(135deg, #10b981, #059669); border: none; padding: 10px 24px;">
                    <i class="bi bi-send-check-fill me-1"></i> Yes, Submit Remittance
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Handle modal confirmation
    document.getElementById('confirmSubmitBtn')?.addEventListener('click', function() {
        // Close modal
        var modal = bootstrap.Modal.getInstance(document.getElementById('confirmRemittanceModal'));
        modal.hide();
        
        // Submit the form
        document.getElementById('remittanceForm').submit();
    });
</script>
}

