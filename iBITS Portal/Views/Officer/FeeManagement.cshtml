@{
    ViewData["Title"] = "Fee & Fine Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var feeTypes = ViewBag.FeeTypes as List<string> ?? new List<string>();
}

@section Styles {
    <style>
        .fee-item {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .fee-name {
            color: var(--text-strong);
            font-weight: 600;
        }
    </style>
}

<!-- TempData for feedback messages -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- ======================= HEADER ======================= -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="glass-header-title"><i class="bi bi-sliders me-2 text-gold"></i> Fee & Fine Management</h4>
        <p class="mb-0 small text-muted">Create new organization-wide fees and manage fine policies.</p>
    </div>
    <button class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#createFeeModal">
        <i class="bi bi-plus-lg"></i> Create New Fee
    </button>
</div>

<div class="row g-4">
    <!-- LEFT COLUMN: EXISTING FEES -->
    <div class="col-md-7">
        <div class="glass-panel h-100">
            <h5 class="glass-header-title mb-3"><i class="bi bi-list-ul me-2"></i> Existing Fee Types</h5>
            @if (feeTypes.Any())
            {
                foreach (var feeName in feeTypes)
                {
                    <div class="fee-item">
                        <span class="fee-name">@feeName</span>
                        <button class="btn btn-sm btn-outline-secondary disabled">Manage</button>
                    </div>
                }
            }
            else
            {
                <p class="text-muted text-center py-4">No fee types have been created yet.</p>
            }
        </div>
    </div>

    <!-- RIGHT COLUMN: FINE SETTINGS (PLACEHOLDER) -->
    <div class="col-md-5">
        <div class="glass-panel h-100">
            <h5 class="glass-header-title mb-3"><i class="bi bi-exclamation-octagon-fill me-2"></i> Fine Settings</h5>
            <div class="mb-3">
                <label class="form-label">Default Fine Amount for Absences</label>
                <div class="input-group"><span class="input-group-text">₱</span><input type="number" class="form-control" value="20.00" disabled></div>
            </div>
            <button class="btn btn-primary w-100 disabled">Update Fine Amount</button>
            <small class="text-muted d-block mt-2 text-center">(Functionality to be implemented)</small>
        </div>
    </div>
</div>


<!-- ======================= MODAL: CREATE NEW FEE (NOW FUNCTIONAL) ======================= -->
<div class="modal fade" id="createFeeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <!-- The form now points to the new action -->
            <form asp-controller="Officer" asp-action="CreateOrganizationFee" method="post" id="createFeeForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title text-gold"><i class="bi bi-cash-stack me-2"></i> Create Organization-Wide Fee</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning small">
                        This action will generate a new fee record for <strong>every active student</strong> in the organization. This cannot be undone.
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fee Name</label>
                        <input type="text" class="form-control" name="feeName" placeholder="e.g., Organization T-Shirt Fee" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input type="number" step="0.01" class="form-control" name="amount" placeholder="e.g., 350.00" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Due Date</label>
                        <input type="date" class="form-control" name="dueDate" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <!-- The button is now enabled and linked to the form -->
                    <button type="submit" class="btn btn-gold">Confirm & Create</button>
                </div>
            </form>
        </div>
    </div>
</div>