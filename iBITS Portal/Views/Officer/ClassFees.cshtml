@* FILE PATH: Views/Officer/ClassFees.cshtml *@
@* CLASS TREASURER - FEES MANAGEMENT (Full Payment Only + Remittance) *@
@model IEnumerable<iBITS_Portal.Models.Fee>
@using iBITS_Portal.Models
@{
    ViewData["Title"] = $"{ViewBag.Section} Fees Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var sectionName = ViewBag.Section as string ?? "N/A";
    var programName = ViewBag.Program as string ?? "N/A";
    var allFees = Model?.ToList() ?? new List<iBITS_Portal.Models.Fee>();
    var totalExp = ViewBag.TotalExpected ?? 0m;
    var totalCol = ViewBag.TotalCollected ?? 0m;
    var totalPending = ViewBag.TotalPending ?? 0m;
    
    // Group fees by FeeName for remittance
    var feesByCategory = allFees.GroupBy(f => f.FeeName ?? "Other").OrderBy(g => g.Key).ToList();
    
    // Count collected but not remitted (ready for remittance)
    var pendingRemittanceCount = allFees.Count(f => f.FeeStatus?.ToUpper() == "PAID" && f.RemittanceStatus == FeeRemittanceStatus.NotRemitted);
    var pendingRemittanceAmount = allFees.Where(f => f.FeeStatus?.ToUpper() == "PAID" && f.RemittanceStatus == FeeRemittanceStatus.NotRemitted).Sum(f => f.Amount ?? 0);
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/officer-treasury.css" asp-append-version="true" />

@section Styles {
    <style>
        .chart-no-data {
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            min-height: 250px;
            color: rgba(255, 255, 255, 0.4);
            text-align: center;
        }

            .chart-no-data i {
                font-size: 4rem;
                margin-bottom: 1rem;
                color: rgba(212, 175, 55, 0.2);
            }

            .chart-no-data p {
                font-size: 1.1rem;
                font-weight: 600;
                margin: 0;
            }

        .summary-card {
            height: 100%;
            min-height: 110px;
        }

            .summary-card.total {
                border-left: 4px solid #06b6d4;
            }

            .summary-card.collected {
                border-left: 4px solid #22c55e;
            }

            .summary-card.pending {
                border-left: 4px solid #ef4444;
            }

        .section-badge {
            background: linear-gradient(135deg, var(--gold-primary), #b8860b);
            color: #000;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.85rem;
        }

        /* Remittance Styles */
        .btn-remit {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-remit:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);
                color: white;
            }

            .btn-remit:disabled {
                background: rgba(107, 114, 128, 0.3);
                cursor: not-allowed;
                transform: none;
                box-shadow: none;
            }

        .btn-mark-paid {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .btn-mark-paid:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
                color: white;
            }

            .btn-mark-paid:disabled {
                background: rgba(107, 114, 128, 0.3);
                cursor: not-allowed;
            }

        .btn-revoke {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
        }

            .btn-revoke:hover {
                box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
                color: white;
            }

        /* Status badges */
        .remittance-status {
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.7rem;
            font-weight: 600;
        }

            .remittance-status.not-remitted {
                background: rgba(107, 114, 128, 0.2);
                color: #9ca3af;
            }

            .remittance-status.collected {
                background: rgba(16, 185, 129, 0.2);
                color: #34d399;
            }

            .remittance-status.pending-remit {
                background: rgba(245, 158, 11, 0.2);
                color: #fbbf24;
            }

            .remittance-status.remitted {
                background: rgba(139, 92, 246, 0.2);
                color: #a78bfa;
            }

        /* Fee category card */
        .fee-category-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .fee-category-header {
            background: rgba(212, 175, 55, 0.08);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 1rem 1.25rem;
        }

        .fee-category-body {
            padding: 0;
        }

        /* Locked State Styling (Purple Glow) */
        .border-purple {
            border: 1px solid #8b5cf6 !important;
            box-shadow: 0 0 15px rgba(139, 92, 246, 0.15);
        }

        .bg-purple {
            background-color: #8b5cf6 !important;
            color: white;
        }

        /* Lock indicator */
        .lock-indicator {
            color: #a78bfa;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .row-locked {
            opacity: 0.6;
            background: rgba(139, 92, 246, 0.05);
            pointer-events: none;
        }

        /* Quick stats bar */
        .quick-stats {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(139, 92, 246, 0.05));
            border: 1px solid rgba(139, 92, 246, 0.3);
            border-radius: 10px;
            padding: 1rem;
        }
    </style>
}

@Html.AntiForgeryToken()

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;">
            <i class="bi bi-cash-stack me-2"></i> Class Fees Management
            <span class="section-badge ms-2">@sectionName</span>
        </h3>
        <p class="text-muted small mb-0">Collect FULL payments from your classmates in @programName - @sectionName (No partial payments)</p>
    </div>
    <div>
        <a asp-action="ClassTreasuryDashboard" class="btn btn-outline-light btn-sm me-2">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
        <a asp-action="PendingCollections" class="btn btn-outline-warning btn-sm me-2">
            <i class="bi bi-collection me-1"></i> Pending Collections
            @if (pendingRemittanceCount > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@pendingRemittanceCount</span>
            }
        </a>
        <a asp-action="RemittanceHistory" class="btn btn-outline-info btn-sm">
            <i class="bi bi-clock-history me-1"></i> Remittance History
        </a>
    </div>
</div>

<!-- QUICK REMITTANCE STATS -->
@if (pendingRemittanceCount > 0)
{
    <div class="quick-stats mb-4 d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-piggy-bank me-2 text-purple"></i>
            <strong class="text-white">@pendingRemittanceCount payment(s)</strong>
            <span class="text-muted">ready for remittance</span>
            <span class="text-white fw-bold ms-2">(₱@pendingRemittanceAmount.ToString("N2"))</span>
        </div>
        <a asp-action="PendingCollections" class="btn btn-remit btn-sm">
            <i class="bi bi-send me-1"></i> Review & Remit to Org Treasurer
        </a>
    </div>
}

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #f59e0b; background: rgba(245, 158, 11, 0.2); color: #fbbf24;">
        <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FINANCIAL OVERVIEW -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> @sectionName Financial Overview
    </h5>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Expected -->
        <div class="col-md-4">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(6, 182, 212, 0.15); color: #06b6d4; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Paid -->
        <div class="col-md-4">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(34, 197, 94, 0.15); color: #22c55e; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Paid</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unpaid -->
        <div class="col-md-4">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(239, 68, 68, 0.155); color: #ef4444; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPendingCard">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Unpaid</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pie Charts -->
    <div class="row g-4">
        <!-- Collected Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Collected by Fee Type</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="collectedChart"></canvas>
                    <div id="collectedNoData" class="chart-no-data">
                        <i class="bi bi-inbox-fill"></i>
                        <p>No Payments Collected Yet</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pending Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart me-2"></i>Pending by Fee Type</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="pendingChart"></canvas>
                    <div id="pendingNoData" class="chart-no-data">
                        <i class="bi bi-check2-all"></i>
                        <p>No Pending Fees</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTERS SECTION -->
<div class="glass-panel p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-funnel me-2"></i> Filters
        </h5>
        <button class="btn btn-sm btn-outline-secondary" id="clearFiltersBtn">
            <i class="bi bi-x-circle me-1"></i> Clear Filters
        </button>
    </div>

    <div class="row g-3">
        <!-- Search Filter -->
        <div class="col-md-4">
            <label class="form-label small text-muted">Search Student</label>
            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Student Name or ID...">
        </div>

        <!-- Fee Name Filter -->
        <div class="col-md-4">
            <label class="form-label small text-muted">Fee Name</label>
            <select id="filterFeeName" class="form-select form-select-sm">
                <option value="">All Fees</option>
                @if (ViewBag.FeeNames != null)
                {
                    foreach (var name in ViewBag.FeeNames)
                    {
                        <option value="@name">@name</option>
                    }
                }
            </select>
        </div>

        <!-- Status Filter -->
        <div class="col-md-4">
            <label class="form-label small text-muted">Status</label>
            <select id="filterStatus" class="form-select form-select-sm">
                <option value="">All Status</option>
                <option value="paid">Paid</option>
                <option value="unpaid">Pending/Unpaid</option>
            </select>
        </div>
    </div>
</div>

<!-- FEE RECORDS BY CATEGORY -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 style="color: var(--text-strong); margin: 0; font-weight: 700;">
            <i class="bi bi-list-check me-2"></i> Fee Records - @sectionName
        </h5>
        <div>
            <button onclick="exportClassFeesData()" class="btn-gold-outline btn-sm">
                <i class="bi bi-download me-1"></i> Export Filtered Data
            </button>
        </div>
    </div>

    @if (feesByCategory.Any())
    {
        @foreach (var category in feesByCategory)
        {
            var categoryName = category.Key;
            var categoryFees = category.ToList();
            var categoryTotal = categoryFees.Sum(f => f.Amount ?? 0);
            var categoryPaid = categoryFees.Count(f => f.FeeStatus?.ToUpper() == "PAID");
            var categoryUnpaid = categoryFees.Count(f => f.FeeStatus?.ToUpper() != "PAID");
            var categoryCollectedNotRemitted = categoryFees.Count(f => f.FeeStatus?.ToUpper() == "PAID" && f.RemittanceStatus == FeeRemittanceStatus.NotRemitted);
            var categoryRemitted = categoryFees.Count(f => f.RemittanceStatus == FeeRemittanceStatus.Remitted);
            
            // Check if this category is validated (closed)
            var validatedCategories = ViewBag.ValidatedCategories as List<string> ?? new List<string>();
            var isClosed = validatedCategories.Contains(categoryName);
            
            // Check if there's already a pending remittance for this category
            var pendingRemittances = ViewBag.PendingRemittances as List<string> ?? new List<string>();
            var hasPendingRemittance = pendingRemittances.Contains(categoryName);
            
            // Can only remit if: has collected fees, not closed, and no pending remittance
            var canRemit = categoryCollectedNotRemitted > 0 && !isClosed && !hasPendingRemittance;

            <div class="fee-category-card @(isClosed ? "border-purple" : "")">
                <!-- Category Header -->
                <div class="fee-category-header d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white mb-1 fw-bold">
                            @categoryName
                            @if (isClosed)
                            {
                                <span class="badge bg-purple ms-2"><i class="bi bi-lock-fill me-1"></i> CLOSED - Validated</span>
                            }
                        </h6>
                        <small class="text-muted">
                            @categoryFees.Count students • ₱@((categoryFees.FirstOrDefault()?.Amount ?? 0).ToString("N2")) each
                            <span class="mx-2">|</span>
                            <span class="text-success">@categoryPaid Paid</span> •
                            <span class="text-warning">@categoryUnpaid Unpaid</span>
                            @if (categoryRemitted > 0 || (isClosed && categoryPaid > 0))
                            {
                                <span class="mx-1">•</span>
                                <span class="text-purple">@(isClosed? categoryPaid : categoryRemitted) Remitted</span>
                            }
                        </small>
                    </div>
                    <div>
                        @if (isClosed)
                        {
                            <span class="badge bg-purple"><i class="bi bi-lock-fill me-1"></i> Category Closed</span>
                        }
                        else if (hasPendingRemittance)
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Pending Validation</span>
                        }
                        else if (canRemit)
                        {
                            <a asp-action="InitiateRemittance" asp-route-feeName="@categoryName" class="btn btn-remit btn-sm">
                                <i class="bi bi-send me-1"></i> Remit @categoryCollectedNotRemitted to Org
                            </a>
                        }
                        else if (categoryRemitted == categoryFees.Count)
                        {
                            <span class="badge" style="background: rgba(139, 92, 246, 0.2); color: #a78bfa;"><i class="bi bi-check-all me-1"></i> All Remitted</span>
                        }
                    </div>
                </div>

                <!-- Bulk Actions Toolbar -->
                <div class="bulk-actions-toolbar" style="display: none; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 8px; padding: 12px; margin-bottom: 15px;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white fw-bold"><span id="selectedCount-@categoryName.Replace(" ", "-")">0</span> selected</span>
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-success me-2 bulk-mark-paid" data-category="@categoryName">
                                <i class="bi bi-check-circle me-1"></i> Mark as Paid
                            </button>
                            <button type="button" class="btn btn-sm btn-warning bulk-revoke" data-category="@categoryName">
                                <i class="bi bi-x-circle me-1"></i> Revoke
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Category Table -->
                <div class="fee-category-body">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0" style="background: transparent;" data-category-table="@categoryName">
                            <thead>
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                                    <th style="width: 40px; color: var(--gold-primary);">
                                        <input type="checkbox" class="form-check-input select-all-category" data-category="@categoryName" title="Select All">
                                    </th>
                                    <th style="width: 40px; color: var(--gold-primary);">#</th>
                                    <th style="color: var(--gold-primary);">Student</th>
                                    <th style="color: var(--gold-primary);">Program</th>
                                    <th style="color: var(--gold-primary);">Year & Section</th>
                                    <th style="color: var(--gold-primary);">Amount</th>
                                    <th style="color: var(--gold-primary);">Payment Status</th>
                                    <th style="color: var(--gold-primary);">Remittance</th>
                                    <th style="color: var(--gold-primary); width: 150px;" class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var rowNum = 1;
                                }
                                @foreach (var fee in categoryFees.OrderBy(f => f.StudentNumNavigation?.StudentLn))
                                {
                                    var student = fee.StudentNumNavigation;
                                    var isPaid = fee.FeeStatus?.ToUpper() == "PAID";
                                    var isLocked = fee.RemittanceStatus != FeeRemittanceStatus.NotRemitted || isClosed || hasPendingRemittance;
                                    var isRemitted = fee.RemittanceStatus == FeeRemittanceStatus.Remitted;
                                    var isPendingRemit = fee.RemittanceStatus == FeeRemittanceStatus.PendingRemittance;
                                    var rowClass = isLocked ? "row-locked" : "";

                                    <tr class="@rowClass fee-row" 
                                        data-fee-id="@fee.FeeId" 
                                        data-fee-name="@(fee.FeeName ?? "")" 
                                        data-student-name="@(student?.FullName ?? "")" 
                                        data-student-id="@fee.StudentNum" 
                                        data-status="@(isPaid ? "paid" : "unpaid")"
                                        data-is-locked="@isLocked.ToString().ToLower()"
                                        data-category="@categoryName">
                                        
                                        <td>
                                            @if (!isLocked)
                                            {
                                                <input type="checkbox" class="form-check-input fee-checkbox" data-fee-id="@fee.FeeId" data-category="@categoryName">
                                            }
                                            else
                                            {
                                                <i class="bi bi-lock-fill text-muted" title="Remitted - Cannot modify"></i>
                                            }
                                        </td>
                                        <td class="text-muted">@rowNum</td>
                                        <td>
                                            <div class="text-white fw-semibold">@(student?.FullName ?? "Unknown")</div>
                                            <small class="text-muted">@fee.StudentNum</small>
                                        </td>
                                        <td>
                                            <span class="badge" style="background: rgba(59, 130, 246, 0.2); color: #60a5fa; font-size: 0.75rem;">@(student?.Course ?? "N/A")</span>
                                        </td>
                                        <td>
                                            <span class="text-white">@(student?.YearLevelSection ?? "N/A")</span>
                                        </td>
                                        <td class="fw-bold" style="color: var(--gold-primary);">₱@((fee.Amount ?? 0).ToString("N2"))</td>
                                        <td>
                                            @if (isPaid)
                                            {
                                                <span class="status-badge status-paid"><i class="bi bi-check-circle-fill me-1"></i>Paid</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-unpaid"><i class="bi bi-x-circle me-1"></i>Unpaid</span>
                                            }
                                        </td>
                                        <td>
                                            @* UPDATED LOGIC: If Remitted OR (Category Closed AND Paid), show as Remitted *@
                                            @if (isRemitted || (isClosed && isPaid))
                                            {
                                                <span class="remittance-status remitted" style="background: rgba(139, 92, 246, 0.2); color: #a78bfa; padding: 4px 10px; border-radius: 15px; font-size: 0.7rem; font-weight: 600;"><i class="bi bi-lock-fill me-1"></i>Remitted</span>
                                            }
                                            else if (isPendingRemit)
                                            {
                                                <span class="remittance-status pending-remit" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; padding: 4px 10px; border-radius: 15px; font-size: 0.7rem; font-weight: 600;"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                            }
                                            else if (isPaid)
                                            {
                                                <span class="remittance-status collected" style="background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 4px 10px; border-radius: 15px; font-size: 0.7rem; font-weight: 600;"><i class="bi bi-piggy-bank me-1"></i>Collected</span>
                                            }
                                            else
                                            {
                                                <span class="remittance-status not-remitted">-</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (isLocked)
                                            {
                                                <span class="lock-indicator" title="@(hasPendingRemittance ? "Locked - Pending Validation" : "Locked - Category is Closed or Remitted")">
                                                    <i class="bi bi-lock-fill"></i> Locked
                                                </span>
                                            }
                                            else if (isPaid)
                                            {
                                                <button type="button" class="btn btn-revoke btn-sm" onclick="revokeFeePayment(@fee.FeeId, '@student?.FullName?.Replace("'", "\\'")')" title="Revoke payment" style="background: linear-gradient(135deg, #ef4444, #dc2626); color: white; border: none; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600;">
                                                    <i class="bi bi-x-circle me-1"></i> Revoke
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-mark-paid btn-sm" onclick="markFeePaid(@fee.FeeId, '@student?.FullName?.Replace("'", "\\'")', '@categoryName?.Replace("'", "\\'")', @(fee.Amount ?? 0))" title="Mark as fully paid" style="background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600;">
                                                    <i class="bi bi-check-circle me-1"></i> Mark Paid
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                    rowNum++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
            <h5 class="text-white">No Fee Records</h5>
            <p class="text-muted">No fee records found for this section.</p>
        </div>
    }
</div>

<!-- CONFIRM FULL PAYMENT MODAL -->
<div class="modal fade" id="confirmPaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0" style="background: linear-gradient(135deg, #10b981, #059669);">
                <h5 class="modal-title text-white"><i class="bi bi-check-circle me-2"></i> Confirm Full Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div style="width: 80px; height: 80px; background: rgba(16, 185, 129, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                    <i class="bi bi-cash-coin fs-1 text-success"></i>
                </div>
                <p class="text-white mb-3">Mark this fee as <strong>FULLY PAID</strong>?</p>
                <div class="text-start mx-auto" style="max-width: 280px; background: rgba(255,255,255,0.05); padding: 1rem; border-radius: 10px;">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Student:</span>
                        <span class="text-white fw-semibold" id="confirmStudentName"></span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Fee:</span>
                        <span class="text-white" id="confirmFeeName"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Amount:</span>
                        <span class="fw-bold" style="color: var(--gold-primary);">₱<span id="confirmAmount"></span></span>
                    </div>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    <i class="bi bi-info-circle me-1"></i> Payment will be collected. You can revoke before remitting.
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmPayBtn" onclick="executeMarkPaid()">
                    <i class="bi bi-check-circle me-1"></i> Confirm Payment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- CONFIRM REVOKE MODAL -->
<div class="modal fade" id="confirmRevokeModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
                <h5 class="modal-title text-white"><i class="bi bi-x-circle me-2"></i> Revoke Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div style="width: 80px; height: 80px; background: rgba(239, 68, 68, 0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                    <i class="bi bi-x-circle fs-1 text-danger"></i>
                </div>
                <p class="text-white mb-3">Revoke this payment and mark as <strong>UNPAID</strong>?</p>
                <div class="text-start mx-auto" style="max-width: 280px; background: rgba(255,255,255,0.05); padding: 1rem; border-radius: 10px;">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Student:</span>
                        <span class="text-white fw-semibold" id="revokeStudentName"></span>
                    </div>
                </div>
                <p class="text-warning small mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i> This cannot be done after remittance.
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmRevokeBtn" onclick="executeRevoke()">
                    <i class="bi bi-x-circle me-1"></i> Revoke Payment
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Chart data from server
        window.feesChartsData = {
            collected: @Html.Raw(Json.Serialize(ViewBag.CollectedBreakdown ?? new Dictionary<string, decimal>())),
            pending: @Html.Raw(Json.Serialize(ViewBag.PendingBreakdown ?? new Dictionary<string, decimal>()))
        };

        // ============================================================
        // FULL PAYMENT SYSTEM (No Partial Payments)
        // ============================================================
        var currentFeeData = {};

        // Mark Fee as Paid - Open confirmation modal
        function markFeePaid(feeId, studentName, feeName, amount) {
            currentFeeData = { feeId, studentName, feeName, amount };
            document.getElementById('confirmStudentName').textContent = studentName;
            document.getElementById('confirmFeeName').textContent = feeName;
            document.getElementById('confirmAmount').textContent = amount.toFixed(2);
            new bootstrap.Modal(document.getElementById('confirmPaymentModal')).show();
        }

        // Execute Mark as Paid
        async function executeMarkPaid() {
            const btn = document.getElementById('confirmPayBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('feeId', currentFeeData.feeId);
                formData.append('__RequestVerificationToken', token);

                const response = await fetch('/Officer/CollectFeePayment', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('confirmPaymentModal')).hide();
                    showToast('success', result.message);
                    // Reload page to reflect changes
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm Payment';
            }
        }

        // Revoke Payment - Open confirmation modal
        function revokeFeePayment(feeId, studentName) {
            currentFeeData = { feeId, studentName };
            document.getElementById('revokeStudentName').textContent = studentName;
            new bootstrap.Modal(document.getElementById('confirmRevokeModal')).show();
        }

        // Execute Revoke Payment
        async function executeRevoke() {
            const btn = document.getElementById('confirmRevokeBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('feeId', currentFeeData.feeId);
                formData.append('__RequestVerificationToken', token);

                const response = await fetch('/Officer/RevokeFeesCollection', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('confirmRevokeModal')).hide();
                    showToast('success', result.message);
                    // Reload page to reflect changes
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-x-circle me-1"></i> Revoke Payment';
            }
        }

        // Toast notification helper
        function showToast(type, message) {
            const bgClass = type === 'success' ? 'success' : (type === 'info' ? 'info' : 'danger');
            const icon = type === 'success' ? 'check-circle' : (type === 'info' ? 'info-circle' : 'exclamation-circle');
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${bgClass} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-${icon} me-2"></i>${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }

        // ============================================================
        // BULK SELECTION FUNCTIONALITY
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            // Handle Select All checkbox for each category
            document.querySelectorAll('.select-all-category').forEach(selectAll => {
                selectAll.addEventListener('change', function() {
                    const category = this.dataset.category;
                    const table = document.querySelector(`table[data-category-table="${category}"]`);
                    const checkboxes = table.querySelectorAll('.fee-checkbox:not(:disabled)');
                    
                    checkboxes.forEach(cb => {
                        cb.checked = this.checked;
                    });
                    
                    updateBulkToolbar(category);
                });
            });

            // Handle individual checkbox changes
            document.querySelectorAll('.fee-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const category = this.dataset.category;
                    updateBulkToolbar(category);
                    updateSelectAllState(category);
                });
            });

            // Bulk Mark as Paid
            document.querySelectorAll('.bulk-mark-paid').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const category = this.dataset.category;
                    const selectedIds = getSelectedFeeIds(category);
                    
                    if (selectedIds.length === 0) {
                        showToast('warning', 'Please select fees to mark as paid');
                        return;
                    }

                    if (!confirm(`Mark ${selectedIds.length} fee(s) as paid?`)) return;

                    await bulkAction('BulkMarkFeesAsPaid', selectedIds, category);
                });
            });

            // Bulk Revoke
            document.querySelectorAll('.bulk-revoke').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const category = this.dataset.category;
                    const selectedIds = getSelectedFeeIds(category);
                    
                    if (selectedIds.length === 0) {
                        showToast('warning', 'Please select fees to revoke');
                        return;
                    }

                    if (!confirm(`Revoke payment for ${selectedIds.length} fee(s)?`)) return;

                    await bulkAction('BulkRevokeFees', selectedIds, category);
                });
            });
        });

        function getSelectedFeeIds(category) {
            const table = document.querySelector(`table[data-category-table="${category}"]`);
            const selected = [];
            table.querySelectorAll('.fee-checkbox:checked').forEach(cb => {
                selected.push(parseInt(cb.dataset.feeId));
            });
            return selected;
        }

        function updateBulkToolbar(category) {
            const selectedIds = getSelectedFeeIds(category);
            const countSpan = document.getElementById(`selectedCount-${category.replace(/ /g, '-')}`);
            
            if (countSpan) {
                countSpan.textContent = selectedIds.length;
            }

            // Show/hide toolbar based on selection
            const categoryCard = document.querySelector(`table[data-category-table="${category}"]`).closest('.fee-category-card');
            const categoryToolbar = categoryCard.querySelector('.bulk-actions-toolbar');
            
            if (selectedIds.length > 0) {
                categoryToolbar.style.display = 'block';
            } else {
                categoryToolbar.style.display = 'none';
            }
        }

        function updateSelectAllState(category) {
            const table = document.querySelector(`table[data-category-table="${category}"]`);
            const selectAllCheckbox = table.querySelector('.select-all-category');
            const checkboxes = table.querySelectorAll('.fee-checkbox');
            const checkedBoxes = table.querySelectorAll('.fee-checkbox:checked');
            
            if (checkboxes.length === 0) {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.indeterminate = false;
            } else if (checkedBoxes.length === checkboxes.length) {
                selectAllCheckbox.checked = true;
                selectAllCheckbox.indeterminate = false;
            } else if (checkedBoxes.length > 0) {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.indeterminate = true;
            } else {
                selectAllCheckbox.checked = false;
                selectAllCheckbox.indeterminate = false;
            }
        }

        async function bulkAction(action, feeIds, category) {
            try {
                const response = await fetch(`/Officer/${action}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify({ feeIds, category })
                });

                const result = await response.json();

                if (result.success) {
                    showToast('success', result.message);
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An error occurred. Please try again.');
            }
        }

        // ============================================================
        // FILTER AND SEARCH FUNCTIONALITY
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            const filterSearch = document.getElementById('filterSearch');
            const filterFeeName = document.getElementById('filterFeeName');
            const filterStatus = document.getElementById('filterStatus');
            const clearFiltersBtn = document.getElementById('clearFiltersBtn');

            function applyFilters() {
                const searchTerm = filterSearch.value.toLowerCase().trim();
                const selectedFeeName = filterFeeName.value.toLowerCase();
                const selectedStatus = filterStatus.value.toLowerCase();

                const rows = document.querySelectorAll('.fee-row');
                const categoryCards = document.querySelectorAll('.fee-category-card');

                rows.forEach(row => {
                    const studentName = (row.getAttribute('data-student-name') || '').toLowerCase();
                    const studentId = (row.getAttribute('data-student-id') || '').toLowerCase();
                    const feeName = (row.getAttribute('data-fee-name') || '').toLowerCase();
                    const status = (row.getAttribute('data-status') || '').toLowerCase();

                    let show = true;

                    // Search filter (student name or ID)
                    if (searchTerm && !studentName.includes(searchTerm) && !studentId.includes(searchTerm)) {
                        show = false;
                    }

                    // Fee name filter
                    if (selectedFeeName && feeName !== selectedFeeName) {
                        show = false;
                    }

                    // Status filter
                    if (selectedStatus && status !== selectedStatus) {
                        show = false;
                    }

                    row.style.display = show ? '' : 'none';
                });

                // Hide empty category cards
                categoryCards.forEach(card => {
                    const visibleRows = card.querySelectorAll('.fee-row:not([style*="display: none"])');
                    card.style.display = visibleRows.length > 0 ? '' : 'none';
                });
            }

            // Event listeners
            filterSearch.addEventListener('input', applyFilters);
            filterFeeName.addEventListener('change', applyFilters);
            filterStatus.addEventListener('change', applyFilters);

            // Clear filters
            clearFiltersBtn.addEventListener('click', function() {
                filterSearch.value = '';
                filterFeeName.value = '';
                filterStatus.value = '';
                applyFilters();
            });
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        // ============================================================
        // EXPORT CLASS FEES DATA (WYSIWYG)
        // ============================================================
        function exportClassFeesData() {
            const modal = document.createElement('div');
            modal.innerHTML = `
                <div class="modal fade" id="exportClassFeesModal" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content glass-modal" style="background: rgba(30, 30, 30, 0.95); border: 1px solid rgba(212, 175, 55, 0.3);">
                            <div class="modal-header border-0">
                                <h5 class="modal-title text-white"><i class="bi bi-download me-2"></i> Export Class Fees</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted">Choose export format for visible fees:</p>
                                <div class="d-grid gap-2">
                                    <button class="btn btn-success" onclick="exportClassFeesToExcel()">
                                        <i class="bi bi-file-earmark-excel me-2"></i> Export to Excel
                                    </button>
                                    <button class="btn btn-danger" onclick="exportClassFeesToPDF()">
                                        <i class="bi bi-file-earmark-pdf me-2"></i> Export to PDF
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>`;
            document.body.appendChild(modal);
            const exportModal = new bootstrap.Modal(document.getElementById('exportClassFeesModal'));
            exportModal.show();
            document.getElementById('exportClassFeesModal').addEventListener('hidden.bs.modal', () => modal.remove());
        }

        function exportClassFeesToExcel() {
            const visibleRows = document.querySelectorAll('.fee-row:not([style*="display: none"])');
            
            if (visibleRows.length === 0) {
                alert('No visible data to export. Please adjust your filters.');
                bootstrap.Modal.getInstance(document.getElementById('exportClassFeesModal')).hide();
                return;
            }
            
            const data = [
                ['Fee ID', 'Fee Category', 'Student Name', 'Student ID', 'Program', 'Year & Section', 'Amount', 'Payment Status', 'Remittance']
            ];
            
            visibleRows.forEach(row => {
                const feeId = row.dataset.feeId || '';
                const category = row.dataset.category || '';
                const studentName = row.dataset.studentName || '';
                const studentId = row.dataset.studentId || '';
                
                const cells = row.querySelectorAll('td');
                const program = cells[3]?.textContent?.trim() || '';
                const yearSection = cells[4]?.textContent?.trim() || '';
                const amount = cells[5]?.textContent?.trim() || '';
                const status = cells[6]?.textContent?.trim() || '';
                const remittance = cells[7]?.textContent?.trim() || '';
                
                data.push([feeId, category, studentName, studentId, program, yearSection, amount, status, remittance]);
            });
            
            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.aoa_to_sheet(data);
            
            ws['!cols'] = [
                { wch: 10 }, { wch: 20 }, { wch: 25 }, { wch: 20 }, 
                { wch: 10 }, { wch: 15 }, { wch: 12 }, { wch: 12 }, { wch: 12 }
            ];
            
            XLSX.utils.book_append_sheet(wb, ws, 'Class Fees');
            XLSX.writeFile(wb, `ClassFees-${new Date().toISOString().slice(0,10)}.xlsx`);
            
            bootstrap.Modal.getInstance(document.getElementById('exportClassFeesModal')).hide();
            showToast('success', `Exported ${visibleRows.length} fee record(s)`);
        }

        function exportClassFeesToPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('l', 'mm', 'a4');
            const visibleRows = document.querySelectorAll('.fee-row:not([style*="display: none"])');
            
            if (visibleRows.length === 0) {
                alert('No visible data to export. Please adjust your filters.');
                bootstrap.Modal.getInstance(document.getElementById('exportClassFeesModal')).hide();
                return;
            }
            
            doc.setFontSize(18);
            doc.text('Class Fees Report', 14, 15);
            
            doc.setFontSize(10);
            doc.text(`Generated: ${new Date().toLocaleString()}`, 14, 22);
            doc.text(`Records: ${visibleRows.length}`, 14, 28);
            
            const tableData = [];
            visibleRows.forEach(row => {
                const feeId = row.dataset.feeId || '';
                const category = row.dataset.category || '';
                const studentName = row.dataset.studentName || '';
                const studentId = row.dataset.studentId || '';
                
                const cells = row.querySelectorAll('td');
                const program = cells[3]?.textContent?.trim() || '';
                const yearSection = cells[4]?.textContent?.trim() || '';
                // Extract amount and format with PHP instead of ₱ for PDF compatibility
                const amountText = cells[5]?.textContent?.trim() || '';
                const amount = 'PHP ' + amountText.replace(/[^\d.,]/g, '');
                const status = cells[6]?.textContent?.trim() || '';
                const remittance = cells[7]?.textContent?.trim() || '';
                
                tableData.push([feeId, category, studentName, studentId, program, yearSection, amount, status, remittance]);
            });
            
            doc.autoTable({
                head: [['Fee ID', 'Category', 'Student Name', 'Student ID', 'Program', 'Year & Section', 'Amount', 'Payment', 'Remittance']],
                body: tableData,
                startY: 35,
                theme: 'grid',
                headStyles: { fillColor: [212, 175, 55], textColor: [0, 0, 0] },
                styles: { fontSize: 7, cellPadding: 1.5 },
                columnStyles: {
                    0: { cellWidth: 15 }, 1: { cellWidth: 30 }, 2: { cellWidth: 40 }, 3: { cellWidth: 30 },
                    4: { cellWidth: 20 }, 5: { cellWidth: 25 }, 6: { cellWidth: 20 }, 7: { cellWidth: 20 }, 8: { cellWidth: 20 }
                }
            });
            
            doc.save(`ClassFees-${new Date().toISOString().slice(0,10)}.pdf`);
            
            bootstrap.Modal.getInstance(document.getElementById('exportClassFeesModal')).hide();
            showToast('success', `Exported ${visibleRows.length} fee record(s) to PDF`);
        }

        function showToast(type, message) {
            const bgClass = type === 'success' ? 'success' : (type === 'info' ? 'info' : 'danger');
            const icon = type === 'success' ? 'check-circle' : (type === 'info' ? 'info-circle' : 'exclamation-circle');
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${bgClass} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-${icon} me-2"></i>${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }
    </script>
    <script src="~/js/officer-fees.js" asp-append-version="true"></script>
}
