@* FILE PATH: Views/Officer/ClassFees.cshtml *@
@* CLASS TREASURER - FEES MANAGEMENT (Admin-style UI with Mark as Paid) *@
@model IEnumerable<iBITS_Portal.Models.Fee>
@{
    ViewData["Title"] = $"Section {ViewBag.Section} Fees Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var sectionName = ViewBag.Section as string ?? "N/A";
    var allFees = Model?.ToList() ?? new List<iBITS_Portal.Models.Fee>();
    var totalExp = ViewBag.TotalExpected ?? 0m;
    var totalCol = ViewBag.TotalCollected ?? 0m;
    var totalPending = ViewBag.TotalPending ?? 0m;
    var collectionRate = ViewBag.CollectionRate ?? 0m;
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/officer-treasury.css" asp-append-version="true" />

@section Styles {
<style>
    .chart-no-data {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 250px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
    }
    .chart-no-data i {
        font-size: 4rem;
        margin-bottom: 1rem;
        color: rgba(212, 175, 55, 0.2);
    }
    .chart-no-data p {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
    }
    .summary-card {
        height: 100%;
        min-height: 110px;
    }
    .section-badge {
        background: linear-gradient(135deg, var(--gold-primary), #b8860b);
        color: #000;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.85rem;
    }
    .btn-mark-paid {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .btn-mark-paid:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
        color: white;
    }
    .completed-badge {
        color: #10b981;
        font-weight: 600;
        font-size: 0.85rem;
    }
</style>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;">
            <i class="bi bi-cash-stack me-2"></i> Section Fees Management
            <span class="section-badge ms-2">@sectionName</span>
        </h3>
        <p class="text-muted small mb-0">Manage fee payments for your section classmates</p>
    </div>
    <div>
        <a asp-action="ClassTreasuryDashboard" class="btn btn-outline-light btn-sm me-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #f59e0b; background: rgba(245, 158, 11, 0.2); color: #fbbf24;">
        <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FINANCIAL OVERVIEW -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> Section @sectionName - Financial Overview
    </h5>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Expected -->
        <div class="col-md-3">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collected -->
        <div class="col-md-3">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Outstanding -->
        <div class="col-md-3">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(251, 191, 36, 0.15); color: #fbbf24; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPendingCard">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Outstanding</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collection Rate -->
        <div class="col-md-3">
            <div class="summary-card rate">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-percent fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white"><span id="collectionRateDisplay">@collectionRate</span>%</div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collection Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pie Charts -->
    <div class="row g-4">
        <!-- Collected Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Collected by Fee Type</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="collectedChart"></canvas>
                    <div id="collectedNoData" class="chart-no-data">
                        <i class="bi bi-inbox-fill"></i>
                        <p>No Payments Collected Yet</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pending Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart me-2"></i>Pending by Fee Type</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="pendingChart"></canvas>
                    <div id="pendingNoData" class="chart-no-data">
                        <i class="bi bi-check2-all"></i>
                        <p>No Pending Fees</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTERS SECTION -->
<div class="glass-panel p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-funnel me-2"></i> Filters
        </h5>
        <button class="btn btn-sm btn-outline-secondary" id="clearFiltersBtn">
            <i class="bi bi-x-circle me-1"></i> Clear Filters
        </button>
    </div>

    <div class="row g-3">
        <!-- Search Filter -->
        <div class="col-md-4">
            <label class="form-label small text-muted">Search Student</label>
            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Student Name or ID...">
        </div>

        <!-- Fee Name Filter -->
        <div class="col-md-4">
            <label class="form-label small text-muted">Fee Name</label>
            <select id="filterFeeName" class="form-select form-select-sm">
                <option value="">All Fees</option>
                @if (ViewBag.FeeNames != null)
                {
                    foreach (var name in ViewBag.FeeNames)
                    {
                        <option value="@name">@name</option>
                    }
                }
            </select>
        </div>

        <!-- Status Filter -->
        <div class="col-md-4">
            <label class="form-label small text-muted">Status</label>
            <select id="filterStatus" class="form-select form-select-sm">
                <option value="">All Status</option>
                <option value="paid">Paid</option>
                <option value="unpaid">Pending/Unpaid</option>
            </select>
        </div>
    </div>
</div>

<!-- FEE RECORDS TABLE -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); margin: 0; font-weight: 700;">
            Fee Records - Section @sectionName
        </h5>
        <div>
            <a asp-action="ExportClassFees" class="btn-gold-outline btn-sm">
                <i class="bi bi-download me-1"></i> Export Fees
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-glass" id="feesTable">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">☐</th>
                    <th>Ref ID</th>
                    <th>Student Name</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Paid</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th class="text-center" style="width: 80px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var fee in Model)
                    {
                        var student = fee.StudentNumNavigation;
                        var paymentStatus = fee.PaymentStatus;
                        var isPaid = paymentStatus == "Paid";
                        var isPartial = paymentStatus == "Partial";
                        var remainingBalance = fee.RemainingBalance;
                        var statusClass = isPaid ? "row-paid" : (isPartial ? "row-partial" : "");
                        var checkboxClass = isPaid ? "status-paid no-revoke" : (isPartial ? "status-partial" : "status-unpaid");

                        <tr class="fee-row @statusClass"
                            data-fee-id="@fee.FeeId"
                            data-ref-id="@fee.FeeId"
                            data-student-name="@(student?.FullName?.ToLower() ?? "")"
                            data-student-id="@(fee.StudentNum?.ToLower() ?? "")"
                            data-fee-name="@(fee.FeeName?.ToLower() ?? "")"
                            data-status="@paymentStatus.ToLower()"
                            data-amount="@(fee.Amount ?? 0)"
                            data-paid="@fee.AmountPaid"
                            data-balance="@remainingBalance">
                            
                            <!-- Checkbox Column -->
                            <td class="text-center">
                                <div class="payment-checkbox-wrapper">
                                    <div class="payment-checkbox @checkboxClass" 
                                         data-fee-id="@fee.FeeId"
                                         data-student-name="@(student?.FullName ?? "Unknown")"
                                         data-fee-name="@fee.FeeName"
                                         data-amount="@(fee.Amount ?? 0)"
                                         data-balance="@remainingBalance"
                                         data-status="@paymentStatus.ToLower()"
                                         onclick="@(isPaid ? "" : "handleOfficerFeeCheckbox(this)")"
                                         title="@(isPaid ? "Payment completed" : (isPartial ? "Click to complete payment" : "Click to mark as paid"))">
                                    </div>
                                </div>
                            </td>
                            
                            <td class="font-monospace text-muted">#@fee.FeeId</td>
                            <td>
                                @if (student != null)
                                {
                                    <div style="color: var(--text-strong); font-weight: 600;">@student.StudentFn @student.StudentLn</div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">@fee.StudentNum</div>
                                }
                                else
                                {
                                    <span class="text-danger">ID: @fee.StudentNum</span>
                                }
                            </td>
                            <td>@fee.FeeName</td>
                            <td style="color: var(--gold-primary); font-weight: bold;">₱@(fee.Amount?.ToString("N2") ?? "0.00")</td>
                            <td class="amount-paid" style="color: #10b981; font-weight: 600;">₱@fee.AmountPaid.ToString("N2")</td>
                            <td class="balance" style="color: @(remainingBalance > 0 ? "#ef4444" : "#10b981"); font-weight: 600;">₱@remainingBalance.ToString("N2")</td>
                            
                            <!-- Status Badge -->
                            <td>
                                @if (isPaid)
                                {
                                    <span class="status-badge status-paid"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                }
                                else if (isPartial)
                                {
                                    <span class="status-badge status-partial"><i class="bi bi-pie-chart-fill"></i> Partial</span>
                                }
                                else
                                {
                                    <span class="status-badge status-unpaid"><i class="bi bi-x-circle-fill"></i> Unpaid</span>
                                }
                            </td>
                            
                            <!-- Actions -->
                            <td class="text-center">
                                @if (!isPaid)
                                {
                                    <button class="btn btn-sm btn-outline-success" onclick="openClassFeePaymentModal(@fee.FeeId, '@student?.FullName?.Replace("'", "\\'")', '@fee.FeeName?.Replace("'", "\\'")', @(fee.Amount ?? 0), @fee.AmountPaid, @remainingBalance)" title="Record partial payment">
                                        <i class="bi bi-cash-coin"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill"></i></span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted"><i class="bi bi-inbox fs-4 d-block mb-2"></i>No fee records found for this section.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CONFIRM PAYMENT MODAL (Officer) -->
<div class="modal fade" id="confirmOfficerFeePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="bi bi-check-circle text-success me-2"></i> Confirm Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div class="confirm-modal-icon success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <p class="mb-3">Mark this fee as <strong>PAID</strong>?</p>
                <div class="confirm-modal-details">
                    <div class="detail-row">
                        <span class="detail-label">Student</span>
                        <span class="detail-value" id="officerConfirmPayStudentName"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Fee</span>
                        <span class="detail-value" id="officerConfirmPayFeeName"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Amount</span>
                        <span class="detail-value text-gold">₱<span id="officerConfirmPayAmount"></span></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="officerConfirmPaymentBtn" onclick="executeOfficerFeePayment()">
                    <i class="bi bi-check-circle me-1"></i> Confirm Payment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- RECORD FEE PAYMENT MODAL (Class Treasurer) -->
<div class="modal fade" id="classFeePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header" style="background: linear-gradient(135deg, #10b981, #059669);">
                <h5 class="modal-title text-white"><i class="bi bi-cash-coin me-2"></i> Record Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RecordClassFeePayment" asp-controller="Officer" method="post" id="classFeePaymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="classFeePaymentId" name="feeId" />
                <div class="modal-body">
                    <div class="fee-section p-3 mb-4">
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted">Student</small>
                                <div id="classFeeStudentName" class="fw-bold text-white"></div>
                            </div>
                            <div class="col-6 text-end">
                                <small class="text-muted">Fee</small>
                                <div id="classFeeFeeName" class="fw-bold text-gold"></div>
                            </div>
                        </div>
                        <hr class="my-2" style="border-color: rgba(255,255,255,0.1);" />
                        <div class="row text-center">
                            <div class="col-4">
                                <small class="text-muted d-block">Total</small>
                                <div class="fw-bold text-white">₱<span id="classFeeTotal">0.00</span></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Paid</small>
                                <div class="fw-bold text-success">₱<span id="classFeePaid">0.00</span></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Balance</small>
                                <div class="fw-bold text-danger">₱<span id="classFeeBalance">0.00</span></div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Payment Amount (₱) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control" id="classFeePaymentAmount" name="paymentAmount" required />
                        <small class="text-muted">Max: ₱<span id="classFeeMaxAmount">0.00</span></small>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block mb-2">Quick Select:</small>
                        <div class="btn-group w-100">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setClassFeeAmount(0.25)">25%</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setClassFeeAmount(0.5)">50%</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setClassFeeAmount(0.75)">75%</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setClassFeeAmount(1)">Full</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select class="form-select" id="classFeePaymentMethod" name="paymentMethod" required>
                            <option value="">-- Select --</option>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reference #</label>
                        <input type="text" class="form-control" name="transactionRef" placeholder="Optional" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" name="notes" rows="2" placeholder="Optional"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Record Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Chart data from server
        window.feesChartsData = {
            collected: @Html.Raw(Json.Serialize(ViewBag.CollectedBreakdown ?? new Dictionary<string, decimal>())),
            pending: @Html.Raw(Json.Serialize(ViewBag.PendingBreakdown ?? new Dictionary<string, decimal>()))
        };

        // Class Fee Payment Modal
        var classFeeBalance = 0;
        function openClassFeePaymentModal(feeId, studentName, feeName, total, paid, balance) {
            document.getElementById('classFeePaymentId').value = feeId;
            document.getElementById('classFeeStudentName').textContent = studentName || 'Unknown';
            document.getElementById('classFeeFeeName').textContent = feeName || 'Fee';
            document.getElementById('classFeeTotal').textContent = total.toFixed(2);
            document.getElementById('classFeePaid').textContent = paid.toFixed(2);
            document.getElementById('classFeeBalance').textContent = balance.toFixed(2);
            document.getElementById('classFeeMaxAmount').textContent = balance.toFixed(2);
            document.getElementById('classFeePaymentAmount').max = balance;
            document.getElementById('classFeePaymentAmount').value = balance.toFixed(2);
            document.getElementById('classFeePaymentMethod').value = '';
            classFeeBalance = balance;
            new bootstrap.Modal(document.getElementById('classFeePaymentModal')).show();
        }

        function setClassFeeAmount(pct) {
            document.getElementById('classFeePaymentAmount').value = (classFeeBalance * pct).toFixed(2);
        }

        // Form validation
        document.getElementById('classFeePaymentForm').addEventListener('submit', function(e) {
            var amount = parseFloat(document.getElementById('classFeePaymentAmount').value);
            var method = document.getElementById('classFeePaymentMethod').value;
            
            if (!amount || amount <= 0) {
                e.preventDefault();
                alert('Please enter a valid payment amount.');
                return false;
            }
            
            if (amount > classFeeBalance) {
                e.preventDefault();
                alert('Payment amount cannot exceed the remaining balance.');
                return false;
            }
            
            if (!method) {
                e.preventDefault();
                alert('Please select a payment method.');
                return false;
            }

            var submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';
        });

        // ============================================================
        // CHECKBOX-BASED PAYMENT (Officer - No Revoke)
        // ============================================================
        var currentOfficerFeeData = {};

        function handleOfficerFeeCheckbox(checkbox) {
            const feeId = checkbox.dataset.feeId;
            const status = checkbox.dataset.status;
            const studentName = checkbox.dataset.studentName;
            const feeName = checkbox.dataset.feeName;
            const amount = parseFloat(checkbox.dataset.amount);
            const balance = parseFloat(checkbox.dataset.balance);

            if (status === 'paid') {
                showToast('info', 'This fee is already paid. Contact admin to revoke.');
                return;
            }

            currentOfficerFeeData = { feeId, studentName, feeName, amount, balance };
            document.getElementById('officerConfirmPayStudentName').textContent = studentName;
            document.getElementById('officerConfirmPayFeeName').textContent = feeName;
            document.getElementById('officerConfirmPayAmount').textContent = balance.toFixed(2);
            new bootstrap.Modal(document.getElementById('confirmOfficerFeePaymentModal')).show();
        }

        async function executeOfficerFeePayment() {
            const btn = document.getElementById('officerConfirmPaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Officer/ToggleFeePayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `feeId=${currentOfficerFeeData.feeId}&markAsPaid=true`
                });

                const result = await response.json();
                
                if (result.success) {
                    updateOfficerFeeRowUI(currentOfficerFeeData.feeId, result.newStatus, result.amountPaid, result.balance);
                    bootstrap.Modal.getInstance(document.getElementById('confirmOfficerFeePaymentModal')).hide();
                    showToast('success', result.message);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm Payment';
            }
        }

        function updateOfficerFeeRowUI(feeId, newStatus, amountPaid, balance) {
            const row = document.querySelector(`tr[data-fee-id="${feeId}"]`);
            if (!row) return;

            const checkbox = row.querySelector('.payment-checkbox');
            const statusBadge = row.querySelector('.status-badge');
            const amountPaidCell = row.querySelector('.amount-paid');
            const balanceCell = row.querySelector('.balance');

            row.classList.remove('row-paid', 'row-partial');
            if (newStatus === 'Paid') row.classList.add('row-paid');
            else if (newStatus === 'Partial') row.classList.add('row-partial');

            checkbox.classList.remove('status-paid', 'status-partial', 'status-unpaid');
            checkbox.dataset.status = newStatus.toLowerCase();
            
            if (newStatus === 'Paid') {
                checkbox.classList.add('status-paid', 'no-revoke');
                checkbox.title = 'Payment completed';
                checkbox.onclick = null;
            } else if (newStatus === 'Partial') {
                checkbox.classList.add('status-partial');
                checkbox.title = 'Click to complete payment';
            } else {
                checkbox.classList.add('status-unpaid');
                checkbox.title = 'Click to mark as paid';
            }
            checkbox.dataset.balance = balance;

            if (newStatus === 'Paid') {
                statusBadge.className = 'status-badge status-paid';
                statusBadge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Paid';
            } else if (newStatus === 'Partial') {
                statusBadge.className = 'status-badge status-partial';
                statusBadge.innerHTML = '<i class="bi bi-pie-chart-fill"></i> Partial';
            } else {
                statusBadge.className = 'status-badge status-unpaid';
                statusBadge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Unpaid';
            }

            amountPaidCell.textContent = '₱' + amountPaid.toFixed(2);
            balanceCell.textContent = '₱' + balance.toFixed(2);
            balanceCell.style.color = balance > 0 ? '#ef4444' : '#10b981';
            row.dataset.status = newStatus.toLowerCase();
            row.dataset.paid = amountPaid;
            row.dataset.balance = balance;
        }

        function showToast(type, message) {
            const bgClass = type === 'success' ? 'success' : (type === 'info' ? 'info' : 'danger');
            const icon = type === 'success' ? 'check-circle' : (type === 'info' ? 'info-circle' : 'exclamation-circle');
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${bgClass} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-${icon} me-2"></i>${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }
    </script>
    <script src="~/js/officer-fees.js" asp-append-version="true"></script>
}
