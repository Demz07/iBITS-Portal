@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Data passed from Controller
        window.finesChartsData = {
            paid: @Html.Raw(Json.Serialize(ViewBag.PaidBreakdown ?? new Dictionary<string, decimal>())),
            unpaid: @Html.Raw(Json.Serialize(ViewBag.UnpaidBreakdown ?? new Dictionary<string, decimal>()))
        };

        // Store current balance for quick select buttons
        var currentFineBalance = 0;

        // Open Fine Payment Modal
        function openFinePaymentModal(fineId, studentName, description, totalAmount, amountPaid, balance, isEventFine) {
            document.getElementById('paymentFineId').value = fineId;
            document.getElementById('finePaymentStudentName').textContent = studentName || 'Unknown';
            document.getElementById('finePaymentDescription').textContent = description || 'Fine';
            document.getElementById('finePaymentTotalAmount').textContent = totalAmount.toFixed(2);
            document.getElementById('finePaymentAlreadyPaid').textContent = amountPaid.toFixed(2);
            document.getElementById('finePaymentBalance').textContent = balance.toFixed(2);
            document.getElementById('fineMaxPaymentAmount').textContent = balance.toFixed(2);
            document.getElementById('finePaymentAmount').max = balance;
            document.getElementById('finePaymentAmount').value = balance.toFixed(2);
            currentFineBalance = balance;

            // Reset form
            document.getElementById('finePaymentMethod').value = '';
            document.getElementById('fineTransactionRef').value = '';
            document.getElementById('finePaymentNotes').value = '';

            new bootstrap.Modal(document.getElementById('recordFinePaymentModal')).show();
        }

        // Set fine payment amount based on percentage
        function setFinePaymentAmount(percentage) {
            var amount = currentFineBalance * percentage;
            document.getElementById('finePaymentAmount').value = amount.toFixed(2);
        }

        // Form validation
        document.getElementById('recordFinePaymentForm').addEventListener('submit', function(e) {
            var amount = parseFloat(document.getElementById('finePaymentAmount').value);
            var method = document.getElementById('finePaymentMethod').value;
            
            if (!amount || amount <= 0) {
                e.preventDefault();
                alert('Please enter a valid payment amount.');
                return false;
            }
            
            if (amount > currentFineBalance) {
                e.preventDefault();
                alert('Payment amount cannot exceed the remaining balance.');
                return false;
            }
            
            if (!method) {
                e.preventDefault();
                alert('Please select a payment method.');
                return false;
            }

            var submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';
        });

        // ============================================================
        // ORG TREASURER - MARK UNPAID FINE AS PAID (Full Payment Only)
        // ============================================================
        var currentOrgFineData = {};

        // Open confirmation modal for marking fine as paid
        function markOrgFinePaid(fineId, studentName, description, amount) {
            currentOrgFineData = { fineId, studentName, description, amount };
            document.getElementById('confirmOrgFineStudentName').textContent = studentName;
            document.getElementById('confirmOrgFineDescription').textContent = description;
            document.getElementById('confirmOrgFineAmount').textContent = amount.toFixed(2);
            new bootstrap.Modal(document.getElementById('confirmOrgFinePaymentModal')).show();
        }

        // Execute mark as paid
        async function executeOrgFinePayment() {
            const btn = document.getElementById('confirmOrgFinePaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const formData = new FormData();
                formData.append('fineId', currentOrgFineData.fineId);
                formData.append('newStatus', 'Paid');
                formData.append('__RequestVerificationToken', token);

                const response = await fetch('/Officer/UpdateFineStatus', {
                    method: 'POST',
                    body: formData
                });

                // Check if redirect (success usually redirects)
                if (response.redirected) {
                    showToast('success', 'Fine marked as paid successfully.');
                    setTimeout(() => location.reload(), 1000);
                    return;
                }

                const result = await response.json();
                
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('confirmOrgFinePaymentModal')).hide();
                    showToast('success', result.message || 'Fine marked as paid.');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', result.message || 'Error updating fine.');
                }
            } catch (error) {
                console.error('Error:', error);
                // Assume success if no error parsing (form submission)
                showToast('success', 'Fine status updated.');
                setTimeout(() => location.reload(), 1500);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm Payment';
            }
        }

        function updateOrgFineRowUI(fineId, newStatus, amountPaid, balance) {
            const row = document.querySelector(`tr[data-fine-id="${fineId}"]`);
            if (!row) return;

            const checkbox = row.querySelector('.payment-checkbox');
            const statusBadge = row.querySelector('.status-badge');
            const amountPaidCell = row.querySelector('.amount-paid');
            const balanceCell = row.querySelector('.balance');

            row.classList.remove('row-paid', 'row-partial', 'row-excused');
            if (newStatus === 'Paid') row.classList.add('row-paid');
            else if (newStatus === 'Partial') row.classList.add('row-partial');

            checkbox.classList.remove('status-paid', 'status-partial', 'status-unpaid', 'status-excused', 'no-revoke');
            checkbox.dataset.status = newStatus.toLowerCase();
            
            if (newStatus === 'Paid') {
                checkbox.classList.add('status-paid', 'no-revoke');
                checkbox.title = 'Payment completed';
                checkbox.onclick = null;
            } else if (newStatus === 'Partial') {
                checkbox.classList.add('status-partial');
                checkbox.title = 'Click to complete payment';
            } else {
                checkbox.classList.add('status-unpaid');
                checkbox.title = 'Click to mark as paid';
            }
            checkbox.dataset.balance = balance;

            if (newStatus === 'Paid') {
                statusBadge.className = 'status-badge status-paid';
                statusBadge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Paid';
            } else if (newStatus === 'Partial') {
                statusBadge.className = 'status-badge status-partial';
                statusBadge.innerHTML = '<i class="bi bi-pie-chart-fill"></i> Partial';
            } else {
                statusBadge.className = 'status-badge status-unpaid';
                statusBadge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Unpaid';
            }

            amountPaidCell.textContent = '₱' + amountPaid.toFixed(2);
            balanceCell.textContent = '₱' + balance.toFixed(2);
            balanceCell.style.color = balance > 0 ? '#ef4444' : '#10b981';
            row.dataset.status = newStatus.toLowerCase();
            row.dataset.paid = amountPaid;
            row.dataset.balance = balance;

            // Update action button
            const actionCell = row.querySelector('td:last-child');
            if (newStatus === 'Paid') {
                actionCell.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill"></i></span>';
            }
        }

        function showToast(type, message) {
            const bgClass = type === 'success' ? 'success' : (type === 'info' ? 'info' : 'danger');
            const icon = type === 'success' ? 'check-circle' : (type === 'info' ? 'info-circle' : 'exclamation-circle');
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${bgClass} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-${icon} me-2"></i>${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }

        // ============================================================
        // BULK SELECTION FUNCTIONALITY
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            const selectAll = document.getElementById('selectAll');
            const bulkToolbar = document.querySelector('.bulk-actions-toolbar');
            const selectedCountSpan = document.getElementById('selectedCount');
            const bulkMarkPaidBtn = document.getElementById('bulkMarkPaid');
            const bulkRevokeBtn = document.getElementById('bulkRevoke');

            // Select All functionality
            if (selectAll) {
                selectAll.addEventListener('change', function() {
                    const checkboxes = document.querySelectorAll('.fine-checkbox:not(:disabled)');
                    checkboxes.forEach(cb => cb.checked = this.checked);
                    updateBulkToolbar();
                });
            }

            // Individual checkbox change
            document.querySelectorAll('.fine-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    updateBulkToolbar();
                    updateSelectAllState();
                });
            });

            // Bulk Mark as Paid
            if (bulkMarkPaidBtn) {
                bulkMarkPaidBtn.addEventListener('click', async function() {
                    const selectedIds = getSelectedFineIds();
                    
                    if (selectedIds.length === 0) {
                        showToast('warning', 'Please select fines to mark as paid');
                        return;
                    }

                    if (!confirm(`Mark ${selectedIds.length} fine(s) as paid?`)) return;

                    await bulkAction('BulkMarkOrgFinesAsPaid', selectedIds);
                });
            }

            // Bulk Revoke
            if (bulkRevokeBtn) {
                bulkRevokeBtn.addEventListener('click', async function() {
                    const selectedIds = getSelectedFineIds();
                    
                    if (selectedIds.length === 0) {
                        showToast('warning', 'Please select fines to revoke');
                        return;
                    }

                    if (!confirm(`Revoke payment for ${selectedIds.length} fine(s)?`)) return;

                    await bulkAction('BulkRevokeOrgFines', selectedIds);
                });
            }

            // Bulk Lock
            const bulkLockBtn = document.getElementById('bulkLock');
            if (bulkLockBtn) {
                bulkLockBtn.addEventListener('click', function() {
                    const selectedIds = getSelectedFineIds();
                    
                    if (selectedIds.length === 0) {
                        showToast('warning', 'Please select fines to lock');
                        return;
                    }

                    // Show bulk lock modal
                    document.getElementById('bulkLockCount').textContent = selectedIds.length;
                    const modal = new bootstrap.Modal(document.getElementById('bulkLockFinesModal'));
                    modal.show();
                });
            }

            function getSelectedFineIds() {
                const selected = [];
                document.querySelectorAll('.fine-checkbox:checked').forEach(cb => {
                    selected.push(parseInt(cb.dataset.fineId));
                });
                return selected;
            }

            function updateBulkToolbar() {
                const selectedIds = getSelectedFineIds();
                
                if (selectedCountSpan) {
                    selectedCountSpan.textContent = selectedIds.length;
                }

                if (bulkToolbar) {
                    bulkToolbar.style.display = selectedIds.length > 0 ? 'block' : 'none';
                }
            }

            function updateSelectAllState() {
                const checkboxes = document.querySelectorAll('.fine-checkbox');
                const checkedBoxes = document.querySelectorAll('.fine-checkbox:checked');
                
                if (!selectAll) return;

                if (checkboxes.length === 0) {
                    selectAll.checked = false;
                    selectAll.indeterminate = false;
                } else if (checkedBoxes.length === checkboxes.length) {
                    selectAll.checked = true;
                    selectAll.indeterminate = false;
                } else if (checkedBoxes.length > 0) {
                    selectAll.checked = false;
                    selectAll.indeterminate = true;
                } else {
                    selectAll.checked = false;
                    selectAll.indeterminate = false;
                }
            }

            async function bulkAction(action, fineIds) {
                try {
                    const response = await fetch(`/Officer/${action}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ fineIds })
                    });

                    const result = await response.json();

                    if (result.success) {
                        showToast('success', result.message);
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showToast('error', result.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showToast('error', 'An error occurred. Please try again.');
                }
            }
        });

        // ============================================================
        // LOCK/REVOKE FUNCTIONS
        // ============================================================

        function showRevokeFineModal(fineId, studentName, description, amount) {
            document.getElementById('revokeFineId').value = fineId;
            document.getElementById('revokeFineStudentName').textContent = studentName;
            document.getElementById('revokeFineDescription').textContent = description;
            document.getElementById('revokeFineAmount').textContent = parseFloat(amount).toFixed(2);
            document.getElementById('revokeFineReason').value = '';
            
            const modal = new bootstrap.Modal(document.getElementById('revokeFineModal'));
            modal.show();
        }

        async function executeRevokeFine() {
            const fineId = document.getElementById('revokeFineId').value;
            const reason = document.getElementById('revokeFineReason').value;

            try {
                const response = await fetch('/Officer/RevokeFinePayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({
                        fineId: fineId,
                        reason: reason
                    })
                });

                const result = await response.json();

                if (result.success) {
                    showToast('success', result.message);
                    bootstrap.Modal.getInstance(document.getElementById('revokeFineModal')).hide();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An error occurred. Please try again.');
            }
        }

        function showLockFineModal(fineId, studentName, description, amount) {
            document.getElementById('lockFineId').value = fineId;
            document.getElementById('lockFineStudentName').textContent = studentName;
            document.getElementById('lockFineDescription').textContent = description;
            document.getElementById('lockFineAmount').textContent = parseFloat(amount).toFixed(2);
            document.getElementById('lockFineConfirmation').value = '';
            
            const modal = new bootstrap.Modal(document.getElementById('lockFineModal'));
            modal.show();
        }

        async function executeLockFine() {
            const fineId = document.getElementById('lockFineId').value;
            const confirmation = document.getElementById('lockFineConfirmation').value;

            if (confirmation !== 'LOCK') {
                showToast('error', 'Please type LOCK to confirm');
                return;
            }

            try {
                const response = await fetch('/Officer/LockFinePayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({
                        fineId: fineId,
                        confirmation: confirmation
                    })
                });

                const result = await response.json();

                if (result.success) {
                    showToast('success', result.message);
                    bootstrap.Modal.getInstance(document.getElementById('lockFineModal')).hide();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An error occurred. Please try again.');
            }
        }

        async function executeBulkLockFines() {
            const confirmation = document.getElementById('bulkLockConfirmation').value;

            if (confirmation !== 'LOCK ALL') {
                showToast('error', 'Please type LOCK ALL to confirm');
                return;
            }

            const selectedIds = [];
            document.querySelectorAll('.fine-checkbox:checked').forEach(cb => {
                selectedIds.push(parseInt(cb.dataset.fineId));
            });

            try {
                const response = await fetch('/Officer/BulkLockFines', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ 
                        fineIds: selectedIds,
                        confirmation: confirmation
                    })
                });

                const result = await response.json();

                if (result.success) {
                    showToast('success', result.message);
                    bootstrap.Modal.getInstance(document.getElementById('bulkLockFinesModal')).hide();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An error occurred. Please try again.');
            }

        }
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        // ============================================================
        // EXPORT FINES DATA (WYSIWYG - What You See Is What You Get)
        // ============================================================
        function exportFinesData() {
            const modal = document.createElement('div');
            modal.innerHTML = `
                <div class="modal fade" id="exportFinesModal" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content glass-modal" style="background: rgba(30, 30, 30, 0.95); border: 1px solid rgba(212, 175, 55, 0.3);">
                            <div class="modal-header border-0">
                                <h5 class="modal-title text-white"><i class="bi bi-download me-2"></i> Export Filtered Data</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted">Choose export format for visible/filtered records:</p>
                                <div class="d-grid gap-2">
                                    <button class="btn btn-success" onclick="exportFinesToExcel()">
                                        <i class="bi bi-file-earmark-excel me-2"></i> Export to Excel
                                    </button>
                                    <button class="btn btn-danger" onclick="exportFinesToPDF()">
                                        <i class="bi bi-file-earmark-pdf me-2"></i> Export to PDF
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>`;
            document.body.appendChild(modal);
            const exportModal = new bootstrap.Modal(document.getElementById('exportFinesModal'));
            exportModal.show();
            document.getElementById('exportFinesModal').addEventListener('hidden.bs.modal', () => modal.remove());
        }

        function exportFinesToExcel() {
            const visibleRows = document.querySelectorAll('#finesTableBody tr:not([style*="display: none"])');
            
            if (visibleRows.length === 0) {
                alert('No visible data to export. Please adjust your filters.');
                bootstrap.Modal.getInstance(document.getElementById('exportFinesModal')).hide();
                return;
            }
            
            const data = [
                ['Fine ID', 'Student Name', 'Student ID', 'Program', 'Year', 'Description', 'Amount', 'Status']
            ];
            
            visibleRows.forEach(row => {
                const cells = row.querySelectorAll('td');
                if (cells.length > 1) {
                    const fineId = cells[1]?.textContent?.trim() || '';
                    const studentInfo = cells[2];
                    const studentName = studentInfo?.querySelector('div:first-child')?.textContent?.trim() || '';
                    const studentId = studentInfo?.querySelector('.small')?.textContent?.trim() || '';
                    const program = cells[3]?.textContent?.trim() || '';
                    const year = cells[4]?.textContent?.trim() || '';
                    const description = cells[5]?.textContent?.trim() || '';
                    const amount = cells[6]?.textContent?.trim() || '';
                    const status = cells[7]?.textContent?.trim() || '';
                    
                    data.push([fineId, studentName, studentId, program, year, description, amount, status]);
                }
            });
            
            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.aoa_to_sheet(data);
            
            ws['!cols'] = [
                { wch: 10 }, { wch: 25 }, { wch: 20 }, { wch: 10 }, 
                { wch: 8 }, { wch: 30 }, { wch: 12 }, { wch: 10 }
            ];
            
            XLSX.utils.book_append_sheet(wb, ws, 'Org Fines');
            XLSX.writeFile(wb, `OrgFines-Filtered-${new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Manila' })}.xlsx`); // YYYY-MM-DD in PHT
            
            bootstrap.Modal.getInstance(document.getElementById('exportFinesModal')).hide();
            showToast('success', `Exported ${visibleRows.length} fine record(s)`);
        }

        function exportFinesToPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('l', 'mm', 'a4');
            const visibleRows = document.querySelectorAll('#finesTableBody tr:not([style*="display: none"])');
            
            if (visibleRows.length === 0) {
                alert('No visible data to export. Please adjust your filters.');
                bootstrap.Modal.getInstance(document.getElementById('exportFinesModal')).hide();
                return;
            }
            
            doc.setFontSize(18);
            doc.text('Organization Fines Report (Filtered)', 14, 15);
            
            doc.setFontSize(10);
            doc.text(`Generated: ${new Date().toLocaleString('en-PH', { timeZone: 'Asia/Manila' })}`, 14, 22);
            doc.text(`Records: ${visibleRows.length}`, 14, 28);
            
            const tableData = [];
            visibleRows.forEach(row => {
                const cells = row.querySelectorAll('td');
                if (cells.length > 1) {
                    const fineId = cells[1]?.textContent?.trim() || '';
                    const studentInfo = cells[2];
                    const studentName = studentInfo?.querySelector('div:first-child')?.textContent?.trim() || '';
                    const studentId = studentInfo?.querySelector('.small')?.textContent?.trim() || '';
                    const program = cells[3]?.textContent?.trim() || '';
                    const year = cells[4]?.textContent?.trim() || '';
                    const description = cells[5]?.textContent?.trim() || '';
                    // Extract amount and format with proper Peso sign (use PHP instead of Unicode for PDF compatibility)
                    const amountText = cells[6]?.textContent?.trim() || '';
                    const amount = 'PHP ' + amountText.replace(/[^\d.,]/g, ''); // Use PHP instead of ₱ symbol
                    const status = cells[7]?.textContent?.trim() || '';
                    
                    tableData.push([fineId, studentName, studentId, program, year, description, amount, status]);
                }
            });
            
            doc.autoTable({
                head: [['Fine ID', 'Student Name', 'Student ID', 'Program', 'Year', 'Description', 'Amount', 'Status']],
                body: tableData,
                startY: 35,
                theme: 'grid',
                headStyles: { fillColor: [212, 175, 55], textColor: [0, 0, 0] },
                styles: { fontSize: 8, cellPadding: 2 },
                columnStyles: {
                    0: { cellWidth: 15 }, 1: { cellWidth: 45 }, 2: { cellWidth: 35 }, 3: { cellWidth: 20 },
                    4: { cellWidth: 15 }, 5: { cellWidth: 50 }, 6: { cellWidth: 25 }, 7: { cellWidth: 20 }
                }
            });
            
            doc.save(`OrgFines-Filtered-${new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Manila' })}.pdf`); // YYYY-MM-DD in PHT
            
            bootstrap.Modal.getInstance(document.getElementById('exportFinesModal')).hide();
            showToast('success', `Exported ${visibleRows.length} fine record(s) to PDF`);
        }
    </script>
    <script src="~/js/officer-fines.js" asp-append-version="true"></script>
