@* FILE PATH: Views/Officer/OrgFines.cshtml *@
@* ORG TREASURER - FINES MANAGEMENT (Edit UNPAID only, no partial payments) *@
@model IEnumerable<iBITS_Portal.Models.Fine>
@using iBITS_Portal.Models
@{
    ViewData["Title"] = "Organization Fines Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var allFines = Model?.ToList() ?? new List<iBITS_Portal.Models.Fine>();
    var totalExp = ViewBag.TotalExpected ?? 0m;
    var totalCol = ViewBag.TotalCollected ?? 0m;
    var totalPending = ViewBag.TotalPending ?? 0m;
    var collectionRate = ViewBag.CollectionRate ?? 0m;
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/officer-treasury.css" asp-append-version="true" />

@section Styles {
<style>
    .chart-no-data {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 250px;
        color: rgba(255, 255, 255, 0.4);
        text-align: center;
    }
    .chart-no-data i {
        font-size: 4rem;
        margin-bottom: 1rem;
        color: rgba(212, 175, 55, 0.2);
    }
    .chart-no-data p {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
    }
    .summary-card {
        height: 100%;
        min-height: 110px;
    }
    .info-banner {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 8px;
        padding: 12px 16px;
        color: #93c5fd;
        font-size: 0.9rem;
    }
    .info-banner i {
        color: #3b82f6;
    }
</style>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;">
            <i class="bi bi-exclamation-triangle me-2"></i> Organization Fines Management
        </h3>
        <p class="text-muted small mb-0">View and create fines for all students across the organization</p>
    </div>
    <div>
        <a asp-action="OrgTreasurerDashboard" class="btn btn-outline-light btn-sm me-2">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FINANCIAL OVERVIEW -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> Fines Overview
    </h5>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Expected -->
        <div class="col-md-4">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collected -->
        <div class="col-md-4">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Paid</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Outstanding -->
        <div class="col-md-4">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(249, 115, 22, 0.15); color: #F97316; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPending">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Unpaid</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Charts -->
    <div class="row g-4">
        <!-- Paid Fines Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Paid Fines by Program & Year</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="paidChart"></canvas>
                    <div class="chart-no-data" id="paidNoData">
                        <i class="bi bi-inbox-fill"></i>
                        <p>No paid fines data available</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unpaid Fines Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart me-2"></i>Unpaid Fines by Program & Year</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="unpaidChart"></canvas>
                    <div class="chart-no-data" id="unpaidNoData">
                        <i class="bi bi-check2-all"></i>
                        <p>No unpaid fines data available</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTERS SECTION -->
<div class="glass-panel p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-funnel me-2"></i> Filters
        </h5>
        <button class="btn btn-sm btn-outline-secondary" id="clearFiltersBtn">
            <i class="bi bi-x-circle me-1"></i> Clear Filters
        </button>
    </div>

    <!-- First Row of Filters -->
    <div class="row g-3 mb-3">
        <!-- Search -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Search Student</label>
            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Name or ID...">
        </div>

        <!-- Fine Type -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Fine Type</label>
            <select id="filterFineType" class="form-select form-select-sm">
                <option value="">All Types</option>
                <option value="event">Event Fines</option>
                <option value="manual">Manual Fines</option>
            </select>
        </div>

        <!-- Program -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Program</label>
            <select id="filterProgram" class="form-select form-select-sm">
                <option value="">All Programs</option>
                <option value="BSIT">BSIT</option>
                <option value="DIT">DIT</option>
            </select>
        </div>

        <!-- Year Level -->
        <div class="col-md-1">
            <label class="form-label small text-muted">Year</label>
            <select id="filterYear" class="form-select form-select-sm">
                <option value="">All</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
            </select>
        </div>

        <!-- Status -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Status</label>
            <select id="filterStatus" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="unpaid">Unpaid</option>
                <option value="paid">Paid</option>
            </select>
        </div>
    </div>

    <!-- Second Row of Filters (Conditional) -->
    <div class="row g-3" id="conditionalFiltersRow" style="display: none;">
        <!-- Event Filter (shows when Fine Type = Event) -->
        <div class="col-md-4" id="filterEventContainer" style="display: none;">
            <label class="form-label small text-muted">Event</label>
            <select id="filterEvent" class="form-select form-select-sm">
                <option value="">All Events</option>
            </select>
        </div>

        <!-- Description/Reason Filter (shows when Fine Type = Manual) -->
        <div class="col-md-4" id="filterDescriptionContainer" style="display: none;">
            <label class="form-label small text-muted">Description/Reason</label>
            <select id="filterDescription" class="form-select form-select-sm">
                <option value="">All Descriptions</option>
            </select>
        </div>
    </div>
</div>

<!-- INFO BANNER -->
<div class="info-banner mb-4">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Note:</strong> As Org Treasurer, you can <strong>VIEW</strong>, <strong>CREATE</strong> fines, and mark <strong>UNPAID</strong> records as paid. 
    You <strong>CANNOT</strong> edit records that are already <strong>PAID</strong>, <strong>EXCUSED</strong>, or <strong>REMITTED</strong>. 
    Class Treasurers collect payments and submit remittances for validation.
</div>

<!-- FINES TABLE -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); margin: 0; font-weight: 700;">Fine Records</h5>
        <div>
            <a asp-action="ExportOrgFines" class="btn-gold-outline btn-sm me-2">
                <i class="bi bi-download me-1"></i> Export Fines
            </a>
            <button class="btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#createFineModal">
                <i class="bi bi-plus-lg me-1"></i> Create Fine
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-glass" id="finesTable">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">☐</th>
                    <th>REF ID</th>
                    <th>STUDENT NAME</th>
                    <th>DESCRIPTION</th>
                    <th>AMOUNT</th>
                    <th>STATUS</th>
                    <th class="text-center" style="width: 100px;">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fine in Model)
                {
                    var student = fine.StudentNumNavigation ?? fine.Attendance?.StudentNumNavigation;
                    var eventRecord = fine.Attendance?.Event;
                    var description = !string.IsNullOrEmpty(fine.Description) ? fine.Description : (eventRecord?.EventName ?? "Unknown");
                    var dbStatus = fine.PaymentStatus; // Actual DB Status
                    var isRemitted = fine.RemittanceStatus == FeeRemittanceStatus.Remitted;
                    var isEventFine = fine.AttendanceId != null;
                    var isExcused = dbStatus == "Excused";

                    // LOGIC: It only reflects as PAID to Org Treasurer if it is Validated (Remitted)
                    // Exception: Excused fines show as Excused immediately.
                    var isOfficiallyPaid = dbStatus == "Paid" && isRemitted;

                    // Visual Data
                    var displayAmountPaid = isOfficiallyPaid ? fine.AmountPaid : 0;
                    var displayBalance = isOfficiallyPaid ? 0 : (isExcused ? 0 : (fine.Amount ?? 0));
                    var displayStatus = isOfficiallyPaid ? "Paid" : (isExcused ? "Excused" : "Unpaid");

                    // Locking Logic
                    var isLocked = dbStatus == "Paid" || dbStatus == "Partial" || isExcused;
                    var canEdit = !isLocked;

                    var statusClass = isOfficiallyPaid ? "row-paid" : (isExcused ? "row-excused" : (isLocked ? "row-locked" : ""));

                    // Extract year level from YearLevelSection (e.g., "BSIT 3-1" -> "3")
                    var yearLevel = "";
                    if (!string.IsNullOrEmpty(student?.YearLevelSection))
                    {
                        var match = System.Text.RegularExpressions.Regex.Match(student.YearLevelSection, @"\d+");
                        if (match.Success) yearLevel = match.Value;
                    }

                    <tr class="fine-row @statusClass"
                        data-fine-id="@fine.FineId"
                        data-student="@student?.FullName?.ToLower()"
                        data-studentnum="@student?.StudentNum?.ToLower()"
                        data-status="@displayStatus.ToLower()"
                        data-section="@student?.YearLevelSection"
                        data-program="@student?.Course"
                        data-year="@yearLevel"
                        data-finetype="@(isEventFine ? "event" : "manual")"
                        data-event="@(eventRecord?.EventName?.ToLower() ?? "")"
                        data-description="@(description?.ToLower() ?? "")"
                        data-amount="@(fine.Amount ?? 0)"
                        data-paid="@displayAmountPaid"
                        data-balance="@displayBalance">

                        <!-- Lock/Status Column -->
                        <td class="text-center text-muted">
                            @if (isLocked && !isOfficiallyPaid && !isExcused)
                            {
                                <i class="bi bi-hourglass-split text-warning" title="Pending Validation"></i>
                            }
                            else if (isOfficiallyPaid)
                            {
                                <i class="bi bi-check-all text-success" title="Validated"></i>
                            }
                            else if (isExcused)
                            {
                                <i class="bi bi-shield-check text-info"></i>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td class="font-monospace text-muted">#@fine.FineId</td>
                        <td>
                            @if (student != null)
                            {
                                <div style="color: var(--text-strong); font-weight: 600;">@student.FullName</div>
                                <div class="small text-muted" style="font-size: 0.75rem;">@student.StudentNum</div>
                            }
                            else
                            {
                                <span class="text-danger">Unknown Student</span>
                            }
                        </td>
                        <td>
                            @if (!isEventFine)
                            {
                                <span class="text-gold"><i class="bi bi-pencil-fill me-1" style="font-size: 0.7rem;"></i> @description</span>
                            }
                            else
                            {
                                <span>@description</span>
                            }
                        </td>
                        <td style="color: var(--gold-primary); font-weight: bold;">₱@fine.Amount?.ToString("N2")</td>

                        <!-- Status Badge -->
                        <td>
                            @if (isOfficiallyPaid)
                            {
                                <span class="status-badge status-paid"><i class="bi bi-check-circle-fill"></i> Paid</span>
                            }
                            else if (isExcused)
                            {
                                <span class="status-badge status-excused"><i class="bi bi-shield-check"></i> Excused</span>
                            }
                            else
                            {
                                <span class="status-badge status-unpaid"><i class="bi bi-x-circle-fill"></i> Unpaid</span>
                            }
                        </td>

                        <!-- Actions -->
                        <td class="text-center">
                            @if (canEdit)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success" onclick="markOrgFinePaid(@fine.FineId, '@student?.FullName?.Replace("'", "\\'")', '@description?.Replace("'", "\\'")', @(fine.Amount ?? 0))" title="Mark as Paid (Full Payment)">
                                    <i class="bi bi-check-circle"></i>
                                </button>
                            }
                            else if (isOfficiallyPaid)
                            {
                                <span class="text-success" title="Validated"><i class="bi bi-lock-fill"></i></span>
                            }
                            else if (isExcused)
                            {
                                <span class="text-info" title="Excused"><i class="bi bi-shield-check"></i></span>
                            }
                            else
                            {
                                @* Locked because Class Treasurer has it *@
                                <span class="text-muted" title="Pending Remittance"><i class="bi bi-hourglass"></i></span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CREATE FINE MODAL -->
<div class="modal fade" id="createFineModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title text-gold"><i class="bi bi-exclamation-circle me-2"></i> Create Manual Fine</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateOrgFine" asp-controller="Officer" method="post" id="createFineForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <!-- Fine Details Section -->
                    <div class="fee-section">
                        <div class="fee-section-header">
                            <i class="bi bi-info-circle me-2"></i> Fine Details
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label">Fine Reason / Event <span class="text-danger">*</span></label>
                                <input type="text" name="fineReason" class="form-control" placeholder="e.g., Uniform Violation, Late Attendance" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Amount (₱) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0.01" name="amount" class="form-control" placeholder="0.00" required />
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Due Date</label>
                                <input type="date" name="finesDueDate" class="form-control" />
                                <small class="text-muted">Leave blank for default (15 days)</small>
                            </div>
                        </div>
                    </div>

                    <!-- Apply To Students Section -->
                    <div class="fee-section mt-4">
                        <div class="fee-section-header">
                            <i class="bi bi-people me-2"></i> Apply To Students
                        </div>

                        <!-- Program Filter -->
                        <div class="mb-3">
                            <label class="form-label">Program <span class="text-danger">*</span></label>
                            <div class="filter-options" id="programFilterOptions">
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programAll" value="all" checked>
                                    <label for="programAll">
                                        <i class="bi bi-grid-3x3-gap"></i>
                                        <span>All Programs</span>
                                        <small>BSIT & DIT</small>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programBSIT" value="bsit">
                                    <label for="programBSIT">
                                        <i class="bi bi-laptop"></i>
                                        <span>BSIT Only</span>
                                        <small>4-Year Program</small>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programDIT" value="dit">
                                    <label for="programDIT">
                                        <i class="bi bi-hdd-network"></i>
                                        <span>DIT Only</span>
                                        <small>3-Year Program</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Year Level Filter -->
                        <div class="mb-3">
                            <label class="form-label">Year Level <span class="text-danger">*</span></label>
                            <div class="filter-options year-filter" id="yearFilterOptions">
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="yearAll" value="all" checked>
                                    <label for="yearAll"><span>All Years</span></label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year1" value="1">
                                    <label for="year1"><span>1st Year</span></label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year2" value="2">
                                    <label for="year2"><span>2nd Year</span></label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year3" value="3">
                                    <label for="year3"><span>3rd Year</span></label>
                                </div>
                                <div class="filter-option" id="year4Option">
                                    <input type="radio" name="yearFilter" id="year4" value="4">
                                    <label for="year4">
                                        <span>4th Year</span>
                                        <small class="bsit-only-badge">BSIT only</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Preview Section -->
                        <div class="fee-preview" id="feePreview">
                            <div class="preview-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="preview-content">
                                <div class="preview-title">This fine will be applied to:</div>
                                <div class="preview-count">
                                    <span id="previewTotal">0</span> students
                                </div>
                                <div class="preview-breakdown">
                                    <span class="preview-bsit"><i class="bi bi-circle-fill"></i> BSIT: <span id="previewBSIT">0</span></span>
                                    <span class="preview-dit"><i class="bi bi-circle-fill"></i> DIT: <span id="previewDIT">0</span></span>
                                </div>
                            </div>
                            <div class="preview-loading" id="previewLoading" style="display: none;">
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold" id="submitFineBtn">
                        <i class="bi bi-check-lg me-1"></i> Create and Assign Fine
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CONFIRM FINE PAYMENT MODAL (Org Treasurer Checkbox) -->
<div class="modal fade" id="confirmOrgFinePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="bi bi-check-circle text-success me-2"></i> Confirm Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div class="confirm-modal-icon success" style="width: 80px; height: 80px; border-radius: 50%; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                    <i class="bi bi-check-circle-fill" style="font-size: 2.5rem; color: #10b981;"></i>
                </div>
                <p class="mb-3">Mark this fine as <strong>PAID</strong>?</p>
                <div class="confirm-modal-details" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 15px; text-align: left;">
                    <div class="detail-row d-flex justify-content-between mb-2">
                        <span class="detail-label text-muted">Student</span>
                        <span class="detail-value fw-bold" id="confirmOrgFineStudentName"></span>
                    </div>
                    <div class="detail-row d-flex justify-content-between mb-2">
                        <span class="detail-label text-muted">Fine</span>
                        <span class="detail-value fw-bold" id="confirmOrgFineDescription"></span>
                    </div>
                    <div class="detail-row d-flex justify-content-between">
                        <span class="detail-label text-muted">Amount</span>
                        <span class="detail-value text-gold fw-bold">₱<span id="confirmOrgFineAmount"></span></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmOrgFinePaymentBtn" onclick="executeOrgFinePayment()">
                    <i class="bi bi-check-circle me-1"></i> Confirm Payment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- RECORD FINE PAYMENT MODAL -->
<div class="modal fade" id="recordFinePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header" style="background: linear-gradient(135deg, #10b981, #059669);">
                <h5 class="modal-title text-white"><i class="bi bi-cash-coin me-2"></i> Record Fine Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RecordFinePayment" asp-controller="Officer" method="post" id="recordFinePaymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="paymentFineId" name="fineId" />
                <div class="modal-body">
                    <!-- Fine Info -->
                    <div class="fee-section p-3 mb-4">
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted">Student</small>
                                <div id="finePaymentStudentName" class="fw-bold text-white"></div>
                            </div>
                            <div class="col-6 text-end">
                                <small class="text-muted">Fine</small>
                                <div id="finePaymentDescription" class="fw-bold text-gold"></div>
                            </div>
                        </div>
                        <hr class="my-2" style="border-color: rgba(255,255,255,0.1);" />
                        <div class="row text-center">
                            <div class="col-4">
                                <small class="text-muted d-block">Total Amount</small>
                                <div class="fw-bold text-white">₱<span id="finePaymentTotalAmount">0.00</span></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Already Paid</small>
                                <div class="fw-bold text-success">₱<span id="finePaymentAlreadyPaid">0.00</span></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Balance</small>
                                <div class="fw-bold text-danger">₱<span id="finePaymentBalance">0.00</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Amount -->
                    <div class="mb-3">
                        <label for="finePaymentAmount" class="form-label">Payment Amount (₱) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control" id="finePaymentAmount" name="paymentAmount" required />
                        <small class="text-muted">Enter the amount being paid (max: <span id="fineMaxPaymentAmount">0.00</span>)</small>
                    </div>

                    <!-- Quick Amount Buttons -->
                    <div class="mb-3">
                        <small class="text-muted d-block mb-2">Quick Select:</small>
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-outline-gold btn-sm" onclick="setFinePaymentAmount(0.25)">25%</button>
                            <button type="button" class="btn btn-outline-gold btn-sm" onclick="setFinePaymentAmount(0.5)">50%</button>
                            <button type="button" class="btn btn-outline-gold btn-sm" onclick="setFinePaymentAmount(0.75)">75%</button>
                            <button type="button" class="btn btn-outline-gold btn-sm" onclick="setFinePaymentAmount(1)">Full</button>
                        </div>
                    </div>

                    <!-- Payment Method -->
                    <div class="mb-3">
                        <label for="finePaymentMethod" class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select class="form-select" id="finePaymentMethod" name="paymentMethod" required>
                            <option value="">-- Select --</option>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Online Banking">Online Banking</option>
                        </select>
                    </div>

                    <!-- Transaction Reference -->
                    <div class="mb-3">
                        <label for="fineTransactionRef" class="form-label">Transaction Reference</label>
                        <input type="text" class="form-control" id="fineTransactionRef" name="transactionRef" placeholder="e.g., GCash Ref #" />
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        <label for="finePaymentNotes" class="form-label">Notes</label>
                        <textarea class="form-control" id="finePaymentNotes" name="notes" rows="2" placeholder="Optional notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Record Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Data passed from Controller
        window.finesChartsData = {
            paid: @Html.Raw(Json.Serialize(ViewBag.PaidBreakdown ?? new Dictionary<string, decimal>())),
            unpaid: @Html.Raw(Json.Serialize(ViewBag.UnpaidBreakdown ?? new Dictionary<string, decimal>()))
        };

        // Store current balance for quick select buttons
        var currentFineBalance = 0;

        // Open Fine Payment Modal
        function openFinePaymentModal(fineId, studentName, description, totalAmount, amountPaid, balance, isEventFine) {
            document.getElementById('paymentFineId').value = fineId;
            document.getElementById('finePaymentStudentName').textContent = studentName || 'Unknown';
            document.getElementById('finePaymentDescription').textContent = description || 'Fine';
            document.getElementById('finePaymentTotalAmount').textContent = totalAmount.toFixed(2);
            document.getElementById('finePaymentAlreadyPaid').textContent = amountPaid.toFixed(2);
            document.getElementById('finePaymentBalance').textContent = balance.toFixed(2);
            document.getElementById('fineMaxPaymentAmount').textContent = balance.toFixed(2);
            document.getElementById('finePaymentAmount').max = balance;
            document.getElementById('finePaymentAmount').value = balance.toFixed(2);
            currentFineBalance = balance;

            // Reset form
            document.getElementById('finePaymentMethod').value = '';
            document.getElementById('fineTransactionRef').value = '';
            document.getElementById('finePaymentNotes').value = '';

            new bootstrap.Modal(document.getElementById('recordFinePaymentModal')).show();
        }

        // Set fine payment amount based on percentage
        function setFinePaymentAmount(percentage) {
            var amount = currentFineBalance * percentage;
            document.getElementById('finePaymentAmount').value = amount.toFixed(2);
        }

        // Form validation
        document.getElementById('recordFinePaymentForm').addEventListener('submit', function(e) {
            var amount = parseFloat(document.getElementById('finePaymentAmount').value);
            var method = document.getElementById('finePaymentMethod').value;
            
            if (!amount || amount <= 0) {
                e.preventDefault();
                alert('Please enter a valid payment amount.');
                return false;
            }
            
            if (amount > currentFineBalance) {
                e.preventDefault();
                alert('Payment amount cannot exceed the remaining balance.');
                return false;
            }
            
            if (!method) {
                e.preventDefault();
                alert('Please select a payment method.');
                return false;
            }

            var submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';
        });

        // ============================================================
        // ORG TREASURER - MARK UNPAID FINE AS PAID (Full Payment Only)
        // ============================================================
        var currentOrgFineData = {};

        // Open confirmation modal for marking fine as paid
        function markOrgFinePaid(fineId, studentName, description, amount) {
            currentOrgFineData = { fineId, studentName, description, amount };
            document.getElementById('confirmOrgFineStudentName').textContent = studentName;
            document.getElementById('confirmOrgFineDescription').textContent = description;
            document.getElementById('confirmOrgFineAmount').textContent = amount.toFixed(2);
            new bootstrap.Modal(document.getElementById('confirmOrgFinePaymentModal')).show();
        }

        // Execute mark as paid
        async function executeOrgFinePayment() {
            const btn = document.getElementById('confirmOrgFinePaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const formData = new FormData();
                formData.append('fineId', currentOrgFineData.fineId);
                formData.append('newStatus', 'Paid');
                formData.append('__RequestVerificationToken', token);

                const response = await fetch('/Officer/UpdateFineStatus', {
                    method: 'POST',
                    body: formData
                });

                // Check if redirect (success usually redirects)
                if (response.redirected) {
                    showToast('success', 'Fine marked as paid successfully.');
                    setTimeout(() => location.reload(), 1000);
                    return;
                }

                const result = await response.json();
                
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('confirmOrgFinePaymentModal')).hide();
                    showToast('success', result.message || 'Fine marked as paid.');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', result.message || 'Error updating fine.');
                }
            } catch (error) {
                console.error('Error:', error);
                // Assume success if no error parsing (form submission)
                showToast('success', 'Fine status updated.');
                setTimeout(() => location.reload(), 1500);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm Payment';
            }
        }

        function updateOrgFineRowUI(fineId, newStatus, amountPaid, balance) {
            const row = document.querySelector(`tr[data-fine-id="${fineId}"]`);
            if (!row) return;

            const checkbox = row.querySelector('.payment-checkbox');
            const statusBadge = row.querySelector('.status-badge');
            const amountPaidCell = row.querySelector('.amount-paid');
            const balanceCell = row.querySelector('.balance');

            row.classList.remove('row-paid', 'row-partial', 'row-excused');
            if (newStatus === 'Paid') row.classList.add('row-paid');
            else if (newStatus === 'Partial') row.classList.add('row-partial');

            checkbox.classList.remove('status-paid', 'status-partial', 'status-unpaid', 'status-excused', 'no-revoke');
            checkbox.dataset.status = newStatus.toLowerCase();
            
            if (newStatus === 'Paid') {
                checkbox.classList.add('status-paid', 'no-revoke');
                checkbox.title = 'Payment completed';
                checkbox.onclick = null;
            } else if (newStatus === 'Partial') {
                checkbox.classList.add('status-partial');
                checkbox.title = 'Click to complete payment';
            } else {
                checkbox.classList.add('status-unpaid');
                checkbox.title = 'Click to mark as paid';
            }
            checkbox.dataset.balance = balance;

            if (newStatus === 'Paid') {
                statusBadge.className = 'status-badge status-paid';
                statusBadge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Paid';
            } else if (newStatus === 'Partial') {
                statusBadge.className = 'status-badge status-partial';
                statusBadge.innerHTML = '<i class="bi bi-pie-chart-fill"></i> Partial';
            } else {
                statusBadge.className = 'status-badge status-unpaid';
                statusBadge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Unpaid';
            }

            amountPaidCell.textContent = '₱' + amountPaid.toFixed(2);
            balanceCell.textContent = '₱' + balance.toFixed(2);
            balanceCell.style.color = balance > 0 ? '#ef4444' : '#10b981';
            row.dataset.status = newStatus.toLowerCase();
            row.dataset.paid = amountPaid;
            row.dataset.balance = balance;

            // Update action button
            const actionCell = row.querySelector('td:last-child');
            if (newStatus === 'Paid') {
                actionCell.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill"></i></span>';
            }
        }

        function showToast(type, message) {
            const bgClass = type === 'success' ? 'success' : (type === 'info' ? 'info' : 'danger');
            const icon = type === 'success' ? 'check-circle' : (type === 'info' ? 'info-circle' : 'exclamation-circle');
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${bgClass} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body"><i class="bi bi-${icon} me-2"></i>${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }
    </script>
    <script src="~/js/officer-fines.js" asp-append-version="true"></script>
}
