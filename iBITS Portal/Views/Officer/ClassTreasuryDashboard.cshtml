@* FILE PATH: Views/Officer/ClassTreasuryDashboard.cshtml *@
@model IEnumerable<iBITS_Portal.Models.Fee>
@{
    ViewData["Title"] = "Section Fee Collection";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    
    var treasurerSection = ViewBag.Section as string ?? "N/A";
    
    // Parse section into Year and Section (e.g., "3-1" -> Year: 3, Section: 1)
    var sectionParts = treasurerSection.Split('-');
    var yearLevel = sectionParts.Length > 0 ? sectionParts[0] : "N/A";
    var sectionNumber = sectionParts.Length > 1 ? sectionParts[1] : "N/A";
    var program = "BSIT"; // Default program - can be enhanced to get from student data
    
    var totalFeesCollected = ViewBag.TotalFeesCollected ?? 0m;
    var totalFinesCollected = ViewBag.TotalFinesCollected ?? 0m;
    var pendingFees = ViewBag.PendingFees ?? 0m;
    var pendingFines = ViewBag.PendingFines ?? 0m;
    var totalCollections = ViewBag.TotalCollections ?? 0m;
    
    // Remittance status breakdown
    var feesNotRemitted = ViewBag.FeesNotRemitted ?? 0m;
    var feesNotRemittedCount = ViewBag.FeesNotRemittedCount ?? 0;
    var feesPendingValidation = ViewBag.FeesPendingValidation ?? 0m;
    var feesPendingValidationCount = ViewBag.FeesPendingValidationCount ?? 0;
    var feesValidated = ViewBag.FeesValidated ?? 0m;
    var feesValidatedCount = ViewBag.FeesValidatedCount ?? 0;
    
    var finesNotRemitted = ViewBag.FinesNotRemitted ?? 0m;
    var finesNotRemittedCount = ViewBag.FinesNotRemittedCount ?? 0;
    var finesPendingValidation = ViewBag.FinesPendingValidation ?? 0m;
    var finesPendingValidationCount = ViewBag.FinesPendingValidationCount ?? 0;
    var finesValidated = ViewBag.FinesValidated ?? 0m;
    var finesValidatedCount = ViewBag.FinesValidatedCount ?? 0;
}

@section Styles {
    <style>
        .table thead th {
            color: var(--gold-primary);
            font-weight: 700;
        }

        .table tbody td {
            color: var(--text-main);
            vertical-align: middle;
        }

        .table .student-name {
            color: var(--text-strong);
            font-weight: 600;
        }

        .stats-card {
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
            transition: transform 0.3s ease;
        }

        .stats-card:hover {
            transform: translateY(-5px);
        }

        .stats-icon {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .chart-container {
            position: relative;
            height: 300px;
            padding: 20px;
        }
    </style>
}

<!-- TempData for feedback messages -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ======================= HEADER ======================= -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="glass-header-title"><i class="bi bi-cash-coin me-2 text-gold"></i> Class Treasury</h4>
        <p class="mb-0 small text-muted">
            <span class="badge me-1" style="background-color: #FFD700; color: #000000;">@program</span>
            <span class="badge me-1" style="background-color: #FFD700; color: #000000;">Year @yearLevel</span>
            <span class="badge me-2" style="background-color: #FFD700; color: #000000;">Section @sectionNumber</span>
            Manage fees and fines for your classmates
        </p>
    </div>
</div>

<!-- ======================= REMITTANCE SECTION ======================= -->
<div class="row mb-4">
    <div class="col-md-6">
        <a href="@Url.Action("PendingCollections", "Officer")" class="text-decoration-none">
            <div class="glass-panel p-4 h-100" style="transition: transform 0.2s ease, box-shadow 0.2s ease; cursor: pointer; background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(139, 92, 246, 0.05)); border: 1px solid rgba(139, 92, 246, 0.3);">
                <div class="d-flex align-items-center">
                    <div class="me-4" style="background: rgba(139, 92, 246, 0.2); color: #a78bfa; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; border-radius: 15px;">
                        <i class="bi bi-collection fs-1"></i>
                    </div>
                    <div>
                        <h5 class="text-white mb-1 fw-bold">Pending Collections</h5>
                        <p class="text-muted mb-0 small">Review all collected fees and fines ready to remit to Org Treasurer</p>
                    </div>
                    <div class="ms-auto">
                        <i class="bi bi-chevron-right fs-4" style="color: #a78bfa;"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="@Url.Action("RemittanceHistory", "Officer")" class="text-decoration-none">
            <div class="glass-panel p-4 h-100" style="transition: transform 0.2s ease, box-shadow 0.2s ease; cursor: pointer; background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(59, 130, 246, 0.05)); border: 1px solid rgba(59, 130, 246, 0.3);">
                <div class="d-flex align-items-center">
                    <div class="me-4" style="background: rgba(59, 130, 246, 0.2); color: #60a5fa; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; border-radius: 15px;">
                        <i class="bi bi-clock-history fs-1"></i>
                    </div>
                    <div>
                        <h5 class="text-white mb-1 fw-bold">Remittance History</h5>
                        <p class="text-muted mb-0 small">Track your submitted remittances and validation status</p>
                    </div>
                    <div class="ms-auto">
                        <i class="bi bi-chevron-right fs-4" style="color: #60a5fa;"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- ======================= STATISTICS CARDS ======================= -->
<div class="row mb-4">
    <!-- Total Collections -->
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-wallet2 stats-icon text-success"></i>
            <h6 class="text-muted mb-1">Total Collections</h6>
            <h3 class="fw-bold text-success mb-0">₱@totalCollections.ToString("N2")</h3>
            <small class="text-muted">Fees + Fines</small>
        </div>
    </div>

    <!-- Fees Collected -->
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-receipt stats-icon text-primary"></i>
            <h6 class="text-muted mb-1">Fees Collected</h6>
            <h3 class="fw-bold text-primary mb-0">₱@totalFeesCollected.ToString("N2")</h3>
            <small class="text-muted">From membership fees</small>
        </div>
    </div>

    <!-- Fines Collected -->
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-exclamation-octagon stats-icon text-warning"></i>
            <h6 class="text-muted mb-1">Fines Collected</h6>
            <h3 class="fw-bold text-warning mb-0">₱@totalFinesCollected.ToString("N2")</h3>
            <small class="text-muted">From penalties</small>
        </div>
    </div>

    <!-- Pending Payments -->
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-hourglass-split stats-icon text-danger"></i>
            <h6 class="text-muted mb-1">Pending Payments</h6>
            <h3 class="fw-bold text-danger mb-0">₱@((pendingFees + pendingFines).ToString("N2"))</h3>
            <small class="text-muted">Outstanding balance</small>
        </div>
    </div>
</div>

<!-- ======================= REMITTANCE STATUS BREAKDOWN ======================= -->
<div class="row mb-4">
    <div class="col-12">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-cash-coin me-2 text-gold"></i> Remittance Status Tracking
            </h5>
            <p class="text-muted small mb-3">
                <i class="bi bi-info-circle me-1"></i> 
                Track the status of collected payments from your section. Items must be remitted and validated by the Org Treasurer before they appear in organizational records.
            </p>
            
            <div class="row">
                <!-- FEES Remittance Status -->
                <div class="col-md-6 mb-3">
                    <div class="card bg-dark border-primary">
                        <div class="card-header bg-primary text-white">
                            <i class="bi bi-receipt me-2"></i> Fees Remittance Status
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <div>
                                    <i class="bi bi-hourglass-split text-warning me-2"></i>
                                    <span class="text-muted">Ready to Remit</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-warning text-dark">@feesNotRemittedCount items</span>
                                    <div class="fw-bold text-warning">₱@feesNotRemitted.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <div>
                                    <i class="bi bi-clock-history text-info me-2"></i>
                                    <span class="text-muted">Pending Validation</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-info">@feesPendingValidationCount items</span>
                                    <div class="fw-bold text-info">₱@feesPendingValidation.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                    <span class="text-muted">Validated</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-success">@feesValidatedCount items</span>
                                    <div class="fw-bold text-success">₱@feesValidated.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FINES Remittance Status -->
                <div class="col-md-6 mb-3">
                    <div class="card bg-dark border-danger">
                        <div class="card-header bg-danger text-white">
                            <i class="bi bi-exclamation-triangle me-2"></i> Fines Remittance Status
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <div>
                                    <i class="bi bi-hourglass-split text-warning me-2"></i>
                                    <span class="text-muted">Ready to Remit</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-warning text-dark">@finesNotRemittedCount items</span>
                                    <div class="fw-bold text-warning">₱@finesNotRemitted.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <div>
                                    <i class="bi bi-clock-history text-info me-2"></i>
                                    <span class="text-muted">Pending Validation</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-info">@finesPendingValidationCount items</span>
                                    <div class="fw-bold text-info">₱@finesPendingValidation.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                    <span class="text-muted">Validated</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-success">@finesValidatedCount items</span>
                                    <div class="fw-bold text-success">₱@finesValidated.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-lightbulb me-2"></i>
                <strong>Remittance Process:</strong>
                <ol class="mb-0 mt-2 small">
                    <li><strong>Ready to Remit:</strong> Collected payments that need to be submitted to Org Treasurer</li>
                    <li><strong>Pending Validation:</strong> Submitted for remittance, awaiting Org Treasurer approval</li>
                    <li><strong>Validated:</strong> Approved by Org Treasurer and recorded in official organizational records</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- ======================= CHARTS ROW ======================= -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-pie-chart me-2 text-gold"></i> Collections Breakdown
            </h5>
            <div class="chart-container">
                <canvas id="collectionsChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-bar-chart me-2 text-gold"></i> Fees vs Fines
            </h5>
            <div class="chart-container">
                <canvas id="comparisonChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ======================= DETAILED BREAKDOWN ======================= -->
<div class="row">
    <div class="col-md-6">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-receipt-cutoff me-2 text-primary"></i> Fees Summary
            </h5>
            <div class="table-responsive">
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td><i class="bi bi-check-circle-fill text-success me-2"></i> Paid</td>
                            <td class="text-end fw-bold text-success">₱@totalFeesCollected.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-hourglass-split text-warning me-2"></i> Unpaid</td>
                            <td class="text-end fw-bold text-warning">₱@pendingFees.ToString("N2")</td>
                        </tr>
                        <tr class="table-active">
                            <td><i class="bi bi-calculator me-2"></i> Total Expected</td>
                            <td class="text-end fw-bold text-white">₱@((totalFeesCollected + pendingFees).ToString("N2"))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-exclamation-triangle me-2 text-warning"></i> Fines Summary
            </h5>
            <div class="table-responsive">
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td><i class="bi bi-check-circle-fill text-success me-2"></i> Paid</td>
                            <td class="text-end fw-bold text-success">₱@totalFinesCollected.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-hourglass-split text-danger me-2"></i> Unpaid</td>
                            <td class="text-end fw-bold text-danger">₱@pendingFines.ToString("N2")</td>
                        </tr>
                        <tr class="table-active">
                            <td><i class="bi bi-calculator me-2"></i> Total Expected</td>
                            <td class="text-end fw-bold text-white">₱@((totalFinesCollected + pendingFines).ToString("N2"))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Collections Pie Chart
    const collectionsCtx = document.getElementById('collectionsChart').getContext('2d');
    new Chart(collectionsCtx, {
        type: 'doughnut',
        data: {
            labels: ['Paid Fees', 'Paid Fines', 'Unpaid Fees', 'Unpaid Fines'],
            datasets: [{
                data: [@totalFeesCollected, @totalFinesCollected, @pendingFees, @pendingFines],
                backgroundColor: ['#3b82f6', '#f59e0b', '#ef4444', '#dc2626'],
                borderWidth: 2,
                borderColor: 'rgba(255, 255, 255, 0.1)'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#fff',
                        padding: 15
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ₱' + context.parsed.toLocaleString('en-US', {minimumFractionDigits: 2});
                        }
                    }
                }
            }
        }
    });

    // Fees vs Fines Bar Chart
    const comparisonCtx = document.getElementById('comparisonChart').getContext('2d');
    new Chart(comparisonCtx, {
        type: 'bar',
        data: {
            labels: ['Fees', 'Fines'],
            datasets: [
                {
                    label: 'Paid',
                    data: [@totalFeesCollected, @totalFinesCollected],
                    backgroundColor: '#10b981',
                    borderWidth: 0
                },
                {
                    label: 'Unpaid',
                    data: [@pendingFees, @pendingFines],
                    backgroundColor: '#ef4444',
                    borderWidth: 0
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    ticks: { color: '#fff' },
                    grid: { color: 'rgba(255, 255, 255, 0.1)' }
                },
                y: {
                    ticks: {
                        color: '#fff',
                        callback: function(value) {
                            return '₱' + value.toLocaleString();
                        }
                    },
                    grid: { color: 'rgba(255, 255, 255, 0.1)' }
                }
            },
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#fff',
                        padding: 15
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ': ₱' + context.parsed.y.toLocaleString('en-US', {minimumFractionDigits: 2});
                        }
                    }
                }
            }
        }
    });
</script>
}
