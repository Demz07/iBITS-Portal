@* FILE PATH: Views/Officer/OrgSecretaryDashboard.cshtml *@
@{
    ViewData["Title"] = "Attendance Analytics";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var totalPresent = ViewBag.TotalPresent ?? 0;
    var totalAbsent = ViewBag.TotalAbsent ?? 0;
    var totalExcused = ViewBag.TotalExcused ?? 0;
    var totalRecords = (int)totalPresent + (int)totalAbsent + (int)totalExcused;

    var distLabels = ViewBag.DistLabels as List<string> ?? new List<string>();
    var distCounts = ViewBag.DistCounts as List<int> ?? new List<int>();
    var distTotal = distCounts.Sum();

    var events = ViewBag.Events as List<iBITS_Portal.Models.Event> ?? new List<iBITS_Portal.Models.Event>();
    var programs = ViewBag.Programs as List<string> ?? new List<string>();
    var yearLevels = ViewBag.YearLevels as List<string> ?? new List<string>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/attendance.css" asp-append-version="true" />
    <style>
        .stats-card {
            background: var(--bg-glass);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid var(--border-color);
            text-align: center;
        }

        .stats-icon {
            font-size: 1.8rem;
            margin-bottom: 8px;
        }

        .rate-circle {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: radial-gradient(closest-side, var(--bg-body) 79%, transparent 80% 100%), conic-gradient(#3b82f6 @(totalRecords > 0 ? (totalPresent * 100 / totalRecords) : 0)%, rgba(255,255,255,0.05) 0);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            position: relative;
        }

        .rate-value {
            font-size: 1.6rem;
            font-weight: 800;
            color: #60a5fa;
        }

        /* Reduced height for a smaller, tighter chart area */
        .chart-container-small {
            height: 320px;
            width: 100%;
            position: relative;
        }
    </style>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4">
    <h4 class="glass-header-title"><i class="bi bi-bar-chart-fill me-2 text-gold"></i> Attendance Analytics</h4>
    <a href="@Url.Action("OrgSecretaryDashboard")" class="btn btn-glass btn-sm"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
</div>

<!-- FILTERS -->
<div class="filter-glass-panel mb-4">
    <form method="get" id="filterForm">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="filter-label">Target Event</label>
                <select class="glass-select" name="eventId" id="eventId" onchange="this.form.submit()">
                    <option value="">-- All Events --</option>
                    @foreach (var evt in events)
                    {
                        <option value="@evt.EventId">@evt.EventName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="filter-label">Filter Stats by Program</label>
                <select class="glass-select" name="program" id="program" onchange="this.form.submit()">
                    <option value="">-- All Programs --</option>
                    @foreach (var prog in programs)
                    {
                        <option value="@prog">@prog</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="filter-label">Filter Stats by Year</label>
                <select class="glass-select" name="yearLevel" id="yearLevel" onchange="this.form.submit()">
                    <option value="">-- All Year Levels --</option>
                    @foreach (var year in yearLevels)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
        </div>
    </form>
</div>

<!-- ANALYTICS CARDS -->
<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="stats-card"><i class="bi bi-check-circle text-success stats-icon"></i><h6 class="text-muted small">Present</h6><h4 class="fw-bold text-success">@totalPresent</h4></div>
    </div>
    <div class="col-md-3">
        <div class="stats-card"><i class="bi bi-x-circle text-danger stats-icon"></i><h6 class="text-muted small">Absent</h6><h4 class="fw-bold text-danger">@totalAbsent</h4></div>
    </div>
    <div class="col-md-3">
        <div class="stats-card"><i class="bi bi-info-circle text-warning stats-icon"></i><h6 class="text-muted small">Excused</h6><h4 class="fw-bold text-warning">@totalExcused</h4></div>
    </div>
    <div class="col-md-3">
        <div class="stats-card"><i class="bi bi-people text-primary stats-icon"></i><h6 class="text-muted small">Group Size</h6><h4 class="fw-bold text-primary">@totalRecords</h4></div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- LEFT: PARTICIPATION RATE GAUGE (Blue Theme) -->
    <div class="col-lg-4">
        <div class="glass-panel h-100 text-center d-flex flex-column justify-content-center py-4">
            <h6 class="text-muted fw-bold mb-4">Participation Rate</h6>
            <div class="rate-circle mb-3">
                <div class="rate-value">@((totalRecords > 0 ? (double)totalPresent / totalRecords * 100 : 0).ToString("F1"))%</div>
            </div>
            <p class="small text-muted mb-0">Filtered Group Performance</p>
        </div>
    </div>

    <!-- RIGHT: MONOCHROMATIC BLUE BAR CHART -->
    <div class="col-lg-8">
        <div class="glass-panel h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small fw-bold text-uppercase">Attendees by Group</span>
                <span class="badge bg-primary px-2" style="font-size: 0.65rem;">Count Steps: 1</span>
            </div>

            @if (distTotal > 0)
            {
                <div class="chart-container-compact">
                    <canvas id="programBarChart"></canvas>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bar-chart fs-1 opacity-25"></i>
                    <p class="mt-1 small">No attendance data found.</p>
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            ['eventId', 'program', 'yearLevel'].forEach(id => {
                const val = urlParams.get(id);
                if (val) document.getElementById(id).value = val;
            });

            @if (distTotal > 0)
            {
                        <text>
                        const ctx = document.getElementById('programBarChart').getContext('2d');
                        new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: @Html.Raw(Json.Serialize(distLabels)),
                                datasets: [{
                                    label: 'Students Present',
                                    data: @Html.Raw(Json.Serialize(distCounts)),
                                    // Monochromatic Blue Palette
                                    backgroundColor: [
                                        '#1e3a8a', '#1d4ed8', '#2563eb', '#3b82f6', '#60a5fa', '#93c5fd'
                                    ],
                                    borderRadius: 6,
                                    borderWidth: 0,
                                    barThickness: 30
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false }, // Legend hidden for clean monochromatic look
                                    tooltip: { backgroundColor: '#0f172a', titleColor: '#60a5fa' }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        grid: { color: 'rgba(255, 255, 255, 0.05)' },
                                        ticks: { color: '#94a3b8' }
                                    },
                                    x: {
                                        grid: { display: false },
                                        ticks: { color: '#94a3b8', font: { size: 11 } }
                                    }
                                }
                            }
                        });
                        </text>
            }
        });
    </script>
}


