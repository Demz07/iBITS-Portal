@{
    ViewData["Title"] = "Organization Secretary Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    
    var totalPresent = ViewBag.TotalPresent ?? 0;
    var totalAbsent = ViewBag.TotalAbsent ?? 0;
    var totalExcused = ViewBag.TotalExcused ?? 0;
    var totalRecords = totalPresent + totalAbsent + totalExcused;
}

@section Styles {
<style>
    .stats-card {
        background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 15px;
        padding: 24px;
        text-align: center;
        transition: transform 0.3s ease;
    }

    .stats-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .stats-icon {
        font-size: 3rem;
        margin-bottom: 12px;
    }

    .action-card {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .action-card:hover {
        background: rgba(255,255,255,0.1);
        border-color: var(--gold-primary);
        transform: translateY(-5px);
    }

    .action-card i {
        font-size: 3rem;
        margin-bottom: 12px;
    }
</style>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="glass-header-title">
            <i class="bi bi-pen-fill me-2 text-gold"></i> Organization Secretary Dashboard
        </h4>
        <p class="mb-0 small text-muted">Manage attendance and create fees/fines for all students</p>
    </div>
</div>

<!-- ATTENDANCE STATISTICS -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-check-circle-fill stats-icon text-success"></i>
            <h6 class="text-muted mb-1">Total Present</h6>
            <h2 class="fw-bold text-success mb-0">@totalPresent</h2>
            <small class="text-muted">Students attended</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-x-circle-fill stats-icon text-danger"></i>
            <h6 class="text-muted mb-1">Total Absent</h6>
            <h2 class="fw-bold text-danger mb-0">@totalAbsent</h2>
            <small class="text-muted">Students missed</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-info-circle-fill stats-icon text-warning"></i>
            <h6 class="text-muted mb-1">Total Excused</h6>
            <h2 class="fw-bold text-warning mb-0">@totalExcused</h2>
            <small class="text-muted">Excused absences</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <i class="bi bi-list-check stats-icon text-primary"></i>
            <h6 class="text-muted mb-1">Total Records</h6>
            <h2 class="fw-bold text-primary mb-0">@totalRecords</h2>
            <small class="text-muted">All attendance</small>
        </div>
    </div>
</div>

<!-- ATTENDANCE RATE -->
<div class="row mb-4">
    <div class="col-12">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-graph-up me-2 text-gold"></i> Attendance Rate
            </h5>
            @{
                var attendanceRate = totalRecords > 0 ? ((double)totalPresent / totalRecords * 100) : 0;
            }
            <div class="progress" style="height: 40px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @attendanceRate%" aria-valuenow="@attendanceRate" aria-valuemin="0" aria-valuemax="100">
                    <strong>@attendanceRate.ToString("F1")% Present</strong>
                </div>
            </div>
            <div class="row text-center mt-3">
                <div class="col-md-4">
                    <h6 class="text-success">@totalPresent Present</h6>
                </div>
                <div class="col-md-4">
                    <h6 class="text-danger">@totalAbsent Absent</h6>
                </div>
                <div class="col-md-4">
                    <h6 class="text-warning">@totalExcused Excused</h6>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- QUICK ACTIONS -->
<div class="row">
    <div class="col-md-3">
        <a href="@Url.Action("Scanner", "Officer")" class="text-decoration-none">
            <div class="action-card">
                <i class="bi bi-qr-code-scan text-primary"></i>
                <h5 class="text-white mb-2">Scan QR Code</h5>
                <p class="text-muted small mb-0">Mark attendance for any student</p>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("AttendanceRecords", "Officer")" class="text-decoration-none">
            <div class="action-card">
                <i class="bi bi-filter-circle text-success"></i>
                <h5 class="text-white mb-2">View Attendance</h5>
                <p class="text-muted small mb-0">Filter by event, program, year</p>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("CreateManualFee", "Officer")" class="text-decoration-none">
            <div class="action-card">
                <i class="bi bi-receipt-cutoff text-warning"></i>
                <h5 class="text-white mb-2">Create Fee</h5>
                <p class="text-muted small mb-0">Post fees for all students</p>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="@Url.Action("CreateManualFine", "Officer")" class="text-decoration-none">
            <div class="action-card">
                <i class="bi bi-exclamation-octagon text-danger"></i>
                <h5 class="text-white mb-2">Create Fine</h5>
                <p class="text-muted small mb-0">Impose fines on students</p>
            </div>
        </a>
    </div>
</div>

<!-- ATTENDANCE CHART -->
<div class="row mt-4">
    <div class="col-12">
        <div class="glass-panel">
            <h5 class="glass-header-title mb-3">
                <i class="bi bi-pie-chart-fill me-2 text-gold"></i> Attendance Distribution
            </h5>
            <div style="position: relative; height: 300px;">
                <canvas id="attendanceChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Attendance Pie Chart
    const ctx = document.getElementById('attendanceChart').getContext('2d');
    new Chart(ctx, {
        type: 'pie',
        data: {
            labels: ['Present', 'Absent', 'Excused'],
            datasets: [{
                data: [@totalPresent, @totalAbsent, @totalExcused],
                backgroundColor: ['#10b981', '#ef4444', '#f59e0b'],
                borderWidth: 2,
                borderColor: 'rgba(255, 255, 255, 0.1)'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#fff',
                        padding: 20,
                        font: { size: 14 }
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const total = @totalRecords;
                            const value = context.parsed;
                            const percentage = total > 0 ? (value / total * 100).toFixed(1) : 0;
                            return context.label + ': ' + value + ' (' + percentage + '%)';
                        }
                    }
                }
            }
        }
    });
</script>
}
