@model IEnumerable<iBITS_Portal.Models.Event>
@{
    ViewData["Title"] = "Event Management";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

@section Styles {
    <style>
        .table thead th {
            color: var(--gold-primary);
            font-weight: 700;
        }

        .table tbody td {
            color: var(--text-main);
            vertical-align: middle;
        }

        .badge-status {
            padding: 0.4em 0.8em;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .status-upcoming {
            background: rgba(16, 185, 129, 0.2);
            color: #34d399;
        }

        .status-today {
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa;
        }

        .status-completed {
            background: rgba(148, 163, 184, 0.2);
            color: #94a3b8;
        }
    </style>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="glass-header-title"><i class="bi bi-calendar-event-fill me-2 text-gold"></i> Event Management</h4>
        <p class="mb-0 small text-muted">Create, edit, and manage all organization events.</p>
    </div>
    <button class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#createEventModal">
        <i class="bi bi-plus-lg"></i> Create New Event
    </button>
</div>

<!-- EVENTS TABLE -->
<div class="glass-panel">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var today = DateOnly.FromDateTime(DateTime.Now);
                        string statusClass = "status-completed";
                        string statusText = "Completed";
                        if (item.EventDate.HasValue)
                        {
                            if (item.EventDate.Value > today) { statusClass = "status-upcoming"; statusText = "Upcoming"; }
                            else if (item.EventDate.Value == today) { statusClass = "status-today"; statusText = "Today"; }
                        }
                        <tr>
                            <td class="fw-bold text-white">@item.EventName</td>
                            <td>
                                @item.EventDate?.ToString("MMMM dd, yyyy")
                                @if (item.StartTime.HasValue)
                                {
                                    <br><span class="small text-muted">@item.StartTime.Value.ToString(@"h\:mm tt")</span>
                                    if (item.EndTime.HasValue)
                                    {
                                        <span class="small text-muted"> - @item.EndTime.Value.ToString(@"h\:mm tt")</span>
                                    }
                                }
                            </td>
                            <td>@item.EventLocation</td>
                            <td><span class="badge-status @statusClass">@statusText</span></td>
                            <td class="text-end">
                                @if (item.IsInUse)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="Event is in use and cannot be modified.">
                                        <i class="bi bi-lock-fill"></i> Manage
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-warning"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editEventModal"
                                            data-event-id="@item.EventId"
                                            data-event-name="@item.EventName"
                                            data-event-location="@item.EventLocation"
                                            data-event-date="@(item.EventDate.HasValue ? item.EventDate.Value.ToString("yyyy-MM-dd") : "")"
                                            data-start-time="@item.StartTime?.ToString(@"hh\:mm")"
                                            data-end-date="@(item.EndDate.HasValue ? item.EndDate.Value.ToString("yyyy-MM-dd") : "")"
                                            data-end-time="@item.EndTime?.ToString(@"hh\:mm")"
                                            data-event-duration="@item.EventDuration"
                                            data-event-acad-year="@item.AcadYear"
                                            data-event-desc="@item.EventDesc"
                                             data-event-type="@item.EventType"
                                             data-fine-member="@item.FineForMember"
                                             data-fine-class-officer="@item.FineForClassOfficer"
                                             data-fine-org-officer="@item.FineForOrgOfficer"
                                             data-non-ibits-fine-member="@item.NonIbitsFineForMember"
                                             data-non-ibits-fine-class-officer="@item.NonIbitsFineForClassOfficer"
                                             data-non-ibits-fine-org-officer="@item.NonIbitsFineForOrgOfficer">
                                        Edit
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center py-5 text-muted"><p>No events have been created yet.</p></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL: CREATE EVENT (FIXED) -->
<div class="modal fade" id="createEventModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal">
            <form asp-controller="Officer" asp-action="CreateEvent" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title text-gold"><i class="bi bi-calendar-plus me-2"></i> Create a New Event</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Each input now uses 'name' which matches the 'Event' model property names -->
                        <div class="col-md-12"><label class="form-label">Event Name</label><input type="text" name="EventName" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label">Event Date</label><input type="date" name="EventDate" class="form-control" required /></div>
                        <div class="col-md-3"><label class="form-label">Start Time</label><input type="time" name="StartTime" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">End Date</label><input type="date" name="EndDate" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">End Time</label><input type="time" name="EndTime" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label">Location</label><input type="text" name="EventLocation" class="form-control" placeholder="e.g., University Gymnasium" required /></div>
                        <div class="col-md-4"><label class="form-label">Duration (Optional)</label><input type="text" name="EventDuration" class="form-control" placeholder="e.g., 2 hours" title="Alternative: Use End Date/Time for precise control" /></div>
                        <div class="col-md-6"><label class="form-label">Academic Year</label><input type="text" name="AcadYear" class="form-control" placeholder="e.g., 2024-2025" /></div>
                        <div class="col-12"><label class="form-label">Description</label><textarea name="EventDesc" class="form-control" rows="3"></textarea></div>
                    </div>

                    <hr class="my-3" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label">Event Type*</label>
                            <select name="EventType" class="form-select" required>
                                <option value="iBITS Event">iBITS Event</option>
                                <option value="Non-iBITS Event">Non-iBITS Event</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-12"><p class="text-muted small">Set fine amounts for absence (enter 0 if no fine).</p></div>
                        
                        <!-- iBITS Event Fines -->
                        <div class="col-12">
                            <h6 class="text-gold"><i class="bi bi-star-fill me-2"></i>iBITS Event Fines</h6>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fine for Members (₱)</label>
                            <input type="number" step="0.01" name="FineForMember" class="form-control" value="100.00" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fine for Class Officers (₱)</label>
                            <input type="number" step="0.01" name="FineForClassOfficer" class="form-control" value="150.00" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fine for Org Officers (₱)</label>
                            <input type="number" step="0.01" name="FineForOrgOfficer" class="form-control" value="300.00" />
                        </div>
                        
                        <!-- Non-iBITS Event Fines -->
                        <div class="col-12 mt-3">
                            <h6 class="text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Non-iBITS Event Fines (if required by President)</h6>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Non-iBITS Fine for Members (₱)</label>
                            <input type="number" step="0.01" name="NonIbitsFineForMember" class="form-control" value="50.00" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Non-iBITS Fine for Class Officers (₱)</label>
                            <input type="number" step="0.01" name="NonIbitsFineForClassOfficer" class="form-control" value="100.00" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Non-iBITS Fine for Org Officers (₱)</label>
                            <input type="number" step="0.01" name="NonIbitsFineForOrgOfficer" class="form-control" value="150.00" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold">Save Event</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- ================= MODAL: EDIT EVENT ================= -->
<div class="modal fade" id="editEventModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title text-gold"><i class="bi bi-pencil-square me-2"></i> Edit Event</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Officer" asp-action="EditEvent" method="post" id="editEventForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EventId" id="editEventId" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">Event Name*</label><input type="text" name="EventName" id="editEventName" class="form-control" required /></div>
                        <div class="col-md-3"><label class="form-label">Date</label><input type="date" name="EventDate" id="editEventDate" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">Start Time</label><input type="time" name="StartTime" id="editStartTime" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">End Date</label><input type="date" name="EndDate" id="editEndDate" class="form-control" /></div>
                        <div class="col-md-3"><label class="form-label">End Time</label><input type="time" name="EndTime" id="editEndTime" class="form-control" /></div>
                        <div class="col-md-8"><label class="form-label">Location</label><input type="text" name="EventLocation" id="editEventLocation" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label">Duration</label><input type="text" name="EventDuration" id="editEventDuration" class="form-control" placeholder="e.g., 2 hours" /></div>
                        <div class="col-12"><label class="form-label">Description</label><textarea name="EventDesc" id="editEventDesc" class="form-control" rows="2"></textarea></div>
                    </div>

                    <hr class="my-3" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-6"><label class="form-label">Academic Year</label><input type="text" name="AcadYear" id="editAcadYear" class="form-control" /></div>
                        <div class="col-md-6">
                            <label class="form-label">Event Type*</label>
                            <select name="EventType" id="editEventType" class="form-select" required>
                                <option value="iBITS Event">iBITS Event</option>
                                <option value="Non-iBITS Event">Non-iBITS Event</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-12"><p class="text-muted small">Set fine amounts for absence (enter 0 if no fine).</p></div>
                        
                        <!-- iBITS Event Fines -->
                        <div class="col-12">
                            <h6 class="text-gold"><i class="bi bi-star-fill me-2"></i>iBITS Event Fines</h6>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fine for Members (₱)</label>
                            <input type="number" step="0.01" name="FineForMember" id="editFineForMember" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fine for Class Officers (₱)</label>
                            <input type="number" step="0.01" name="FineForClassOfficer" id="editFineForClassOfficer" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fine for Org Officers (₱)</label>
                            <input type="number" step="0.01" name="FineForOrgOfficer" id="editFineForOrgOfficer" class="form-control" />
                        </div>
                        
                        <!-- Non-iBITS Event Fines -->
                        <div class="col-12 mt-3">
                            <h6 class="text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Non-iBITS Event Fines (if required by President)</h6>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Non-iBITS Fine for Members (₱)</label>
                            <input type="number" step="0.01" name="NonIbitsFineForMember" id="editNonIbitsFineForMember" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Non-iBITS Fine for Class Officers (₱)</label>
                            <input type="number" step="0.01" name="NonIbitsFineForClassOfficer" id="editNonIbitsFineForClassOfficer" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Non-iBITS Fine for Org Officers (₱)</label>
                            <input type="number" step="0.01" name="NonIbitsFineForOrgOfficer" id="editNonIbitsFineForOrgOfficer" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <div>
                        <button type="submit"
                                class="btn btn-outline-danger"
                                formaction="@Url.Action("DeleteEvent", "Officer")"
                                name="eventId"
                                id="deleteEventId"
                                formmethod="post"
                                onclick="return confirm('Are you sure you want to delete this event? This action cannot be undone.');">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                    <div>
                        <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-gold">Save Changes</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const editEventModal = document.getElementById('editEventModal');
            if (editEventModal) {
                editEventModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;

                    const getAttr = (attr, defaultValue = '') => button.getAttribute(attr) || defaultValue;

                    const eventId = getAttr('data-event-id');
                    document.getElementById('editEventId').value = eventId;
                    document.getElementById('deleteEventId').value = eventId;

                    document.getElementById('editEventName').value = getAttr('data-event-name');
                    document.getElementById('editEventLocation').value = getAttr('data-event-location');
                    document.getElementById('editEventDate').value = getAttr('data-event-date');
                    document.getElementById('editStartTime').value = getAttr('data-start-time');
                    document.getElementById('editEndDate').value = getAttr('data-end-date');
                    document.getElementById('editEndTime').value = getAttr('data-end-time');
                    document.getElementById('editEventDuration').value = getAttr('data-event-duration');
                    document.getElementById('editAcadYear').value = getAttr('data-event-acad-year');
                    document.getElementById('editEventDesc').value = getAttr('data-event-desc');

                    document.getElementById('editFineForMember').value = getAttr('data-fine-member', '0.00');
                    document.getElementById('editFineForClassOfficer').value = getAttr('data-fine-class-officer', '0.00');
                    document.getElementById('editFineForOrgOfficer').value = getAttr('data-fine-org-officer', '0.00');
                    
                    document.getElementById('editNonIbitsFineForMember').value = getAttr('data-non-ibits-fine-member', '50.00');
                    document.getElementById('editNonIbitsFineForClassOfficer').value = getAttr('data-non-ibits-fine-class-officer', '100.00');
                    document.getElementById('editNonIbitsFineForOrgOfficer').value = getAttr('data-non-ibits-fine-org-officer', '150.00');

                    const eventType = getAttr('data-event-type');
                    const eventTypeSelect = document.getElementById('editEventType');
                    if (eventType) {
                        eventTypeSelect.value = eventType;
                    }
                });
            }
        });
    </script>
}

