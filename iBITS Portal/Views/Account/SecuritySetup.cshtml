@model iBITS_Portal.Controllers.AccountController.SecuritySetupViewModel
@{
    ViewData["Title"] = "Security Setup";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Security Setup - iBITS Portal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS COPIED DIRECTLY FROM YOUR LOGIN PAGE -->
    <style>
        :root {
            --bg-deep: #030a16;
            --gold-primary: #D4AF37;
            --gold-light: #F9E076;
            --gold-glow: rgba(212, 175, 55, 0.4);
            --text-muted: #94a3b8;
        }

        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-deep);
            color: #fff;
            overflow-x: hidden;
            overflow-y: auto;
        }

        #matrixCanvas { /* Copied */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            opacity: 0.3;
        }

        .top-header { /* Copied */
            position: absolute;
            top: 30px;
            left: 40px;
            display: flex;
            align-items: center;
            z-index: 100;
            pointer-events: none;
        }

        .header-logo {
            width: 60px;
            height: 60px;
            object-fit: contain;
            margin-right: 15px;
            filter: drop-shadow(0 2px 5px rgba(0,0,0,0.5));
        }

        .header-info {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .uni-name {
            font-weight: 700;
            font-size: 1.1rem;
            color: #fff;
            letter-spacing: 1px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.8);
            line-height: 1.2;
        }

        .campus-name {
            font-weight: 400;
            font-size: 0.9rem;
            color: var(--gold-primary);
            letter-spacing: 2px;
            margin-top: 2px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.8);
        }

        .split-layout {
            position: relative;
            z-index: 1;
            display: flex;
            height: 100vh;
            width: 100%;
        }

        .left-brand {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            position: relative;
        }

        .logo-wrapper {
            position: relative;
            margin-bottom: -50px;
            animation: fadeUp 1s ease-out forwards;
            z-index: 1;
        }

        .logo-img {
            width: 500px;
            height: 500px;
            object-fit: contain;
            filter: drop-shadow(0 25px 50px rgba(0,0,0,0.6));
            position: relative;
            z-index: 2;
        }

        .brand-text {
            text-align: center;
            animation: fadeUp 1.2s ease-out forwards;
            max-width: 800px;
            position: relative;
            z-index: 5;
        }

            .brand-text h1 {
                font-size: 4.5rem;
                font-weight: 800;
                line-height: 1;
                margin: 0 0 15px 0;
                background: linear-gradient(180deg, #fff 20%, #b0b0b0 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                text-shadow: 0 10px 30px rgba(0,0,0,0.3);
            }

            .brand-text .gold-accent {
                font-size: 1.1rem;
                color: var(--gold-primary);
                text-transform: uppercase;
                letter-spacing: 3px;
                font-weight: 600;
                display: block;
                text-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
                opacity: 0.9;
            }

        .right-controls {
            flex: 1;
            display: flex;
            justify-content: flex-start;
            padding-left: 0;
            align-items: center;
            position: relative;
            z-index: 2;
        }

        .glass-panel {
            width: 100%;
            max-width: 650px;
            padding: 80px;
            margin: 50px 0 50px 50px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 30px;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.5);
            animation: cardEntrance 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
            opacity: 0;
            transform: translateY(30px);
        }

        .panel-header {
            margin-bottom: 3rem;
            position: relative;
            border-left: 5px solid var(--gold-primary);
            padding-left: 30px;
        }

            .panel-header h3 {
                font-weight: 800;
                font-size: 2.2rem;
                color: #fff;
                margin: 0;
                line-height: 1;
                text-shadow: 0 0 30px rgba(255, 255, 255, 0.2);
            }

            .panel-header p {
                color: var(--gold-primary);
                font-size: 0.85rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 3px;
                margin-top: 10px;
                opacity: 0.8;
            }

        /* EXACT FORM STYLES FROM YOUR LOGIN PAGE */
        .form-floating {
            margin-bottom: 25px;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff !important;
            border-radius: 15px;
            height: 65px;
            font-family: 'Outfit', sans-serif;
            letter-spacing: 1px;
            font-size: 1.1rem;
        }

            .form-control:focus {
                background: rgba(255, 255, 255, 0.1) !important;
                border-color: var(--gold-primary);
                box-shadow: 0 0 20px rgba(212, 175, 55, 0.2);
                color: var(--gold-primary) !important;
            }

        .form-floating label {
            color: #888;
            padding-top: 1.25rem;
        }
        /* Adjusted padding slightly for better alignment */
        .password-toggle {
            position: absolute;
            right: 20px;
            top: 20px;
            color: #666;
            cursor: pointer;
            transition: 0.3s;
            z-index: 10;
            font-size: 1.4rem;
        }

            .password-toggle:hover {
                color: var(--gold-primary);
            }

        .btn-gold {
            background: var(--gold-primary);
            color: #000;
            font-weight: 800;
            font-size: 1.1rem;
            width: 100%;
            padding: 20px;
            border: none;
            border-radius: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            margin-top: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

            .btn-gold:hover {
                background: #fff;
                transform: translateY(-3px);
                box-shadow: 0 0 25px var(--gold-glow);
            }

        /* THE CRUCIAL SCRAMBLING CLASS FROM YOUR LOGIN PAGE */
        .scrambling {
            color: var(--gold-primary) !important;
            text-shadow: 0 0 8px var(--gold-primary);
            font-family: monospace !important;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @@keyframes cardEntrance {
            from {
                opacity: 0;
                transform: translateY(40px) scale(.95)
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1)
            }
        }
    
        @@media (max-width: 900px) {
            .split-layout { flex-direction: column; }
            .left-brand { padding: 5rem 1rem 1rem 1rem; flex: none; }
            .right-controls { padding: 1rem; flex: none; justify-content: center; width: 100%; }
            .glass-panel { max-width: 100%; margin: 0 0 30px 0; padding: 40px 30px; }
            .logo-img { width: 180px; height: 180px; }
            .brand-text h1 { font-size: 2.8rem; }
            .top-header { top: 15px; left: 15px; }
            .header-logo { width: 40px; height: 40px; }
            .uni-name { font-size: 0.78rem; }
            .campus-name { font-size: 0.68rem; }
        }

        @@media (max-width: 600px) {
            .split-layout { flex-direction: column; }
            .left-brand { padding: 4.5rem 1rem 0.5rem 1rem; flex: none; }
            .right-controls { padding: 0.75rem; justify-content: center; width: 100%; }
            .glass-panel { max-width: 100%; margin: 0 0 20px 0; padding: 28px 18px; border-radius: 20px; }
            .logo-img { width: 120px; height: 120px; }
            .brand-text h1 { font-size: 1.8rem; }
            .brand-text .gold-accent { font-size: 0.85rem; letter-spacing: 2px; }
            .top-header { top: 12px; left: 12px; }
            .header-logo { width: 32px; height: 32px; margin-right: 8px; }
            .uni-name { font-size: 0.68rem; }
            .campus-name { font-size: 0.6rem; }
            .panel-header h3 { font-size: 1.6rem; }
            .panel-header { margin-bottom: 1.5rem; padding-left: 18px; }
            .form-control { height: 52px; font-size: 0.95rem; }
            .btn-gold { padding: 14px; font-size: 0.95rem; }
            .form-floating { margin-bottom: 16px; }
        }

        @@media (max-width: 480px) {
            .left-brand { display: none; }
            .right-controls { padding: 0.5rem; width: 100%; justify-content: center; align-items: flex-start; padding-top: 70px; }
            .glass-panel { padding: 22px 16px; border-radius: 16px; margin: 0 0 15px 0; }
            .panel-header h3 { font-size: 1.3rem; }
            .panel-header p { font-size: 0.7rem; letter-spacing: 1px; }
            .form-control { height: 48px; font-size: 0.9rem; }
            .btn-gold { padding: 13px; font-size: 0.9rem; margin-top: 10px; }
            .top-header { top: 10px; left: 10px; }
            .header-logo { width: 26px; height: 26px; margin-right: 7px; }
            .uni-name { font-size: 0.56rem; }
            .campus-name { font-size: 0.5rem; }
        }

        @@media (max-width: 380px) {
            .glass-panel { padding: 18px 12px; }
            .panel-header h3 { font-size: 1.15rem; }
            .form-control { height: 44px; }
            .btn-gold { padding: 11px; font-size: 0.85rem; }
        }
    </style>
</head>
<body>

    <canvas id="matrixCanvas"></canvas>

    <div class="top-header">
        <img src="~/images/pup-logo.png" alt="PUP Logo" class="header-logo">
        <div class="header-info">
            <span class="uni-name">POLYTECHNIC UNIVERSITY OF THE PHILIPPINES</span>
            <span class="campus-name">&mdash; LOPEZ, QUEZON CAMPUS</span>
        </div>
    </div>

    <div class="split-layout">
        <div class="left-brand">
            <div class="logo-wrapper"><img src="~/images/logo.png" alt="iBITS Logo" class="logo-img"></div>
            <div class="brand-text"><h1>iBITS PORTAL</h1><span class="gold-accent">Unified Attendance & Payment System</span></div>
        </div>

        <div class="right-controls">
            <div class="glass-panel">
                <div class="panel-header">
                    <h3>Security Update Required</h3>
                    <p>Create a new personal password</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <!-- NEW PASSWORD FIELD (Using your HTML structure) -->
                    <div class="form-floating position-relative">
                        <input asp-for="NewPassword" type="password" class="form-control" id="newPasswordField" placeholder="New Password" />
                        <label asp-for="NewPassword">New Password</label>
                        <i class="bi bi-eye password-toggle" id="toggleBtnNew" onclick="matrixReveal('newPasswordField', 'toggleBtnNew')"></i>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <!-- CONFIRM PASSWORD FIELD (Using your HTML structure) -->
                    <div class="form-floating position-relative">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPasswordField" placeholder="Confirm New Password" />
                        <label asp-for="ConfirmPassword">Confirm New Password</label>
                        <i class="bi bi-eye password-toggle" id="toggleBtnConfirm" onclick="matrixReveal('confirmPasswordField', 'toggleBtnConfirm')"></i>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-gold">Set New Password & Access Portal</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Matrix Rain Script (Copied from your Login page) -->
    <script>
        const canvas = document.getElementById('matrixCanvas');
        const ctx = canvas.getContext('2d');
        function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        const fontSize = 26; const columns = canvas.width / fontSize; const drops = [];
        for (let x = 0; x < columns; x++) { drops[x] = 1; }
        const characters = "01";
        function draw() {
            ctx.fillStyle = 'rgba(3, 10, 22, 0.05)'; ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#D4AF37'; ctx.font = fontSize + 'px monospace';
            for (let i = 0; i < drops.length; i++) {
                const text = characters.charAt(Math.floor(Math.random() * characters.length));
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) { drops[i] = 0; }
                drops[i]++;
            }
        }
        setInterval(draw, 33);
    </script>

    <!-- YOUR Password Reveal Script, ADAPTED for multiple fields -->
    <script>
        function matrixReveal(inputId, buttonId) {
            const input = document.getElementById(inputId);
            const btn = document.getElementById(buttonId);
            const originalValue = input.value;

            // Prevent animation on an empty field
            if (!originalValue) return;
            // Prevent animation from running again if it's already active
            if (input.classList.contains("scrambling")) return;

            if (input.type === "password") {
                input.type = "text";
                btn.classList.remove("bi-eye");
                btn.classList.add("bi-eye-slash");

                let iterations = 0;
                const scrambleChars = "0101010101XYZABC#$&";
                input.classList.add("scrambling");

                const interval = setInterval(() => {
                    input.value = input.value.split("")
                        .map((letter, index) => {
                            if (index < iterations) return originalValue[index];
                            return scrambleChars[Math.floor(Math.random() * 18)];
                        }).join("");

                    if (iterations >= originalValue.length) {
                        clearInterval(interval);
                        input.value = originalValue;
                        input.classList.remove("scrambling");
                    }
                    // This controls the speed of the reveal
                    iterations += 1 / 2;
                }, 30);
            } else {
                input.type = "password";
                btn.classList.remove("bi-eye-slash");
                btn.classList.add("bi-eye");
            }
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>