@model iBITS_Portal.Controllers.AccountController.SecuritySetupViewModel
@{
    ViewData["Title"] = "Security Setup";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Security Setup - iBITS Portal</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS COPIED DIRECTLY FROM YOUR LOGIN PAGE -->
    <style>
        :root {
            --bg-deep: #030a16;
            --gold-primary: #D4AF37;
            --gold-light: #F9E076;
            --gold-glow: rgba(212, 175, 55, 0.4);
            --text-muted: #94a3b8;
        }

        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-deep);
            color: #fff;
            overflow-x: hidden;
            overflow-y: auto;
        }

        #matrixCanvas { /* Copied */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            opacity: 0.3;
        }

        .top-header { /* Copied */
            position: absolute;
            top: 30px;
            left: 40px;
            display: flex;
            align-items: center;
            z-index: 100;
            pointer-events: none;
        }

        .header-logo {
            width: 60px;
            height: 60px;
            object-fit: contain;
            margin-right: 15px;
            filter: drop-shadow(0 2px 5px rgba(0,0,0,0.5));
        }

        .header-info {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .uni-name {
            font-weight: 700;
            font-size: 1.1rem;
            color: #fff;
            letter-spacing: 1px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.8);
            line-height: 1.2;
        }

        .campus-name {
            font-weight: 400;
            font-size: 0.9rem;
            color: var(--gold-primary);
            letter-spacing: 2px;
            margin-top: 2px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.8);
        }

        .split-layout {
            position: relative;
            z-index: 1;
            display: flex;
            height: 100vh;
            width: 100%;
        }

        .left-brand {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            position: relative;
        }

        .logo-wrapper {
            position: relative;
            margin-bottom: 20px;
            animation: fadeUp 1s ease-out forwards;
            z-index: 1;
        }

        /* Glowing Halo behind Logo */
        .logo-wrapper::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 250px;
            height: 250px;
            background: var(--gold-primary);
            filter: blur(100px);
            opacity: 0.15;
            border-radius: 50%;
            animation: pulseGlow 5s infinite alternate;
        }

        .logo-img {
            width: 420px;
            height: 420px;
            object-fit: contain;
            filter: drop-shadow(0 25px 50px rgba(0,0,0,0.6));
            position: relative;
            z-index: 2;
        }

        .brand-text {
            text-align: center;
            animation: fadeUp 1.2s ease-out forwards;
            max-width: 800px;
            position: relative;
            z-index: 5;
        }

            .brand-text h1 {
                font-size: 4.5rem;
                font-weight: 800;
                line-height: 1;
                margin: 0 0 15px 0;
                background: linear-gradient(180deg, #fff 20%, #b0b0b0 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                text-shadow: 0 10px 30px rgba(0,0,0,0.3);
            }

            .brand-text .gold-accent {
                font-size: 1.1rem;
                color: var(--gold-primary);
                text-transform: uppercase;
                letter-spacing: 3px;
                font-weight: 600;
                display: block;
                text-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
                opacity: 0.9;
            }

        .right-controls {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            z-index: 2;
            padding: 2rem;
        }

        .glass-panel {
            width: 100%;
            max-width: 650px;
            padding: 40px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 30px;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.5);
            animation: cardEntrance 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
            opacity: 0;
            transform: translateY(30px);
        }

        .panel-header {
            margin-bottom: 2.5rem;
            border-left: 5px solid var(--gold-primary);
            padding-left: 25px;
        }

            .panel-header h3 {
                font-weight: 800;
                font-size: 2rem;
                color: #fff;
                margin: 0;
                line-height: 1;
            }

            .panel-header p {
                color: var(--gold-primary);
                font-size: 0.85rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 3px;
                margin-top: 10px;
                opacity: 0.8;
            }

        /* EXACT FORM STYLES FROM YOUR LOGIN PAGE */
        .form-floating {
            margin-bottom: 12px;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff !important;
            border-radius: 15px;
            height: 56px;
            font-family: 'Outfit', sans-serif;
            letter-spacing: 1px;
            font-size: 1.1rem;
        }

            .form-control:focus {
                background: rgba(255, 255, 255, 0.1) !important;
                border-color: var(--gold-primary);
                box-shadow: 0 0 20px rgba(212, 175, 55, 0.2);
                color: var(--gold-primary) !important;
            }

        .form-floating label {
            color: #888;
            padding-top: 20px;
        }

        /* Adjusted padding slightly for better alignment */
        .password-toggle {
            position: absolute;
            right: 20px;
            top: 20px;
            color: #666;
            cursor: pointer;
            transition: 0.3s;
            z-index: 10;
            font-size: 1.4rem;
        }

            .password-toggle:hover {
                color: var(--gold-primary);
            }

        .btn-gold {
            background: var(--gold-primary);
            color: #000;
            font-weight: 800;
            font-size: 1.1rem;
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            margin-top: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            position: relative;
        }

            .btn-gold:hover {
                background: #fff;
                transform: translateY(-3px);
                box-shadow: 0 0 25px var(--gold-glow);
            }

        /* THE CRUCIAL SCRAMBLING CLASS FROM YOUR LOGIN PAGE */
        .scrambling {
            color: var(--gold-primary) !important;
            text-shadow: 0 0 8px var(--gold-primary);
            font-family: monospace !important;
        }

        /* --- FLOATING NAVIGATION (From Login) --- */
        .floating-nav {
            display: flex;
            background: rgba(3, 10, 22, 0.95);
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            min-height: 70px;
        }

        .nav-container {
            width: 100%;
            display: flex;
            align-items: center;
            padding: 0 50px;
            box-sizing: border-box;
            gap: 16px;
        }

        .hero-header {
            display: flex;
            align-items: center;
            gap: 15px;
            flex: 1;
        }

        .pup-logo {
            width: 55px;
            height: 55px;
            object-fit: contain;
        }

        .header-text {
            display: flex;
            flex-direction: column;
        }

        /* ===== HAMBURGER BUTTON ===== */
        .landing-hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 8px 10px;
            background: rgba(212, 175, 55, 0.1);
            border: 1px solid #D4AF37;
            border-radius: 8px;
            z-index: 1100;
        }

        .landing-hamburger span {
            display: block; width: 22px; height: 2px; background: #D4AF37; border-radius: 2px;
        }

        /* ===== MOBILE MENU SIDEBAR ===== */
        .landing-mobile-menu {
            position: fixed;
            top: 0;
            right: -300px;
            width: 280px;
            height: 100vh;
            background: rgba(3, 10, 22, 0.98);
            z-index: 1090;
            flex-direction: column;
            align-items: flex-start;
            padding: 80px 20px 60px;
            transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            backdrop-filter: blur(20px);
        }

        .landing-mobile-menu.active { right: 0; }

        .menu-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1085;
            opacity: 0;
            visibility: hidden;
            transition: 0.3s;
        }

        .menu-backdrop.active { opacity: 1; visibility: visible; }

        .landing-mobile-menu a {
            color: #ffffff;
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: 600;
            padding: 15px 10px;
            width: 100%;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .mobile-menu-close {
            position: absolute;
            top: 15px;
            right: 20px;
            background: none;
            border: none;
            color: #ffffff;
            font-size: 1.8rem;
            cursor: pointer;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @@keyframes cardEntrance {
            from {
                opacity: 0;
                transform: translateY(40px) scale(.95)
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1)
            }
        }

        @@keyframes pulseGlow { 0% { opacity: 0.1; } 100% { opacity: 0.25; } }

        /* --- RESPONSIVE BREAKPOINTS --- */
        @@media (max-width: 1200px) {
            .logo-img { width: 320px; height: 320px; }
            .brand-text h1 { font-size: 3.5rem; }
            .nav-container { padding: 0 30px; }
        }

        @@media (max-width: 992px) {
            .split-layout { flex-direction: column; height: auto; min-height: 100vh; padding-top: 80px; }
            .left-brand { flex: none; padding: 3rem 1rem 1rem; }
            .right-controls {
                flex: none;
                width: 100%;
                justify-content: center;
                padding: 1.5rem;
                align-items: flex-start;
                padding-bottom: 150px;
            }
            .logo-img { width: 220px; height: 220px; }
            .brand-text h1 { font-size: 2.8rem; }
            .glass-panel { margin: 0 auto; max-width: 600px; }
        }

        @@media (max-width: 768px) {
            .logo-img { width: 160px; height: 160px; }
            .brand-text h1 { font-size: 2.2rem; }
            .brand-text .gold-accent { font-size: 0.9rem; letter-spacing: 2px; }
            .glass-panel { padding: 30px 20px; }
            .uni-name { font-size: 0.8rem; }
            .campus-name { font-size: 0.7rem; }
        }

        @@media (max-width: 480px) {
            .logo-img { width: 120px; height: 120px; }
            .brand-text h1 { font-size: 1.8rem; }
            .brand-text .gold-accent { font-size: 0.75rem; letter-spacing: 1.5px; }
            .glass-panel { padding: 22px 16px; border-radius: 20px; margin: 0 auto; }
            .panel-header { padding-left: 15px; margin-bottom: 1.5rem; }
            .panel-header h3 { font-size: 1.5rem; }
            .form-control { height: 50px; font-size: 0.9rem; border-radius: 10px; }
            .btn-gold { padding: 11px; font-size: 0.9rem; }
        }

        .btn-abort {
            position: relative;
            z-index: 99;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 13px;
            margin-top: 15px;
            background: rgba(220, 53, 69, 0.05);
            border: 1px solid rgba(220, 53, 69, 0.3);
            border-radius: 15px;
            color: #ff6b6b;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer !important;
        }

        .btn-abort:hover {
            background: rgba(220, 53, 69, 0.2);
            border-color: #ff6b6b;
            color: #fff;
            box-shadow: 0 0 20px rgba(220, 53, 69, 0.3);
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

    <canvas id="matrixCanvas"></canvas>

    <!-- Floating Navigation (Cloned from Login) -->
    <nav class="floating-nav visible" id="floatingNav">
        <div class="nav-container">
            <div class="hero-header">
                <img src="/images/pup-logo.png" alt="PUP Logo" class="pup-logo">
                <div class="header-text">
                    <span class="uni-name">POLYTECHNIC UNIVERSITY OF THE PHILIPPINES</span>
                    <span class="campus-name">LOPEZ, QUEZON CAMPUS</span>
                </div>
            </div>
        </div>
    </nav>

    <div class="split-layout">
        <div class="left-brand">
            <div class="logo-wrapper">
                <img src="~/images/logo.png" alt="iBITS Logo" class="logo-img">
            </div>
            <div class="brand-text">
                <h1>iBITS PORTAL</h1>
                <span class="gold-accent">Unified Attendance & Payment System</span>
            </div>
        </div>

        <div class="right-controls">
            <div class="glass-panel">
                <div class="panel-header">
                    <h3>Security Update Required</h3>
                    <p>Create a new personal password</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <!-- NEW PASSWORD FIELD (Using your HTML structure) -->
                    <div class="form-floating position-relative">
                        <input asp-for="NewPassword" type="password" class="form-control" id="newPasswordField" placeholder="New Password" />
                        <label asp-for="NewPassword">New Password</label>
                        <i class="bi bi-eye password-toggle" id="toggleBtnNew" onclick="matrixReveal('newPasswordField', 'toggleBtnNew')"></i>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <!-- CONFIRM PASSWORD FIELD (Using your HTML structure) -->
                    <div class="form-floating position-relative">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPasswordField" placeholder="Confirm New Password" />
                        <label asp-for="ConfirmPassword">Confirm New Password</label>
                        <i class="bi bi-eye password-toggle" id="toggleBtnConfirm" onclick="matrixReveal('confirmPasswordField', 'toggleBtnConfirm')"></i>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-gold">Set New Password & Access Portal</button>
                </form>

                <form method="post" action="@Url.Action("AbortSetup", "Account")" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-abort">
                        <i class="bi bi-x-circle me-2"></i> Abort &amp; Exit
                    </button>
                </form>
                </button>
            </div>
        </div>
    </div>

    <!-- Matrix Rain Script (Copied from your Login page) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        const canvas = document.getElementById('matrixCanvas');
        const ctx = canvas.getContext('2d');
        function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        const fontSize = 26; const columns = canvas.width / fontSize; const drops = [];
        for (let x = 0; x < columns; x++) { drops[x] = 1; }
        const characters = "01";
        function draw() {
            ctx.fillStyle = 'rgba(3, 10, 22, 0.05)'; ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#D4AF37'; ctx.font = fontSize + 'px monospace';
            for (let i = 0; i < drops.length; i++) {
                const text = characters.charAt(Math.floor(Math.random() * characters.length));
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) { drops[i] = 0; }
                drops[i]++;
            }
        }
        setInterval(draw, 33);
    </script>

    <!-- YOUR Password Reveal Script, ADAPTED for multiple fields -->
    <script>
        function matrixReveal(inputId, buttonId) {
            const input = document.getElementById(inputId);
            const btn = document.getElementById(buttonId);
            const originalValue = input.value;

            // Prevent animation on an empty field
            if (!originalValue) return;
            // Prevent animation from running again if it's already active
            if (input.classList.contains("scrambling")) return;

            if (input.type === "password") {
                input.type = "text";
                btn.classList.remove("bi-eye");
                btn.classList.add("bi-eye-slash");

                let iterations = 0;
                const scrambleChars = "0101010101XYZABC#$&";
                input.classList.add("scrambling");

                const interval = setInterval(() => {
                    input.value = input.value.split("")
                        .map((letter, index) => {
                            if (index < iterations) return originalValue[index];
                            return scrambleChars[Math.floor(Math.random() * 18)];
                        }).join("");

                    if (iterations >= originalValue.length) {
                        clearInterval(interval);
                        input.value = originalValue;
                        input.classList.remove("scrambling");
                    }
                    // This controls the speed of the reveal
                    iterations += 1 / 2;
                }, 30);
            } else {
                input.type = "password";
                btn.classList.remove("bi-eye-slash");
                btn.classList.add("bi-eye");
            }
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
