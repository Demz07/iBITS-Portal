@* ============================================================ *@
@* FILE PATH: Views/Account/ProfileSetup.cshtml                  *@
@* ACTION: REPLACE ENTIRE FILE                                   *@
@* ============================================================ *@

@{
    Layout = null;
    ViewData["Title"] = "Profile Setup";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - iBITS Portal</title>

    <!-- Google Fonts - Outfit (matches gateway) -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/ProfileSetup.css" asp-append-version="true" />
</head>
<body>

    <!-- Matrix Background Canvas -->
    <canvas id="matrixCanvas"></canvas>

    <div class="setup-container">
        <div class="setup-card">
            <!-- Progress Steps -->
            <div class="progress-steps">
                <div class="step completed">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Password Set</span>
                </div>
                <div class="step active">
                    <i class="bi bi-camera-fill"></i>
                    <span>Profile Photo</span>
                </div>
            </div>

            <!-- Header -->
            <div class="setup-header">
                <div class="icon-circle">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <h1>Profile Photo Required</h1>
                <p>Upload a formal ID-style photograph for verification</p>
            </div>

            <!-- Validation Errors -->
            @if (TempData["Error"] != null)
            {
                <div class="validation-error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <!-- Form -->
            <form method="post" enctype="multipart/form-data" id="profile-form" asp-action="ProfileSetup" asp-controller="Account">
                @Html.AntiForgeryToken()

                <!-- Photo Upload Area -->
                <div class="photo-upload-area">
                    <div class="photo-preview-container" id="preview-container">
                        <img id="photo-preview" src="" alt="Profile Preview" />
                        <div class="photo-placeholder" id="placeholder">
                            <i class="bi bi-person-circle"></i>
                            <span>No photo selected</span>
                        </div>
                    </div>

                    <div class="upload-buttons">
                        <label for="file-input" class="btn-upload btn-choose-file">
                            <i class="bi bi-upload"></i>
                            <span>Choose File</span>
                        </label>
                        <input type="file"
                               id="file-input"
                               name="ProfilePicture"
                               accept="image/jpeg,image/png"
                               required />

                        <button type="button" class="btn-upload btn-take-photo" id="btn-webcam">
                            <i class="bi bi-camera"></i>
                            <span>Take Photo</span>
                        </button>
                    </div>
                </div>

                <!-- Requirements -->
                <div class="requirements-box">
                    <h4><i class="bi bi-list-check"></i> Photo Requirements</h4>
                    <div class="requirements-list">
                        <div class="requirement-item valid">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Face clearly visible</span>
                        </div>
                        <div class="requirement-item valid">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Plain background</span>
                        </div>
                        <div class="requirement-item valid">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Formal attire</span>
                        </div>
                        <div class="requirement-item valid">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Similar to school ID</span>
                        </div>
                        <div class="requirement-item invalid">
                            <i class="bi bi-x-circle-fill"></i>
                            <span>No selfies</span>
                        </div>
                        <div class="requirement-item invalid">
                            <i class="bi bi-x-circle-fill"></i>
                            <span>No filters/edits</span>
                        </div>
                        <div class="requirement-item invalid">
                            <i class="bi bi-x-circle-fill"></i>
                            <span>No sunglasses/hats</span>
                        </div>
                        <div class="requirement-item invalid">
                            <i class="bi bi-x-circle-fill"></i>
                            <span>No group photos</span>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-submit" id="btn-submit" disabled>
                    <i class="bi bi-cloud-upload-fill"></i>
                    <span class="btn-text">Upload & Access Portal</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Webcam Modal -->
    <div class="webcam-modal" id="webcam-modal">
        <div class="webcam-container">
            <h3><i class="bi bi-camera-video"></i> Take Your Photo</h3>
            <video id="webcam-video" autoplay playsinline></video>
            <canvas id="webcam-canvas" style="display: none;"></canvas>
            <div class="webcam-buttons">
                <button type="button" class="btn-capture" id="btn-capture">
                    <i class="bi bi-camera-fill"></i>
                    <span>Capture</span>
                </button>
                <button type="button" class="btn-close-webcam" id="btn-close-webcam">
                    <i class="bi bi-x-lg"></i>
                    <span>Cancel</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Custom JS -->
    <script src="~/js/ProfileSetup.js" asp-append-version="true"></script>

</body>
</html>
