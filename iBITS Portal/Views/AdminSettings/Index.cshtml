@model iBITS_Portal.Models.PasswordChangeModel
@{
    ViewData["Title"] = "Account Settings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .settings-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .nav-settings {
            border: none;
            gap: 10px;
            margin-bottom: 25px;
        }

        .nav-settings .nav-link {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            border-radius: 12px;
            padding: 12px 20px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .nav-settings .nav-link:hover {
            background: rgba(212, 175, 55, 0.05);
            border-color: var(--gold-primary);
            color: var(--gold-primary);
        }

        .nav-settings .nav-link.active {
            background: var(--gold-primary) !important;
            color: #000 !important;
            border-color: var(--gold-primary);
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        }

        .security-info-box {
            background: rgba(212, 175, 55, 0.05);
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 12px;
            padding: 20px;
        }

        .security-info-box h6 {
            color: var(--gold-primary);
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .security-info-box ul {
            padding-left: 20px;
            margin-top: 10px;
            color: var(--text-main);
            font-size: 0.9rem;
        }

        .security-info-box li {
            margin-bottom: 5px;
        }

        .form-floating label {
            color: var(--text-main);
        }

        .form-control:focus ~ label {
            color: var(--gold-primary);
        }
    </style>
}

<div class="settings-container">
    <!-- Page Header -->
    <div class="mb-4">
        <h3 class="fw-800 text-strong mb-1">Admin Settings</h3>
        <p class="text-main">Manage your account credentials and system preferences</p>
    </div>

    <!-- Tab Navigation -->
    <ul class="nav nav-settings" id="settingsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="password-tab" data-bs-toggle="tab" data-bs-target="#password-pane" type="button" role="tab">
                <i class="bi bi-shield-lock me-2"></i>Security
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="email-tab" data-bs-toggle="tab" data-bs-target="#email-pane" type="button" role="tab">
                <i class="bi bi-envelope-at me-2"></i>Email Config
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="twofa-tab" data-bs-toggle="tab" data-bs-target="#twofa-pane" type="button" role="tab">
                <i class="bi bi-phone-vibrate me-2"></i>Two-Factor (2FA)
            </button>
        </li>
    </ul>

    <!-- Main Content Panel -->
    <div class="glass-panel">
        <div class="tab-content" id="settingsTabContent">
            
            <!-- PASSWORD CHANGE -->
            <div class="tab-pane fade show active" id="password-pane" role="tabpanel">
                <div class="mb-4">
                    <h5 class="text-strong fw-bold mb-2">Update Password</h5>
                    <p class="small text-main">Ensure your account is protected with a strong password.</p>
                </div>

                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Current Password" required autocomplete="current-password" />
                        <label asp-for="CurrentPassword">Current Password</label>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="New Password" required autocomplete="new-password" />
                                <label asp-for="NewPassword">New Password</label>
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" required autocomplete="new-password" />
                                <label asp-for="ConfirmPassword">Confirm New Password</label>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small"><i class="bi bi-info-circle me-1"></i> Minimum 6 characters required</span>
                        <button type="submit" class="btn btn-gold px-4 fw-bold">
                            <i class="bi bi-check2-circle me-2"></i>Apply New Password
                        </button>
                    </div>
                </form>
            </div>

            <!-- EMAIL UPDATE -->
            <div class="tab-pane fade" id="email-pane" role="tabpanel">
                <div class="mb-4">
                    <h5 class="text-strong fw-bold mb-2">Primary Email Address</h5>
                    <p class="small text-main">This email is used for system notifications and as your primary login ID.</p>
                </div>

                <form asp-action="UpdateEmail" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" type="email" class="form-control" placeholder="newemail@ibits.edu.ph" required />
                        <label asp-for="Email">New Email Address</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input name="CurrentPassword" type="password" class="form-control" placeholder="Password" required />
                        <label>Current Password (Security Check)</label>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-gold px-4 fw-bold">
                            <i class="bi bi-save me-2"></i>Update Account Email
                        </button>
                    </div>
                </form>
            </div>

            <!-- TWO-FACTOR AUTH (2FA) -->
            <div class="tab-pane fade" id="twofa-pane" role="tabpanel">
                <div id="twofaContent">
                    <div class="text-center py-5">
                        <div class="spinner-border text-gold" role="status" style="width: 3rem; height: 3rem;"></div>
                        <p class="mt-3 text-main">Loading security status...</p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Security Advisory Box -->
    <div class="glass-panel mt-4 p-4" style="background: rgba(212, 175, 55, 0.05); border: 1px solid rgba(212, 175, 55, 0.2);">
        <h6 class="text-gold fw-bold mb-3"><i class="bi bi-shield-fill-check me-2"></i> Security Guidelines</h6>
        <ul class="mb-0 text-main small" style="list-style-type: none; padding-left: 0;">
            <li class="mb-2"><i class="bi bi-check2-circle me-2 text-gold"></i> Changing your password will immediately end all other active sessions.</li>
            <li class="mb-2"><i class="bi bi-check2-circle me-2 text-gold"></i> Your <strong>Email Address</strong> serves as your primary Administrator Username.</li>
            <li class="mb-2"><i class="bi bi-check2-circle me-2 text-gold"></i> Multi-Factor Authentication (2FA) is highly recommended for all admin accounts.</li>
            <li><i class="bi bi-check2-circle me-2 text-gold"></i> Never share your credentials; monitor the System Activity Logs regularly.</li>
        </ul>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        // Tab management
        document.addEventListener('DOMContentLoaded', function() {
            if (window.location.hash) {
                const tabId = window.location.hash.substring(1) + '-tab';
                const tabEl = document.getElementById(tabId);
                if (tabEl) {
                    const bsTab = new bootstrap.Tab(tabEl);
                    bsTab.show();
                }
            }

            // Load 2FA status when tab is clicked
            document.getElementById('twofa-tab').addEventListener('shown.bs.tab', loadTwoFactorStatus);
        });

        function loadTwoFactorStatus() {
            const container = document.getElementById('twofaContent');
            
            fetch('@Url.Action("GetTwoFactorStatus", "AdminSettings")')
                .then(r => r.json())
                .then(data => {
                    renderTwoFactorUI(data);
                });
        }

        function renderTwoFactorUI(data) {
            const container = document.getElementById('twofaContent');
            const statusClass = data.isEnabled ? 'text-success' : 'text-danger';
            const statusIcon = data.isEnabled ? 'bi-shield-check' : 'bi-shield-x';
            const statusText = data.isEnabled ? 'ENABLED' : 'DISABLED';
            const statusBg = data.isEnabled ? 'rgba(25, 135, 84, 0.1)' : 'rgba(220, 53, 69, 0.1)';
            const statusBorder = data.isEnabled ? 'rgba(25, 135, 84, 0.2)' : 'rgba(220, 53, 69, 0.2)';

            let html = `
                <div class="mb-4">
                    <h5 class="text-strong fw-bold mb-2">Two-Factor Authentication (2FA)</h5>
                    <p class="small text-main">Add an extra layer of security to your account by requiring a 6-digit code from your phone to log in.</p>
                </div>

                <div class="p-4 rounded-3 mb-4" style="background: ${statusBg}; border: 1px solid ${statusBorder};">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: ${statusBorder};">
                                <i class="bi ${statusIcon} fs-3 ${statusClass}"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 ${statusClass} fw-800 text-uppercase" style="letter-spacing: 1px;">${statusText}</h6>
                                <p class="small text-main mb-0">Authenticator App Verification</p>
                            </div>
                        </div>
                        ${data.isEnabled 
                            ? `<div class="d-flex gap-2">
                                <button onclick="generateNewRecoveryCodes()" class="btn btn-outline-warning fw-bold"><i class="bi bi-arrow-repeat me-2"></i>New Codes</button>
                                <button onclick="toggle2FA(false)" class="btn btn-outline-danger fw-bold"><i class="bi bi-power me-2"></i>Disable</button>
                               </div>` 
                            : `<button onclick="start2FASetup()" class="btn btn-gold fw-bold"><i class="bi bi-shield-lock me-2"></i>Setup Authenticator</button>`
                        }
                    </div>
                </div>
            `;

            if (data.isEnabled) {
                html += `
                    <div class="glass-panel p-3 d-flex align-items-start gap-3" style="background: var(--card-bg-subtle);">
                        <i class="bi bi-shield-check text-success fs-5 mt-1"></i>
                        <div>
                            <h6 class="text-strong fw-bold mb-1">Recovery Access Active</h6>
                            <p class="small text-main mb-0">You have enabled two-factor authentication. If you ever lose your phone, you can use one of your recovery codes to sign in. <a href="javascript:void(0)" onclick="generateNewRecoveryCodes()" class="text-gold">Click here</a> to generate a new set of codes if you've lost yours.</p>
                        </div>
                    </div>
                `;
            } else {
                html += `
                    <div class="glass-panel p-3 d-flex align-items-start gap-3" style="background: var(--card-bg-subtle);">
                        <i class="bi bi-info-circle-fill text-gold fs-5 mt-1"></i>
                        <div>
                            <h6 class="text-strong fw-bold mb-1">Why enable 2FA?</h6>
                            <p class="small text-main mb-0">Even if someone guesses your password, they won't be able to access your account without your phone. It's the single best way to secure your admin privileges.</p>
                        </div>
                    </div>
                `;
            }

            container.innerHTML = html;
        }

        function generateNewRecoveryCodes() {
            if (!confirm("Generating new recovery codes will invalidate your old ones. Are you sure?")) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('@Url.Action("GenerateRecoveryCodes", "AdminSettings")', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token 
                }
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showRecoveryCodes(data.recoveryCodes);
                } else {
                    alert(data.message);
                }
            });
        }

        function start2FASetup() {
            const container = document.getElementById('twofaContent');
            container.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="text-strong fw-bold mb-1">Setup Authenticator App</h5>
                        <p class="small text-main mb-0">Follow these 3 simple steps to secure your account.</p>
                    </div>
                    <button onclick="loadTwoFactorStatus()" class="btn btn-sm btn-outline-light"><i class="bi bi-x-lg"></i> Cancel</button>
                </div>

                <div class="row g-4">
                    <!-- Step 1 & 2 -->
                    <div class="col-md-7">
                        <div class="glass-panel h-100 p-4" style="background: var(--card-bg-subtle);">
                            <h6 class="text-gold fw-bold mb-3">Step 1 & 2: Scan QR Code</h6>
                            <div class="d-flex flex-column flex-sm-row gap-4 align-items-center">
                                <div class="bg-white p-2 rounded shadow-sm">
                                    <div id="qrCode"></div>
                                </div>
                                <div>
                                    <ol class="text-main small ps-3 mb-3">
                                        <li class="mb-2">Download <strong>Google Authenticator</strong> or <strong>Microsoft Authenticator</strong> on your phone.</li>
                                        <li class="mb-2">Open the app and select <strong>"Scan a QR code"</strong>.</li>
                                        <li>Scan the image to the left.</li>
                                    </ol>
                                    <div class="p-3 rounded" style="background: rgba(0,0,0,0.2); border: 1px dashed var(--border-color); overflow: hidden;">
                                        <p class="mb-1 text-muted" style="font-size: 0.75rem;">Can't scan? Enter this key manually:</p>
                                        <code id="sharedKey" class="text-gold fs-6 fw-bold user-select-all" style="letter-spacing: 1px; word-break: break-all; white-space: normal;">Loading...</code>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="col-md-5">
                        <div class="glass-panel h-100 p-4" style="background: var(--card-bg-subtle);">
                            <h6 class="text-gold fw-bold mb-3">Step 3: Verify Setup</h6>
                            <p class="small text-main mb-3">Enter the 6-digit code generated by your app to confirm the link.</p>
                            
                            <div class="mb-3">
                                <label class="form-label small text-uppercase text-muted fw-bold">Verification Code</label>
                                <input type="text" id="verificationCode" class="form-control text-center fw-bold fs-4" 
                                       style="background: var(--input-bg); border-color: var(--input-border); letter-spacing: 5px; color: #6c757d;" 
                                       placeholder="000000" maxlength="6" autocomplete="off">
                            </div>
                            
                            <button onclick="verifyAndEnable()" id="btnVerify" class="btn btn-gold w-100 fw-bold py-2">
                                <i class="bi bi-shield-check me-2"></i>Verify & Enable
                            </button>
                        </div>
                    </div>
                </div>
            `;

            fetch('@Url.Action("LoadAuthenticatorKey", "AdminSettings")')
                .then(r => r.json())
                .then(data => {
                    document.getElementById('sharedKey').innerText = data.sharedKey;
                    new QRCode(document.getElementById("qrCode"), {
                        text: data.authenticatorUri,
                        width: 140,
                        height: 140,
                        correctLevel: QRCode.CorrectLevel.M
                    });
                });
        }

        function verifyAndEnable() {
            const code = document.getElementById('verificationCode').value;
            const btn = document.getElementById('btnVerify');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            if (!code || code.length < 6) {
                alert("Please enter the full 6-digit code.");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Verifying...';

            fetch('@Url.Action("VerifyAndEnable2FA", "AdminSettings")', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token 
                },
                body: `code=${code}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    if (data.recoveryCodes && data.recoveryCodes.length > 0) {
                        showRecoveryCodes(data.recoveryCodes);
                    } else {
                        loadTwoFactorStatus();
                    }
                } else {
                    alert(data.message || "Invalid code. Please try again.");
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-shield-check me-2"></i>Verify & Enable';
                }
            })
            .catch(err => {
                 alert("An error occurred. Please try again.");
                 btn.disabled = false;
                 btn.innerHTML = '<i class="bi bi-shield-check me-2"></i>Verify & Enable';
            });
        }

        function showRecoveryCodes(codes) {
            const container = document.getElementById('twofaContent');
            let codesHtml = codes.map(code => `<div class="col-6 mb-2"><code class="fs-5 text-gold fw-bold">${code}</code></div>`).join('');
            
            container.innerHTML = `
                <div class="mb-4">
                    <h5 class="text-strong fw-bold mb-1 text-success"><i class="bi bi-check-circle-fill me-2"></i>2FA Successfully Enabled!</h5>
                    <p class="small text-main">These recovery codes are your <strong>last resort</strong> to access your account if you lose your phone. Please save them in a safe place.</p>
                </div>

                <div class="glass-panel p-4 mb-4" style="background: rgba(255, 193, 7, 0.05); border: 1px solid rgba(255, 193, 7, 0.2);">
                    <div class="row text-center mb-3">
                        ${codesHtml}
                    </div>
                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Warning:</strong> You will only see these codes once. Download or copy them now!
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button onclick="downloadRecoveryCodes('${codes.join('\\n')}')" class="btn btn-outline-light flex-grow-1 fw-bold">
                        <i class="bi bi-download me-2"></i>Download TXT
                    </button>
                    <button onclick="loadTwoFactorStatus()" class="btn btn-gold flex-grow-1 fw-bold">
                        <i class="bi bi-check2-circle me-2"></i>I've Saved My Codes
                    </button>
                </div>
            `;
        }

        function downloadRecoveryCodes(content) {
            const blob = new Blob([content], { type: 'text/plain' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'iBITS_Portal_Recovery_Codes.txt';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
        }

        function toggle2FA(enable) {
            if (!confirm("Are you sure you want to disable 2FA? This will lower your account security.")) return;
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            fetch('@Url.Action("ToggleTwoFactor", "AdminSettings")', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token 
                },
                body: `enable=${enable}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    loadTwoFactorStatus();
                }
            });
        }
    </script>
}
