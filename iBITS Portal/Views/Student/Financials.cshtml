@* FILE PATH: Views/Student/Financials.cshtml *@
@* FIXED: Improved payment status display and calculations *@
@{
    ViewData["Title"] = "My Financials";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var fees = ViewBag.Fees as List<iBITS_Portal.Models.Fee> ?? new List<iBITS_Portal.Models.Fee>();
    var fines = ViewBag.Fines as List<iBITS_Portal.Models.Fine> ?? new List<iBITS_Portal.Models.Fine>();

    // FIXED: Use case-insensitive comparison for status checks
    var totalFees = fees.Sum(f => f.Amount ?? 0);
    var totalFines = fines.Sum(f => f.Amount ?? 0);
    var paidFees = fees.Where(f => string.Equals(f.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase)).Sum(f => f.Amount ?? 0);
    var paidFines = fines.Where(f => string.Equals(f.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase)).Sum(f => f.Amount ?? 0);
    var totalDue = (totalFees + totalFines) - (paidFees + paidFines);

    // Count paid/unpaid items for summary
    var paidFeesCount = fees.Count(f => string.Equals(f.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase));
    var unpaidFeesCount = fees.Count - paidFeesCount;
    var paidFinesCount = fines.Count(f => string.Equals(f.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase));
    var unpaidFinesCount = fines.Count - paidFinesCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-features.css" asp-append-version="true" />
    <style>
        .nav-tabs .nav-link {
            color: #9ca3af;
            border: none;
            border-bottom: 3px solid transparent;
            font-weight: 600;
            padding: 12px 24px;
        }

            .nav-tabs .nav-link.active {
                color: var(--gold-primary);
                border-bottom: 3px solid var(--gold-primary);
                background: transparent;
            }

            .nav-tabs .nav-link:hover {
                border-bottom: 3px solid var(--gold-primary);
                opacity: 0.8;
            }

        .transaction-card {
            background: rgba(255, 255, 255, 0.05);
            border-left: 4px solid var(--gold-primary);
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 12px;
            transition: transform 0.2s ease;
        }

            .transaction-card:hover {
                transform: translateX(5px);
                background: rgba(255, 255, 255, 0.08);
            }

        .badge-fee {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-fine {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }
    </style>
}

<!-- Balance Summary -->
<div class="row">
    <div class="col-12">
        <div class="glass-panel text-center">
            <p class="text-uppercase small text-muted mb-2">Current Balance Due</p>
            <h1 class="display-4 fw-bold" style="color: @(totalDue > 0 ? "#f87171" : "#34d399")">₱@totalDue.ToString("N2")</h1>
            <p class="text-muted mb-0">
                @if (totalDue > 0)
                {
                    <span><i class="bi bi-exclamation-triangle me-1"></i> Outstanding balance</span>
                }
                else
                {
                    <span><i class="bi bi-check-circle me-1"></i> All payments up to date</span>
                }
            </p>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="glass-panel mt-4">
    <ul class="nav nav-tabs mb-4" id="financialTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="fees-tab" data-bs-toggle="tab" data-bs-target="#fees-content" type="button" role="tab">
                <i class="bi bi-receipt me-2"></i> Fees
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="fines-tab" data-bs-toggle="tab" data-bs-target="#fines-content" type="button" role="tab">
                <i class="bi bi-exclamation-octagon me-2"></i> Fines
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-content" type="button" role="tab">
                <i class="bi bi-clock-history me-2"></i> Payment History
            </button>
        </li>
    </ul>

    <div class="tab-content" id="financialTabsContent">
        <!-- FEES TAB -->
        <div class="tab-pane fade show active" id="fees-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-receipt me-2 text-gold"></i> Membership Fees</h5>
            <ul class="list-group">
                @if (fees.Any())
                {
                    @foreach (var fee in fees)
                    {
                        <li class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@fee.FeeName</h6>
                                    <small class="text-muted">Due: @fee.FeesDueDate?.ToString("MMM dd, yyyy")</small>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold d-block">₱@fee.Amount?.ToString("N2")</span>
                                    @* FIXED: Use case-insensitive comparison *@
                                    @if (string.Equals(fee.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-success"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><i class="bi bi-hourglass-split"></i> Unpaid</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-2"></i>
                        <p class="mt-2 mb-0">No fees assigned yet.</p>
                    </li>
                }
            </ul>
        </div>

        <!-- FINES TAB -->
        <div class="tab-pane fade" id="fines-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-exclamation-octagon-fill me-2 text-danger"></i> Fines</h5>
            <ul class="list-group">
                @if (fines.Any())
                {
                    @foreach (var fine in fines)
                    {
                        <li class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@(fine.Description ?? $"Fine for {fine.Attendance?.Event?.EventName}")</h6>
                                    <small class="text-muted">Due: @fine.FinesDueDate?.ToString("MMM dd, yyyy")</small>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold d-block">₱@fine.Amount?.ToString("N2")</span>
                                    @* FIXED: Use case-insensitive comparison *@
                                    @if (string.Equals(fine.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-success"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><i class="bi bi-hourglass-split"></i> Unpaid</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4 text-muted">
                        <i class="bi bi-check-circle fs-2"></i>
                        <p class="mt-2 mb-0">No fines on your record. Great job!</p>
                    </li>
                }
            </ul>
        </div>

        <!-- PAYMENT HISTORY TAB -->
        <div class="tab-pane fade" id="history-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-clock-history me-2 text-gold"></i> Payment Transaction History</h5>
            <div id="transactionsList">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading payment history...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load payment history when tab is clicked
        document.getElementById('history-tab').addEventListener('click', function() {
            loadPaymentHistory();
        });

        function loadPaymentHistory() {
            const container = document.getElementById('transactionsList');

            // Show loading spinner
            container.innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading payment history...</p>
                </div>
            `;

            // Fetch payment history
            fetch('@Url.Action("GetPaymentHistory", "Student")')
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.transactions && data.transactions.length > 0) {
                        let html = '';
                        data.transactions.forEach(tx => {
                            const date = new Date(tx.paymentDate);
                            const badgeClass = tx.type === 'Fee' ? 'badge-fee' : 'badge-fine';
                            const icon = tx.type === 'Fee' ? 'bi-receipt' : 'bi-exclamation-octagon';

                            html += `
                                <div class="transaction-card">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="badge ${badgeClass}">
                                                <i class="bi ${icon} me-1"></i>${tx.type}
                                            </span>
                                            <h6 class="mt-2 mb-1">${tx.description}</h6>
                                        </div>
                                        <div class="text-end">
                                            <h5 class="mb-0 text-success">₱${parseFloat(tx.amount).toFixed(2)}</h5>
                                            <small class="text-muted">${date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</small>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-4">
                                            <small class="text-muted d-block">Payment Method</small>
                                            <span><i class="bi bi-credit-card me-1"></i>${tx.paymentMethod || 'Cash'}</span>
                                        </div>
                                        <div class="col-md-4">
                                            <small class="text-muted d-block">Processed By</small>
                                            <span><i class="bi bi-person-check me-1"></i>${tx.processedBy || 'System'}</span>
                                        </div>
                                        <div class="col-md-4">
                                            <small class="text-muted d-block">Reference</small>
                                            <span class="font-monospace">${tx.transactionReference || 'N/A'}</span>
                                        </div>
                                    </div>
                                    ${tx.notes ? `
                                        <div class="mt-2">
                                            <small class="text-muted d-block">Notes</small>
                                            <span>${tx.notes}</span>
                                        </div>
                                    ` : ''}
                                </div>
                            `;
                        });
                        container.innerHTML = html;
                    } else {
                        container.innerHTML = `
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2"></i>
                                <p class="mt-2 mb-0">No payment transactions yet.</p>
                            </div>
                        `;
                    }
                })
                .catch(error => {
                    console.error('Error loading payment history:', error);
                    container.innerHTML = `
                        <div class="text-center py-4 text-danger">
                            <i class="bi bi-exclamation-triangle fs-2"></i>
                            <p class="mt-2 mb-0">Error loading payment history.</p>
                        </div>
                    `;
                });
        }
    </script>
}

