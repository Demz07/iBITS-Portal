@* FILE PATH: Views/Student/Financials.cshtml *@
@* FIXED: Improved payment status display and calculations *@
@{
    ViewData["Title"] = "My Financials";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var fees = ViewBag.Fees as List<iBITS_Portal.Models.Fee> ?? new List<iBITS_Portal.Models.Fee>();
    var fines = ViewBag.Fines as List<iBITS_Portal.Models.Fine> ?? new List<iBITS_Portal.Models.Fine>();

    // FIXED: Use case-insensitive comparison for status checks
    var totalFees = fees.Sum(f => f.Amount ?? 0);
    var totalFines = fines.Sum(f => f.Amount ?? 0);
    var paidFees = fees.Where(f => string.Equals(f.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase)).Sum(f => f.Amount ?? 0);
    var paidFines = fines.Where(f => string.Equals(f.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase)).Sum(f => f.Amount ?? 0);
    var totalDue = (totalFees + totalFines) - (paidFees + paidFines);

    // Count paid/unpaid items for summary
    var paidFeesCount = fees.Count(f => string.Equals(f.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase));
    var unpaidFeesCount = fees.Count - paidFeesCount;
    var paidFinesCount = fines.Count(f => string.Equals(f.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase));
    var unpaidFinesCount = fines.Count - paidFinesCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-features.css" asp-append-version="true" />
    <style>
        /* Existing styles for tabs etc. */
        .nav-tabs .nav-link {
            border: none;
            border-bottom: 3px solid transparent;
            color: #9ca3af;
            font-weight: 600;
        }

            .nav-tabs .nav-link.active {
                color: var(--gold-primary);
                border-bottom-color: var(--gold-primary);
                background: transparent;
            }

            .nav-tabs .nav-link:hover {
                border-bottom-color: var(--gold-primary);
                opacity: 0.8;
            }

        /* ========================================================= */
        /* Summary Stats at Top                                      */
        /* ========================================================= */
        .payment-summary-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
        }

        .stat-label {
            color: var(--text-main);
            font-size: 0.75rem;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            color: var(--text-strong);
            font-size: 1.5rem;
            font-weight: 700;
        }

        /* ========================================================= */
        /* Filter Controls                                           */
        /* ========================================================= */
        .filter-controls {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
        }

            .filter-btn:hover {
                background: rgba(255, 255, 255, 0.1);
                border-color: var(--gold-primary);
                color: var(--gold-primary);
            }

        /* ========================================================= */
        /* NEW: SIMPLE COLUMN LIST FOR PAYMENT HISTORY (NO RECEIPTS)  */
        /* Scoped to #transactionsList so it won't affect other pages */
        /* ========================================================= */

        /* keep original class name in markup, but override layout when .simple-list is added */
        #transactionsList.simple-list {
            display: flex !important;
            flex-direction: column !important;
            gap: 10px;
            padding: 12px 0;
            overflow-y: auto;
            max-height: calc(100vh - 400px);
        }

        #transactionsList .tx-row {
            display: grid;
            grid-template-columns: 1.6fr 0.8fr 0.6fr;
            gap: 12px;
            align-items: center;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 14px 16px;
        }

        /* Razor requires @@media */
        @@media (max-width: 768px) {
            #transactionsList .tx-row {
                grid-template-columns: 1fr;
                gap: 8px;
            }
        }

        #transactionsList .tx-main {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        #transactionsList .tx-title {
            font-weight: 700;
            color: var(--text-strong);
            font-size: 0.95rem;
        }

        #transactionsList .tx-sub {
            color: var(--text-main);
            opacity: 0.9;
            font-size: 0.82rem;
        }

        /* Middle column: ONLY Processed By + Date */
        #transactionsList .tx-meta {
            display: flex;
            flex-direction: column;
            gap: 6px;
            font-size: 0.82rem;
            color: var(--text-main);
            opacity: 0.9;
        }

        #transactionsList .tx-amount {
            text-align: right;
        }

            #transactionsList .tx-amount .amount {
                font-weight: 800;
                color: #34d399;
                font-size: 1.05rem;
            }

            #transactionsList .tx-amount .status {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                margin-top: 6px;
                background: rgba(16, 185, 129, 0.15);
                border: 1px solid rgba(16, 185, 129, 0.35);
                color: #34d399;
                padding: 5px 10px;
                border-radius: 999px;
                font-weight: 700;
                font-size: 0.75rem;
                text-transform: uppercase;
            }

        #transactionsList .tx-type {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 800;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            width: fit-content;
            padding: 4px 10px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-strong);
        }

            #transactionsList .tx-type.fee {
                border-color: rgba(251, 191, 36, 0.35);
                background: rgba(251, 191, 36, 0.10);
                color: #fbbf24;
            }

            #transactionsList .tx-type.fine {
                border-color: rgba(239, 68, 68, 0.35);
                background: rgba(239, 68, 68, 0.10);
                color: #f87171;
            }
    </style>
}

<!-- Balance Summary -->
<div class="row">
    <div class="col-12">
        <div class="glass-panel text-center">
            <p class="text-uppercase small text-muted mb-2">Current Balance Due</p>
            <h1 class="display-4 fw-bold" style="color: @(totalDue > 0 ? "#f87171" : "#34d399")">₱@totalDue.ToString("N2")</h1>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="glass-panel mt-4">
    <ul class="nav nav-tabs mb-4" id="financialTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="fees-tab" data-bs-toggle="tab" data-bs-target="#fees-content" type="button" role="tab">
                <i class="bi bi-receipt me-2"></i> Fees
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="fines-tab" data-bs-toggle="tab" data-bs-target="#fines-content" type="button" role="tab">
                <i class="bi bi-exclamation-octagon me-2"></i> Fines
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-content" type="button" role="tab">
                <i class="bi bi-clock-history me-2"></i> Payment History
            </button>
        </li>
    </ul>

    <div class="tab-content" id="financialTabsContent">
        <!-- FEES TAB -->
        <div class="tab-pane fade show active" id="fees-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-receipt me-2 text-gold"></i> Membership Fees</h5>
            <ul class="list-group">
                @if (fees.Any())
                {
                    @foreach (var fee in fees)
                    {
                        <li class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@fee.FeeName</h6>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold d-block">₱@fee.Amount?.ToString("N2")</span>
                                    @* SIMPLIFIED: Only show Paid or Unpaid *@
                                    @if (string.Equals(fee.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-success"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><i class="bi bi-hourglass-split"></i> Unpaid</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-2"></i>
                        <p class="mt-2 mb-0">No fees assigned yet.</p>
                    </li>
                }
            </ul>
        </div>

        <!-- FINES TAB -->
        <div class="tab-pane fade" id="fines-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-exclamation-octagon-fill me-2 text-danger"></i> Fines</h5>
            <ul class="list-group">
                @if (fines.Any())
                {
                    @foreach (var fine in fines)
                    {
                        <li class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@(fine.Description ?? $"Fine for {fine.Attendance?.Event?.EventName}")</h6>

                                    @* --- THIS LINE HAS BEEN REMOVED ---
                                        <small class="text-muted">Due: @fine.FinesDueDate?.ToString("MMM dd, yyyy")</small>
                                       --- END OF REMOVED CODE --- *@
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold d-block">₱@fine.Amount?.ToString("N2")</span>
                                    @* SIMPLIFIED: Only show Paid or Unpaid *@
                                    @if (string.Equals(fine.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-success"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><i class="bi bi-hourglass-split"></i> Unpaid</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4 text-muted">
                        <i class="bi bi-check-circle fs-2"></i>
                        <p class="mt-2 mb-0">No fines on your record. Great job!</p>
                    </li>
                }
            </ul>
        </div>

        <!-- PAYMENT HISTORY TAB -->
        <div class="tab-pane fade" id="history-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-clock-history me-2 text-gold"></i> Payment Transaction History</h5>

            <!-- Summary Statistics -->
            <div class="payment-summary-stats" id="paymentSummary" style="display: none;">
                <div class="stat-card">
                    <div class="stat-label">Total Paid</div>
                    <div class="stat-value text-success" id="totalPaidAmount">₱0.00</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Total Transactions</div>
                    <div class="stat-value" id="totalTransactions">0</div>
                </div>
            </div>

            <!-- Filter Controls -->
            <div class="filter-controls" id="filterControls" style="display: none;">
                <button class="filter-btn" onclick="filterTransactions('all', event)">
                    <i class="bi bi-list-ul"></i> All
                </button>
                <button class="filter-btn" onclick="filterTransactions('fee', event)">
                    <i class="bi bi-receipt"></i> Fees
                </button>
                <button class="filter-btn" onclick="filterTransactions('fine', event)">
                    <i class="bi bi-exclamation-octagon"></i> Fines
                </button>
            </div>

            <!-- Transactions List -->
            <div id="transactionsList" class="receipts-container">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading payment history...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allTransactions = [];
        let currentFilter = 'all';

        document.getElementById('history-tab').addEventListener('shown.bs.tab', function () {
            loadPaymentHistory();
        });
        if (document.getElementById('history-tab').classList.contains('active')) {
            loadPaymentHistory();
        }

        function loadPaymentHistory() {
            const container = document.getElementById('transactionsList');
            if (container.dataset.loaded === 'true') return;

            container.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading...</p></div>`;

            fetch('@Url.Action("GetPaymentHistory", "Student")')
                .then(response => response.json())
                .then(data => {
                    container.dataset.loaded = 'true';
                    if (data.success && data.transactions && data.transactions.length > 0) {
                        allTransactions = data.transactions;
                        updateSummaryStats();
                        renderTransactions(allTransactions);
                        document.getElementById('paymentSummary').style.display = 'grid';
                        document.getElementById('filterControls').style.display = 'flex';
                    } else {
                        container.innerHTML = `<div class="text-center py-5 text-muted"><i class="bi bi-inbox fs-2"></i><p class="mt-2 mb-0">No payment history.</p></div>`;
                    }
                })
                .catch(error => {
                    container.innerHTML = `<div class="text-center py-4 text-danger"><p>Error loading payment history.</p></div>`;
                });
        }

        function updateSummaryStats() {
            const totalAmount = allTransactions.reduce((sum, tx) => sum + parseFloat(tx.amount), 0);
            document.getElementById('totalPaidAmount').textContent = `₱${totalAmount.toFixed(2)}`;
            document.getElementById('totalTransactions').textContent = `${allTransactions.length} transaction${allTransactions.length !== 1 ? 's' : ''}`;
        }

        function filterTransactions(type, event) {
            currentFilter = type;
            let filtered = allTransactions;

            if (type === 'fee') {
                filtered = allTransactions.filter(tx => tx.type === 'Fee');
            } else if (type === 'fine') {
                filtered = allTransactions.filter(tx => tx.type === 'Fine');
            }

            renderTransactions(filtered);

            // Update active button (safe event usage)
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            if (event && event.target) {
                event.target.closest('.filter-btn').classList.add('active');
            }
        }

        // SIMPLE COLUMN LIST RENDER (no receipts)
        function renderTransactions(transactions) {
            const container = document.getElementById('transactionsList');

            // Force simple list layout (scoped)
            container.classList.add('simple-list');

            if (transactions.length === 0) {
                container.innerHTML = `<div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-2"></i>
                    <p class="mt-2 mb-0">No transactions found.</p>
                </div>`;
                return;
            }

            let html = '';

            transactions.forEach((tx) => {
                const isFine = tx.type === 'Fine';
                const paymentDate = new Date(tx.paymentDate);
                const formattedDate = paymentDate.toLocaleDateString('en-PH', {
                    timeZone: 'Asia/Manila',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
                const typeClass = isFine ? 'fine' : 'fee';
                const typeIcon = isFine ? 'bi-exclamation-octagon' : 'bi-receipt';

                html += `
                    <div class="tx-row" data-type="${tx.type.toLowerCase()}">
                        <div class="tx-main">
                            <div class="tx-type ${typeClass}">
                                <i class="bi ${typeIcon}"></i>
                                ${tx.type}
                            </div>

                            <div class="tx-title">
                                ${tx.description}
                            </div>

                            <div class="tx-sub">
                                ${tx.academicYear ? `AY ${tx.academicYear}` : ''}
                            </div>
                        </div>

                        <div class="tx-meta">
                            <div><i class="bi bi-person-check me-1"></i> Processed By: ${tx.processedBy || 'System'}</div>
                            <div><i class="bi bi-calendar-check me-1"></i> Date: ${formattedDate}</div>
                        </div>

                        <div class="tx-amount">
                            <div class="amount">₱${parseFloat(tx.amount).toFixed(2)}</div>
                            <div class="status"><i class="bi bi-check-circle-fill"></i> Paid</div>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }
    </script>
}
