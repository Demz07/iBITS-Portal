@{
    ViewData["Title"] = "My Financials";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var fees = ViewBag.Fees as List<iBITS_Portal.Models.Fee> ?? new List<iBITS_Portal.Models.Fee>();
    var fines = ViewBag.Fines as List<iBITS_Portal.Models.Fine> ?? new List<iBITS_Portal.Models.Fine>();

    // FIXED: Use case-insensitive comparison for status checks
    var totalFees = fees.Sum(f => f.Amount ?? 0);
    var totalFines = fines.Sum(f => f.Amount ?? 0);
    var paidFees = fees.Where(f => string.Equals(f.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase)).Sum(f => f.Amount ?? 0);
    var paidFines = fines.Where(f => string.Equals(f.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase)).Sum(f => f.Amount ?? 0);
    var totalDue = (totalFees + totalFines) - (paidFees + paidFines);

    // Count paid/unpaid items for summary
    var paidFeesCount = fees.Count(f => string.Equals(f.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase));
    var unpaidFeesCount = fees.Count - paidFeesCount;
    var paidFinesCount = fines.Count(f => string.Equals(f.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase));
    var unpaidFinesCount = fines.Count - paidFinesCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-features.css" asp-append-version="true" />
    <style>
        /* Existing styles for tabs etc. */
        .nav-tabs .nav-link {
            border: none;
            border-bottom: 3px solid transparent;
            color: #9ca3af;
            font-weight: 600;
        }

            .nav-tabs .nav-link.active {
                color: var(--gold-primary);
                border-bottom-color: var(--gold-primary);
                background: transparent;
            }

            .nav-tabs .nav-link:hover {
                border-bottom-color: var(--gold-primary);
                opacity: 0.8;
            }

        /* ========================================================= */
        /* COMPACT RECEIPT-STYLE CARD DESIGN WITH RANDOM COLORS      */
        /* ========================================================= */
        
        /* Summary Stats at Top */
        .payment-summary-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
        }

        .stat-label {
            color: var(--text-main);
            font-size: 0.75rem;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            color: var(--text-strong);
            font-size: 1.5rem;
            font-weight: 700;
        }

        /* Receipts Container - 2 Column Grid with Vertical Scroll */
        .receipts-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            padding: 20px 0;
            overflow-y: auto;
            max-height: calc(100vh - 400px);
        }

        /* Responsive: 1 column on mobile */
        @@media (max-width: 768px) {
            .receipts-container {
                grid-template-columns: 1fr;
                gap: 20px;
            }
        }

        /* Receipt Card Container - Grid Item */
        .receipt-card {
            width: 100%;
            max-width: none;
            margin: 0;
            background: rgba(255, 255, 255, 0.03);
            border: 1px dashed rgba(255, 255, 255, 0.3);
            border-radius: 10px;
            padding: 0;
            overflow: hidden;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
            transition: all 0.3s ease;
            font-family: 'Courier New', monospace;
        }

        .receipt-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        /* Custom scrollbar for receipts container */
        .receipts-container::-webkit-scrollbar {
            width: 8px;
        }

        .receipts-container::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }

        .receipts-container::-webkit-scrollbar-thumb {
            background: rgba(251, 191, 36, 0.5);
            border-radius: 4px;
        }

        .receipts-container::-webkit-scrollbar-thumb:hover {
            background: rgba(251, 191, 36, 0.7);
        }

        /* Receipt Header - BIGGER */
        .receipt-header {
            border-bottom: 2px dashed rgba(255, 255, 255, 0.3);
            padding: 20px 25px;
            text-align: center;
        }

        .receipt-title {
            color: var(--text-strong);
            font-size: 1.1rem;
            font-weight: 700;
            margin: 0 0 8px 0;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .receipt-id {
            color: var(--text-main);
            font-size: 0.85rem;
            margin: 0;
            opacity: 0.9;
        }

        /* Receipt Body - BIGGER */
        .receipt-body {
            padding: 25px 30px;
        }

        .receipt-type-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .receipt-divider {
            height: 2px;
            background: repeating-linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.3) 0px,
                rgba(255, 255, 255, 0.3) 5px,
                transparent 5px,
                transparent 10px
            );
            margin: 15px 0;
        }

        /* Receipt Details - BIGGER */
        .receipt-detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .receipt-detail-row:last-of-type {
            border-bottom: none;
        }

        .receipt-label {
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
            opacity: 0.95;
            font-size: 0.9rem;
        }

        .receipt-label i {
            font-size: 0.85rem;
        }

        .receipt-value {
            color: var(--text-strong);
            font-weight: 600;
            text-align: right;
            font-size: 0.95rem;
        }

        /* Receipt Footer - BIGGER */
        .receipt-footer {
            background: rgba(0, 0, 0, 0.3);
            border-top: 2px dashed rgba(255, 255, 255, 0.3);
            padding: 20px 30px;
        }

        .receipt-total {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .receipt-total-label {
            color: var(--text-main);
            font-size: 0.95rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .receipt-total-amount {
            color: #34d399;
            font-size: 2rem;
            font-weight: 700;
        }

        .receipt-status {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .receipt-status-label {
            color: var(--text-main);
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .receipt-status-badge {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            padding: 8px 20px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 8px rgba(16, 185, 129, 0.3);
        }

        .receipt-status-badge i {
            font-size: 0.85rem;
        }

        /* Filter Controls */
        .filter-controls {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .filter-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--gold-primary);
            color: var(--gold-primary);
        }

    </style>
}
<!-- Balance Summary -->
<div class="row">
    <div class="col-12">
        <div class="glass-panel text-center">
            <p class="text-uppercase small text-muted mb-2">Current Balance Due</p>
            <h1 class="display-4 fw-bold" style="color: @(totalDue > 0 ? "#f87171" : "#34d399")">₱@totalDue.ToString("N2")</h1>

        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="glass-panel mt-4">
    <ul class="nav nav-tabs mb-4" id="financialTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="fees-tab" data-bs-toggle="tab" data-bs-target="#fees-content" type="button" role="tab">
                <i class="bi bi-receipt me-2"></i> Fees
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="fines-tab" data-bs-toggle="tab" data-bs-target="#fines-content" type="button" role="tab">
                <i class="bi bi-exclamation-octagon me-2"></i> Fines
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-content" type="button" role="tab">
                <i class="bi bi-clock-history me-2"></i> Payment History
            </button>
        </li>
    </ul>

    <div class="tab-content" id="financialTabsContent">
        <!-- FEES TAB -->
        <div class="tab-pane fade show active" id="fees-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-receipt me-2 text-gold"></i> Membership Fees</h5>
            <ul class="list-group">
                @if (fees.Any())
                {
                    @foreach (var fee in fees)
                    {
                        <li class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@fee.FeeName</h6>

                                </div>
                                <div class="text-end">
                                    <span class="fw-bold d-block">₱@fee.Amount?.ToString("N2")</span>
                                    @* FIXED: Use case-insensitive comparison *@
                                    @if (string.Equals(fee.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-success"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><i class="bi bi-hourglass-split"></i> Unpaid</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-2"></i>
                        <p class="mt-2 mb-0">No fees assigned yet.</p>
                    </li>
                }
            </ul>
        </div>

        <!-- FINES TAB -->
        <div class="tab-pane fade" id="fines-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-exclamation-octagon-fill me-2 text-danger"></i> Fines</h5>
            <ul class="list-group">
                @if (fines.Any())
                {
                    @foreach (var fine in fines)
                    {
                        <li class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@(fine.Description ?? $"Fine for {fine.Attendance?.Event?.EventName}")</h6>

                                    @* --- THIS LINE HAS BEEN REMOVED ---
                            <small class="text-muted">Due: @fine.FinesDueDate?.ToString("MMM dd, yyyy")</small>
                            --- END OF REMOVED CODE --- *@
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold d-block">₱@fine.Amount?.ToString("N2")</span>
                                    @if (string.Equals(fine.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-success"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><i class="bi bi-hourglass-split"></i> Unpaid</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4 text-muted">
                        <i class="bi bi-check-circle fs-2"></i>
                        <p class="mt-2 mb-0">No fines on your record. Great job!</p>
                    </li>
                }
            </ul>

        </div>

        <!-- PAYMENT HISTORY TAB -->
        <div class="tab-pane fade" id="history-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-clock-history me-2 text-gold"></i> Payment Transaction History</h5>
            
            <!-- Summary Statistics -->
            <div class="payment-summary-stats" id="paymentSummary" style="display: none;">
                <div class="stat-card">
                    <div class="stat-label">Total Paid</div>
                    <div class="stat-value text-success" id="totalPaidAmount">₱0.00</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Total Transactions</div>
                    <div class="stat-value" id="totalTransactions">0</div>
                </div>
            </div>

            <!-- Filter Controls -->
            <div class="filter-controls" id="filterControls" style="display: none;">
                <button class="filter-btn" onclick="filterTransactions('all')">
                    <i class="bi bi-list-ul"></i> All
                </button>
                <button class="filter-btn" onclick="filterTransactions('fee')">
                    <i class="bi bi-receipt"></i> Fees
                </button>
                <button class="filter-btn" onclick="filterTransactions('fine')">
                    <i class="bi bi-exclamation-octagon"></i> Fines
                </button>
            </div>

            <!-- Transactions List -->
            <div id="transactionsList" class="receipts-container">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading payment history...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allTransactions = [];
        let currentFilter = 'all';

        document.getElementById('history-tab').addEventListener('shown.bs.tab', function() {
            loadPaymentHistory();
        });
        if(document.getElementById('history-tab').classList.contains('active')){
            loadPaymentHistory();
        }

        function loadPaymentHistory() {
            const container = document.getElementById('transactionsList');
            if(container.dataset.loaded === 'true') return;

            container.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading...</p></div>`;

            fetch('@Url.Action("GetPaymentHistory", "Student")')
                .then(response => response.json())
                .then(data => {
                    container.dataset.loaded = 'true';
                    if (data.success && data.transactions && data.transactions.length > 0) {
                        allTransactions = data.transactions;
                        updateSummaryStats();
                        renderTransactions(allTransactions);
                        document.getElementById('paymentSummary').style.display = 'grid';
                        document.getElementById('filterControls').style.display = 'flex';
                    } else {
                        container.innerHTML = `<div class="text-center py-5 text-muted"><i class="bi bi-inbox fs-2"></i><p class="mt-2 mb-0">No payment history.</p></div>`;
                    }
                })
                .catch(error => {
                    container.innerHTML = `<div class="text-center py-4 text-danger"><p>Error loading payment history.</p></div>`;
                });
        }

        function updateSummaryStats() {
            const totalAmount = allTransactions.reduce((sum, tx) => sum + parseFloat(tx.amount), 0);
            document.getElementById('totalPaidAmount').textContent = `₱${totalAmount.toFixed(2)}`;
            document.getElementById('totalTransactions').textContent = `${allTransactions.length} transaction${allTransactions.length !== 1 ? 's' : ''}`;
        }

        function filterTransactions(type) {
            currentFilter = type;
            let filtered = allTransactions;
            
            if (type === 'fee') {
                filtered = allTransactions.filter(tx => tx.type === 'Fee');
            } else if (type === 'fine') {
                filtered = allTransactions.filter(tx => tx.type === 'Fine');
            }
            
            renderTransactions(filtered);

            // Update active button
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            event.target.closest('.filter-btn').classList.add('active');
        }

        // Random color generator for receipts
        function getRandomReceiptColor() {
            const colors = [
                { header: 'linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(37, 99, 235, 0.1))', badge: 'rgba(59, 130, 246, 0.25)', badgeText: '#60a5fa', border: 'rgba(59, 130, 246, 0.3)' },
                { header: 'linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(147, 51, 234, 0.1))', badge: 'rgba(168, 85, 247, 0.25)', badgeText: '#a78bfa', border: 'rgba(168, 85, 247, 0.3)' },
                { header: 'linear-gradient(135deg, rgba(236, 72, 153, 0.15), rgba(219, 39, 119, 0.1))', badge: 'rgba(236, 72, 153, 0.25)', badgeText: '#f472b6', border: 'rgba(236, 72, 153, 0.3)' },
                { header: 'linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(245, 158, 11, 0.1))', badge: 'rgba(251, 191, 36, 0.25)', badgeText: '#fbbf24', border: 'rgba(251, 191, 36, 0.3)' },
                { header: 'linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(5, 150, 105, 0.1))', badge: 'rgba(16, 185, 129, 0.25)', badgeText: '#34d399', border: 'rgba(16, 185, 129, 0.3)' },
                { header: 'linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(220, 38, 38, 0.1))', badge: 'rgba(239, 68, 68, 0.25)', badgeText: '#f87171', border: 'rgba(239, 68, 68, 0.3)' },
                { header: 'linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(2, 132, 199, 0.1))', badge: 'rgba(14, 165, 233, 0.25)', badgeText: '#38bdf8', border: 'rgba(14, 165, 233, 0.3)' },
                { header: 'linear-gradient(135deg, rgba(234, 88, 12, 0.15), rgba(194, 65, 12, 0.1))', badge: 'rgba(234, 88, 12, 0.25)', badgeText: '#fb923c', border: 'rgba(234, 88, 12, 0.3)' },
                { header: 'linear-gradient(135deg, rgba(20, 184, 166, 0.15), rgba(13, 148, 136, 0.1))', badge: 'rgba(20, 184, 166, 0.25)', badgeText: '#2dd4bf', border: 'rgba(20, 184, 166, 0.3)' },
                { header: 'linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(124, 58, 237, 0.1))', badge: 'rgba(139, 92, 246, 0.25)', badgeText: '#a78bfa', border: 'rgba(139, 92, 246, 0.3)' }
            ];
            return colors[Math.floor(Math.random() * colors.length)];
        }


        function renderTransactions(transactions) {
            const container = document.getElementById('transactionsList');
            
            if (transactions.length === 0) {
                container.innerHTML = `<div class="text-center py-5 text-muted"><i class="bi bi-inbox fs-2"></i><p class="mt-2 mb-0">No transactions found.</p></div>`;
                return;
            }

            let html = '';
            let transactionNumber = transactions.length;
            
            transactions.forEach((tx) => {
                const isFine = tx.type === 'Fine';
                const paymentDate = new Date(tx.paymentDate);
                const formattedDate = paymentDate.toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                });
                const formattedTime = paymentDate.toLocaleTimeString('en-US', { 
                    hour: 'numeric', 
                    minute: '2-digit',
                    hour12: true 
                });

                // Get random color for this receipt
                const color = getRandomReceiptColor();

                html += `
                    <div class="receipt-card" data-type="${tx.type.toLowerCase()}">
                        <!-- Receipt Header -->
                        <div class="receipt-header" style="background: ${color.header};">
                            <h5 class="receipt-title">
                                <i class="bi bi-receipt-cutoff"></i> PAYMENT RECEIPT
                            </h5>
                            <p class="receipt-id">Transaction #${String(transactionNumber).padStart(3, '0')}</p>
                        </div>

                        <!-- Receipt Body -->
                        <div class="receipt-body">
                            <!-- Type Badge -->
                            <div class="receipt-type-badge" style="background: ${color.badge}; color: ${color.badgeText}; border: 1px solid ${color.border};">
                                <i class="bi ${isFine ? 'bi-exclamation-octagon' : 'bi-receipt'}"></i>
                                ${tx.type}: ${tx.description}
                            </div>

                            <div class="receipt-divider"></div>

                            <!-- Transaction Details -->
                            <div class="receipt-details">
                                <div class="receipt-detail-row">
                                    <span class="receipt-label">
                                        <i class="bi bi-calendar-check"></i> Date
                                    </span>
                                    <span class="receipt-value">${formattedDate}</span>
                                </div>

                                <div class="receipt-detail-row">
                                    <span class="receipt-label">
                                        <i class="bi bi-clock"></i> Time
                                    </span>
                                    <span class="receipt-value">${formattedTime}</span>
                                </div>

                                <div class="receipt-detail-row">
                                    <span class="receipt-label">
                                        <i class="bi bi-person-check"></i> Processed By
                                    </span>
                                    <span class="receipt-value">${tx.processedBy || 'System'}</span>
                                </div>

                                <div class="receipt-detail-row">
                                    <span class="receipt-label">
                                        <i class="bi bi-cash-coin"></i> Payment Method
                                    </span>
                                    <span class="receipt-value">Cash</span>
                                </div>

                                ${tx.academicYear ? `
                                <div class="receipt-detail-row">
                                    <span class="receipt-label">
                                        <i class="bi bi-book"></i> Academic Year
                                    </span>
                                    <span class="receipt-value">${tx.academicYear}</span>
                                </div>
                                ` : ''}
                            </div>

                            <div class="receipt-divider"></div>
                        </div>

                        <!-- Receipt Footer -->
                        <div class="receipt-footer">
                            <div class="receipt-total">
                                <span class="receipt-total-label">Amount Paid:</span>
                                <span class="receipt-total-amount">₱${parseFloat(tx.amount).toFixed(2)}</span>
                            </div>
                            <div class="receipt-status">
                                <span class="receipt-status-label">Status:</span>
                                <span class="receipt-status-badge">
                                    <i class="bi bi-check-circle-fill"></i> PAID
                                </span>
                            </div>
                        </div>
                    </div>
                `;
                transactionNumber--;
            });
            
            container.innerHTML = html;
        }
    </script>
}

