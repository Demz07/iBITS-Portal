@* FILE PATH: Views/Student/Financials.cshtml *@
@* FIXED: Improved payment status display and calculations *@
@{
    ViewData["Title"] = "My Financials";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var fees = ViewBag.Fees as List<iBITS_Portal.Models.Fee> ?? new List<iBITS_Portal.Models.Fee>();
    var fines = ViewBag.Fines as List<iBITS_Portal.Models.Fine> ?? new List<iBITS_Portal.Models.Fine>();

    // FIXED: Use case-insensitive comparison for status checks
    var totalFees = fees.Sum(f => f.Amount ?? 0);
    var totalFines = fines.Sum(f => f.Amount ?? 0);
    var paidFees = fees.Where(f => string.Equals(f.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase)).Sum(f => f.Amount ?? 0);
    var paidFines = fines.Where(f => string.Equals(f.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase)).Sum(f => f.Amount ?? 0);
    var totalDue = (totalFees + totalFines) - (paidFees + paidFines);

    // Count paid/unpaid items for summary
    var paidFeesCount = fees.Count(f => string.Equals(f.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase));
    var unpaidFeesCount = fees.Count - paidFeesCount;
    var paidFinesCount = fines.Count(f => string.Equals(f.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase));
    var unpaidFinesCount = fines.Count - paidFinesCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-features.css" asp-append-version="true" />
    <style>
        /* Existing styles for tabs etc. */
        .nav-tabs .nav-link {
            border: none;
            border-bottom: 3px solid transparent;
            color: #9ca3af;
            font-weight: 600;
        }

            .nav-tabs .nav-link.active {
                color: var(--gold-primary);
                border-bottom-color: var(--gold-primary);
                background: transparent;
            }

            .nav-tabs .nav-link:hover {
                border-bottom-color: var(--gold-primary);
                opacity: 0.8;
            }

        /* ========================================================= */
        /* Updated STYLES for short vertical border strip */
        /* ========================================================= */
        .financial-item {
            display: grid;
            grid-template-columns: 3fr 2fr 1fr 1fr;
            align-items: center;
            gap: 1rem;
            background: rgba(255, 255, 255, 0.05);
            padding: 16px 20px;
            border-radius: 12px;
            margin-bottom: 12px;
            position: relative;
            overflow: hidden;
        }

            .financial-item::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 0;
                width: 4px;
                height: 50%;
                transform: translateY(-50%);
                border-radius: 0 4px 4px 0;
            }

        .item-fee::before {
            background-color: #3b82f6;
        }

        .item-fine::before {
            background-color: var(--gold-primary);
        }

        /* Existing Column and Header Styles */
        .financial-col {
            display: flex;
            flex-direction: column;
        }

        .col-header {
            font-size: 0.75rem;
            color: var(--text-main);
            margin-bottom: 4px;
            text-transform: uppercase;
        }

        .col-value {
            font-weight: 600;
            color: var(--text-strong);
        }

        .col-amount .col-value {
            font-size: 1.2rem;
        }

        /* Column-specific alignment */
        .col-description {
            text-align: left;
        }

        .col-processedby, .col-status {
            text-align: center;
        }

        .col-amount {
            text-align: right;
        }

        /* ========================================================= */
        /* UPDATED: BADGE STYLES (Shortened Padding)                 */
        /* ========================================================= */
        .badge-type {
            padding: 2px 6px; /* REDUCED horizontal padding (from 4px 10px to 2px 6px) */
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 4px;
        }

        .badge-type-fee {
            background: #3b82f6;
            color: white;
        }

        .badge-type-fine {
            background: var(--gold-primary);
            color: black;
        }

        .status-paid {
            background: #10b981;
            color: white;
            padding: 5px 16px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.8rem;
            display: inline-block;
        }
    </style>
}
}
<!-- Balance Summary -->
<div class="row">
    <div class="col-12">
        <div class="glass-panel text-center">
            <p class="text-uppercase small text-muted mb-2">Current Balance Due</p>
            <h1 class="display-4 fw-bold" style="color: @(totalDue > 0 ? "#f87171" : "#34d399")">₱@totalDue.ToString("N2")</h1>

        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="glass-panel mt-4">
    <ul class="nav nav-tabs mb-4" id="financialTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="fees-tab" data-bs-toggle="tab" data-bs-target="#fees-content" type="button" role="tab">
                <i class="bi bi-receipt me-2"></i> Fees
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="fines-tab" data-bs-toggle="tab" data-bs-target="#fines-content" type="button" role="tab">
                <i class="bi bi-exclamation-octagon me-2"></i> Fines
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-content" type="button" role="tab">
                <i class="bi bi-clock-history me-2"></i> Payment History
            </button>
        </li>
    </ul>

    <div class="tab-content" id="financialTabsContent">
        <!-- FEES TAB -->
        <div class="tab-pane fade show active" id="fees-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-receipt me-2 text-gold"></i> Membership Fees</h5>
            <ul class="list-group">
                @if (fees.Any())
                {
                    @foreach (var fee in fees)
                    {
                        <li class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@fee.FeeName</h6>

                                </div>
                                <div class="text-end">
                                    <span class="fw-bold d-block">₱@fee.Amount?.ToString("N2")</span>
                                    @* FIXED: Use case-insensitive comparison *@
                                    @if (string.Equals(fee.FeeStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-success"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><i class="bi bi-hourglass-split"></i> Unpaid</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-2"></i>
                        <p class="mt-2 mb-0">No fees assigned yet.</p>
                    </li>
                }
            </ul>
        </div>

        <!-- FINES TAB -->
        <div class="tab-pane fade" id="fines-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-exclamation-octagon-fill me-2 text-danger"></i> Fines</h5>
            <ul class="list-group">
                @if (fines.Any())
                {
                    @foreach (var fine in fines)
                    {
                        <li class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1">@(fine.Description ?? $"Fine for {fine.Attendance?.Event?.EventName}")</h6>

                                    @* --- THIS LINE HAS BEEN REMOVED ---
                            <small class="text-muted">Due: @fine.FinesDueDate?.ToString("MMM dd, yyyy")</small>
                            --- END OF REMOVED CODE --- *@
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold d-block">₱@fine.Amount?.ToString("N2")</span>
                                    @if (string.Equals(fine.FinesStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-success"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><i class="bi bi-hourglass-split"></i> Unpaid</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4 text-muted">
                        <i class="bi bi-check-circle fs-2"></i>
                        <p class="mt-2 mb-0">No fines on your record. Great job!</p>
                    </li>
                }
            </ul>

        </div>

        <!-- PAYMENT HISTORY TAB -->
        <div class="tab-pane fade" id="history-content" role="tabpanel">
            <h5 class="glass-header-title mb-3"><i class="bi bi-clock-history me-2 text-gold"></i> Payment Transaction History</h5>
            <div id="transactionsList">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading payment history...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('history-tab').addEventListener('shown.bs.tab', function() {
            loadPaymentHistory();
        });
        if(document.getElementById('history-tab').classList.contains('active')){
            loadPaymentHistory();
        }

        function loadPaymentHistory() {
            const container = document.getElementById('transactionsList');
            if(container.dataset.loaded === 'true') return;

            container.innerHTML = `<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Loading...</p></div>`;

            fetch('@Url.Action("GetPaymentHistory", "Student")')
                .then(response => response.json())
                .then(data => {
                    container.dataset.loaded = 'true';
                    if (data.success && data.transactions && data.transactions.length > 0) {
                        let html = '';
                        data.transactions.forEach(tx => {
                            const isFine = tx.type === 'Fine';

                            // UPDATED HTML TEMPLATE: Removed all date columns and subtitles
                            html += `
                                <div class="financial-item ${isFine ? 'item-fine' : 'item-fee'}">
                                    <!-- Column 1: Description -->
                                    <div class="financial-col col-description">
                                        <span class="badge-type ${isFine ? 'badge-type-fine' : 'badge-type-fee'}"><i class="bi ${isFine ? 'bi-exclamation-octagon' : 'bi-receipt'}"></i> ${tx.type}</span>
                                        <span class="col-value">${tx.description}</span>
                                    </div>
                                    <!-- Column 2: Processed By -->
                                    <div class="financial-col col-processedby">
                                        <span class="col-header">Processed By</span>
                                        <span class="col-value"><i class="bi bi-person-check me-1"></i> ${tx.processedBy || 'System'}</span>
                                    </div>
                                    <!-- Column 3: Status -->
                                    <div class="financial-col col-status">
                                        <span class="col-header">Status</span>
                                        <span class="status-paid">Paid</span>
                                    </div>
                                    <!-- Column 4: Amount -->
                                    <div class="financial-col col-amount">
                                        <span class="col-header">Amount</span>
                                        <span class="col-value" style="color:#34d399;">₱${parseFloat(tx.amount).toFixed(2)}</span>
                                    </div>
                                </div>
                            `;
                        });
                        container.innerHTML = html;
                    } else {
                        container.innerHTML = `<div class="text-center py-5 text-muted"><i class="bi bi-inbox fs-2"></i><p class="mt-2 mb-0">No payment history.</p></div>`;
                    }
                })
                .catch(error => {
                    container.innerHTML = `<div class="text-center py-4 text-danger"><p>Error loading payment history.</p></div>`;
                });
        }
    </script>
}

