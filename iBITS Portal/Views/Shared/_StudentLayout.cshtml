@* ============================================================ *@
@* FILE PATH: Views/Shared/_StudentLayout.cshtml                *@
@* ============================================================ *@
@* FIXED: Added spaces to all User.IsInRole() checks to match *@
@* the official role names (e.g., "Org Secretary").             *@
@* ============================================================ *@

@using Microsoft.AspNetCore.Identity
@using iBITS_Portal.ViewModels
@inject SignInManager<IdentityUser> SignInManager
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - iBITS Portal</title>

    <!-- CSS LIBRARIES -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- CUSTOM STYLES -->
    <link rel="stylesheet" href="~/css/portal-layout.css" />

    <!-- Academic Year Badge Styles (Read-Only for Students) - Glass Blur Effect -->
    <style>
        .academic-year-badge {
            background: rgba(11, 26, 51, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.4);
            border-radius: 12px;
            padding: 10px 18px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            transition: all 0.3s ease;
        }

            .academic-year-badge:hover {
                border-color: rgba(212, 175, 55, 0.6);
                box-shadow: 0 6px 25px rgba(212, 175, 55, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.08);
            }

            .academic-year-badge i {
                font-size: 1.3rem !important;
            }

        .academic-year-text {
            color: var(--gold-primary);
            font-weight: 700;
            font-size: 1rem;
            letter-spacing: 0.5px;
        }

        /* Light theme adjustments */
        [data-theme="light"] .academic-year-badge {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-color: rgba(212, 175, 55, 0.5);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.5);
        }

        [data-theme="light"] .academic-year-text {
            color: #b8860b;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="wrapper">
        <!-- SIDEBAR -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <img src="~/images/logo.png" alt="iBITS Logo" class="sidebar-logo-img">
                <div class="sidebar-brand">iBITS <span>PORTAL</span></div>
                <div class="sidebar-role">Student Command Center</div>
            </div>

            <ul class="list-unstyled components">
                @{
                    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                }
                <!-- ================== BASE STUDENT LINKS (Always Visible) ================== -->
                <li class="@(controller == "Home" && action == "Index" ? "active" : "")">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
                </li>
                <li class="@(controller == "Student" && action == "Events" ? "active" : "")">
                    <a asp-controller="Student" asp-action="Events"><i class="bi bi-calendar-event-fill"></i> Events</a>
                </li>
                <li class="@(controller == "Student" && action == "Timeline" ? "active" : "")">
                    <a asp-controller="Student" asp-action="Timeline"><i class="bi bi-calendar-check-fill"></i> Participation Timeline</a>
                </li>
                <li class="@(controller == "Student" && action == "Financials" ? "active" : "")">
                    <a asp-controller="Student" asp-action="Financials"><i class="bi bi-wallet2"></i> My Financials</a>
                </li>


                <!-- ================== ROLE-BASED OFFICER LINKS (Dynamically Shown) ================== -->
                <!-- TREASURER FEATURES (Updated) -->
                @if (User.IsInRole("Class Treasurer") || User.IsInRole("Org Treasurer"))
                {
                    <li class="@(controller == "Officer" && action == "Payments" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="Payments"><i class="bi bi-cash-stack"></i> Payments & Fees</a>
                    </li>
                   
                }


                <!-- SECRETARY FEATURES -->
                @if (User.IsInRole("Class Secretary") || User.IsInRole("Org Secretary"))
                {
                    <li class="@(controller == "Officer" && action == "Scanner" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="Scanner"><i class="bi bi-qr-code-scan"></i> QR Attendance Scanner</a>
                    </li>
                }

                <!-- ORG SECRETARY ONLY FEATURES -->
                @if (User.IsInRole("Org Secretary"))
                {
                    <li class="@(controller == "Excuse" && action == "ManageExcuses" ? "active" : "")">
                        <a asp-controller="Excuse" asp-action="ManageExcuses"><i class="bi bi-file-earmark-medical"></i> Manage Excuses</a>
                    </li>
                    <li class="@(controller == "Excuse" && action == "AllExcuses" ? "active" : "")">
                        <a asp-controller="Excuse" asp-action="AllExcuses"><i class="bi bi-list-ul"></i> All Excuses</a>
                    </li>
                }



                <!-- ORGANIZATION TREASURER ONLY FEATURES -->
                @if (User.IsInRole("Org Treasurer"))
                {
                    <li class="@(controller == "Officer" && action == "FeeManagement" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="FeeManagement"><i class="bi bi-sliders"></i> Fee Management</a>
                    </li>
                }

                <!-- EXECUTIVE BOARD / "Officer" ROLE FEATURES -->
                @if (User.IsInRole("Officer"))
                {
                    <li class="@(controller == "Officer" && action == "Announcements" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="Announcements"><i class="bi bi-megaphone"></i> Announcements</a>
                    </li>
                    <li class="@(controller == "Officer" && action == "EventManagement" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="EventManagement"><i class="bi bi-calendar-event-fill"></i> Event Management</a>
                    </li>
                }

                <!-- ADMIN / SYSTEM FEATURES -->
            </ul>

            <div style="padding: 20px;">
                <!-- The hidden form that will be triggered by the modal -->
                <form id="logoutForm" class="form-inline d-none" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"></form>

                <!-- The button that the user clicks, which now opens the modal -->
                <button type="button" class="btn-logout-custom" data-bs-toggle="modal" data-bs-target="#confirmLogoutModal">
                    <i class="bi bi-box-arrow-left"></i> Sign Out
                </button>
            </div>
        </nav>

        <!-- MAIN CONTENT WRAPPER -->
        <div id="content">
            <!-- Fixed Navbar -->
            <div class="admin-navbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" id="sidebarCollapse" class="btn-toggle"><i class="bi bi-list"></i></button>
                    <div class="d-flex align-items-center gap-3">
                        <img src="~/images/pup-logo.png" alt="PUP Logo" class="pup-nav-logo">
                        <div class="d-none d-sm-block">
                            <div class="pup-nav-title">POLYTECHNIC UNIVERSITY OF THE PHILIPPINES</div>
                            <div class="pup-nav-sub">LOPEZ, QUEZON CAMPUS</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <!-- Academic Year Display (Read-Only for Students) -->
                    <div class="academic-year-badge d-none d-md-flex align-items-center gap-2" title="Current Academic Year">
                        <i class="bi bi-calendar-range" style="color: var(--gold-primary); font-size: 1rem;"></i>
                        <span id="currentAcademicYear" class="academic-year-text">
                            @(ViewBag.CurrentAcademicYear ?? $"A.Y. {DateTime.Now.Year}-{DateTime.Now.Year + 1}")
                        </span>
                    </div>
                    <div class="vr d-none d-md-block" style="height: 30px; opacity: 0.3;"></div>
                    <div class="d-none d-md-block text-end">
                        <div style="font-weight:bold; color:var(--text-strong);">@User.Identity?.Name</div>
                        <div style="font-size:0.75rem; color:var(--gold-text);">Member Access</div>
                    </div>
                    <button type="button" id="themeToggle" class="btn-toggle theme-btn" title="Toggle Theme">
                        <i class="bi bi-sun-fill" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Scrollable Content Area -->
            <div class="scrollable-content">
                @RenderBody()
            </div>
        </div>
    </div>

    @{
        var logoutModal = new ConfirmationModalViewModel
        {
            ModalId = "confirmLogoutModal",
            ModalTitle = "Confirm Sign Out",
            ModalBody = "Are you sure you want to end your current session?",
            ConfirmButtonText = "Sign Out",
            ConfirmButtonClass = "btn btn-danger"
        };
    }
    <partial name="_ConfirmationModal" model="logoutModal" />

    <!-- INACTIVITY WARNING MODAL -->
    <div class="modal fade" id="inactivityWarning" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Session Timeout Warning
                    </h5>
                </div>
                <div class="modal-body text-center">
                    <i class="bi bi-clock-history text-warning mb-3" style="font-size: 3rem;"></i>
                    <h5 style="color: var(--text-strong);">Your session is about to expire</h5>
                    <p class="text-muted">
                        You have been inactive for 4 minutes. You will be automatically logged out in 1 minute unless you resume activity.
                    </p>
                    <div class="mt-3">
                        <button type="button" class="btn btn-warning fw-bold px-4" onclick="resetTimer()">
                            <i class="bi bi-arrow-clockwise me-2"></i> Keep Me Logged In
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SESSION EXPIRED MODAL (SOFT LOCK) -->
    <div class="modal fade" id="sessionExpiredModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal text-center p-4" style="border: 1px solid var(--gold-primary);">
                <div class="modal-body">
                    <div class="mb-3">
                        <i class="bi bi-shield-lock-fill text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="fw-bold" style="color:var(--text-strong);">Session Expired</h4>
                    <p class="text-muted mb-4">
                        For security reasons, your session has been locked due to extended inactivity.
                        <br>Please log in again to continue.
                    </p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-gold w-100 py-2 fw-bold">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Log In Again
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- CUSTOM SCRIPTS -->
    <script src="~/js/portal-layout.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>