@* ============================================================ *@
@* FILE PATH: Views/Shared/_StudentLayout.cshtml                *@
@* ============================================================ *@
@* FIXED: Added spaces to all User.IsInRole() checks to match *@
@* the official role names (e.g., "Org Secretary").             *@
@* ============================================================ *@

@using Microsoft.AspNetCore.Identity
@using iBITS_Portal.ViewModels
@inject SignInManager<IdentityUser> SignInManager
@{
    Layout = null;
    string displayRole = "Member";
    
    // Priority order: Most specific roles first
    if (User.IsInRole("Admin"))
    {
        displayRole = "Admin";
    }
    else if (User.IsInRole("Org Treasurer"))
    {
        displayRole = "Org Treasurer";
    }
    else if (User.IsInRole("Class Treasurer"))
    {
        displayRole = "Class Treasurer";
    }
    else if (User.IsInRole("Org Secretary"))
    {
        displayRole = "Org Secretary";
    }
    else if (User.IsInRole("Class Secretary"))
    {
        displayRole = "Class Secretary";
    }
    else if (User.IsInRole("Officer"))
    {
        displayRole = "Officer";
    }
    
    // Determine if user is an officer who can switch semesters
    bool canSwitchSemester = User.IsInRole("Org Treasurer") 
        || User.IsInRole("Class Treasurer") 
        || User.IsInRole("Org Secretary") 
        || User.IsInRole("Class Secretary");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - iBITS Portal</title>

    <!-- CSS LIBRARIES -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- CUSTOM STYLES -->
    <link rel="stylesheet" href="~/css/portal-layout.css" />

    <!-- Academic Year Badge Styles (Read-Only for Students) - Glass Blur Effect -->
    <style>
        .academic-year-badge {
            background: rgba(11, 26, 51, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.4);
            border-radius: 12px;
            padding: 10px 18px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            transition: all 0.3s ease;
        }

            .academic-year-badge:hover {
                border-color: rgba(212, 175, 55, 0.6);
                box-shadow: 0 6px 25px rgba(212, 175, 55, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.08);
            }

            .academic-year-badge i {
                font-size: 1.3rem !important;
            }

        .academic-year-text {
            color: var(--gold-primary);
            font-weight: 700;
            font-size: 1rem;
            letter-spacing: 0.5px;
        }

        /* Light theme adjustments */
        [data-theme="light"] .academic-year-badge {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-color: rgba(212, 175, 55, 0.5);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.5);
        }

        [data-theme="light"] .academic-year-text {
            color: #b8860b;
        }

        /* Navigation Section Headers */
        .nav-section-header {
            padding: 15px 20px 8px 20px !important;
            margin-top: 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

            .nav-section-header:first-of-type {
                border-top: none;
                margin-top: 5px;
            }

            .nav-section-header span {
                font-size: 0.7rem;
                letter-spacing: 1px;
                opacity: 0.8;
            }

                .nav-section-header span i {
                    font-size: 0.65rem;
                }

        /* Light theme for nav section headers */
        [data-theme="light"] .nav-section-header {
            border-top-color: rgba(0, 0, 0, 0.08);
        }

        /* Semester Selector for Officers */
        .semester-selector-wrapper {
            background: rgba(11, 26, 51, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.4);
            border-radius: 12px;
            padding: 10px 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            transition: all 0.3s ease;
        }

        .semester-selector-wrapper.historical-mode {
            border-color: rgba(255, 193, 7, 0.6);
            background: rgba(255, 193, 7, 0.1);
        }

        .semester-dropdown {
            background: transparent !important;
            border: none !important;
            color: var(--gold-primary) !important;
            font-weight: 700;
            font-size: 0.95rem;
            min-width: 260px;
        }

        .semester-dropdown option {
            background: var(--bg-primary);
            color: var(--text-strong);
        }

        /* Light theme adjustments */
        [data-theme="light"] .semester-selector-wrapper {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-color: rgba(212, 175, 55, 0.5);
        }

        [data-theme="light"] .semester-dropdown {
            color: #b8860b !important;
        }

        #historicalModeIndicator {
            animation: fadeInSlide 0.3s ease;
        }

        @@keyframes fadeInSlide {
            from { opacity: 0; transform: translateX(-10px); }
            to { opacity: 1; transform: translateX(0); }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="wrapper">
        <!-- SIDEBAR -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <img src="~/images/logo.png" alt="iBITS Logo" class="sidebar-logo-img">
                <div class="sidebar-brand">iBITS <span>PORTAL</span></div>
                <div class="sidebar-role">@displayRole</div>
            </div>

            <ul class="list-unstyled components">
                @{
                    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                }
                <!-- ================== BASE STUDENT LINKS (Always Visible) ================== -->
                <li class="@(controller == "Home" && action == "Index" ? "active" : "")">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
                </li>
                <li class="@(controller == "Student" && action == "Timeline" ? "active" : "")">
                    <a asp-controller="Student" asp-action="Timeline"><i class="bi bi-calendar-check-fill"></i> Participation Timeline</a>
                </li>
                <li class="@(controller == "Student" && action == "Financials" ? "active" : "")">
                    <a asp-controller="Student" asp-action="Financials"><i class="bi bi-wallet2"></i> My Financials</a>
                </li>


                <!-- ================== ROLE-BASED OFFICER LINKS (Dynamically Shown) ================== -->
                <!-- ORG TREASURER FEATURES -->
                @if (User.IsInRole("Org Treasurer"))
                {
                    <li class="nav-section-header">
                        <span class="text-gold small text-uppercase fw-bold"><i class="bi bi-bank me-1"></i> Org Treasury</span>
                    </li>
                    <li class="@(controller == "Officer" && action == "OrgTreasurerDashboard" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="OrgTreasurerDashboard"><i class="bi bi-speedometer2"></i> Treasury Dashboard</a>
                    </li>
                    <li class="@(controller == "Officer" && action == "OrgFees" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="OrgFees"><i class="bi bi-cash-stack"></i> Fees Management</a>
                    </li>
                    <li class="@(controller == "Officer" && action == "OrgFines" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="OrgFines"><i class="bi bi-exclamation-triangle"></i> Fines Management</a>
                    </li>
                    <li class="@(controller == "Officer" && action == "PaymentReminders" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="PaymentReminders"><i class="bi bi-megaphone"></i> Payment Reminders</a>
                    </li>
                }

                <!-- CLASS TREASURER FEATURES (Only show if NOT Org Treasurer to avoid duplicate) -->
                @if (User.IsInRole("Class Treasurer") && !User.IsInRole("Org Treasurer"))
                {
                    <li class="nav-section-header">
                        <span class="text-gold small text-uppercase fw-bold"><i class="bi bi-people me-1"></i> Section Treasury</span>
                    </li>
                    <li class="@(controller == "Officer" && action == "ClassTreasuryDashboard" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="ClassTreasuryDashboard"><i class="bi bi-speedometer2"></i> Treasury Dashboard</a>
                    </li>
                    <li class="@(controller == "Officer" && action == "ClassFees" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="ClassFees"><i class="bi bi-cash-stack"></i> Manage Fees</a>
                    </li>
                    <li class="@(controller == "Officer" && action == "ClassFines" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="ClassFines"><i class="bi bi-exclamation-triangle"></i> Manage Fines</a>
                    </li>
                }

                <!-- SECRETARY FEATURES (Combined) -->
                @* Find the Secretary Features section in your sidebar and replace it with this *@

                @if (User.IsInRole("Class Secretary") || User.IsInRole("Org Secretary"))
                {
                    <li class="nav-section-header">
                        <span class="text-gold small text-uppercase fw-bold"><i class="bi bi-clipboard-check me-1"></i> Attendance</span>
                    </li>

                    @* 1. Dashboard: Visible ONLY to Org Secretary *@
                    @if (User.IsInRole("Org Secretary"))
                    {
                        <li class="@(controller == "Officer" && action == "OrgSecretaryDashboard" ? "active" : "")">
                            <a asp-controller="Officer" asp-action="OrgSecretaryDashboard">
                                <i class="bi bi-speedometer2"></i> Secretary Dashboard
                            </a>
                        </li>
                    }

                    @* 2. Scanner: Visible to BOTH *@
                    <li class="@(controller == "Officer" && action == "Scanner" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="Scanner">
                            <i class="bi bi-qr-code-scan"></i> QR Attendance Scanner
                        </a>
                    </li>

                    @* 3. Attendance Records: Visible to BOTH (Placed here so it appears only once) *@
                    <li class="@(controller == "Officer" && action == "AttendanceRecords" ? "active" : "")">
                        <a asp-controller="Officer" asp-action="AttendanceRecords">
                            <i class="bi bi-list-check"></i> Attendance Records
                        </a>
                    </li>
                }

                @* IMPORTANT: Scroll down to where your "ORG SECRETARY ONLY FEATURES" block was *@
                @* Make sure "Attendance Records" is NOT listed there again. It should look like this: *@

                @if (User.IsInRole("Org Secretary"))
                {
                    @* Keep only other Org Secretary specific links here, like Manual Fees/Fines if you still have them *@
                    @* Do NOT put Attendance Records here because it is already listed above *@
                }




               

                <!-- ADMIN / SYSTEM FEATURES -->
            </ul>

            <div style="padding: 20px;">
                <!-- The hidden form that will be triggered by the modal -->
                <form id="logoutForm" class="form-inline d-none" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"></form>

                <!-- The button that the user clicks, which now opens the modal -->
                <button type="button" class="btn-logout-custom" data-bs-toggle="modal" data-bs-target="#confirmLogoutModal">
                    <i class="bi bi-box-arrow-left"></i> Sign Out
                </button>
            </div>
        </nav>

        <!-- MAIN CONTENT WRAPPER -->
        <div id="content">
            <!-- Fixed Navbar -->
            <div class="admin-navbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" id="sidebarCollapse" class="btn-toggle"><i class="bi bi-list"></i></button>
                    <div class="d-flex align-items-center gap-3">
                        <img src="~/images/pup-logo.png" alt="PUP Logo" class="pup-nav-logo">
                        <div class="d-none d-sm-block">
                            <div class="pup-nav-title">POLYTECHNIC UNIVERSITY OF THE PHILIPPINES</div>
                            <div class="pup-nav-sub">LOPEZ, QUEZON CAMPUS</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    @if (canSwitchSemester)
                    {
                        <!-- Semester Selector for Officers -->
                        <div class="semester-selector-wrapper d-none d-md-flex align-items-center gap-2">
                            <i class="bi bi-calendar-range" style="color: var(--gold-primary); font-size: 1.1rem;"></i>
                            <select id="semesterSelect" class="form-select semester-dropdown" title="Select Semester">
                                <option value="">Loading semesters...</option>
                            </select>
                        </div>
                        
                        <!-- Historical Mode Indicator -->
                        <div id="historicalModeIndicator" class="d-none align-items-center gap-2">
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-lock-fill"></i> Historical View
                            </span>
                        </div>
                    }
                    else
                    {
                        <!-- Read-Only Badge for Regular Students -->
                        <div class="academic-year-badge d-none d-md-flex align-items-center gap-2" title="Current Semester">
                            <i class="bi bi-calendar-range" style="color: var(--gold-primary); font-size: 1rem;"></i>
                            <span id="currentSemesterDisplay" class="academic-year-text">
                                Loading...
                            </span>
                        </div>
                    }
                    <div class="vr d-none d-md-block" style="height: 30px; opacity: 0.3;"></div>
                    <div class="d-none d-md-block text-end">
                        <div style="font-weight:bold; color:var(--text-strong);">@User.Identity?.Name</div>
                        <div style="font-size:0.75rem; color:var(--gold-text);">@displayRole</div>
                    </div>
                    <button type="button" id="themeToggle" class="btn-toggle theme-btn" title="Toggle Theme">
                        <i class="bi bi-sun-fill" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Scrollable Content Area -->
            <div class="scrollable-content">
                @RenderBody()
            </div>
        </div>
    </div>

    @{
        var logoutModal = new ConfirmationModalViewModel
        {
            ModalId = "confirmLogoutModal",
            ModalTitle = "Confirm Sign Out",
            ModalBody = "Are you sure you want to end your current session?",
            ConfirmButtonText = "Sign Out",
            ConfirmButtonClass = "btn btn-danger"
        };
    }
    <partial name="_ConfirmationModal" model="logoutModal" />

    <!-- INACTIVITY WARNING MODAL -->
    <div class="modal fade" id="inactivityWarning" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Session Timeout Warning
                    </h5>
                </div>
                <div class="modal-body text-center">
                    <i class="bi bi-clock-history text-warning mb-3" style="font-size: 3rem;"></i>
                    <h5 style="color: var(--text-strong);">Your session is about to expire</h5>
                    <p class="text-muted">
                        You have been inactive for 4 minutes. You will be automatically logged out in 1 minute unless you resume activity.
                    </p>
                    <div class="mt-3">
                        <button type="button" class="btn btn-warning fw-bold px-4" onclick="resetTimer()">
                            <i class="bi bi-arrow-clockwise me-2"></i> Keep Me Logged In
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SESSION EXPIRED MODAL (SOFT LOCK) -->
    <div class="modal fade" id="sessionExpiredModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal text-center p-4" style="border: 1px solid var(--gold-primary);">
                <div class="modal-body">
                    <div class="mb-3">
                        <i class="bi bi-shield-lock-fill text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="fw-bold" style="color:var(--text-strong);">Session Expired</h4>
                    <p class="text-muted mb-4">
                        For security reasons, your session has been locked due to extended inactivity.
                        <br>Please log in again to continue.
                    </p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-gold w-100 py-2 fw-bold">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Log In Again
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- CUSTOM SCRIPTS -->
    <script src="~/js/portal-layout.js"></script>

    @if (canSwitchSemester)
    {
        <script>
            // Semester Selector Logic for Officers
            $(document).ready(function() {
                loadSemesters();
                
                $('#semesterSelect').on('change', function () {
                    var semesterId = $(this).val();
                    switchSemester(semesterId);
                });
            });

            function loadSemesters() {
                $.ajax({
                    url: '@Url.Action("GetAllSemestersForDropdown", "Officer")',
                    type: 'GET',
                    success: function(data) {
                        var dropdown = $('#semesterSelect');
                        dropdown.empty();
                        
                        if (data.error) {
                            dropdown.append('<option value="">Error loading semesters</option>');
                            return;
                        }
                        
                        $.each(data, function(i, semester) {
                            var option = $('<option>')
                                .val(semester.semesterId)
                                .text(semester.displayName);
                            
                            if (semester.isCurrent) {
                                option.attr('selected', 'selected');
                                option.prepend('⭐ ');
                            }
                            
                            dropdown.append(option);
                        });
                        
                        checkHistoricalMode();
                    },
                    error: function() {
                        $('#semesterSelect').append('<option value="">Failed to load</option>');
                    }
                });
            }

            function switchSemester(semesterId) {
                $.ajax({
                    url: '@Url.Action("SetViewingSemester", "Officer")',
                    type: 'POST',
                    data: { semesterId: semesterId },
                    success: function (response) {
                        if (response.success) {
                            if (response.isHistorical) {
                                $('.semester-selector-wrapper').addClass('historical-mode');
                                $('#historicalModeIndicator').removeClass('d-none').css('display', 'flex');
                            } else {
                                $('.semester-selector-wrapper').removeClass('historical-mode');
                                $('#historicalModeIndicator').addClass('d-none');
                            }
                            
                            // Reload to refresh data
                            setTimeout(function() {
                                location.reload();
                            }, 800);
                        }
                    }
                });
            }

            function checkHistoricalMode() {
                var selected = $('#semesterSelect option:selected');
                if (selected.text().indexOf('⭐') === -1 && selected.val() !== '') {
                    $('.semester-selector-wrapper').addClass('historical-mode');
                    $('#historicalModeIndicator').removeClass('d-none').css('display', 'flex');
                }
            }
        </script>
    }
    else
    {
        <script>
            // Load current semester display for regular students
            $(document).ready(function() {
                $.ajax({
                    url: '@Url.Action("GetCurrentSemesterDisplay", "Student")',
                    type: 'GET',
                    success: function(data) {
                        if (data.displayName) {
                            $('#currentSemesterDisplay').text(data.displayName);
                        }
                    }
                });
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>