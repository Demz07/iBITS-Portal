@* Views/Shared/_AdminLayout.cshtml *@

@{
    Layout = null;
}
@using iBITS_Portal.ViewModels
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - iBITS Admin</title>

    <!-- CSS LIBRARIES -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- CUSTOM STYLES -->
    <link rel="stylesheet" href="~/css/portal-layout.css" />

    <!-- Academic Year Selector Styles -->
    <style>
        /* Academic Year Dropdown (Admin) - Glass Blur Effect */
        .academic-year-selector {
            background: rgba(11, 26, 51, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.4);
            border-radius: 12px;
            padding: 10px 16px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.05);
        }

            .academic-year-selector:hover {
                border-color: rgba(212, 175, 55, 0.7);
                box-shadow: 0 6px 25px rgba(212, 175, 55, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.08);
                transform: translateY(-1px);
            }

            .academic-year-selector i {
                font-size: 1.3rem !important;
            }

        .academic-year-dropdown {
            background: transparent !important;
            border: none !important;
            color: var(--gold-primary) !important;
            font-weight: 700;
            font-size: 1rem;
            padding: 0 !important;
            padding-right: 28px !important;
            cursor: pointer;
            min-width: 150px;
            letter-spacing: 0.5px;
        }

            .academic-year-dropdown:focus {
                box-shadow: none !important;
                outline: none !important;
            }

            .academic-year-dropdown option {
                background: rgba(11, 26, 51, 0.98);
                color: var(--text-strong);
                padding: 12px;
                font-size: 0.95rem;
            }

        /* Light theme adjustments */
        [data-theme="light"] .academic-year-selector {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-color: rgba(212, 175, 55, 0.5);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.5);
        }

        [data-theme="light"] .academic-year-dropdown {
            color: #b8860b !important;
        }

            [data-theme="light"] .academic-year-dropdown option {
                background: #fff;
                color: #1a1a2e;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Anti-Forgery Token for AJAX requests -->
    @Html.AntiForgeryToken()

    <div class="wrapper">
        <!-- SIDEBAR -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <img src="~/images/logo.png" alt="iBITS Logo" class="sidebar-logo-img">
                <div class="sidebar-brand">iBITS <span>PORTAL</span></div>
                <div class="sidebar-role">Administrator Console</div>
            </div>
            <ul class="list-unstyled components">
                @{
                    string? action = ViewContext.RouteData.Values["Action"]?.ToString();
                }
                <!-- Dashboard Link -->
                <li class="@(action == "Index" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                </li>

                <!-- Student Records Link -->
                <li class="@(action == "StudentRecords" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="StudentRecords">
                        <i class="bi bi-people-fill"></i> Student Records
                    </a>
                </li>

                <!-- Events Link -->
                <li class="@(action == "Events" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Events">
                        <i class="bi bi-calendar-check-fill"></i> Events
                    </a>
                </li>

                <!-- Payments Link -->
                <li class="@(action == "Payments" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Payments">
                        <i class="bi bi-wallet2"></i> Payments
                    </a>
                </li>

                <!-- Fines Link -->
                <li class="@(action == "Fines" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Fines">
                        <i class="bi bi-exclamation-triangle"></i> Fines
                    </a>
                </li>

                <!-- Year-End Archiving Link -->
                <!-- Archive Link (Renamed from Year-End Archiving) -->
                <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Archive" ? "active" : "")">
                    <a asp-controller="Archive" asp-action="Index">
                        <i class="bi bi-archive"></i> Archive
                    </a>
                </li>

                <!-- Admin Settings Link -->
                <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminSettings" ? "active" : "")">
                    <a asp-controller="AdminSettings" asp-action="Index">
                        <i class="bi bi-gear-fill"></i> Settings
                    </a>
                </li>

                <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "ActivityLogs" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="ActivityLogs">
                        <i class="bi bi-activity"></i> Activity Logs
                    </a>
                </li>
            </ul>

            <div style="padding: 20px;">
                <!-- The hidden form that will be triggered by the modal -->
                <form id="logoutForm" class="form-inline d-none" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"></form>

                <!-- The button that the user clicks, which now opens the modal -->
                <button type="button" class="btn-logout-custom" data-bs-toggle="modal" data-bs-target="#confirmLogoutModal">
                    <i class="bi bi-box-arrow-left"></i> Sign Out
                </button>
            </div>
        </nav>


        <!-- MAIN CONTENT WRAPPER -->
        <div id="content">
            <!-- Fixed Navbar -->
            <div class="admin-navbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" id="sidebarCollapse" class="btn-toggle"><i class="bi bi-list"></i></button>
                    <div class="d-flex align-items-center gap-3">
                        <img src="~/images/pup-logo.png" alt="PUP Logo" class="pup-nav-logo">
                        <div class="d-none d-sm-block">
                            <div class="pup-nav-title">POLYTECHNIC UNIVERSITY OF THE PHILIPPINES</div>
                            <div class="pup-nav-sub">LOPEZ, QUEZON CAMPUS</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <!-- Academic Year Selector (Admin Editable) -->
                    <div class="academic-year-selector d-none d-md-flex align-items-center gap-2">
                        <i class="bi bi-calendar-range" style="color: var(--gold-primary); font-size: 1.1rem;"></i>
                        <select id="academicYearSelect" class="form-select academic-year-dropdown" title="Set Current Academic Year">
                            @{
                                int currentYear = DateTime.Now.Year;
                                string currentAY = ViewBag.CurrentAcademicYear ?? $"A.Y. {currentYear}-{currentYear + 1}";
                                for (int year = currentYear + 1; year >= currentYear - 5; year--)
                                {
                                    string ayValue = $"A.Y. {year}-{year + 1}";
                                    <option value="@ayValue" selected="@(currentAY == ayValue)">@ayValue</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="vr d-none d-md-block" style="height: 30px; opacity: 0.3;"></div>
                    <div class="d-none d-md-block text-end">
                        <div style="font-weight:bold; color:var(--text-strong);">Administrator</div>
                        <div style="font-size:0.75rem; color:var(--gold-text);">System Access</div>
                    </div>
                    <button type="button" id="themeToggle" class="btn-toggle theme-btn" title="Toggle Theme">
                        <i class="bi bi-sun-fill" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Scrollable Content Area -->
            <div class="scrollable-content">
                @RenderBody()
            </div>
        </div>
    </div>

    @* --- HIDDEN FLASH MESSAGES FOR JS TO READ --- *@
    @if (TempData["Error"] != null)
    {
        <div id="flash-error-msg" data-message="@TempData["Error"]" style="display:none;"></div>
    }
    @if (TempData["Message"] != null)
    {
        <div id="flash-success-msg" data-message="@TempData["Message"]" style="display:none;"></div>
    }

    @* --- LOGOUT MODAL --- *@
    @{
        var logoutModal = new ConfirmationModalViewModel
        {
            ModalId = "confirmLogoutModal",
            ModalTitle = "Confirm Sign Out",
            ModalBody = "Are you sure you want to end your current session?",
            ConfirmButtonText = "Sign Out",
            ConfirmButtonClass = "btn btn-danger"
        };
    }
    <partial name="_ConfirmationModal" model="logoutModal" />

    @* --- GLOBAL STATUS MESSAGE MODAL (POP-UP) --- *@
    <div class="modal fade" id="statusMessageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="statusModalTitle">Notification</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <i id="statusModalIcon" class="bi" style="font-size: 3rem; display: block; margin-bottom: 15px;"></i>
                    <p id="statusModalBody" class="fs-6"></p>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-gold px-4" data-bs-dismiss="modal">Okay</button>
                </div>
            </div>
        </div>
    </div>

    <!-- INACTIVITY WARNING MODAL -->
    <div class="modal fade" id="inactivityWarning" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Session Timeout Warning
                    </h5>
                </div>
                <div class="modal-body text-center">
                    <i class="bi bi-clock-history fa-3x text-warning mb-3"></i>
                    <h5>Your session is about to expire</h5>
                    <p class="text-muted">
                        You have been inactive for 4 minutes. You will be automatically logged out in 1 minute unless you resume activity.
                    </p>
                    <div class="mt-3">
                        <button type="button" class="btn btn-warning" onclick="resetTimer()">
                            <i class="bi bi-arrow-clockwise me-2"></i> Keep Me Logged In
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SESSION EXPIRED MODAL (SOFT LOCK) -->
    <div class="modal fade" id="sessionExpiredModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal text-center p-4" style="border: 1px solid var(--gold-primary);">
                <div class="modal-body">
                    <div class="mb-3">
                        <i class="bi bi-shield-lock-fill text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="fw-bold" style="color:var(--text-strong);">Session Expired</h4>
                    <p class="text-muted mb-4">
                        For security reasons, your session has been locked due to extended inactivity.
                        <br>Please log in again to continue.
                    </p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-gold w-100 py-2 fw-bold">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Log In Again
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js" asp-append-version="true"></script>

    <!-- CUSTOM SCRIPTS -->
    <script src="~/js/portal-layout.js"></script>

    <script>
        $(document).ready(function () {
            // Check for Error Message
            var errorMsg = $('#flash-error-msg').data('message');
            if (errorMsg) {
                $('#statusModalTitle').text('Action Failed').css('color', '#ff6b6b');
                $('#statusModalBody').text(errorMsg);
                $('#statusModalIcon').removeClass().addClass('bi bi-x-circle-fill text-danger');
                var myModal = new bootstrap.Modal(document.getElementById('statusMessageModal'));
                myModal.show();
            }

            // Check for Success Message
            var successMsg = $('#flash-success-msg').data('message');
            if (successMsg) {
                $('#statusModalTitle').text('Success').css('color', '#34d399');
                $('#statusModalBody').text(successMsg);
                $('#statusModalIcon').removeClass().addClass('bi bi-check-circle-fill text-success');
                var myModal = new bootstrap.Modal(document.getElementById('statusMessageModal'));
                myModal.show();
            }

            // Academic Year Selector Change Handler
            $('#academicYearSelect').on('change', function () {
                var selectedYear = $(this).val();
                var $selector = $(this).closest('.academic-year-selector');

                // Show loading state
                $selector.css('opacity', '0.6');
                $(this).prop('disabled', true);

                // Send AJAX request to update the academic year
                $.ajax({
                    url: '@Url.Action("SetCurrentAcademicYear", "Admin")',
                    type: 'POST',
                    data: { academicYear: selectedYear },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            // Show success feedback
                            $selector.css({
                                'border-color': 'rgba(52, 211, 153, 0.8)',
                                'box-shadow': '0 0 15px rgba(52, 211, 153, 0.3)'
                            });

                            // Reset after animation
                            setTimeout(function () {
                                $selector.css({
                                    'border-color': 'rgba(212, 175, 55, 0.3)',
                                    'box-shadow': 'none',
                                    'opacity': '1'
                                });
                            }, 1500);

                            // Optional: Show toast notification
                            if (typeof showToast === 'function') {
                                showToast('Academic year updated to ' + selectedYear, 'success');
                            }
                        } else {
                            alert('Failed to update academic year: ' + (response.message || 'Unknown error'));
                            location.reload();
                        }
                    },
                    error: function (xhr, status, error) {
                        alert('Error updating academic year. Please try again.');
                        location.reload();
                    },
                    complete: function () {
                        $selector.css('opacity', '1');
                        $('#academicYearSelect').prop('disabled', false);
                    }
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>