@* Views/Admin/_ResetPasswordModal.cshtml *@

<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title text-warning">
                    <i class="bi bi-key-fill me-2"></i> Confirm Password Reset
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="ResetPassword" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body text-center p-4">
                    <!-- Warning Icon -->
                    <div class="mb-3">
                        <div style="width: 60px; height: 60px; background: rgba(212, 175, 55, 0.1); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 1.8rem;"></i>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3" style="color: var(--text-strong);">Are you sure?</h5>

                    <p class="mb-2" style="color: var(--text-main);">
                        You are about to reset the password for:
                    </p>
                    <h5 class="fw-bold mb-3" id="resetModalStudentName" style="color: var(--gold-primary);"></h5>

                    <div class="alert small text-start" style="background: rgba(212, 175, 55, 0.05); border: 1px solid rgba(212, 175, 55, 0.2); color: var(--text-main); border-radius: 8px;">
                        <i class="bi bi-info-circle-fill me-2 text-warning"></i>
                        The password will be reverted to the default:
                        <strong id="resetModalDefaultPassword" class="text-warning font-monospace"></strong>
                    </div>

                    <!-- Hidden Input for Student ID -->
                    <input type="hidden" name="id" id="resetModalStudentId" />
                </div>

                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-glass px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold px-4">
                        <i class="bi bi-check-lg me-2"></i> Confirm Reset
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>