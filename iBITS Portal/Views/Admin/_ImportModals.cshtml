@* Views/Admin/_ImportModals.cshtml *@

<!-- 1. MAPPING MODAL -->
<div class="modal fade" id="mappingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title" style="color: var(--gold-primary);">
                    <i class="bi bi-diagram-3-fill me-2"></i> Step 1: Map Columns
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Match your CSV/XLSX columns to the required System Fields.</p>
                <input type="hidden" id="tempFileName" />
                <input type="hidden" id="tempFileType" />
                <form id="mappingForm">
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle" style="color: var(--text-strong);">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--border-color); color: var(--gold-text);">
                                    <th width="40%">System Field</th>
                                    <th>Your File Column</th>
                                </tr>
                            </thead>
                            <tbody id="mappingTableBody"></tbody>
                        </table>
                    </div>
                </form>
                <!-- Date Format Selector -->
                <div class="mt-3 p-3 rounded" style="background: rgba(212,175,55,0.08); border: 1px solid rgba(212,175,55,0.3);">
                    <label class="form-label small fw-bold text-uppercase mb-1" style="color: var(--gold-primary);">
                        <i class="bi bi-calendar-date me-1"></i> Birthdate Format in your File
                    </label>
                    <select id="birthdateFormatSelect" class="form-select" style="background: rgba(255, 255, 255, 0.05); color: #fff; border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); cursor: pointer;">
                        <option value="M/d/yyyy" style="background: #1a1a1a;">MM/DD/YYYY &amp;nbsp; e.g. 12/02/2004</option>
                        <option value="d/M/yyyy" style="background: #1a1a1a;">DD/MM/YYYY &amp;nbsp; e.g. 02/12/2004</option>
                        <option value="yyyy-MM-dd" style="background: #1a1a1a;">YYYY-MM-DD &amp;nbsp; e.g. 2004-12-02</option>
                        <option value="MM-dd-yyyy" style="background: #1a1a1a;">MM-DD-YYYY &amp;nbsp; e.g. 12-02-2004</option>
                        <option value="dd-MM-yyyy" style="background: #1a1a1a;">DD-MM-YYYY &amp;nbsp; e.g. 02-12-2004</option>
                        <option value="auto" style="background: #1a1a1a;">Auto-Detect (use if unsure)</option>
                    </select>
                    <small class="text-muted mt-1 d-block">Select the exact date format used in your Birthdate column.</small>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-gold" onclick="generatePreview()">
                    Next: Preview Data <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 2. PREVIEW MODAL -->
<div class="modal fade" id="previewModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title" style="color: var(--gold-primary);">
                    <i class="bi bi-table me-2"></i> Step 2: Verify Data
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="previewContent">
                    <div class="text-center p-4">
                        <div class="spinner-border text-gold" role="status"></div>
                        <p class="mt-2 text-muted">Generating preview...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-between">
                <button type="button" class="btn btn-glass" id="backToMappingBtn">
                    <i class="bi bi-arrow-left me-2"></i> Back to Mapping
                </button>
                <button type="button" class="btn btn-gold" onclick="confirmUpload()">
                    <i class="bi bi-check-lg me-2"></i> Confirm Import
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 3. IMPORT PROGRESS MODAL -->
<div class="modal fade" id="importProgressModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title" style="color: var(--gold-primary);">
                    <i class="bi bi-cloud-upload-fill me-2"></i> Importing Students...
                </h5>
            </div>
            <div class="modal-body p-4">

                <!-- Progress Bar with row counter -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <small class="text-muted" id="progressLabel">Preparing...</small>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold" style="color: var(--gold-primary); font-size: 1rem;" id="progressCounter">0 / 0</span>
                            <small class="text-muted" id="progressPercent">(0%)</small>
                        </div>
                    </div>
                    <div class="progress" style="height: 12px; background: rgba(255,255,255,0.1); border-radius: 6px;">
                        <div id="importProgressBar" class="progress-bar bg-warning progress-bar-striped progress-bar-animated"
                             role="progressbar" style="width: 0%; border-radius: 6px;"></div>
                    </div>
                </div>

                <!-- Stats Row -->
                <div class="row g-2 mb-3">
                    <div class="col-4 text-center">
                        <div class="p-2 rounded" style="background: rgba(25,135,84,0.15); border: 1px solid rgba(25,135,84,0.3);">
                            <div class="fw-bold text-success fs-5" id="progressSuccess">0</div>
                            <small class="text-muted">✅ Imported</small>
                        </div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="p-2 rounded" style="background: rgba(220,53,69,0.15); border: 1px solid rgba(220,53,69,0.3);">
                            <div class="fw-bold text-danger fs-5" id="progressSkipped">0</div>
                            <small class="text-muted">⏭️ Skipped</small>
                        </div>
                    </div>
                    <div class="col-4 text-center">
                        <div class="p-2 rounded" style="background: rgba(212,175,55,0.15); border: 1px solid rgba(212,175,55,0.3);">
                            <div class="fw-bold fs-5" style="color: var(--gold-primary);" id="progressTotal">0</div>
                            <small class="text-muted">📊 Total</small>
                        </div>
                    </div>
                </div>

                <!-- Current Row Being Processed -->
                <div id="currentRowInfo" class="mb-3 p-2 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); display: none;">
                    <small class="text-muted">Processing:</small>
                    <span class="text-white ms-2 small font-monospace" id="currentRowText">—</span>
                </div>

                <!-- Live Error Log -->
                <div id="liveErrorContainer" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="text-danger small fw-bold text-uppercase mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Issues Found:
                        </h6>
                        <span class="badge bg-danger" id="errorBadge">0</span>
                    </div>
                    <div class="p-2" style="background: rgba(220,53,69,0.08); border: 1px solid rgba(220,53,69,0.25); border-radius: 8px; max-height: 130px; overflow-y: auto;">
                        <ul id="liveErrorList" class="list-unstyled mb-0 small text-danger font-monospace"></ul>
                    </div>
                </div>

                <p class="text-muted small text-center mt-3 mb-0" id="progressHint">
                    <i class="bi bi-info-circle me-1"></i> Import will pause when an error is found so you can decide.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- 4. ERROR PAUSE DIALOG (pauses on each error row) -->
<div class="modal fade" id="importErrorPauseModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal" style="border: 1px solid rgba(220,53,69,0.5);">
            <div class="modal-header border-0" style="background: rgba(220,53,69,0.1);">
                <h5 class="modal-title text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Row Error Detected
                </h5>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3 p-3 rounded" style="background: rgba(220,53,69,0.08); border: 1px solid rgba(220,53,69,0.2);">
                    <p class="text-danger fw-bold mb-1" id="pauseErrorRowNum">Row #0</p>
                    <p class="text-white mb-0" id="pauseErrorMessage">Error message here</p>
                </div>
                <div class="mb-3 p-3 rounded" style="background: rgba(255,255,255,0.05);">
                    <small class="text-muted d-block mb-1">Row Data:</small>
                    <code class="text-warning small" id="pauseRowData">—</code>
                </div>
                <p class="text-muted small mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    You can <strong class="text-warning">skip this row</strong> and continue importing the rest,
                    or <strong class="text-danger">abort</strong> the entire import.
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-between">
                <button type="button" class="btn btn-outline-danger" id="abortImportBtn">
                    <i class="bi bi-x-circle me-2"></i> Abort Import
                </button>
                <button type="button" class="btn btn-warning text-dark fw-bold" id="skipRowBtn">
                    <i class="bi bi-skip-forward-fill me-2"></i> Skip & Continue
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 5. IMPORT RESULT MODAL -->
<div class="modal fade" id="importResultModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="importResultTitle">Import Results</h5>
                <button type="button" class="btn-close btn-close-white" onclick="location.reload()"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <i id="importResultIcon" class="bi" style="font-size: 3.5rem;"></i>
                </div>
                <h4 id="importResultSummary" class="fw-bold mb-3" style="color: var(--text-strong);"></h4>
                <p id="importResultDetail" class="text-muted"></p>

                <!-- Error List Container -->
                <div id="importErrorContainer" class="mt-4 text-start" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-danger small fw-bold text-uppercase mb-0">Skipped Rows:</h6>
                        <button class="btn btn-sm btn-outline-danger" onclick="downloadErrorLog()" style="font-size: 0.75rem;">
                            <i class="bi bi-download me-1"></i> Download Log
                        </button>
                    </div>
                    <div class="p-3" style="background: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.3); border-radius: 8px; max-height: 180px; overflow-y: auto;">
                        <ul id="importErrorList" class="list-unstyled mb-0 small text-danger font-monospace"></ul>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-gold px-4" onclick="location.reload()">
                    <i class="bi bi-check-lg me-2"></i> Finish
                </button>
            </div>
        </div>
    </div>
</div>
