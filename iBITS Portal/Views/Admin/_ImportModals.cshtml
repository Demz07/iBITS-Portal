@* Views/Admin/_ImportModals.cshtml *@

<!-- 1. MAPPING MODAL -->
<div class="modal fade" id="mappingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title" style="color: var(--gold-primary);">
                    <i class="bi bi-diagram-3-fill me-2"></i> Step 1: Map Columns
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Match your CSV columns to the required System Fields.</p>
                <input type="hidden" id="tempFileName" />

                <form id="mappingForm">
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle" style="color: var(--text-strong);">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--border-color); color: var(--gold-text);">
                                    <th width="40%">System Field</th>
                                    <th>Your CSV Column</th>
                                </tr>
                            </thead>
                            <tbody id="mappingTableBody"></tbody>
                        </table>
                    </div>

                    <!-- NEW: Semester Selection -->
                    <div class="mt-4 p-3" style="background: rgba(212, 175, 55, 0.1); border: 1px solid var(--gold-primary); border-radius: 8px;">
                        <label class="form-label fw-bold" style="color: var(--gold-primary);">
                            <i class="bi bi-calendar-check me-2"></i>Enroll imported students in semester (Optional)
                        </label>
                        <select id="importSemesterId" class="form-select" style="background: var(--bg-secondary); color: var(--text-strong); border-color: var(--border-color);">
                            <option value="">-- No Semester (Enroll Later) --</option>
                            @if (ViewBag.Semesters != null)
                            {
                                foreach (var semester in ViewBag.Semesters)
                                {
                                    var isCurrent = semester.IsCurrent ? " ⭐ CURRENT" : "";
                                    <option value="@semester.SemesterId">
                                        @semester.SemesterName - @semester.AcademicYear.YearName@isCurrent
                                    </option>
                                }
                            }
                        </select>
                        <small class="text-muted d-block mt-2">
                            <i class="bi bi-info-circle me-1"></i>
                            If selected, all imported students will be automatically enrolled in this semester.
                        </small>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-gold" onclick="generatePreview()">
                    Next: Preview Data <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 2. PREVIEW MODAL -->
<div class="modal fade" id="previewModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title" style="color: var(--gold-primary);">
                    <i class="bi bi-table me-2"></i> Step 2: Verify Data
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="previewContent">
                    <!-- Partial View content injected here -->
                    <div class="text-center p-4">
                        <div class="spinner-border text-gold" role="status"></div>
                        <p class="mt-2 text-muted">Generating preview...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-between">
                <button type="button" class="btn btn-glass" id="backToMappingBtn">
                    <i class="bi bi-arrow-left me-2"></i> Back to Mapping
                </button>
                <button type="button" class="btn btn-gold" onclick="confirmUpload()">
                    <i class="bi bi-check-lg me-2"></i> Confirm Import
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 3. IMPORT RESULT MODAL -->
<div class="modal fade" id="importResultModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="importResultTitle">Import Results</h5>
                <button type="button" class="btn-close btn-close-white" onclick="location.reload()"></button>
            </div>
            <div class="modal-body text-center p-4">
                <!-- Dynamic Icon -->
                <div class="mb-3">
                    <i id="importResultIcon" class="bi" style="font-size: 3rem;"></i>
                </div>

                <h4 id="importResultSummary" class="fw-bold mb-3" style="color: var(--text-strong);"></h4>
                <p id="importResultDetail" class="text-muted"></p>

                <!-- Error List Container -->
                <div id="importErrorContainer" class="mt-4 text-start" style="display: none;">
                    <h6 class="text-danger small fw-bold text-uppercase">Issues Found:</h6>
                    <div class="p-3" style="background: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.3); border-radius: 8px; max-height: 150px; overflow-y: auto;">
                        <ul id="importErrorList" class="list-unstyled mb-0 small text-danger font-monospace"></ul>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-gold px-4" onclick="location.reload()">Finish</button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay (Optional, for transparency during processing) -->
<div id="importProcessingOverlay" style="display:none; position: fixed; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.7); z-index: 9999; align-items:center; justify-content:center; flex-direction: column;">
    <div class="spinner-border text-gold" style="width: 3rem; height: 3rem;" role="status"></div>
    <h5 class="mt-3 text-white">Importing Data...</h5>
    <p class="text-white-50">Please do not close this window.</p>
</div>