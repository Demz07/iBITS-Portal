@model IEnumerable<iBITS_Portal.Controllers.ManualPaymentBatchViewModel>
@{
    ViewData["Title"] = "Manual Payment Batches";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;"><i class="bi bi-journal-album me-2"></i> Manual Payment Batches</h3>
        <p class="text-muted small mb-0">Manage the batches of manual payments you have created.</p>
    </div>
    <div>
        <a asp-action="Payments" class="btn btn-outline-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Payments
        </a>
    </div>
</div>

<!-- ALERTS -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert">@TempData["Message"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- INFO MESSAGE -->
<div class="alert alert-info glass-alert mb-4" style="border-left: 5px solid #3b82f6; background: rgba(59, 130, 246, 0.15);">
    <i class="bi bi-info-circle-fill me-2"></i>
    <strong>Tip:</strong> Double-click on any batch row to view the list of students associated with that batch.
</div>

<!-- MANUAL PAYMENT BATCHES TABLE -->
<div class="glass-panel p-4">
    <div class="table-responsive">
        <table class="table table-glass">
            <thead>
                <tr>
                    <th>DESCRIPTION / FEE NAME</th>
                    <th>DEFAULT AMOUNT</th>
                    <th>DATE CREATED</th>
                    <th>STUDENTS AFFECTED</th>
                    <th class="text-end">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted p-4">No manual payment batches have been created yet.</td>
                    </tr>
                }
                @foreach (var batch in Model)
                {
                    <tr style="cursor: pointer;" 
                        ondblclick="viewStudentsInBatch('@batch.BatchId', '@batch.Description')"
                        title="Double-click to view students">
                        <td><span class="text-gold fw-bold">@batch.Description</span></td>
                        <td style="color: var(--gold-primary);">₱@batch.Amount.ToString("N2")</td>
                        <td class="text-muted">@batch.DateCreated?.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td>@batch.StudentCount student(s)</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="event.stopPropagation(); openSecureDeleteModal('@batch.BatchId', '@batch.Description', @batch.StudentCount)">
                                <i class="bi bi-trash me-1"></i> Delete Batch
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- SECURE DELETE BATCH MODAL -->
<div class="modal fade" id="secureDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <form asp-action="DeletePaymentBatch" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="batchId" id="deleteBatchId" />
                <div class="modal-header">
                    <h5 class="modal-title text-danger"><i class="bi bi-trash me-2"></i> Delete Payment Batch</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">Warning: This will permanently delete ALL payments associated with this batch. This action cannot be undone.</p>
                    <div class="fee-section p-3 mb-3">
                        <div><strong>Description:</strong> <span id="deleteBatchDescription"></span></div>
                        <div><strong>Students Affected:</strong> <span id="deleteBatchCount"></span></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm with your Admin Password</label>
                        <input type="password" name="adminPassword" class="form-control" required placeholder="Enter your password" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Batch Permanently</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- VIEW STUDENTS IN BATCH MODAL -->
<div class="modal fade" id="viewStudentsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title text-gold">
                    <i class="bi bi-people me-2"></i> Students in Batch: <span id="batchDescriptionTitle"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="studentsLoadingSpinner" style="text-align: center; padding: 2rem;">
                    <div class="spinner-border text-gold" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted mt-2">Loading students...</p>
                </div>
                <div id="studentsTableContainer" style="display: none;">
                    <div class="table-responsive">
                        <table class="table table-glass">
                            <thead>
                                <tr>
                                    <th>Student ID</th>
                                    <th>Full Name</th>
                                    <th>Program</th>
                                    <th>Year Level</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="studentsTableBody">
                                <!-- Students will be populated here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Open secure delete modal
        function openSecureDeleteModal(batchId, description, count) {
            document.getElementById('deleteBatchId').value = batchId;
            document.getElementById('deleteBatchDescription').innerText = description;
            document.getElementById('deleteBatchCount').innerText = count;
            new bootstrap.Modal(document.getElementById('secureDeleteModal')).show();
        }

        // View students in batch (double-click)
        function viewStudentsInBatch(batchId, description) {
            document.getElementById('batchDescriptionTitle').innerText = description;
            document.getElementById('studentsLoadingSpinner').style.display = 'block';
            document.getElementById('studentsTableContainer').style.display = 'none';

            const modal = new bootstrap.Modal(document.getElementById('viewStudentsModal'));
            modal.show();

            // Fetch students via AJAX
            fetch(`/Admin/GetStudentsInPaymentBatch?batchId=${encodeURIComponent(batchId)}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.students) {
                        const tbody = document.getElementById('studentsTableBody');
                        tbody.innerHTML = '';

                        if (data.students.length === 0) {
                            tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No students found in this batch.</td></tr>';
                        } else {
                            data.students.forEach(student => {
                                const statusClass = student.status?.toLowerCase() === 'paid' || student.status?.toLowerCase() === 'completed' ? 'success' : 'warning';
                                const statusText = student.status || 'Pending';
                                
                                const row = `
                                    <tr>
                                        <td>${student.studentNum || 'N/A'}</td>
                                        <td>${student.fullName || 'N/A'}</td>
                                        <td>${student.program || 'N/A'}</td>
                                        <td>${student.yearLevel || 'N/A'}</td>
                                        <td>₱${(student.amount || 0).toFixed(2)}</td>
                                        <td><span class="badge bg-${statusClass}">${statusText}</span></td>
                                    </tr>
                                `;
                                tbody.innerHTML += row;
                            });
                        }

                        document.getElementById('studentsLoadingSpinner').style.display = 'none';
                        document.getElementById('studentsTableContainer').style.display = 'block';
                    } else {
                        alert('Error loading students. Please try again.');
                        modal.hide();
                    }
                })
                .catch(error => {
                    console.error('Error fetching students:', error);
                    alert('Error loading students. Please try again.');
                    modal.hide();
                });
        }
    </script>
}
