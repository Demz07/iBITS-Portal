@model IEnumerable<iBITS_Portal.Models.Fee>
@{
    ViewData["Title"] = "Payments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Calculate financial summaries
    var allFees = Model?.ToList() ?? new List<iBITS_Portal.Models.Fee>();
    var totalExp = allFees.Sum(f => f.Amount ?? 0);
    var totalCol = allFees.Where(f => f.FeeStatus?.ToLower() == "paid" || f.FeeStatus?.ToLower() == "completed").Sum(f => f.Amount ?? 0);
    var totalPending = totalExp - totalCol;

    // Calculate Collection Rate
    var collectionRate = totalExp > 0 ? Math.Round((totalCol / totalExp) * 100, 1) : 0;

    <style>
        /* New styles for No Data state in Charts */
        .chart-no-data {
            display: none; /* Hidden by default */
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            min-height: 250px;
            color: rgba(255, 255, 255, 0.4);
            text-align: center;
        }

            .chart-no-data i {
                font-size: 4rem; /* Big Icon */
                margin-bottom: 1rem;
                color: rgba(212, 175, 55, 0.2); /* Dim Gold */
            }

            .chart-no-data p {
                font-size: 1.1rem;
                font-weight: 600;
                margin: 0;
            }
        /* Ensure summary cards match height in the new grid layout */
        .summary-card {
            height: 100%;
            min-height: 110px;
        }
    </style>
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;"><i class="bi bi-cash-stack me-2"></i> Payments & Fees</h3>
        <p class="text-muted small mb-0">Track student payments, fees, and financial records.</p>
    </div>
    <div>
        <a asp-action="ManualPaymentBatches" class="btn btn-outline-light btn-sm">
            <i class="bi bi-journal-album me-1"></i> Manage Payment Batches
        </a>
    </div>
</div>

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ============================================================ -->
<!-- FINANCIAL OVERVIEW (Updated to match Fines UI)               -->
<!-- ============================================================ -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> Financial Overview
    </h5>

    <!-- Row 1: Summary Cards (4 Columns) -->
    <div class="row g-4 mb-4">
        <!-- Total Expected (Red Style) -->
        <div class="col-md-3">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collected (Green Style) -->
        <div class="col-md-3">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Outstanding (Yellow/Amber Style) -->
        <div class="col-md-3">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(251, 191, 36, 0.15); color: #fbbf24; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPendingCard">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Outstanding</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collection Rate (Purple Style) -->
        <div class="col-md-3">
            <div class="summary-card rate">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-percent fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white"><span id="collectionRateDisplay">@collectionRate</span>%</div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collection Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Pie Charts with No Data State -->
    <div class="row g-4">
        <!-- Collected Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Collected by Program & Year</h6>
                <div style="height: 250px; position: relative;">
                    <!-- Canvas for Chart -->
                    <canvas id="paymentsBreakdownChart"></canvas>

                    <!-- No Data Feedback -->
                    <div id="paymentsNoData" class="chart-no-data">
                        <i class="bi bi-inbox-fill"></i>
                        <p>No Payments Collected Yet</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pending Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart me-2"></i>Pending by Program & Year</h6>
                <div style="height: 250px; position: relative;">
                    <!-- Canvas for Chart -->
                    <canvas id="pendingBreakdownChart"></canvas>

                    <!-- No Data Feedback -->
                    <div id="pendingNoData" class="chart-no-data">
                        <i class="bi bi-check2-all"></i>
                        <p>No Pending Fees</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- FILTERS SECTION                                              -->
<!-- ============================================================ -->
<div class="glass-panel p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-funnel me-2"></i> Filters
        </h5>
        <button class="btn btn-sm btn-outline-secondary" id="clearFiltersBtn">
            <i class="bi bi-x-circle me-1"></i> Clear Filters
        </button>
    </div>

    <div class="row g-3">
        <!-- Search Filter -->
        <div class="col-md-3">
            <label class="form-label small text-muted">Search</label>
            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="Ref ID, Student Name or ID...">
        </div>

        <!-- Fee Name Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Fee Name</label>
            <select id="filterFeeName" class="form-select form-select-sm">
                <option value="">All Fees</option>
                @if (ViewBag.FeeNames != null)
                {
                    foreach (var name in ViewBag.FeeNames)
                    {
                        <option value="@name">@name</option>
                    }
                }
            </select>
        </div>

        <!-- Program Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Program</label>
            <select id="filterProgram" class="form-select form-select-sm">
                <option value="">All Programs</option>
                <option value="BSIT">BSIT</option>
                <option value="DIT">DIT</option>
            </select>
        </div>

        <!-- Year Level Filter -->
        <div class="col-md-1">
            <label class="form-label small text-muted">Year</label>
            <select id="filterYear" class="form-select form-select-sm">
                <option value="">All</option>
                <option value="1">1st</option>
                <option value="2">2nd</option>
                <option value="3">3rd</option>
                <option value="4">4th</option>
            </select>
        </div>

        <!-- Status Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Status</label>
            <select id="filterStatus" class="form-select form-select-sm">
                <option value="">All Status</option>
                <option value="paid">Paid</option>
                <option value="pending">Pending/Unpaid</option>
            </select>
        </div>

        <!-- Academic Year Filter -->
        <div class="col-md-2">
            <label class="form-label small text-muted">Academic Year</label>
            <input type="text" id="filterAcadYear" class="form-control form-control-sm" placeholder="e.g., 2023-2024">
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- FEE RECORDS TABLE                                            -->
<!-- ============================================================ -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); margin: 0; font-weight: 700;">Fee Records</h5>
        <div>
            <button type="button" class="btn-gold-outline btn-sm me-2" onclick="exportPayments()">
                <i class="bi bi-download me-1"></i> Export Fees
            </button>
            <button class="btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#createFeeModal">
                <i class="bi bi-plus-lg me-1"></i> Create Fee
            </button>
        </div>
    </div>

    <!-- Standard Fees Table with Checkbox UI -->
    <div class="table-responsive">
        <table class="table table-glass" id="feesTable">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">☐</th>
                    <th>Ref ID</th>
                    <th>Student Name</th>
                    <th>Section</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Paid</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th class="text-center" style="width: 60px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var fee in Model)
                    {
                        var student = fee.StudentNumNavigation;
                        var paymentStatus = fee.PaymentStatus;
                        var isPaid = paymentStatus == "Paid";
                        var isPartial = paymentStatus == "Partial";
                        var remainingBalance = fee.RemainingBalance;
                        var statusClass = isPaid ? "row-paid" : (isPartial ? "row-partial" : "");
                        var checkboxClass = isPaid ? "status-paid" : (isPartial ? "status-partial" : "status-unpaid");

                        <tr class="fee-row @statusClass"
                            data-fee-id="@fee.FeeId"
                            data-ref-id="@fee.FeeId"
                            data-student-name="@(fee.StudentNumNavigation?.FullName?.ToLower() ?? "")"
                            data-student-id="@(fee.StudentNum?.ToLower() ?? "")"
                            data-fee-name="@(fee.FeeName?.ToLower() ?? "")"
                            data-section="@(student?.YearLevelSection ?? "")"
                            data-status="@paymentStatus.ToLower()"
                            data-amount="@(fee.Amount ?? 0)"
                            data-paid="@fee.AmountPaid"
                            data-balance="@remainingBalance">
                            
                            <!-- Checkbox Column -->
                            <td class="text-center">
                                <div class="payment-checkbox-wrapper">
                                    <div class="payment-checkbox @checkboxClass" 
                                         data-fee-id="@fee.FeeId"
                                         data-student-name="@(student?.FullName ?? "Unknown")"
                                         data-fee-name="@fee.FeeName"
                                         data-amount="@(fee.Amount ?? 0)"
                                         data-balance="@remainingBalance"
                                         data-status="@paymentStatus.ToLower()"
                                         onclick="handleFeeCheckboxClick(this)"
                                         title="@(isPaid ? "Click to revoke payment" : (isPartial ? "Click to complete payment" : "Click to mark as paid"))">
                                    </div>
                                </div>
                            </td>
                            
                            <td class="font-monospace text-muted">#@fee.FeeId</td>
                            <td>
                                @if (student != null)
                                {
                                    <div style="color: var(--text-strong); font-weight: 600;">@student.StudentFn @student.StudentLn</div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">@fee.StudentNum</div>
                                }
                                else
                                {
                                    <span class="text-danger">ID: @fee.StudentNum</span>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@(student?.YearLevelSection ?? "-")</span></td>
                            <td>@fee.FeeName</td>
                            <td style="color: var(--gold-primary); font-weight: bold;">₱@(fee.Amount?.ToString("N2") ?? "0.00")</td>
                            <td class="amount-paid" style="color: #10b981; font-weight: 600;">₱@fee.AmountPaid.ToString("N2")</td>
                            <td class="balance" style="color: @(remainingBalance > 0 ? "#ef4444" : "#10b981"); font-weight: 600;">₱@remainingBalance.ToString("N2")</td>
                            
                            <!-- Status Badge -->
                            <td>
                                @if (isPaid)
                                {
                                    <span class="status-badge status-paid"><i class="bi bi-check-circle-fill"></i> Paid</span>
                                }
                                else if (isPartial)
                                {
                                    <span class="status-badge status-partial"><i class="bi bi-pie-chart-fill"></i> Partial</span>
                                }
                                else
                                {
                                    <span class="status-badge status-unpaid"><i class="bi bi-x-circle-fill"></i> Unpaid</span>
                                }
                            </td>
                            
                            <!-- Actions Dropdown -->
                            <td class="text-center">
                                <div class="dropdown">
                                    <button class="action-dropdown-btn" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end glass-dropdown">
                                        @if (!isPaid)
                                        {
                                            <li>
                                                <a href="#" class="dropdown-item" onclick="openAdminFeePaymentModal(@fee.FeeId, '@(student?.FullName?.Replace("'", "\\'") ?? "Unknown")', '@fee.FeeName?.Replace("'", "\\'")', @(fee.Amount ?? 0), @fee.AmountPaid, @remainingBalance); return false;">
                                                    <i class="bi bi-cash-coin me-2 text-success"></i> Record Partial Payment
                                                </a>
                                            </li>
                                        }
                                        @if (isPaid || isPartial)
                                        {
                                            <li>
                                                <a href="#" class="dropdown-item" onclick="confirmRevokeFeePayment(@fee.FeeId, '@(student?.FullName?.Replace("'", "\\'") ?? "Unknown")', @fee.AmountPaid); return false;">
                                                    <i class="bi bi-arrow-counterclockwise me-2 text-warning"></i> Revoke Payment
                                                </a>
                                            </li>
                                        }
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a href="#" class="dropdown-item text-danger" onclick="confirmDeleteFee(@fee.FeeId, '@(student?.FullName?.Replace("'", "\\'") ?? "Unknown")', @(fee.Amount ?? 0)); return false;">
                                                <i class="bi bi-trash me-2"></i> Delete Record
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="10" class="text-center py-4 text-muted"><i class="bi bi-inbox fs-4 d-block mb-2"></i>No fee records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CONFIRM PAYMENT MODAL -->
<div class="modal fade" id="confirmPaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="bi bi-check-circle text-success me-2"></i> Confirm Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div class="confirm-modal-icon success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <p class="mb-3">Mark this fee as <strong>PAID</strong>?</p>
                <div class="confirm-modal-details">
                    <div class="detail-row">
                        <span class="detail-label">Student</span>
                        <span class="detail-value" id="confirmPayStudentName"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Fee</span>
                        <span class="detail-value" id="confirmPayFeeName"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Amount</span>
                        <span class="detail-value text-gold">₱<span id="confirmPayAmount"></span></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmPaymentBtn" onclick="executeToggleFeePayment()">
                    <i class="bi bi-check-circle me-1"></i> Confirm Payment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- REVOKE PAYMENT MODAL -->
<div class="modal fade" id="revokePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-warning me-2"></i> Revoke Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div class="confirm-modal-icon warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <p class="mb-2 text-warning fw-bold">Warning: This will delete all payment transactions!</p>
                <p class="mb-3">Are you sure you want to revoke this payment?</p>
                <div class="confirm-modal-details">
                    <div class="detail-row">
                        <span class="detail-label">Student</span>
                        <span class="detail-value" id="revokeStudentName"></span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Amount Paid</span>
                        <span class="detail-value text-success">₱<span id="revokeAmountPaid"></span></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="revokePaymentBtn" onclick="executeRevokeFeePayment()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Revoke Payment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE FEE MODAL -->
<div class="modal fade" id="deleteFeeModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <form asp-action="DeleteFee" method="post" id="deleteFeeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="feeId" id="deleteFeeId" />
                <div class="modal-header border-0">
                    <h5 class="modal-title"><i class="bi bi-trash text-danger me-2"></i> Delete Fee</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="confirm-modal-icon danger">
                        <i class="bi bi-trash-fill"></i>
                    </div>
                    <p class="mb-2 text-danger fw-bold">This action cannot be undone!</p>
                    <p class="mb-3">Delete this fee record permanently?</p>
                    <div class="confirm-modal-details">
                        <div class="detail-row">
                            <span class="detail-label">Student</span>
                            <span class="detail-value" id="deleteStudentName"></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Amount</span>
                            <span class="detail-value text-gold">₱<span id="deleteAmount"></span></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill me-1"></i> Delete Permanently
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL: CREATE FEE ================= -->
<div class="modal fade" id="createFeeModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title text-gold"><i class="bi bi-cash-coin me-2"></i> Create New Fee</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateFee" method="post" id="createFeeForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <!-- Fee Details Section -->
                    <div class="fee-section">
                        <div class="fee-section-header">
                            <i class="bi bi-info-circle me-2"></i> Fee Details
                        </div>

                        <!-- Row 1: Academic Year + Fee Name -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Academic Year <span class="text-danger">*</span></label>
                                <input type="text" name="AcadYear" class="form-control" placeholder="e.g., 2023-2024" required />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Fee Name / Description <span class="text-danger">*</span></label>
                                <input type="text" name="FeeName" class="form-control" placeholder="e.g., Membership Fee, T-Shirt Payment" required />
                            </div>
                        </div>

                        <!-- Row 2: Amount + Due Date -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Amount (₱) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0.01" name="Amount" class="form-control" placeholder="0.00" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Due Date</label>
                                <input type="date" name="FeesDueDate" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <!-- Apply To Students Section -->
                    <div class="fee-section mt-4">
                        <div class="fee-section-header">
                            <i class="bi bi-people me-2"></i> Apply To Students
                        </div>

                        <!-- Program Filter -->
                        <div class="mb-3">
                            <label class="form-label">Program <span class="text-danger">*</span></label>
                            <div class="filter-options" id="programFilter">
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programAll" value="all" checked>
                                    <label for="programAll">
                                        <i class="bi bi-grid-3x3-gap"></i>
                                        <span>All Programs</span>
                                        <small>BSIT & DIT</small>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programBSIT" value="bsit">
                                    <label for="programBSIT">
                                        <i class="bi bi-laptop"></i>
                                        <span>BSIT Only</span>
                                        <small>4-Year Program</small>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programDIT" value="dit">
                                    <label for="programDIT">
                                        <i class="bi bi-hdd-network"></i>
                                        <span>DIT Only</span>
                                        <small>3-Year Program</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Year Level Filter -->
                        <div class="mb-3">
                            <label class="form-label">Year Level <span class="text-danger">*</span></label>
                            <div class="filter-options year-filter" id="yearFilter">
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="yearAll" value="all" checked>
                                    <label for="yearAll">
                                        <span>All Years</span>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year1" value="1">
                                    <label for="year1">
                                        <span>1st Year</span>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year2" value="2">
                                    <label for="year2">
                                        <span>2nd Year</span>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year3" value="3">
                                    <label for="year3">
                                        <span>3rd Year</span>
                                    </label>
                                </div>
                                <div class="filter-option" id="year4Option">
                                    <input type="radio" name="yearFilter" id="year4" value="4">
                                    <label for="year4">
                                        <span>4th Year</span>
                                        <small class="bsit-only-badge">BSIT only</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Preview Section -->
                        <div class="fee-preview" id="feePreview">
                            <div class="preview-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="preview-content">
                                <div class="preview-title">This fee will be applied to:</div>
                                <div class="preview-count">
                                    <span id="previewTotal">0</span> students
                                </div>
                                <div class="preview-breakdown">
                                    <span class="preview-bsit"><i class="bi bi-circle-fill"></i> BSIT: <span id="previewBSIT">0</span></span>
                                    <span class="preview-dit"><i class="bi bi-circle-fill"></i> DIT: <span id="previewDIT">0</span></span>
                                </div>
                            </div>
                            <div class="preview-loading" id="previewLoading" style="display: none;">
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold" id="submitFeeBtn">
                        <i class="bi bi-check-lg me-1"></i> Create and Assign Fee
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- RECORD FEE PAYMENT MODAL (Admin) -->
<div class="modal fade" id="adminFeePaymentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header" style="background: linear-gradient(135deg, #10b981, #059669);">
                <h5 class="modal-title text-white"><i class="bi bi-cash-coin me-2"></i> Record Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RecordFeePayment" asp-controller="Admin" method="post" id="adminFeePaymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="adminPaymentFeeId" name="feeId" />
                <div class="modal-body">
                    <div class="fee-section p-3 mb-4">
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted">Student</small>
                                <div id="adminPaymentStudentName" class="fw-bold text-white"></div>
                            </div>
                            <div class="col-6 text-end">
                                <small class="text-muted">Fee</small>
                                <div id="adminPaymentFeeName" class="fw-bold text-gold"></div>
                            </div>
                        </div>
                        <hr class="my-2" style="border-color: rgba(255,255,255,0.1);" />
                        <div class="row text-center">
                            <div class="col-4">
                                <small class="text-muted d-block">Total</small>
                                <div class="fw-bold text-white">₱<span id="adminPaymentTotal">0.00</span></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Paid</small>
                                <div class="fw-bold text-success">₱<span id="adminPaymentPaid">0.00</span></div>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Balance</small>
                                <div class="fw-bold text-danger">₱<span id="adminPaymentBalance">0.00</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payment Amount (₱) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control" id="adminPaymentAmount" name="paymentAmount" required />
                        <small class="text-muted">Max: ₱<span id="adminMaxAmount">0.00</span></small>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block mb-2">Quick Select:</small>
                        <div class="btn-group w-100">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setAdminFeeAmount(0.25)">25%</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setAdminFeeAmount(0.5)">50%</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setAdminFeeAmount(0.75)">75%</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setAdminFeeAmount(1)">Full</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select class="form-select" id="adminFeePaymentMethod" name="paymentMethod" required>
                            <option value="">-- Select --</option>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reference #</label>
                        <input type="text" class="form-control" name="transactionRef" placeholder="Optional" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" name="notes" rows="2" placeholder="Optional"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i> Record Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        // Pass chart data from server to JavaScript
        window.paymentsChartsData = {
            collected: @Html.Raw(Json.Serialize(ViewBag.CollectedBreakdown ?? new Dictionary<string, decimal>())),
            pending: @Html.Raw(Json.Serialize(ViewBag.PendingBreakdown ?? new Dictionary<string, decimal>()))
        };

        // Admin Fee Payment Modal
        var adminFeeBalance = 0;
        function openAdminFeePaymentModal(feeId, studentName, feeName, total, paid, balance) {
            document.getElementById('adminPaymentFeeId').value = feeId;
            document.getElementById('adminPaymentStudentName').textContent = studentName;
            document.getElementById('adminPaymentFeeName').textContent = feeName;
            document.getElementById('adminPaymentTotal').textContent = total.toFixed(2);
            document.getElementById('adminPaymentPaid').textContent = paid.toFixed(2);
            document.getElementById('adminPaymentBalance').textContent = balance.toFixed(2);
            document.getElementById('adminMaxAmount').textContent = balance.toFixed(2);
            document.getElementById('adminPaymentAmount').max = balance;
            document.getElementById('adminPaymentAmount').value = balance.toFixed(2);
            document.getElementById('adminFeePaymentMethod').value = '';
            adminFeeBalance = balance;
            new bootstrap.Modal(document.getElementById('adminFeePaymentModal')).show();
        }
        function setAdminFeeAmount(pct) {
            document.getElementById('adminPaymentAmount').value = (adminFeeBalance * pct).toFixed(2);
        }

        // Export Function
        function exportPayments() {
            const search = document.getElementById('filterSearch').value;
            const feeName = document.getElementById('filterFeeName').value;
            const program = document.getElementById('filterProgram').value;
            const year = document.getElementById('filterYear').value;
            const status = document.getElementById('filterStatus').value;
            const acadYear = document.getElementById('filterAcadYear').value;

            const params = new URLSearchParams({
                searchString: search,
                feeNameFilter: feeName,
                programFilter: program,
                yearFilter: year,
                statusFilter: status,
                acadYearFilter: acadYear
            });

            window.location.href = '/Admin/ExportPayments?' + params.toString();
        }

        // ============================================================
        // CHECKBOX-BASED PAYMENT SYSTEM
        // ============================================================
        var currentFeeData = {};

        // Handle checkbox click
        function handleFeeCheckboxClick(checkbox) {
            const feeId = checkbox.dataset.feeId;
            const status = checkbox.dataset.status;
            const studentName = checkbox.dataset.studentName;
            const feeName = checkbox.dataset.feeName;
            const amount = parseFloat(checkbox.dataset.amount);
            const balance = parseFloat(checkbox.dataset.balance);

            currentFeeData = { feeId, studentName, feeName, amount, balance, checkbox };

            if (status === 'paid') {
                // Already paid - show revoke confirmation
                confirmRevokeFeePayment(feeId, studentName, amount);
            } else {
                // Unpaid or Partial - show payment confirmation
                document.getElementById('confirmPayStudentName').textContent = studentName;
                document.getElementById('confirmPayFeeName').textContent = feeName;
                document.getElementById('confirmPayAmount').textContent = balance.toFixed(2);
                new bootstrap.Modal(document.getElementById('confirmPaymentModal')).show();
            }
        }

        // Execute toggle fee payment (mark as paid)
        async function executeToggleFeePayment() {
            const btn = document.getElementById('confirmPaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Admin/ToggleFeePayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `feeId=${currentFeeData.feeId}&markAsPaid=true`
                });

                const result = await response.json();
                
                if (result.success) {
                    // Update UI
                    updateFeeRowUI(currentFeeData.feeId, result.newStatus, result.amountPaid, result.balance);
                    bootstrap.Modal.getInstance(document.getElementById('confirmPaymentModal')).hide();
                    showToast('success', result.message);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm Payment';
            }
        }

        // Confirm revoke payment
        function confirmRevokeFeePayment(feeId, studentName, amountPaid) {
            currentFeeData.feeId = feeId;
            document.getElementById('revokeStudentName').textContent = studentName;
            document.getElementById('revokeAmountPaid').textContent = amountPaid.toFixed(2);
            new bootstrap.Modal(document.getElementById('revokePaymentModal')).show();
        }

        // Execute revoke fee payment
        async function executeRevokeFeePayment() {
            const btn = document.getElementById('revokePaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Admin/RevokeFeePayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `feeId=${currentFeeData.feeId}`
                });

                const result = await response.json();
                
                if (result.success) {
                    updateFeeRowUI(currentFeeData.feeId, result.newStatus, result.amountPaid, result.balance);
                    bootstrap.Modal.getInstance(document.getElementById('revokePaymentModal')).hide();
                    showToast('success', result.message);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i> Revoke Payment';
            }
        }

        // Confirm delete fee
        function confirmDeleteFee(feeId, studentName, amount) {
            document.getElementById('deleteFeeId').value = feeId;
            document.getElementById('deleteStudentName').textContent = studentName;
            document.getElementById('deleteAmount').textContent = amount.toFixed(2);
            new bootstrap.Modal(document.getElementById('deleteFeeModal')).show();
        }

        // Update fee row UI after status change
        function updateFeeRowUI(feeId, newStatus, amountPaid, balance) {
            const row = document.querySelector(`tr[data-fee-id="${feeId}"]`);
            if (!row) return;

            const checkbox = row.querySelector('.payment-checkbox');
            const statusBadge = row.querySelector('.status-badge');
            const amountPaidCell = row.querySelector('.amount-paid');
            const balanceCell = row.querySelector('.balance');
            const amount = parseFloat(row.dataset.amount);

            // Update row class
            row.classList.remove('row-paid', 'row-partial');
            if (newStatus === 'Paid') row.classList.add('row-paid');
            else if (newStatus === 'Partial') row.classList.add('row-partial');

            // Update checkbox
            checkbox.classList.remove('status-paid', 'status-partial', 'status-unpaid');
            checkbox.dataset.status = newStatus.toLowerCase();
            if (newStatus === 'Paid') {
                checkbox.classList.add('status-paid');
                checkbox.title = 'Click to revoke payment';
            } else if (newStatus === 'Partial') {
                checkbox.classList.add('status-partial');
                checkbox.title = 'Click to complete payment';
            } else {
                checkbox.classList.add('status-unpaid');
                checkbox.title = 'Click to mark as paid';
            }
            checkbox.dataset.balance = balance;

            // Update status badge
            if (newStatus === 'Paid') {
                statusBadge.className = 'status-badge status-paid';
                statusBadge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Paid';
            } else if (newStatus === 'Partial') {
                statusBadge.className = 'status-badge status-partial';
                statusBadge.innerHTML = '<i class="bi bi-pie-chart-fill"></i> Partial';
            } else {
                statusBadge.className = 'status-badge status-unpaid';
                statusBadge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Unpaid';
            }

            // Update amounts
            amountPaidCell.textContent = '₱' + amountPaid.toFixed(2);
            balanceCell.textContent = '₱' + balance.toFixed(2);
            balanceCell.style.color = balance > 0 ? '#ef4444' : '#10b981';

            // Update data attributes
            row.dataset.status = newStatus.toLowerCase();
            row.dataset.paid = amountPaid;
            row.dataset.balance = balance;
        }

        // Toast notification
        function showToast(type, message) {
            // Create toast element
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }
    </script>
    <script src="~/js/payments.js" asp-append-version="true"></script>
}