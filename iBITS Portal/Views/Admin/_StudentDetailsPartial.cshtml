@model iBITS_Portal.ViewModels.StudentDetailsViewModel

<!-- Modal Header -->
<div class="modal-header">
    <h5 class="modal-title text-gold">
        <i class="bi bi-person-circle me-2"></i>
        Student Details - @Model.FullName
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<!-- Modal Body -->
<div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
    
    <!-- Student Info Card -->
    <div class="glass-panel mb-3" style="background: rgba(212, 175, 55, 0.05); border: 1px solid rgba(212, 175, 55, 0.2); padding: 20px; border-radius: 12px;">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="info-item">
                    <span class="info-label" style="color: var(--gold-primary); font-size: 0.75rem; text-transform: uppercase; font-weight: bold; display: block; margin-bottom: 5px;">Student ID</span>
                    <span class="info-value" style="color: #fff; font-size: 1rem;">@Model.Student.StudentNum</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-item">
                    <span class="info-label" style="color: var(--gold-primary); font-size: 0.75rem; text-transform: uppercase; font-weight: bold; display: block; margin-bottom: 5px;">Email</span>
                    <span class="info-value" style="color: #fff; font-size: 1rem;">@(Model.Student.StudentEmail ?? "N/A")</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-item">
                    <span class="info-label" style="color: var(--gold-primary); font-size: 0.75rem; text-transform: uppercase; font-weight: bold; display: block; margin-bottom: 5px;">Program</span>
                    <span class="info-value" style="color: #fff; font-size: 1rem;">@(Model.Student.Course ?? "N/A")</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-item">
                    <span class="info-label" style="color: var(--gold-primary); font-size: 0.75rem; text-transform: uppercase; font-weight: bold; display: block; margin-bottom: 5px;">Year & Section</span>
                    <span class="info-value" style="color: #fff; font-size: 1rem;">@(Model.Student.YearLevelSection ?? "N/A")</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-item">
                    <span class="info-label" style="color: var(--gold-primary); font-size: 0.75rem; text-transform: uppercase; font-weight: bold; display: block; margin-bottom: 5px;">Role</span>
                    <span class="info-value" style="color: #fff; font-size: 1rem;">
                        @if (Model.Role == "Member")
                        {
                            <span class="badge bg-secondary">@Model.Role</span>
                        }
                        else if (Model.Role.Contains("Org Officer"))
                        {
                            <span class="badge" style="background: var(--gold-primary); color: #000;">@Model.Role</span>
                        }
                        else
                        {
                            <span class="badge bg-info">@Model.Role</span>
                        }
                    </span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-item">
                    <span class="info-label" style="color: var(--gold-primary); font-size: 0.75rem; text-transform: uppercase; font-weight: bold; display: block; margin-bottom: 5px;">Student Type</span>
                    <span class="info-value" style="color: #fff; font-size: 1rem;">@(Model.Student.StudentType ?? "Regular")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Row -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="stat-card" style="background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3); padding: 15px; border-radius: 10px; text-align: center;">
                <div class="stat-value" style="font-size: 1.5rem; font-weight: bold; color: #22C55E;">@Model.AttendanceRate.ToString("F1")%</div>
                <div class="stat-label" style="font-size: 0.75rem; color: rgba(255,255,255,0.7); text-transform: uppercase;">Attendance Rate</div>
                <div style="font-size: 0.7rem; color: rgba(255,255,255,0.5); margin-top: 5px;">@Model.EventsAttended / @Model.TotalEvents events</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.3); padding: 15px; border-radius: 10px; text-align: center;">
                <div class="stat-value" style="font-size: 1.5rem; font-weight: bold; color: #3B82F6;">₱@Model.TotalFees.ToString("N2")</div>
                <div class="stat-label" style="font-size: 0.75rem; color: rgba(255,255,255,0.7); text-transform: uppercase;">Total Fees</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); padding: 15px; border-radius: 10px; text-align: center;">
                <div class="stat-value" style="font-size: 1.5rem; font-weight: bold; color: #EF4444;">₱@Model.TotalFines.ToString("N2")</div>
                <div class="stat-label" style="font-size: 0.75rem; color: rgba(255,255,255,0.7); text-transform: uppercase;">Total Fines</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: rgba(212, 175, 55, 0.1); border: 1px solid rgba(212, 175, 55, 0.3); padding: 15px; border-radius: 10px; text-align: center;">
                <div class="stat-value" style="font-size: 1.5rem; font-weight: bold; color: var(--gold-primary);">₱@Model.Balance.ToString("N2")</div>
                <div class="stat-label" style="font-size: 0.75rem; color: rgba(255,255,255,0.7); text-transform: uppercase;">Balance</div>
                <div style="font-size: 0.7rem; color: rgba(255,255,255,0.5); margin-top: 5px;">Paid: ₱@Model.TotalPaid.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3" id="studentDetailsTabs" role="tablist" style="border-bottom: 2px solid rgba(212, 175, 55, 0.3);">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="fees-tab" data-bs-toggle="tab" data-bs-target="#fees-content" type="button" role="tab" style="color: rgba(255,255,255,0.7);">
                <i class="bi bi-wallet2 me-1"></i> Fees (@Model.Fees.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="fines-tab" data-bs-toggle="tab" data-bs-target="#fines-content" type="button" role="tab" style="color: rgba(255,255,255,0.7);">
                <i class="bi bi-exclamation-triangle me-1"></i> Fines (@Model.Fines.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="attendance-tab" data-bs-toggle="tab" data-bs-target="#attendance-content" type="button" role="tab" style="color: rgba(255,255,255,0.7);">
                <i class="bi bi-calendar-check me-1"></i> Attendance (@Model.AttendanceHistory.Count)
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="studentDetailsTabContent">
        <!-- Fees Tab -->
        <div class="tab-pane fade show active" id="fees-content" role="tabpanel">
            @if (Model.Fees.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-dark table-hover">
                        <thead style="background: rgba(212, 175, 55, 0.15);">
                            <tr>
                                <th>Fee Name</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Due Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fee in Model.Fees)
                            {
                                <tr>
                                    <td>@(fee.FeeName ?? "N/A")</td>
                                    <td>₱@((fee.Amount ?? 0).ToString("N2"))</td>
                                    <td>
                                        @if (fee.FeeStatus == "Paid" || fee.FeeStatus == "Completed")
                                        {
                                            <span class="badge bg-success">@fee.FeeStatus</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@(fee.FeeStatus ?? "Pending")</span>
                                        }
                                    </td>
                                    <td>@(fee.FeesDueDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4" style="color: rgba(255,255,255,0.5);">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">No fees assigned</p>
                </div>
            }
        </div>

        <!-- Fines Tab -->
        <div class="tab-pane fade" id="fines-content" role="tabpanel">
            @if (Model.Fines.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-dark table-hover">
                        <thead style="background: rgba(239, 68, 68, 0.15);">
                            <tr>
                                <th>Event/Reason</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Due Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fine in Model.Fines)
                            {
                                <tr>
                                    <td>@fine.EventName</td>
                                    <td>₱@fine.Amount.ToString("N2")</td>
                                    <td>
                                        @if (fine.Status == "Paid")
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@fine.Status</span>
                                        }
                                    </td>
                                    <td>@(fine.DueDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4" style="color: rgba(255,255,255,0.5);">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">No fines recorded</p>
                </div>
            }
        </div>

        <!-- Attendance Tab -->
        <div class="tab-pane fade" id="attendance-content" role="tabpanel">
            @if (Model.AttendanceHistory.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-dark table-hover">
                        <thead style="background: rgba(59, 130, 246, 0.15);">
                            <tr>
                                <th>Event Name</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Fine</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.AttendanceHistory)
                            {
                                <tr>
                                    <td>@record.EventName</td>
                                    <td>@(record.Date?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                    <td>
                                        @if (record.Status == "Present")
                                        {
                                            <span class="badge bg-success">Present</span>
                                        }
                                        else if (record.Status == "Absent")
                                        {
                                            <span class="badge bg-danger">Absent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@record.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (record.HasFine)
                                        {
                                            <i class="bi bi-exclamation-circle text-warning"></i>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4" style="color: rgba(255,255,255,0.5);">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">No attendance records</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Footer -->
<div class="modal-footer" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">
    <a href="@Url.Action("StudentRecords", "Admin")?searchString=@Model.Student.StudentNum" class="btn btn-sm btn-outline-light">
        <i class="bi bi-arrow-right-circle me-1"></i> Go to Student Records
    </a>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>

<style>
    .nav-tabs .nav-link {
        border: none;
        border-bottom: 2px solid transparent;
        background: transparent;
    }
    .nav-tabs .nav-link.active {
        color: var(--gold-primary) !important;
        border-bottom-color: var(--gold-primary);
        background: rgba(212, 175, 55, 0.1);
    }
    .nav-tabs .nav-link:hover {
        color: var(--gold-primary) !important;
    }
</style>
