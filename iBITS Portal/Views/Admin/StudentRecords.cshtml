                                {
                                    foreach (var ay in ViewBag.AcademicYearOptions)
                                    {
                                        <option value="@ay" selected="@(ViewBag.CurrentAcademicYear == ay)">@ay</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-bold">Register Student</button>
                </div>
            </form>
        </div>
    </div>
</div>

