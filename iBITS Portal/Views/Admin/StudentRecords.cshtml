                                <option value="Irregular">Irregular</option>
                                <option value="Ladderized">Ladderized</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 2: First Name, Middle Name, Last Name -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="StudentFn" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Middle Name</label>
                            <input type="text" name="StudentMn" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="StudentLn" class="form-control" required />
                        </div>
                    </div>

                    <!-- Row 3: Birthday, Email -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Birthday</label>
                            <input type="date" name="Birthday" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" name="StudentEmail" class="form-control" />
                        </div>
                    </div>

                    <!-- Row 4: Course, Year & Section, School Year -->
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Course/Program</label>
                            <select name="Course" class="form-select select2-modal">
                                <option value="BSIT">BSIT</option>
                                <option value="DIT">DIT</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Year & Section</label>
                            <select name="YearLevelSection" class="form-select select2-modal">
                                <option value="1-1">1-1</option>
                                <option value="2-1">2-1</option>
                                <option value="3-1">3-1</option>
                                <option value="4-1">4-1</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">School Year Enrolled <span class="text-danger">*</span></label>
                            <select name="SchoolYearEnrolled" id="createSchoolYearEnrolled" class="form-select select2-modal" required>
