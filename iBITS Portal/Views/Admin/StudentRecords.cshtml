@section Scripts {
    <script>
        // Function to reveal masked email
        function revealEmail(element, email) {
            const span = element.querySelector('.masked-email');
            const icon = element.querySelector('i');
            
            if (span.innerText.includes('***')) {
                span.innerText = email;
                icon.classList.remove('bi-eye-fill');
                icon.classList.add('bi-eye-slash-fill');
                element.style.color = 'var(--gold-primary)';
            } else {
                // Re-mask logic
                const parts = email.split('@@');
                const masked = parts[0].length > 2 
                    ? parts[0].substring(0, 1) + '*'.repeat(parts[0].length - 2) + parts[0].substring(parts[0].length - 1)
                    : '*'.repeat(parts[0].length);
                span.innerText = masked + '@@' + parts[1];
                icon.classList.remove('bi-eye-slash-fill');
                icon.classList.add('bi-eye-fill');
                element.style.color = '';
            }
        }

        // Define Razor URLs for external JS
        window.getStudentDetailsUrl = '@Url.Action("GetStudentDetails", "Admin")';
        window.analyzeCsvUrl = '@Url.Action("AnalyzeCsv", "Admin")';
        window.analyzeFileUrl = '@Url.Action("AnalyzeCsv", "Admin")';
        window.previewImportUrl = '@Url.Action("PreviewImport", "Admin")';
        window.executeImportUrl = '@Url.Action("ExecuteImport", "Admin")';
    window.getImportRowsUrl = '@Url.Action("GetImportRows", "Admin")';
    window.importSingleRowUrl = '@Url.Action("ImportSingleRow", "Admin")';
        window.studentRecordsUrl = '@Url.Action("StudentRecords", "Admin")';
        window.exportToExcelUrl = '@Url.Action("ExportStudentsToExcel", "Admin")';
        // Bulk action URLs
        window.exportSelectedUrl = '@Url.Action("ExportSelectedStudents", "Admin")';
        window.archiveSelectedUrl = '@Url.Action("ArchiveSelectedStudents", "Admin")';
        window.resetPasswordSelectedUrl = '@Url.Action("ResetPasswordSelected", "Admin")';

        // Auto-apply filters from URL parameters (from dashboard links)
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const program = urlParams.get('program');
            const year = urlParams.get('year');
            
            if (program || year) {
                // Set filter values
                if (program) {
                    const programFilter = document.getElementById('programFilter');
                    if (programFilter) {
                        programFilter.value = program;
                        // Trigger Select2 update if it's initialized
                        if ($(programFilter).hasClass('select2-hidden-accessible')) {
                            $(programFilter).trigger('change');
                        }
                    }
                }
                
                if (year) {
                    const yearFilter = document.getElementById('yearFilter');
                    if (yearFilter) {
                        yearFilter.value = year;
                        // Trigger Select2 update if it's initialized
                        if ($(yearFilter).hasClass('select2-hidden-accessible')) {
                            $(yearFilter).trigger('change');
                        }
                    }
                }
                
                // Submit the form to apply filters
                setTimeout(function() {
                    document.getElementById('filterForm').submit();
                }, 100);
            }

            // Initialize student count display
            updateStudentCountDisplay();
        });

        // Function to update student count display with program breakdown
        function updateStudentCountDisplay() {
            const filteredCount = @(ViewBag.FilteredCount ?? 0);
            const totalCount = @(ViewBag.TotalStudents ?? 0);
            const programBreakdown = @Html.Raw(Json.Serialize(ViewBag.ProgramBreakdown ?? new {}));

            document.getElementById('filteredCount').textContent = filteredCount;
            document.getElementById('totalCount').textContent = totalCount;

            // Build breakdown text
            let breakdownParts = [];
            if (programBreakdown.BSIT > 0) {
                breakdownParts.push(`BSIT: ${programBreakdown.BSIT}`);
            }
            if (programBreakdown.DIT > 0) {
                breakdownParts.push(`DIT: ${programBreakdown.DIT}`);
            }

            const breakdownText = breakdownParts.length > 0 ? `(${breakdownParts.join(', ')})` : '';
            document.getElementById('programBreakdown').textContent = breakdownText;
        }




                // Function to handle the Archive Check
        function confirmArchiveStudent(studentId, studentName) {
            // 1. Show loading state on cursor
            document.body.style.cursor = 'wait';

            // 2. Call the Controller check we created in Step 1
            $.ajax({
                url: '/Admin/CheckStudentDebt',
                type: 'GET',
                data: { id: studentId },
                success: function (response) {
                    document.body.style.cursor = 'default';

                    if (response.hasDebt) {
                        // SCENARIO A: Student owes money -> Show the Warning Modal
                        $('#debtStudentId').val(studentId);
                        $('#debtStudentName').text(studentName);
                $('#debtAmountDisplay').text('?' + response.amount.toLocaleString('en-PH', { timeZone: 'Asia/Manila', minimumFractionDigits: 2 }));
                        $('#debtBreakdownDisplay').text(response.details);

                        $('#studentArchiveWarningModal').modal('show');
                    } else {
                        // SCENARIO B: No debt -> Show standard browser confirmation
                        if (confirm("Are you sure you want to archive " + studentName + "? This will move their paid records to history.")) {
                            submitArchiveForm(studentId);
                        }
                    }
                },
                error: function () {
                    document.body.style.cursor = 'default';
                    // Fallback: If AJAX fails, just try to archive normally
                    if (confirm("Proceed with archiving student " + studentId + "?")) {
                        submitArchiveForm(studentId);
                    }
                }
            });
        }

              function submitArchiveForm(studentId) {
            // Look for the token anywhere on the page
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (!token) {
                alert("Security token missing. Please refresh the page.");
                return;
            }

            const form = $('<form>', {
                "method": "POST",
                "action": "/Admin/ArchiveStudent"
            }).append($('<input>', {
                "type": "hidden",
                "name": "id",
                "value": studentId
            })).append($('<input>', {
                "type": "hidden",
                "name": "__RequestVerificationToken",
                "value": token
            }));

            $('body').append(form);
            form.submit();
        }
    </script>
    <script src="~/js/student-records.js" asp-append-version="true"></script>
}


