@model IEnumerable<iBITS_Portal.Models.Attendance>
@{
    ViewData["Title"] = "Time Attendance Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h2 class="mb-4">
        <i class="fas fa-clock"></i> Time Attendance Management
        <small class="text-muted">Semester: @ViewBag.CurrentSemester</small>
    </h2>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-list"></i> Recent Time-In Records</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No time-in records found for today.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Student Number</th>
                                        <th>Student Name</th>
                                        <th>Time In</th>
                                        <th>Time Out</th>
                                        <th>Duration</th>
                                        <th>Location</th>
                                        <th>Device</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model)
                                    {
                                        <tr>
                                            <td>@record.StudentNum</td>
                                            <td>@record.StudentNumNavigation?.FullName</td>
                                            <td>@record.TimeIn?.ToString("HH:mm:ss")</td>
                                            <td>@(record.TimeOut?.ToString("HH:mm:ss") ?? "-")</td>
                                            <td>
                                                @if (record.DurationMinutes.HasValue)
                                                {
                                                    <span class="badge badge-success">@record.DurationMinutes min</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">Active</span>
                                                }
                                            </td>
                                            <td>@record.Location</td>
                                            <td>@record.ScanDevice</td>
                                            <td>
                                                @if (!record.TimeOut.HasValue)
                                                {
                                                    <button class="btn btn-warning btn-sm" onclick="timeOut('@record.StudentNum')">
                                                            <i class="fas fa-sign-out-alt"></i> Time Out
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted"><i class="fas fa-check"></i> Completed</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5><i class="fas fa-keyboard"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                            <label class="form-label">Manual Time-In</label>
                            <div class="input-group">
                                    <input type="text" id="studentNumForTimeIn" class="form-control" placeholder="Enter Student Number" />
                                    <button class="btn btn-primary" onclick="timeIn()">
                                            <i class="fas fa-sign-in-alt"></i> Time In
                                    </button>
                            </div>
                    </div>

                    <div class="mb-3">
                            <label class="form-label">Manual Time-Out</label>
                            <div class="input-group">
                                    <input type="text" id="studentNumForTimeOut" class="form-control" placeholder="Enter Student Number" />
                                    <button class="btn btn-warning" onclick="timeOut()">
                                            <i class="fas fa-sign-out-alt"></i> Time Out
                                    </button>
                            </div>
                    </div>

                    <div class="text-center">
                            <small class="text-muted">
                                    <i class="fas fa-info-circle"></i>
                                    Use these for manual attendance recording or corrections
                            </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function timeIn() {
            const studentNum = document.getElementById('studentNumForTimeIn').value;
            if (!studentNum) {
                alert('Please enter a student number');
                return;
            }

            fetch('/Admin/RecordTimeIn', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ studentNum: studentNum })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(`Successfully timed in: ${data.studentName} at ${data.timeIn}`);
                    location.reload();
                } else {
                    alert(`Error: ${data.message}`);
                }
            })
            .catch(error => {
                alert('Error recording time in');
                console.error(error);
            });
        }

        function timeOut() {
            const studentNum = document.getElementById('studentNumForTimeOut').value;
            if (!studentNum) {
                alert('Please enter a student number');
                return;
            }

            fetch('/Admin/RecordTimeOut', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ studentNum: studentNum })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(`Successfully timed out: ${data.studentName} (Duration: ${data.duration} minutes)`);
                    location.reload();
                } else {
                    alert(`Error: ${data.message}`);
                }
            })
            .catch(error => {
                alert('Error recording time out');
                console.error(error);
            });
        }
    </script>
}