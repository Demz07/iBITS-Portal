@* Views/Admin/Events.cshtml *@

@model iBITS_Portal.Models.PagedList<iBITS_Portal.Models.Event>
@{
    ViewData["Title"] = "Events";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Link External CSS -->
<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;"><i class="bi bi-calendar-event me-2"></i> Events</h3>
        <p class="text-muted small mb-0">Manage organization activities and schedules.</p>
    </div>
    <button class="btn-gold" data-bs-toggle="modal" data-bs-target="#createEventModal"><i class="bi bi-plus-lg"></i> Create New Event</button>
</div>

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- EVENT FILTER PANEL (Collapsible) -->
<div class="glass-panel mb-3">
    <!-- Filter Header -->
    <div class="p-3 d-flex justify-content-between align-items-center" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#filterCollapse">
        <div class="d-flex align-items-center gap-3">
            <h6 class="mb-0" style="color: var(--gold-text); font-weight: 600;">
                <i class="bi bi-funnel-fill me-2"></i>Filters
            </h6>
            <!-- Active Filter Badges -->
            <div id="activeFilterBadges" class="d-flex flex-wrap gap-2"></div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" id="clearAllFilters" class="btn btn-sm" 
                    style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 6px; padding: 4px 10px; font-size: 0.8rem;">
                <i class="bi bi-x-circle me-1"></i>Clear
            </button>
            <i class="bi bi-chevron-down" id="filterToggleIcon" style="color: var(--gold-text); transition: transform 0.3s;"></i>
        </div>
    </div>

    <!-- Collapsible Filter Form -->
    <div class="collapse show" id="filterCollapse">
        <div class="p-3 pt-0" style="border-top: 1px solid var(--border-color);">
            <form id="eventFilterForm" method="get" asp-action="Events">
                <div class="row g-2">
                    <!-- Search Bar -->
                    <div class="col-md-3">
                        <label class="form-label" style="color: var(--text-main); font-weight: 500; font-size: 0.85rem;">
                            <i class="bi bi-search me-1"></i>Search
                        </label>
                        <input type="text" 
                               name="search" 
                               id="searchInput"
                               class="form-control glass-input filter-trigger" 
                               placeholder="Search events..."
                               value="@ViewBag.CurrentSearch">
                    </div>

                    <!-- Academic Year Filter -->
                    <div class="col-md-2">
                        <label class="form-label" style="color: var(--text-main); font-weight: 500; font-size: 0.85rem;">
                            <i class="bi bi-calendar3 me-1"></i>Academic Year
                        </label>
                        <select name="acadYear" 
                                id="acadYearFilter" 
                                class="form-select glass-dropdown filter-trigger">
                            <option value="">All Years</option>
                            @if (ViewBag.AcademicYears != null)
                            {
                                foreach (var year in ViewBag.AcademicYears)
                                {
                                    var isSelected = ViewBag.CurrentAcadYear == year;
                                    <option value="@year" selected="@isSelected">@year</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Event Type Filter -->
                    <div class="col-md-2">
                        <label class="form-label" style="color: var(--text-main); font-weight: 500; font-size: 0.85rem;">
                            <i class="bi bi-tag me-1"></i>Type
                        </label>
                        <select name="eventType" 
                                id="eventTypeFilter" 
                                class="form-select glass-dropdown filter-trigger">
                            <option value="">All Types</option>
                            <option value="iBITS Event" selected="@(ViewBag.CurrentEventType == "iBITS Event")">iBITS Event</option>
                            <option value="Non-iBITS Event" selected="@(ViewBag.CurrentEventType == "Non-iBITS Event")">Non-iBITS Event</option>
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div class="col-md-2">
                        <label class="form-label" style="color: var(--text-main); font-weight: 500; font-size: 0.85rem;">
                            <i class="bi bi-clock-history me-1"></i>Status
                        </label>
                        <select name="status" 
                                id="statusFilter" 
                                class="form-select glass-dropdown filter-trigger">
                            <option value="">All</option>
                            <option value="upcoming" selected="@(ViewBag.CurrentStatus == "upcoming")">Upcoming</option>
                            <option value="today" selected="@(ViewBag.CurrentStatus == "today")">Today</option>
                            <option value="past" selected="@(ViewBag.CurrentStatus == "past")">Past</option>
                        </select>
                    </div>

                    <!-- Closure Status Filter -->
                    <div class="col-md-3">
                        <label class="form-label" style="color: var(--text-main); font-weight: 500; font-size: 0.85rem;">
                            <i class="bi bi-lock me-1"></i>Closure
                        </label>
                        <select name="isClosed" 
                                id="isClosedFilter" 
                                class="form-select glass-dropdown filter-trigger">
                            <option value="">All Events</option>
                            <option value="false" selected="@(ViewBag.CurrentIsClosed == "false")">Open Only</option>
                            <option value="true" selected="@(ViewBag.CurrentIsClosed == "true")">Closed Only</option>
                        </select>
                    </div>
                </div>

                <!-- Date Range Row -->
                <div class="row g-2 mt-2">
                    <!-- Date From -->
                    <div class="col-md-3">
                        <label class="form-label" style="color: var(--text-main); font-weight: 500; font-size: 0.85rem;">
                            <i class="bi bi-calendar-check me-1"></i>Date From
                        </label>
                        <input type="date" 
                               name="dateFrom" 
                               id="dateFromFilter"
                               class="form-control glass-input filter-trigger" 
                               value="@ViewBag.CurrentDateFrom">
                    </div>

                    <!-- Date To -->
                    <div class="col-md-3">
                        <label class="form-label" style="color: var(--text-main); font-weight: 500; font-size: 0.85rem;">
                            <i class="bi bi-calendar-x me-1"></i>Date To
                        </label>
                        <input type="date" 
                               name="dateTo" 
                               id="dateToFilter"
                               class="form-control glass-input filter-trigger" 
                               value="@ViewBag.CurrentDateTo">
                    </div>
                </div>

                <!-- Quick Filter Buttons -->
                <div class="mt-2 pt-2" style="border-top: 1px solid var(--border-color);">
                    <small class="text-muted mb-2 d-block" style="color: var(--text-main); font-size: 0.8rem;">Quick Filters:</small>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="quick-filter-btn" data-filter="week">
                            <i class="bi bi-calendar-week"></i> This Week
                        </button>
                        <button type="button" class="quick-filter-btn" data-filter="month">
                            <i class="bi bi-calendar-month"></i> This Month
                        </button>
                        <button type="button" class="quick-filter-btn" data-filter="upcoming">
                            <i class="bi bi-arrow-right-circle"></i> Upcoming
                        </button>
                        <button type="button" class="quick-filter-btn" data-filter="past">
                            <i class="bi bi-clock-history"></i> Past
                        </button>
                        <button type="button" class="quick-filter-btn" data-filter="open">
                            <i class="bi bi-unlock"></i> Open
                        </button>
                        <button type="button" class="quick-filter-btn" data-filter="closed">
                            <i class="bi bi-lock"></i> Closed
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Results Count Info Bar -->
@if (ViewBag.FilterApplied == true)
{
    <div class="mb-3 p-3" style="background: rgba(59, 130, 246, 0.1); border-left: 4px solid #3b82f6; border-radius: 8px;">
        <i class="bi bi-info-circle me-2" style="color: #60a5fa;"></i>
        <span style="color: var(--text-strong);">
            Showing <strong>@Model.TotalCount</strong> event(s) matching your filters
        </span>
        <a href="@Url.Action("Events")" class="ms-3" style="color: var(--gold-text); text-decoration: none;">
            <i class="bi bi-x-circle"></i> Clear filters
        </a>
    </div>
}

<!-- EVENTS GRID -->
<div class="row g-4">
    @if (Model != null && Model.Items != null && Model.Items.Any())
    {
        @foreach (var item in Model.Items)
        {
            string statusClass = "badge-completed";
            string statusText = "Completed";

            var now = DateTime.Now;
            var today = DateOnly.FromDateTime(now);
            var timeNow = TimeOnly.FromDateTime(now);

            DateOnly effectiveEndDate = item.EndDate ?? item.EventDate ?? DateOnly.MaxValue;

            bool isPastDate = effectiveEndDate < today;
            bool isPastTimeToday = effectiveEndDate == today && item.EndTime.HasValue && item.EndTime.Value < timeNow;
            bool isAutomaticallyClosed = isPastDate || isPastTimeToday;

            // STATUS LOGIC
            if (item.IsClosed || isAutomaticallyClosed)
            {
                statusClass = "badge-completed";
                statusText = "Completed";
            }
            else if (item.EventDate.HasValue)
            {
                if (item.EventDate.Value > today)
                {
                    statusClass = "badge-upcoming";
                    statusText = "Upcoming";
                }
                else if (item.EventDate.Value == today)
                {
                    if (item.StartTime.HasValue && item.StartTime.Value > timeNow)
                    {
                        statusClass = "badge-upcoming"; 
                        statusText = "Upcoming";
                    }
                    else
                    {
                        statusClass = "badge-today";    
                        statusText = "Happening Now";
                    }
                }
            }

            <div class="col-md-6 col-lg-4">
                <div class="glass-card">
                    <!-- Gradient Header & Status -->
                    <div class="event-header-gradient">
                        <span class="status-badge @statusClass">@statusText</span>
                        <div class="event-date-sticker">
                            <span class="date-month">@(item.EventDate.HasValue? item.EventDate.Value.ToString("MMM") : "TBA")</span>
                            <span class="date-day">@(item.EventDate.HasValue? item.EventDate.Value.Day.ToString() : "--")</span>
                        </div>
                    </div>

                    <div class="event-body">
                        <h5 class="event-title" title="@item.EventName">@item.EventName</h5>

                        <div class="event-meta">
                            <div class="meta-item">
                                <i class="bi bi-clock"></i>
                                <span>@(item.StartTime.HasValue? item.StartTime.Value.ToString(@"h\:mm tt") : "TBA")</span>
                            </div>
                            <div class="meta-item">
                                <i class="bi bi-geo-alt"></i>
                                <span class="text-truncate" style="max-width: 120px;" title="@item.EventLocation">@(item.EventLocation ?? "TBA")</span>
                            </div>
                        </div>

                        <div class="event-desc">
                            @(string.IsNullOrEmpty(item.EventDesc) ? "No additional details provided for this event." : item.EventDesc)
                        </div>

                        <!-- Footer -->
                        <div class="event-footer">
                            <div class="attendees-tag" title="Total Attendees">
                                <i class="bi bi-people-fill"></i> @(item.Attendances?.Count ?? 0)
                            </div>

                            <div class="d-flex gap-2">
                                <!-- 1. MANAGE (Active) vs VIEW (Completed) Logic -->
                                @if (statusText != "Completed")
                                {
                                    <button class="btn btn-sm btn-glass text-danger"
                                            title="Close Event & Assign Fines"
                                            data-bs-toggle="modal"
                                            data-bs-target="#closeEventModal"
                                            onclick="setCloseEventModal('@item.EventId', '@item.EventName')">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                    </button>

                                    <button class="btn btn-sm btn-glass text-warning"
                                            title="Archive Event"
                                            onclick="archiveEvent(@item.EventId, '@item.EventName')">
                                        <i class="bi bi-archive-fill"></i>
                                    </button>

                                    <button class="btn btn-sm btn-manage-event"
                                            style="font-size: 0.75rem; padding: 5px 12px;"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editEventModal"
                                            data-locked="false"
                                            
                                            data-event-id="@item.EventId"
                                            data-event-name="@item.EventName"
                                            data-event-location="@item.EventLocation"
                                            data-event-date="@(item.EventDate.HasValue ? item.EventDate.Value.ToString("yyyy-MM-dd") : "")"
                                            data-start-time="@item.StartTime?.ToString(@"HH\:mm")"
                                            data-end-date="@(item.EndDate.HasValue ? item.EndDate.Value.ToString("yyyy-MM-dd") : "")"
                                            data-end-time="@item.EndTime?.ToString(@"HH\:mm")"
                                            data-event-duration="@item.EventDuration"
                                            data-event-acad-year="@item.AcadYear"
                                            data-event-desc="@item.EventDesc"
                                            data-event-type="@item.EventType"
                                            data-fine-member="@item.FineForMember"
                                            data-fine-class-officer="@item.FineForClassOfficer"
                                            data-fine-org-officer="@item.FineForOrgOfficer"
                                            data-non-ibits-fine-member="@item.NonIbitsFineForMember"
                                            data-non-ibits-fine-class-officer="@item.NonIbitsFineForClassOfficer"
                                            data-non-ibits-fine-org-officer="@item.NonIbitsFineForOrgOfficer">
                                        Manage
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-view-details"
                                            style="font-size: 0.75rem; padding: 5px 12px;"
                                            title="View Details (Event Locked)"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editEventModal"
                                            data-locked="true"
                                            
                                            data-event-id="@item.EventId"
                                            data-event-name="@item.EventName"
                                            data-event-location="@item.EventLocation"
                                            data-event-date="@(item.EventDate.HasValue ? item.EventDate.Value.ToString("yyyy-MM-dd") : "")"
                                            data-start-time="@item.StartTime?.ToString(@"HH\:mm")"
                                            data-end-date="@(item.EndDate.HasValue ? item.EndDate.Value.ToString("yyyy-MM-dd") : "")"
                                            data-end-time="@item.EndTime?.ToString(@"HH\:mm")"
                                            data-event-duration="@item.EventDuration"
                                            data-event-acad-year="@item.AcadYear"
                                            data-event-desc="@item.EventDesc"
                                            data-event-type="@item.EventType"
                                            data-fine-member="@item.FineForMember"
                                            data-fine-class-officer="@item.FineForClassOfficer"
                                            data-fine-org-officer="@item.FineForOrgOfficer"
                                            data-non-ibits-fine-member="@item.NonIbitsFineForMember"
                                            data-non-ibits-fine-class-officer="@item.NonIbitsFineForClassOfficer"
                                            data-non-ibits-fine-org-officer="@item.NonIbitsFineForOrgOfficer">
                                        <i class="bi bi-eye-fill me-1"></i> View Details
                                    </button>
                                }
                            </div>
                        </div> <!-- End Footer -->
                    </div> <!-- End Event Body -->
                </div> <!-- End Glass Card -->
            </div> <!-- End Col -->
        } @* End Foreach *@
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="glass-panel p-5 d-inline-block">
                <i class="bi bi-calendar-event text-muted" style="font-size: 3rem; opacity:0.5;"></i>
                <h5 class="text-muted mt-3 fw-bold">No Events Found</h5>
                <button class="btn btn-gold btn-sm" data-bs-toggle="modal" data-bs-target="#createEventModal">
                    <i class="bi bi-plus-lg me-1"></i> Create Event
                </button>
            </div>
        </div>
    }
</div> <!-- End Row -->

<!-- PAGINATION -->
@if (Model != null && Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4 glass-panel p-3">
        <div class="text-muted small">
            Showing @((Model.PageNumber - 1) * Model.PageSize + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount events
        </div>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Events", new { pageNumber = Model.PageNumber - 1 })"><i class="bi bi-chevron-left"></i></a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Events", new { pageNumber = i })">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Events", new { pageNumber = Model.PageNumber + 1 })"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    </div>
}

<!-- ================= MODAL: CREATE EVENT ================= -->
<div class="modal fade" id="createEventModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title text-gold"><i class="bi bi-calendar-plus me-2"></i> Create New Event</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateEvent" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Academic Year*</label>
                            <input type="text" name="AcadYear" class="form-control" placeholder="e.g., 2023-2024" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Event Type*</label>
                            <select name="EventType" class="form-select select2-modal" required style="width: 100%;">
                                <option value="iBITS Event">iBITS Event</option>
                                <option value="Non-iBITS Event">Non-iBITS Event</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Event Name*</label>
                            <input type="text" name="EventName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Start Date*</label>
                            <input type="date" name="EventDate" id="createEventDate" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Date</label>
                            <input type="date" name="EndDate" id="createEndDate" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Start Time</label>
                            <input type="time" name="StartTime" id="createStartTime" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Time</label>
                            <input type="time" name="EndTime" id="createEndTime" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Location</label>
                            <input type="text" name="EventLocation" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Duration (Optional)</label>
                            <input type="text" name="EventDuration" class="form-control" placeholder="e.g., 2 hours" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea name="EventDesc" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <hr class="my-3" style="border-color: var(--border-color);" />
                    <div class="row g-3">
                        <div class="col-12"><h6 class="text-gold"><i class="bi bi-star-fill me-2"></i>iBITS Event Fines</h6></div>
                        <div class="col-md-4"><label class="form-label">Member (₱)</label><input type="number" step="0.01" name="FineForMember" class="form-control" value="100.00" /></div>
                        <div class="col-md-4"><label class="form-label">Class Officer (₱)</label><input type="number" step="0.01" name="FineForClassOfficer" class="form-control" value="150.00" /></div>
                        <div class="col-md-4"><label class="form-label">Org Officer (₱)</label><input type="number" step="0.01" name="FineForOrgOfficer" class="form-control" value="300.00" /></div>
                        <div class="col-12 mt-3"><h6 class="text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Non-iBITS Event Fines</h6></div>
                        <div class="col-md-4"><label class="form-label">Member (₱)</label><input type="number" step="0.01" name="NonIbitsFineForMember" class="form-control" value="50.00" /></div>
                        <div class="col-md-4"><label class="form-label">Class Officer (₱)</label><input type="number" step="0.01" name="NonIbitsFineForClassOfficer" class="form-control" value="100.00" /></div>
                        <div class="col-md-4"><label class="form-label">Org Officer (₱)</label><input type="number" step="0.01" name="NonIbitsFineForOrgOfficer" class="form-control" value="150.00" /></div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-gold-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold">Save Event</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL: EDIT EVENT (UPDATED WITH IDs FOR LOCKING) ================= -->
<div class="modal fade" id="editEventModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <!-- ADDED ID -->
                <h5 class="modal-title text-gold" id="editEventTitle"><i class="bi bi-pencil-square me-2"></i> Edit Event</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditEvent" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editEventId" name="EventId" />
                <div class="modal-body">
                    <!-- ADDED FIELDSET WRAPPER -->
                    <fieldset id="editEventFieldset">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Academic Year*</label>
                                <input type="text" id="editAcadYear" name="AcadYear" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Event Type*</label>
                                <select id="editEventType" name="EventType" class="form-select select2-modal" required style="width: 100%;">
                                    <option value="iBITS Event">iBITS Event</option>
                                    <option value="Non-iBITS Event">Non-iBITS Event</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Event Name*</label>
                                <input type="text" id="editEventName" name="EventName" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Start Date*</label>
                                <input type="date" id="editEventDate" name="EventDate" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">End Date</label>
                                <input type="date" id="editEndDate" name="EndDate" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Start Time</label>
                                <input type="time" id="editStartTime" name="StartTime" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">End Time</label>
                                <input type="time" id="editEndTime" name="EndTime" class="form-control" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Location</label>
                                <input type="text" id="editEventLocation" name="EventLocation" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Duration (Optional)</label>
                                <input type="text" id="editEventDuration" name="EventDuration" class="form-control" placeholder="e.g., 2 hours" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea id="editEventDesc" name="EventDesc" class="form-control" rows="2"></textarea>
                            </div>
                        </div>

                        <hr class="my-3" style="border-color: var(--border-color);" />

                        <div class="row g-3">
                            <div class="col-12"><h6 class="text-gold"><i class="bi bi-star-fill me-2"></i>iBITS Event Fines</h6></div>
                            <div class="col-md-4"><label class="form-label">Member (₱)</label><input type="number" step="0.01" id="editFineForMember" name="FineForMember" class="form-control" /></div>
                            <div class="col-md-4"><label class="form-label">Class Officer (₱)</label><input type="number" step="0.01" id="editFineForClassOfficer" name="FineForClassOfficer" class="form-control" /></div>
                            <div class="col-md-4"><label class="form-label">Org Officer (₱)</label><input type="number" step="0.01" id="editFineForOrgOfficer" name="FineForOrgOfficer" class="form-control" /></div>
                            <div class="col-12 mt-3"><h6 class="text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Non-iBITS Event Fines</h6></div>
                            <div class="col-md-4"><label class="form-label">Member (₱)</label><input type="number" step="0.01" id="editNonIbitsFineForMember" name="NonIbitsFineForMember" class="form-control" /></div>
                            <div class="col-md-4"><label class="form-label">Class Officer (₱)</label><input type="number" step="0.01" id="editNonIbitsFineForClassOfficer" name="NonIbitsFineForClassOfficer" class="form-control" /></div>
                            <div class="col-md-4"><label class="form-label">Org Officer (₱)</label><input type="number" step="0.01" id="editNonIbitsFineForOrgOfficer" name="NonIbitsFineForOrgOfficer" class="form-control" /></div>
                        </div>
                    </fieldset> <!-- END FIELDSET -->
                </div>
                <div class="modal-footer border-0">
                    <!-- ADDED BUTTON IDs -->
                    <button type="button" class="btn btn-outline-danger" id="btnEditDelete" data-bs-toggle="modal" data-bs-target="#deleteEventModal">Delete Event</button>
                    <button type="button" class="btn btn-gold-outline" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-gold" id="btnEditSave">Update Event</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL: DELETE EVENT CONFIRMATION ================= -->
<div class="modal fade" id="deleteEventModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Event</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="DeleteEvent" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteEventId" name="eventId" />
                <div class="modal-body">
                    <p class="text-light">⚠️ This action cannot be undone. All attendance records associated with this event will be permanently deleted.</p>
                    <div class="mb-3">
                        <label class="form-label">Confirm with your Admin Password</label>
                        <input type="password" name="Password" class="form-control" placeholder="Enter your password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason for Deletion</label>
                        <textarea name="Reason" class="form-control" rows="2" placeholder="Why are you deleting this event?" required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Permanently</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL: CLOSE EVENT & ASSIGN FINES ================= -->
<div class="modal fade" id="closeEventModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i> Close Event & Assign Fines</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CloseEvent" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="closeEventId" name="eventId" />
                <div class="modal-body">
                    <p class="text-light">You are about to close event: <strong id="closeEventName"></strong></p>
                    <p class="text-warning small">⚠️ This will automatically assign fines to all students marked as "Absent" for this event.</p>
                    <div class="mb-3">
                        <label class="form-label">Confirm with your Admin Password</label>
                        <input type="password" name="Password" class="form-control" placeholder="Enter your password" required />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Close Event & Assign Fines</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- jQuery (Required for Select2) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Custom Events JS (Uses the External File) -->
    <script src="~/js/events.js"></script>

    <script>
        $(document).ready(function () {
            // Initialize Select2 for Create Modal
            $('#createEventModal').on('shown.bs.modal', function () {
                $(this).find('select').select2({
                    dropdownParent: $('#createEventModal'),
                    minimumResultsForSearch: Infinity,
                    width: '100%'
                });
            });

            // Initialize Select2 for Edit Modal
            $('#editEventModal').on('shown.bs.modal', function () {
                $(this).find('select').select2({
                    dropdownParent: $('#editEventModal'),
                    minimumResultsForSearch: Infinity,
                    width: '100%'
                });
            });

            // Reset form when Create Modal is closed
            $('#createEventModal').on('hidden.bs.modal', function () {
                const form = $(this).find('form')[0];
                if (form) {
                    form.reset();
                    $('#createEventModal select').val('iBITS Event').trigger('change');
                }
            });

            // ========================================
            // EVENT FILTER FUNCTIONALITY
            // ========================================
            
            // Real-time filtering with debounce
            let filterTimeout;
            document.querySelectorAll('.filter-trigger').forEach(input => {
                input.addEventListener('change', function() {
                    clearTimeout(filterTimeout);
                    filterTimeout = setTimeout(() => {
                        document.getElementById('eventFilterForm').submit();
                    }, 300);
                });
                
                // For text input, use keyup with debounce
                if (input.type === 'text') {
                    input.addEventListener('keyup', function() {
                        clearTimeout(filterTimeout);
                        filterTimeout = setTimeout(() => {
                            document.getElementById('eventFilterForm').submit();
                        }, 800); // Longer delay for typing
                    });
                }
            });
            
            // Collapse icon rotation
            const filterCollapse = document.getElementById('filterCollapse');
            const filterToggleIcon = document.getElementById('filterToggleIcon');
            
            filterCollapse.addEventListener('show.bs.collapse', function () {
                filterToggleIcon.style.transform = 'rotate(180deg)';
            });
            
            filterCollapse.addEventListener('hide.bs.collapse', function () {
                filterToggleIcon.style.transform = 'rotate(0deg)';
            });
            
            // Update active filter badges
            function updateFilterBadges() {
                const badges = [];
                const form = document.getElementById('eventFilterForm');
                
                // Check search
                const search = document.getElementById('searchInput').value;
                if (search) badges.push({ label: 'Search: ' + search, icon: 'search' });
                
                // Check academic year
                const acadYear = document.getElementById('acadYearFilter').value;
                if (acadYear) badges.push({ label: acadYear, icon: 'calendar3' });
                
                // Check event type
                const eventType = document.getElementById('eventTypeFilter').value;
                if (eventType) badges.push({ label: eventType, icon: 'tag' });
                
                // Check status
                const status = document.getElementById('statusFilter').value;
                if (status) badges.push({ label: status.charAt(0).toUpperCase() + status.slice(1), icon: 'clock-history' });
                
                // Check closure
                const isClosed = document.getElementById('isClosedFilter').value;
                if (isClosed === 'true') badges.push({ label: 'Closed', icon: 'lock' });
                if (isClosed === 'false') badges.push({ label: 'Open', icon: 'unlock' });
                
                // Check dates
                const dateFrom = document.getElementById('dateFromFilter').value;
                const dateTo = document.getElementById('dateToFilter').value;
                if (dateFrom || dateTo) {
                    const dateLabel = dateFrom && dateTo ? `${dateFrom} to ${dateTo}` : 
                                      dateFrom ? `From ${dateFrom}` : `To ${dateTo}`;
                    badges.push({ label: dateLabel, icon: 'calendar-range' });
                }
                
                // Render badges
                const container = document.getElementById('activeFilterBadges');
                container.innerHTML = badges.map(b => 
                    `<span class="badge" style="background: var(--gold-dim); color: var(--gold-text); font-size: 0.75rem; padding: 4px 8px; border-radius: 12px; font-weight: 500;">
                        <i class="bi bi-${b.icon} me-1"></i>${b.label}
                    </span>`
                ).join('');
            }
            
            // Call on page load
            updateFilterBadges();
            
            // Quick Filter Buttons
            document.querySelectorAll('.quick-filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const filter = this.dataset.filter;
                    const form = document.getElementById('eventFilterForm');
                    
                    // Clear existing filters
                    form.querySelectorAll('input, select').forEach(input => {
                        if (input.type !== 'submit' && input.type !== 'button') {
                            input.value = '';
                        }
                    });
                    
                    const today = new Date();
                    const formatDate = (date) => {
                        const year = date.getFullYear();
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const day = String(date.getDate()).padStart(2, '0');
                        return `${year}-${month}-${day}`;
                    };
                    
                    switch(filter) {
                        case 'week':
                            document.getElementById('dateFromFilter').value = formatDate(today);
                            const nextWeek = new Date(today);
                            nextWeek.setDate(today.getDate() + 7);
                            document.getElementById('dateToFilter').value = formatDate(nextWeek);
                            break;
                            
                        case 'month':
                            document.getElementById('dateFromFilter').value = formatDate(today);
                            const nextMonth = new Date(today);
                            nextMonth.setMonth(today.getMonth() + 1);
                            document.getElementById('dateToFilter').value = formatDate(nextMonth);
                            break;
                            
                        case 'upcoming':
                            document.getElementById('statusFilter').value = 'upcoming';
                            break;
                            
                        case 'past':
                            document.getElementById('statusFilter').value = 'past';
                            break;
                            
                        case 'open':
                            document.getElementById('isClosedFilter').value = 'false';
                            break;
                            
                        case 'closed':
                            document.getElementById('isClosedFilter').value = 'true';
                            break;
                    }
                    
                    form.submit();
                });
            });
            
            // Clear All Filters Button
            document.getElementById('clearAllFilters').addEventListener('click', function(e) {
                e.stopPropagation(); // Prevent collapse toggle
                window.location.href = '@Url.Action("Events")';
            });
        });

        // Archive Event Function
        function archiveEvent(eventId, eventName) {
            if (confirm(`Are you sure you want to archive the event "${eventName}"? This will remove it from the active events list.`)) {
                $.ajax({
                    url: '@Url.Action("ArchiveEvent", "Admin")',
                    type: 'POST',
                    data: { 
                        eventId: eventId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            alert('Event archived successfully!');
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('An error occurred while archiving the event.');
                    }
                });
            }
        }
    </script>

    <style>
        /* Glass Input & Dropdown Styles */
        .glass-input,
        .glass-dropdown {
            background: var(--input-bg) !important;
            border: 1px solid var(--input-border) !important;
            color: var(--text-strong) !important;
            border-radius: 8px !important;
            padding: 8px 12px !important;
            height: 38px !important;
            font-size: 0.9rem !important;
            transition: all 0.3s ease !important;
        }

        .glass-input:focus,
        .glass-dropdown:focus {
            outline: none !important;
            border-color: var(--gold-primary) !important;
            box-shadow: 0 0 0 3px var(--gold-dim) !important;
            background: var(--input-bg) !important;
        }

        /* Dropdown options styling */
        .glass-dropdown option {
            background: var(--bg-glass) !important;
            color: var(--text-strong) !important;
            padding: 10px !important;
        }

        .glass-dropdown option:hover {
            background: var(--gold-dim) !important;
            color: var(--gold-text) !important;
        }

        /* Quick Filter Buttons */
        .quick-filter-btn {
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            color: var(--text-main);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .quick-filter-btn:hover {
            background: var(--gold-dim);
            border-color: var(--gold-primary);
            color: var(--gold-text);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(212, 175, 55, 0.2);
        }

        .quick-filter-btn:active {
            transform: translateY(0);
        }

        .quick-filter-btn i {
            font-size: 0.9rem;
        }

        /* Ensure glass panel uses theme variables */
        .glass-panel {
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: var(--shadow-soft);
        }
    </style>
}