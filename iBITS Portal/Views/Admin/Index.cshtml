@* ============================================================ *@
@* FILE PATH: Views/Admin/Index.cshtml                          *@
@* ============================================================ *@
@* DASHBOARD: Charts & Statistics Overview                      *@
@* Gold & Navy Blue Theme - Glassmorphism Design                *@
@* Categorized Sections: Enrollment, Status, Financial, Events  *@
@* ============================================================ *@

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container">
    <!-- ============================================================ -->
    <!-- HEADER SECTION                                               -->
    <!-- ============================================================ -->
    <div class="dashboard-header glass-panel">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="dashboard-title">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </h4>
                <p class="dashboard-subtitle mb-0">Overview of student statistics and analytics</p>
            </div>

            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="date-display">
                    <i class="bi bi-calendar3 me-2"></i>
                    <span id="currentDate">@PhTime.Now.ToString("MMMM dd, yyyy")</span>
                </div>
                <button class="btn-gold-outline" onclick="refreshDashboard()" title="Refresh Data" id="btnRefresh">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                </button>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- QUICK ACTIONS PANEL (Collapsible)                            -->
    <!-- ============================================================ -->
    <div class="quick-actions-panel glass-panel" id="quickActionsPanel">
        <div class="quick-actions-header" data-bs-toggle="collapse" data-bs-target="#quickActionsContent">
            <div class="d-flex align-items-center">
                <i class="bi bi-lightning-charge-fill me-2 text-gold"></i>
                <h6 class="mb-0">Quick Actions</h6>
            </div>
            <button class="btn-collapse" type="button">
                <i class="bi bi-chevron-down" id="quickActionsChevron"></i>
            </button>
        </div>
        <div class="collapse show" id="quickActionsContent">
            <div class="quick-actions-grid">
                <!-- Add Student -->
                <a href="@Url.Action("StudentRecords", "Admin")?action=add" class="quick-action-card" aria-label="Add new student">
                    <div class="action-icon add-student" aria-hidden="true">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <div class="action-content">
                        <span class="action-title">Add Student</span>
                        <span class="action-desc">Quick enroll</span>
                    </div>
                </a>

                <!-- Create Fee -->
                <a href="@Url.Action("Payments", "Admin")?action=createFee" class="quick-action-card" aria-label="Create new fee">
                    <div class="action-icon create-fee" aria-hidden="true">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div class="action-content">
                        <span class="action-title">Create Fee</span>
                        <span class="action-desc">Assign payment</span>
                    </div>
                </a>

                <!-- Create Event -->
                <a href="@Url.Action("Events", "Admin")?action=create" class="quick-action-card" aria-label="Create new event">
                    <div class="action-icon create-event" aria-hidden="true">
                        <i class="bi bi-calendar-plus-fill"></i>
                    </div>
                    <div class="action-content">
                        <span class="action-title">Create Event</span>
                        <span class="action-desc">Schedule new</span>
                    </div>
                </a>

                <!-- Export Reports -->
                <div class="quick-action-card dropdown">
                    <div class="dropdown-trigger-area" 
                         data-bs-toggle="dropdown" 
                         aria-expanded="false"
                         role="button"
                         tabindex="0"
                         aria-label="Export reports menu"
                         onkeypress="if(event.key==='Enter' || event.key===' ') this.click()">
                        <div class="action-icon export-reports" aria-hidden="true">
                            <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                        </div>
                        <div class="action-content">
                            <span class="action-title">Export Reports</span>
                            <span class="action-desc">Download data</span>
                        </div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-dark shadow-lg">
                        <li><a class="dropdown-item" href="@Url.Action("ExportDashboardReport", "Admin")?format=excel&reportType=students"><i class="bi bi-people me-2"></i>Student List (Excel)</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("ExportDashboardReport", "Admin")?format=excel&reportType=financial"><i class="bi bi-cash-stack me-2"></i>Financial Report (Excel)</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("ExportDashboardReport", "Admin")?format=excel&reportType=attendance"><i class="bi bi-calendar-check me-2"></i>Attendance Report (Excel)</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="@Url.Action("ExportDashboardReport", "Admin")?format=excel&reportType=full"><i class="bi bi-file-earmark-zip me-2"></i>Full Dashboard Report</a></li>
                    </ul>
                </div>

                <!-- Send Notice -->
                <button type="button" class="quick-action-card" data-bs-toggle="modal" data-bs-target="#sendNoticeModal" aria-label="Send notice to students">
                    <div class="action-icon send-notice" aria-hidden="true">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <div class="action-content">
                        <span class="action-title">Send Notice</span>
                        <span class="action-desc">Bulk notify</span>
                    </div>
                </button>

                <!-- Scan Attendance -->
                <a href="@Url.Action("Attendance", "Admin")" class="quick-action-card" aria-label="View attendance records">
                    <div class="action-icon scan-attendance" aria-hidden="true">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                    <div class="action-content">
                        <span class="action-title">Attendance</span>
                        <span class="action-desc">Attendance Records</span>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- SECTION 1: STUDENT ENROLLMENT                                -->
    <!-- ============================================================ -->
    <div class="dashboard-section">
        <div class="section-header">
            <div class="section-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h5 class="section-title">Student Enrollment</h5>
            <span class="section-badge">BSIT & DIT Programs</span>
        </div>

        <div class="row g-4">
            <!-- Doughnut Chart: Students per Program -->
            <div class="col-lg-5">
                <div class="glass-panel chart-panel h-100">
                    <div class="panel-header">
                        <h5 class="panel-title"><i class="bi bi-pie-chart-fill me-2"></i>Students per Program</h5>
                        <a href="@Url.Action("StudentRecords", "Admin")" class="badge badge-gold clickable-badge" aria-label="View all students">
                            Total: <span id="totalStudents">0</span>
                        </a>
                    </div>
                    <div class="chart-container">
                        <canvas id="studentsPerProgramChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Program Counters Grid -->
            <div class="col-lg-7">
                <div class="glass-panel h-100">
                    <div class="panel-header">
                        <h5 class="panel-title"><i class="bi bi-grid-3x3-gap-fill me-2"></i>Enrollment by Year Level</h5>
                    </div>
                    <div class="counters-grid">
                        <!-- BSIT Counters -->
                        <div class="program-section">
                            <h6 class="program-label">
                                <span class="program-indicator bsit"></span>
                                BSIT <span class="program-years">(4-Year Program)</span>
                            </h6>
                            <div class="counters-row">
                                <a href="@Url.Action("StudentRecords", "Admin")?program=BSIT&year=1" class="counter-card bsit clickable-counter" aria-label="View BSIT 1st Year students">
                                    <div class="counter-strip gold-strip"></div>
                                    <span class="counter-value" id="bsit1Count">0</span>
                                    <span class="counter-label">1st Year</span>
                                    <span class="counter-hint"><i class="bi bi-eye"></i></span>
                                </a>
                                <a href="@Url.Action("StudentRecords", "Admin")?program=BSIT&year=2" class="counter-card bsit clickable-counter" aria-label="View BSIT 2nd Year students">
                                    <div class="counter-strip gold-strip"></div>
                                    <span class="counter-value" id="bsit2Count">0</span>
                                    <span class="counter-label">2nd Year</span>
                                    <span class="counter-hint"><i class="bi bi-eye"></i></span>
                                </a>
                                <a href="@Url.Action("StudentRecords", "Admin")?program=BSIT&year=3" class="counter-card bsit clickable-counter" aria-label="View BSIT 3rd Year students">
                                    <div class="counter-strip gold-strip"></div>
                                    <span class="counter-value" id="bsit3Count">0</span>
                                    <span class="counter-label">3rd Year</span>
                                    <span class="counter-hint"><i class="bi bi-eye"></i></span>
                                </a>
                                <a href="@Url.Action("StudentRecords", "Admin")?program=BSIT&year=4" class="counter-card bsit clickable-counter" aria-label="View BSIT 4th Year students">
                                    <div class="counter-strip gold-strip"></div>
                                    <span class="counter-value" id="bsit4Count">0</span>
                                    <span class="counter-label">4th Year</span>
                                    <span class="counter-hint"><i class="bi bi-eye"></i></span>
                                </a>
                            </div>
                        </div>
                        <!-- DIT Counters -->
                        <div class="program-section">
                            <h6 class="program-label">
                                <span class="program-indicator dit"></span>
                                DIT <span class="program-years">(3-Year Program)</span>
                            </h6>
                            <div class="counters-row dit-row">
                                <a href="@Url.Action("StudentRecords", "Admin")?program=DIT&year=1" class="counter-card dit clickable-counter" aria-label="View DIT 1st Year students">
                                    <div class="counter-strip blue-strip"></div>
                                    <span class="counter-value" id="dit1Count">0</span>
                                    <span class="counter-label">1st Year</span>
                                    <span class="counter-hint"><i class="bi bi-eye"></i></span>
                                </a>
                                <a href="@Url.Action("StudentRecords", "Admin")?program=DIT&year=2" class="counter-card dit clickable-counter" aria-label="View DIT 2nd Year students">
                                    <div class="counter-strip blue-strip"></div>
                                    <span class="counter-value" id="dit2Count">0</span>
                                    <span class="counter-label">2nd Year</span>
                                    <span class="counter-hint"><i class="bi bi-eye"></i></span>
                                </a>
                                <a href="@Url.Action("StudentRecords", "Admin")?program=DIT&year=3" class="counter-card dit clickable-counter" aria-label="View DIT 3rd Year students">
                                    <div class="counter-strip blue-strip"></div>
                                    <span class="counter-value" id="dit3Count">0</span>
                                    <span class="counter-label">3rd Year</span>
                                    <span class="counter-hint"><i class="bi bi-eye"></i></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- FINANCIAL OVERVIEW (Consolidated)                            -->
    <!-- ============================================================ -->
    <div class="dashboard-section">
        <!-- Main Section Header -->
        <div class="section-header border-bottom-0 pb-0 mb-4">
            <div class="section-icon financial-icon">
                <i class="bi bi-bank2"></i>
            </div>
            <h5 class="section-title">Financial Overview</h5>
        </div>

        <div class="row g-4">
            <!-- ========================== -->
            <!-- LEFT COLUMN: FEES          -->
            <!-- ========================== -->
            <div class="col-xl-6 financial-column-divider">
                <!-- Fees Sub-Header & Filter -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <!-- Requirement: Gold Label -->
                    <h6 class="text-gold fw-bold m-0"><i class="bi bi-wallet2 me-2"></i>FEES COLLECTION</h6>

                    <!-- Requirement: Separated Interactive Label -->
                    <div class="d-flex align-items-center">
                        <label for="feeCategoryFilter" class="category-label me-2">Category</label>
                        <div class="filter-container">
                            <select class="glass-select" id="feeCategoryFilter" onchange="refreshFinancialData('fees')" aria-label="Filter fees by category">
                                <option value="all">All Fees</option>
                                @if (ViewBag.FeeCategories != null)
                                {
                                    foreach (var category in ViewBag.FeeCategories)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Fees Summary Cards -->
                <div class="financial-summary-cards">
                    <div class="summary-card total">
                        <div class="card-icon"><i class="bi bi-cash-stack"></i></div>
                        <div class="card-content">
                            <div class="card-value">₱<span id="feesExpected">0.00</span></div>
                            <div class="card-label">Total</div>
                        </div>
                    </div>
                    <div class="summary-card collected">
                        <div class="card-icon"><i class="bi bi-check-circle-fill"></i></div>
                        <div class="card-content">
                            <div class="card-value">₱<span id="feesCollected">0.00</span></div>
                            <div class="card-label">Paid</div>
                            <div class="card-badge success"><span id="feesCollectionRate">0</span>%</div>
                        </div>
                    </div>

                    <!-- Requirement: Fees Unpaid set to Red (Danger) instead of Yellow (Warning) -->
                    <div class="summary-card pending">
                        <div class="card-icon" style="background: rgba(239, 68, 68, 0.15); color: var(--chart-red);"><i class="bi bi-x-circle-fill"></i></div>
                        <div class="card-content">
                            <div class="card-value">₱<span id="feesPending">0.00</span></div>
                            <div class="card-label">Unpaid</div>
                            <div class="card-badge danger"><span id="feesPendingRate">0</span>%</div>
                        </div>
                    </div>
                </div>

                <!-- Fees Charts -->
                <div class="row g-2">
                    <div class="col-6">
                        <div class="glass-panel chart-panel h-100 clickable-chart p-2" data-chart-type="payments" data-status="paid" role="button" tabindex="0" aria-label="View paid fees distribution details">
                            <div class="text-center mb-1"><small class="text-success fw-bold">Paid Distribution</small></div>
                            <div class="chart-container-medium">
                                <canvas id="feesPaidChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="glass-panel chart-panel h-100 clickable-chart p-2" data-chart-type="payments" data-status="pending" role="button" tabindex="0" aria-label="View unpaid fees distribution details">
                            <!-- Requirement: Text changed to Red -->
                            <div class="text-center mb-1"><small class="text-danger fw-bold">Unpaid Distribution</small></div>
                            <div class="chart-container-medium">
                                <canvas id="feesUnpaidChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shared Legend -->
                <div class="chart-legend-horizontal compact border-0 pt-3 mt-0 justify-content-center">
                    <div class="legend-item"><span class="legend-color bsit1"></span><span>BSIT1</span></div>
                    <div class="legend-item"><span class="legend-color bsit2"></span><span>BSIT2</span></div>
                    <div class="legend-item"><span class="legend-color bsit3"></span><span>BSIT3</span></div>
                    <div class="legend-item"><span class="legend-color bsit4"></span><span>BSIT4</span></div>
                    <div class="legend-item"><span class="legend-color dit1"></span><span>DIT1</span></div>
                    <div class="legend-item"><span class="legend-color dit2"></span><span>DIT2</span></div>
                    <div class="legend-item"><span class="legend-color dit3"></span><span>DIT3</span></div>
                </div>
            </div>

            <!-- ========================== -->
            <!-- RIGHT COLUMN: FINES        -->
            <!-- ========================== -->
            <div class="col-xl-6">
                <!-- Fines Sub-Header & Filter -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <!-- Requirement: Gold Label (Changed from text-danger) -->
                    <h6 class="text-gold fw-bold m-0"><i class="bi bi-exclamation-triangle me-2"></i>FINES & PENALTIES</h6>

                    <!-- Requirement: Separated Interactive Label -->
                    <div class="d-flex align-items-center">
                        <label for="fineCategoryFilter" class="category-label me-2">Category</label>
                        <div class="filter-container">
                            <select class="glass-select" id="fineCategoryFilter" onchange="refreshFinancialData('fines')" aria-label="Filter fines by category">
                                <option value="all">All Fines</option>
                                <option value="manual">Manual Only</option>
                                <option value="event">Event Only</option>
                                <optgroup label="Specific Events/Reasons">
                                    @if (ViewBag.FineCategories != null)
                                    {
                                        foreach (var category in ViewBag.FineCategories)
                                        {
                                            <option value="@category">@category</option>
                                        }
                                    }
                                </optgroup>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Fines Summary Cards -->
                <div class="financial-summary-cards">
                    <div class="summary-card total">
                        <div class="card-icon"><i class="bi bi-cash-stack"></i></div>
                        <div class="card-content">
                            <div class="card-value">₱<span id="finesExpected">0.00</span></div>
                            <div class="card-label">Total</div>
                        </div>
                    </div>
                    <div class="summary-card collected">
                        <div class="card-icon"><i class="bi bi-check-circle-fill"></i></div>
                        <div class="card-content">
                            <div class="card-value">₱<span id="finesCollected">0.00</span></div>
                            <div class="card-label">Paid</div>
                            <div class="card-badge success"><span id="finesCollectionRate">0</span>%</div>
                        </div>
                    </div>
                    <div class="summary-card pending">
                        <div class="card-icon" style="background: rgba(239, 68, 68, 0.15); color: var(--chart-red);"><i class="bi bi-exclamation-circle-fill"></i></div>
                        <div class="card-content">
                            <div class="card-value">₱<span id="finesPending">0.00</span></div>
                            <div class="card-label">Unpaid</div>
                            <div class="card-badge danger"><span id="finesPendingRate">0</span>%</div>
                        </div>
                    </div>
                </div>

                <!-- Fines Charts -->
                <div class="row g-2">
                    <div class="col-6">
                        <div class="glass-panel chart-panel h-100 clickable-chart p-2" data-chart-type="fines" data-status="paid" role="button" tabindex="0" aria-label="View paid fines distribution details">
                            <div class="text-center mb-1"><small class="text-success fw-bold">Paid Distribution</small></div>
                            <div class="chart-container-medium">
                                <canvas id="finesPaidChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="glass-panel chart-panel h-100 clickable-chart p-2" data-chart-type="fines" data-status="pending" role="button" tabindex="0" aria-label="View unpaid fines distribution details">
                            <div class="text-center mb-1"><small class="text-danger fw-bold">Unpaid Distribution</small></div>
                            <div class="chart-container-medium">
                                <canvas id="finesUnpaidChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shared Legend -->
                <div class="chart-legend-horizontal compact border-0 pt-3 mt-0 justify-content-center">
                    <div class="legend-item"><span class="legend-color bsit1"></span><span>BSIT1</span></div>
                    <div class="legend-item"><span class="legend-color bsit2"></span><span>BSIT2</span></div>
                    <div class="legend-item"><span class="legend-color bsit3"></span><span>BSIT3</span></div>
                    <div class="legend-item"><span class="legend-color bsit4"></span><span>BSIT4</span></div>
                    <div class="legend-item"><span class="legend-color dit1"></span><span>DIT1</span></div>
                    <div class="legend-item"><span class="legend-color dit2"></span><span>DIT2</span></div>
                    <div class="legend-item"><span class="legend-color dit3"></span><span>DIT3</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- MODAL: Financial Chart Details                               -->
    <!-- ============================================================ -->
    <div class="modal fade" id="financialDetailsModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content glass-modal">
                <div class="modal-header">
                    <h5 class="modal-title text-gold">
                        <i class="bi bi-currency-exchange me-2"></i>
                        <span id="financialModalTitle">Financial Details</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading State -->
                    <div id="financialModalLoading" class="text-center py-5">
                        <div class="spinner-border text-gold" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3 text-muted">Loading details...</p>
                    </div>

                    <!-- Content -->
                    <div id="financialModalContent" class="modal-content-hidden">
                        <!-- Summary Cards -->
                        <div class="details-summary">
                            <div class="summary-item">
                                <div class="summary-value" id="financialTotalAmount">₱0.00</div>
                                <div class="summary-label">Total Amount</div>
                            </div>
                            <div class="summary-item">
                                <div class="summary-value" id="financialStudentCount">0</div>
                                <div class="summary-label">Students</div>
                            </div>

                        </div>

                        <!-- Fee/Event Breakdown Table -->
                        <div class="details-section">
                            <h6 class="details-section-title" id="financialBreakdownTitle">
                                <i class="bi bi-list-ul me-2"></i>Fee Breakdown
                            </h6>
                            <div class="table-responsive">
                                <table class="table table-dark table-hover">
                                    <thead>
                                        <tr>
                                            <th id="financialBreakdownColName">Fee Name</th>
                                            <th>Amount</th>
                                            <th>Students</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody id="financialBreakdownBody">
                                        <!-- Dynamic content -->
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Student List (Collapsible) -->
                        <div class="details-section">
                            <h6 class="details-section-title collapsed" data-bs-toggle="collapse" data-bs-target="#financialStudentListCollapse" style="cursor: pointer;" role="button" tabindex="0" aria-expanded="false" aria-controls="financialStudentListCollapse">
                                <i class="bi bi-people me-2"></i>Student List
                                <i class="bi bi-chevron-down ms-auto collapse-icon"></i>
                            </h6>
                            <div class="collapse" id="financialStudentListCollapse">
                                <div class="table-responsive financial-student-list-scroll">
                                    <table class="table table-dark table-sm table-hover">
                                        <thead>
                                            <tr>
                                                <th>Student ID</th>
                                                <th>Name</th>
                                                <th id="financialStudentColDetail">Fee</th>
                                                <th>Amount</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody id="financialStudentListBody">
                                            <!-- Dynamic content -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="modal-quick-actions me-auto">
                        <button type="button" class="btn btn-sm btn-outline-light" onclick="exportFinancialModalData()" title="Export to Excel">
                            <i class="bi bi-download"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light" onclick="sendNoticeToFinancialStudents()" title="Send Notice">
                            <i class="bi bi-bell"></i>
                        </button>
                    </div>
                    <a href="@Url.Action("Payments", "Admin")" class="btn btn-gold-outline" id="financialGoToPaymentsBtn">
                        <i class="bi bi-arrow-right-circle me-1"></i> Go to Payments
                    </a>
                    <button type="button" class="btn btn-gold-outline" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

</div> <!-- End dashboard-container -->

<!-- ============================================================ -->
<!-- MODALS (Outside Container)                                   -->
<!-- ============================================================ -->

<!-- ============================================================ -->
<!-- MODAL: Send Notice                                           -->
<!-- ============================================================ -->
<div class="modal fade" id="sendNoticeModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title text-gold">
                    <i class="bi bi-bell-fill me-2"></i> Manage Notifications
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Notification Tabs -->
                <div class="notification-tabs">
                    <button class="notification-tab active" onclick="switchNotificationTab('sendNotice')">
                        <i class="bi bi-send me-1"></i> Send Notice
                    </button>
                    <button class="notification-tab" onclick="switchNotificationTab('activeNotifications')">
                        <i class="bi bi-list-ul me-1"></i> Active Notifications
                    </button>
                </div>

                <!-- Tab Content: Send Notice -->
                <div class="tab-content-pane active" id="sendNoticeTab">
                    <form id="sendNoticeForm">
                        @Html.AntiForgeryToken()
                        
                        <!-- Recipients Section -->
                        <div class="notice-section">
                            <label class="form-label fw-bold"><i class="bi bi-people me-2"></i>Recipients</label>
                            <div class="recipient-options">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="recipientFilter" id="recipientAll" value="all" checked>
                                    <label class="form-check-label" for="recipientAll">All Students</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="recipientFilter" id="recipientProgram" value="program">
                                    <label class="form-check-label" for="recipientProgram">By Program</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="recipientFilter" id="recipientYear" value="year">
                                    <label class="form-check-label" for="recipientYear">By Program & Year Level</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="recipientFilter" id="recipientPending" value="pending">
                                    <label class="form-check-label" for="recipientPending">Students with Pending Fees</label>
                                </div>
                            </div>

                            <!-- Filter Options -->
                            <div class="filter-row mt-3" id="programFilterRow" style="display: none;">
                                <select class="glass-select-modal" id="noticeProgram" name="programFilter">
                                    <option value="BSIT">BSIT</option>
                                    <option value="DIT">DIT</option>
                                </select>
                            </div>
                            <div class="filter-row mt-2" id="yearFilterRow" style="display: none;">
                                <select class="glass-select-modal" id="noticeYear" name="yearFilter">
                                    <option value="1">1st Year</option>
                                    <option value="2">2nd Year</option>
                                    <option value="3">3rd Year</option>
                                    <option value="4">4th Year (BSIT only)</option>
                                </select>
                            </div>

                            <!-- Preview Recipients -->
                            <div class="recipient-preview mt-3" id="recipientPreview">
                                <i class="bi bi-people-fill me-2"></i>
                                <span id="recipientCount">0</span> students will receive this notice
                                <small class="d-block text-muted mt-1" id="recipientSample"></small>
                            </div>
                        </div>

                        <!-- Message Section -->
                        <div class="notice-section mt-4">
                            <label class="form-label fw-bold"><i class="bi bi-envelope me-2"></i>Message</label>
                            <input type="text" class="form-control mb-3" id="noticeSubject" name="subject" placeholder="Subject" required>
                            <textarea class="form-control" id="noticeMessage" name="message" rows="5" placeholder="Enter your message here..." required></textarea>
                        </div>
                    </form>
                </div>

                <!-- Tab Content: Active Notifications -->
                <div class="tab-content-pane" id="activeNotificationsTab">
                    <div id="activeNotificationsList" class="active-notifications-list">
                        <div class="text-center py-4">
                            <div class="spinner-border text-gold" role="status"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-gold-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-gold" id="sendNoticeBtn" onclick="document.getElementById('sendNoticeForm').requestSubmit()">
                    <i class="bi bi-send me-1"></i> Send Notice
                </button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            // Pass data from controller to JavaScript with null guards
            window.dashboardData = {
                // Student Enrollment (Preserved)
                studentsPerProgram: @Html.Raw(Json.Serialize(ViewBag.StudentsPerProgram ?? new {})),
                totalStudents: @(ViewBag.TotalStudents ?? 0),
                yearLevelCounts: @Html.Raw(Json.Serialize(ViewBag.YearLevelCounts ?? new {})),

                // NEW: Financial Data Structure
                feesData: @Html.Raw(Json.Serialize(ViewBag.FeesData ?? new {})),
                finesData: @Html.Raw(Json.Serialize(ViewBag.FinesData ?? new {})),

                // Placeholders to prevent JS errors if referenced
                monthlyActiveStudents: [],
                archiveCount: 0,
                activeInactive: {},
                monthlyEvents: [],
                eventStatus: {}
            };

            // Dashboard URLs
            window.dashboardRefreshUrl = '@Url.Action("GetDashboardData", "Admin")';
            window.chartDetailsUrl = '@Url.Action("GetChartDetails", "Admin")';
            window.finesDetailsUrl = '@Url.Action("GetFinesDetails", "Admin")';
            window.studentsByYearLevelUrl = '@Url.Action("GetStudentsByYearLevel", "Admin")';

            // Ensure student records URL is correct for the double-click modal
            window.studentRecordsUrl = '@Url.Action("StudentRecords", "Admin")';
            window.notificationPreviewUrl = '@Url.Action("GetNotificationPreview", "Admin")';
            window.sendNotificationUrl = '@Url.Action("SendNotification", "Admin")';
            window.getActiveNotificationsUrl = '@Url.Action("GetActiveNotifications", "Admin")';
            window.updateNotificationUrl = '@Url.Action("UpdateNotification", "Admin")';
            window.deleteNotificationUrl = '@Url.Action("DeleteNotification", "Admin")';


        </script>
        <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
}




