@model IEnumerable<iBITS_Portal.Models.Announcement>
@{
    ViewData["Title"] = "Announcements";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Link External CSS -->
<link rel="stylesheet" href="~/css/announcements.css" asp-append-version="true" />

<!-- HEADER & CREATE FORM -->
<div class="glass-panel mb-4">
    <h4 class="glass-header-title mb-3"><i class="bi bi-megaphone-fill me-2"></i> Post a New Announcement</h4>
    <form asp-action="CreateAnnouncement" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label for="Title" class="form-label">Title*</label>
            <input type="text" id="Title" name="Title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label for="Content" class="form-label">Content*</label>
            <textarea id="Content" name="Content" class="form-control" rows="4" required></textarea>
        </div>
        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-gold">Post Announcement</button>
        </div>
    </form>
</div>

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- EXISTING ANNOUNCEMENTS -->
<div class="glass-panel">
    <h4 class="glass-header-title mb-3"><i class="bi bi-clock-history me-2"></i> Announcement History</h4>
    <div class="announcement-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="announcement-item">
                    <div class="announcement-header">
                        <div class="announcement-title">@item.Title</div>
                        <div class="announcement-meta">
                            Posted by <strong>@item.PostedBy</strong> on @item.Timestamp.ToString("MMM dd, yyyy, hh:mm tt")
                        </div>
                    </div>
                    <div class="announcement-body">
                        @item.Content
                    </div>
                    <div class="announcement-footer">
                        <form asp-action="DeleteAnnouncement" method="post" onsubmit="return confirm('Are you sure you want to delete this announcement?');" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                No announcements have been posted yet.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/announcements.js" asp-append-version="true"></script>
}