@* ============================================================ *@
@* FILE PATH: Views/Admin/_EditStudentModal.cshtml              *@
@* ============================================================ *@
@* UPDATED: Changed Student Type from text input to dropdown    *@
@* with options: Regular, Irregular, Transferee, Ladderized     *@
@* UPDATED: Added School Year Enrolled dropdown field           *@
@* ============================================================ *@

@model iBITS_Portal.Models.Student

<div class="modal fade" id="editStudentModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title" style="color: var(--gold-primary);"><i class="bi bi-pencil-square me-2"></i> Edit Student Record</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateStudent" method="post" id="editStudentForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Student ID (Read-only) -->
                        <div class="col-md-4">
                            <label class="form-label small text-uppercase fw-bold">Student ID</label>
                            <input type="text" asp-for="StudentNum" id="editStudentNum" class="form-control" />
                            <input type="hidden" id="originalStudentNum" name="OriginalStudentNum" />
                        </div>

                        <div class="col-md-8">
                            <label class="form-label small text-uppercase fw-bold">Email <span class="text-muted">(Optional)</span></label>
                            <input type="email" asp-for="StudentEmail" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-uppercase fw-bold">First Name *</label>
                            <input type="text" asp-for="StudentFn" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-uppercase fw-bold">Middle Name</label>
                            <input type="text" asp-for="StudentMn" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-uppercase fw-bold">Last Name *</label>
                            <input type="text" asp-for="StudentLn" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-uppercase fw-bold">Program</label>
                            <input type="text" asp-for="Course" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-uppercase fw-bold">Year & Section</label>
                            <input type="text" asp-for="YearLevelSection" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-uppercase fw-bold">Student Type</label>
                            <select asp-for="StudentType" id="editStudentType" class="form-select select2-modal" style="width: 100%;">
                                <option value="">-- Select Type --</option>
                                <option value="Regular">Regular</option>
                                <option value="Irregular">Irregular</option>
                                <option value="Transferee">Transferee</option>
                                <option value="Ladderized">Ladderized</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-uppercase fw-bold">Birthday</label>
                            <input type="date" asp-for="Birthday" class="form-control" />
                        </div>

                        <!-- NEW: School Year Enrolled Field -->
                        <div class="col-md-4">
                            <label class="form-label small text-uppercase fw-bold">School Year Enrolled <span class="text-muted">(Optional)</span></label>
                            <select asp-for="SchoolYearEnrolled" id="editSchoolYearEnrolled" class="form-select select2-modal" style="width: 100%;">
                                <option value="">-- Select Year --</option>
                                @{
                                    int currentYear = PhTime.Now.Year;
                                    for (int year = currentYear - 5; year <= currentYear + 2; year++)
                                    {
                                        string ayValue = $"A.Y. {year}-{year + 1}";
                                        <option value="@ayValue">@ayValue</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold"><i class="bi bi-save me-2"></i> Save Changes</button>
                </div>

            </form>
<!-- Admin Password Confirmation Modal for StudentNum Change -->
<div class="modal fade" id="confirmStudentNumModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title text-gold"><i class="fas fa-lock me-2"></i>Admin Verification Required</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">You are about to change the <strong class="text-gold">Student Number</strong>. This will also update the student&apos;s login credentials. Please enter your admin password to confirm.</p>
                <div class="mb-3">
                    <label class="modal-label text-gold">Admin Password</label>
                    <input type="password" id="adminConfirmPassword" class="form-control" placeholder="Enter your password" autocomplete="off" />
                    <div id="adminPasswordError" class="text-danger small mt-1 d-none">Incorrect password. Please try again.</div>
                </div>
                <p class="text-warning small"><i class="fas fa-exclamation-triangle me-1"></i>This action cannot be undone without another edit.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmStudentNumChange" class="btn btn-gold">
                    <i class="fas fa-check me-1"></i>Confirm &amp; Save
                </button>
            </div>
        </div>
    </div>
</div>
        </div>
    </div>
</div>
