@model IEnumerable<iBITS_Portal.Models.Student>
@{
    ViewData["Title"] = "Student Management - Semester Filter";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h2 class="mb-4">
        <i class="fas fa-users"></i> Student Management
        <small class="text-muted">Current Semester: @ViewBag.CurrentSemester?.ToString()</small>
    </h2>

    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-filter"></i> Filters</h5>
                </div>
                <div class="card-body">
                        <form method="get" class="row g-3">
                                <div class="col-md-3">
                                        <label class="form-label">Semester</label>
                                        <select name="semesterFilter" class="form-select">
                                                <option value="">All Semesters</option>
                                                @if (ViewBag.Semesters != null)
                                                {
                                                    @foreach (var semester in ViewBag.Semesters)
                                                    {
                                                                <option value="@semester.SemesterId" selected="@(ViewBag.CurrentSemesterId?.ToString() == semester.SemesterId.ToString())">
                                                                        @semester.SemesterName
                                                                </option>
                                                    }
                                                }
                                        </select>
                                </div>

                                <div class="col-md-3">
                                        <label class="form-label">Program/Course</label>
                                        <select name="programFilter" class="form-select">
                                                <option value="">All Courses</option>
                                                @if (ViewBag.Courses != null)
                                                {
                                                    @foreach (var course in ViewBag.Courses)
                                                    {
                                                                <option value="@course" selected="@(ViewBag.ProgramFilter == course)">@course</option>
                                                    }
                                                }
                                        </select>
                                </div>

                                <div class="col-md-2">
                                        <label class="form-label">Year Level</label>
                                        <select name="yearFilter" class="form-select">
                                                <option value="">All Years</option>
                                                @if (ViewBag.YearLevels != null)
                                                {
                                                    @foreach (var year in ViewBag.YearLevels)
                                                    {
                                                                <option value="@year" selected="@(ViewBag.YearFilter == year)">Year @year</option>
                                                    }
                                                }
                                        </select>
                                </div>

                                <div class="col-md-2">
                                        <label class="form-label">Section</label>
                                        <select name="sectionFilter" class="form-select">
                                                <option value="">All Sections</option>
                                                @if (ViewBag.Sections != null)
                                                {
                                                    @foreach (var section in ViewBag.Sections)
                                                    {
                                                                <option value="@(section)" selected="@(ViewBag.SectionFilter == section)">Section @(section)</option>
                                                    }
                                                }
                                        </select>
                                </div>

                                <div class="col-md-2">
                                        <label class="form-label">&nbsp;</label>
                                        <div class="d-grid gap-2">
                                                <button type="submit" class="btn btn-primary">
                                                        <i class="fas fa-search"></i> Filter
                                                </button>
                                                <a href="/Admin/Students" class="btn btn-secondary">
                                                        <i class="fas fa-times"></i> Clear
                                                </a>
                                        </div>
                                </div>
                        </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-users"></i> Students 
                        @if (ViewBag.TotalStudents != null)
                        {
                            <span class="badge bg-light text-dark ml-2">@ViewBag.TotalStudents Total</span>
                        }
                    </h5>
                </div>
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i> No students found matching the current filters.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                        <thead>
                                                <tr>
                                                        <th>Student Number</th>
                                                        <th>Full Name</th>
                                                        <th>Course</th>
                                                        <th>Year & Section</th>
                                                        <th>Email</th>
                                                        <th>Student Type</th>
                                                        <th>Status</th>
                                                        <th>Actions</th>
                                                </tr>
                                        </thead>
                                        <tbody>
                                                @foreach (var student in Model)
                                                {
                                                    <tr>
                                                                <td>@student.StudentNum</td>
                                                                <td>@student.FullName</td>
                                                                <td>@student.Course</td>
                                                                <td>@student.YearLevelSection</td>
                                                                <td>@student.StudentEmail</td>
                                                                <td>@student.StudentType</td>
                                                                <td>
                                                                        @if (student.IsArchived == true)
                                                                        {
                                                                            <span class="badge bg-danger">Archived</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-success">Active</span>
                                                                        }
                                                                </td>
                                                                <td>
                                                                        <a href="/Admin/EditStudent/@student.StudentNum" class="btn btn-sm btn-primary">
                                                                                <i class="fas fa-edit"></i>
                                                                        </a>
                                                                        <a href="/Admin/StudentDetails/@student.StudentNum" class="btn btn-sm btn-info">
                                                                                <i class="fas fa-eye"></i>
                                                                        </a>
                                                                </td>
                                                    </tr>
                                                }
                                        </tbody>
                            </table>
                        </div>

                        @if (ViewBag.TotalPages > 1)
                        {
                            <nav aria-label="Page navigation">
                                        <ul class="pagination justify-content-center">
                                                        @{
                                                            int totalPages = (int)Math.Ceiling((double)ViewBag.TotalStudents / ViewBag.PageSize);
                                                            int currentPage = ViewBag.CurrentPage;
                                                            
                                                            @if (currentPage > 1)
                                                            {
                                                                                    <li class="page-item">
                                                                                                    <a class="page-link" href="/Admin/Students?page=@(currentPage - 1)">
                                                                                                            <i class="fas fa-chevron-left"></i> Previous
                                                                                                    </a>
                                                                                            </li>
                                                            }

                                                            for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                                            {
                                                                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                                                                                    @if (i == currentPage)
                                                                                                    {
                                                                                                            <span class="page-link">@i</span>
                                                                                                    }
                                                                                                    else
                                                                                                    {
                                                                                                            <a class="page-link" href="/Admin/Students?page=@i">@i</a>
                                                                                                    }
                                                                                            </li>
                                                            }

                                                            @if (currentPage < totalPages)
                                                            {
                                                                                    <li class="page-item">
                                                                                                    <a class="page-link" href="/Admin/Students?page=@(currentPage + 1)">
                                                                                                            Next <i class="fas fa-chevron-right"></i>
                                                                                                    </a>
                                                                                            </li>
                                                            }
                                                        }
                                        </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5><i class="fas fa-chart-pie"></i> Enrollment Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                                <div class="col-md-4">
                                                <h4 class="text-primary">@ViewBag.TotalStudents</h4>
                                                <small>Total Students</small>
                                </div>
                                <div class="col-md-4">
                                                <h4 class="text-success">@ViewBag.ActiveStudents</h4>
                                                <small>Active Students</small>
                                </div>
                                <div class="col-md-4">
                                                <h4 class="text-info">@ViewBag.ArchivedStudents</h4>
                                                <small>Archived Students</small>
                                </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h5><i class="fas fa-calendar"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                                <a href="/Admin/Semesters" class="btn btn-info">
                                        <i class="fas fa-calendar-alt"></i> Manage Semesters
                                </a>
                                <a href="/Admin/TimeAttendance" class="btn btn-success">
                                        <i class="fas fa-clock"></i> Time Attendance
                                </a>
                                <a href="/Admin/AttendanceReport" class="btn btn-primary">
                                        <i class="fas fa-chart-bar"></i> Attendance Report
                                </a>
                                <a href="/Admin/ExportStudents" class="btn btn-secondary">
                                        <i class="fas fa-download"></i> Export Students
                                </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>