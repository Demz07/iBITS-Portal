@model IEnumerable<iBITS_Portal.Models.Fine>
@{
    ViewData["Title"] = "Fines Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Calculate financial summaries
    var allFines = Model?.ToList() ?? new List<iBITS_Portal.Models.Fine>();
    var totalExp = allFines.Where(f => f.FinesStatus != "Waived").Sum(f => f.Amount ?? 0);
    var totalCol = allFines.Where(f => f.FinesStatus?.ToLower() == "paid").Sum(f => f.Amount ?? 0);
    var totalPending = totalExp - totalCol;
    var paidCount = allFines.Count(f => f.FinesStatus?.ToLower() == "paid");
    var unpaidCount = allFines.Count(f => f.FinesStatus?.ToLower() == "unpaid");
    var waivedCount = allFines.Count(f => f.FinesStatus?.ToLower() == "waived");
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;"><i class="bi bi-exclamation-triangle me-2"></i> Fines Management</h3>
        <p class="text-muted small mb-0">Manage student fines, absences, and penalties.</p>
    </div>
    <div>
        <a asp-action="ManualFineBatches" class="btn btn-outline-light btn-sm">
            <i class="bi bi-journal-album me-1"></i> Manage Fine Batches
        </a>
    </div>
</div>

<!-- ADMIN INFO BANNER -->
<div class="alert mb-4" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); border-left: 4px solid #3b82f6; color: #93c5fd;">
    <i class="bi bi-info-circle-fill me-2"></i>
    <strong>View Only:</strong> Admin can view and create fines, but <strong>cannot change payment status</strong>. 
    Payment collection is handled by <strong>Class Treasurers</strong> and validated by <strong>Org Treasurer</strong>.
    Excused status is managed by <strong>Org Secretary</strong>.
</div>

<style>
    /* Admin view-only status indicator styles */
    .status-indicator {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
    }
    .status-indicator.paid {
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
    }
    .status-indicator.unpaid {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }
    .status-indicator.excused {
        background: rgba(59, 130, 246, 0.2);
        color: #3b82f6;
    }
</style>

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FINANCIAL OVERVIEW -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> Fines Overview
    </h5>

    <!-- Row 1: Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Expected -->
        <div class="col-md-3">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Collected -->
        <div class="col-md-3">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Outstanding -->
        <div class="col-md-3">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(249, 115, 22, 0.15); color: #F97316; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPending">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Outstanding</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collection Rate -->
        <div class="col-md-3">
            <div class="summary-card rate">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-percent fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white"><span id="collectionRate">@ViewBag.CollectionRate</span>%</div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collection Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Charts -->
    <div class="row g-4">
        <!-- Paid Fines Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart-fill me-2"></i>Paid Fines by Year Level</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="paidChart"></canvas>
                    <div class="chart-no-data" id="paidNoData">
                        <i class="bi bi-inbox-fill"></i>
                        <p>No paid fines data available</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unpaid Fines Chart -->
        <div class="col-md-6">
            <div class="chart-panel" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; height: 100%;">
                <h6 class="text-center text-muted mb-4"><i class="bi bi-pie-chart me-2"></i>Unpaid Fines by Year Level</h6>
                <div style="height: 250px; position: relative;">
                    <canvas id="unpaidChart"></canvas>
                    <div class="chart-no-data" id="unpaidNoData">
                        <i class="bi bi-check2-all"></i>
                        <p>No unpaid fines data available</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTERS SECTION (UPDATED FOR DYNAMIC FILTERS) -->
<div class="glass-panel p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-funnel me-2"></i> Filters
        </h5>
        <a asp-action="Fines" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-x-circle me-1"></i> Clear Filters
        </a>
    </div>

    <form asp-action="Fines" method="get" id="filterForm">
        <div class="row g-3">
            <!-- Search -->
            <div class="col-md-3">
                <label class="form-label small text-muted">Search Student</label>
                <input type="text" id="filterSearch" name="searchString" class="form-control form-control-sm" placeholder="Name or ID..." value="@ViewData["SearchFilter"]">
            </div>

            <!-- Fine Type -->
            <div class="col-md-2">
                <label class="form-label small text-muted">Fine Type</label>
                <select id="filterFineType" name="fineType" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="event" selected="@("event".Equals(ViewData["FineTypeFilter"]))">Event Fines</option>
                    <option value="manual" selected="@("manual".Equals(ViewData["FineTypeFilter"]))">Manual Fines</option>
                </select>
            </div>

            <!-- Dynamic Event Filter -->
            <div class="col-md-3" id="eventFilterContainer" style="display:none;">
                <label class="form-label small text-muted">Event</label>
                <select id="filterEvent" name="eventId" class="form-select form-select-sm">
                    <option value="">All Events</option>
                    @foreach (var evt in ViewBag.Events)
                    {
                        <option value="@evt.EventId" selected="@(evt.EventId == (int?)ViewData["EventFilter"])">@evt.EventName</option>
                    }
                </select>
            </div>

            <!-- Dynamic Reason Filter -->
            <div class="col-md-3" id="reasonFilterContainer" style="display:none;">
                <label class="form-label small text-muted">Fine Reason</label>
                <select id="filterReason" name="manualFineReason" class="form-select form-select-sm">
                    <option value="">All Reasons</option>
                    @foreach (var reason in ViewBag.ManualFineReasons)
                    {
                        <option value="@reason" selected="@(reason.Equals(ViewData["ReasonFilter"]))">@reason</option>
                    }
                </select>
            </div>

            <!-- Status -->
            <div class="col-md-2">
                <label class="form-label small text-muted">Status</label>
                <select id="filterStatus" name="statusFilter" class="form-select form-select-sm" asp-items="@(new SelectList(new[] { "Unpaid", "Paid", "Waived" }, (string)ViewData["StatusFilter"]))">
                    <option value="">All Statuses</option>
                </select>
            </div>

            <!-- Program -->
            <div class="col-md-2">
                <label class="form-label small text-muted">Program</label>
                <select id="filterProgram" name="programFilter" class="form-select form-select-sm" asp-items="@(new SelectList(new[] { "BSIT", "DIT" }, (string)ViewData["ProgramFilter"]))">
                    <option value="">All Programs</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-gold btn-sm mt-3"><i class="bi bi-search me-1"></i> Apply Filters</button>
    </form>
</div>

<!-- FINES TABLE -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="color: var(--text-strong); margin: 0; font-weight: 700;">Fine Records</h5>
        <div>
            <button class="btn-gold btn-sm me-2" data-bs-toggle="modal" data-bs-target="#createFineModal">
                <i class="bi bi-plus-lg me-1"></i> Create Fine
            </button>
            <button class="btn-gold-outline btn-sm" onclick="exportFines()">
                <i class="bi bi-download me-1"></i> Export to Excel
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-glass" id="finesTable">
            <thead>
                <tr>
                    <th class="text-center" style="width: 50px;"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i></th>
                    <th>REF ID</th>
                    <th>STUDENT NAME</th>
                    <th>SECTION</th>
                    <th>DESCRIPTION</th>
                    <th>AMOUNT</th>
                    <th>PAID</th>
                    <th>BALANCE</th>
                    <th>STATUS</th>
                    <th class="text-center" style="width: 60px;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fine in Model)
                {
                    var student = fine.StudentNumNavigation ?? fine.Attendance?.StudentNumNavigation;
                    var eventRecord = fine.Attendance?.Event;
                    var description = !string.IsNullOrEmpty(fine.Description) ? fine.Description : (eventRecord?.EventName ?? "Unknown");
                    var paymentStatus = fine.PaymentStatus;
                    var isPaid = paymentStatus == "Paid";
                    var isExcused = paymentStatus == "Excused";
                    var remainingBalance = fine.RemainingBalance;
                    var isEventFine = fine.AttendanceId != null;
                    var statusClass = isPaid ? "row-paid" : (isExcused ? "row-excused" : "");
                    var checkboxClass = isPaid ? "status-paid" : (isExcused ? "status-excused" : "status-unpaid");

                    <tr class="fine-row @statusClass"
                        data-fine-id="@fine.FineId"
                        data-student="@student?.FullName?.ToLower()"
                        data-studentnum="@student?.StudentNum?.ToLower()"
                        data-status="@paymentStatus.ToLower()"
                        data-section="@student?.YearLevelSection"
                        data-finetype="@(isEventFine ? "event" : "manual")"
                        data-amount="@(fine.Amount ?? 0)"
                        data-paid="@fine.AmountPaid"
                        data-balance="@remainingBalance">

                        <!-- Status Icon Column (View Only) -->
                        <td class="text-center">
                            <div class="status-indicator @(isPaid ? "paid" : (isExcused ? "excused" : "unpaid"))" title="@(isExcused ? "Excused" : (isPaid ? "Paid" : "Unpaid"))">
                                <i class="bi bi-@(isPaid ? "check" : (isExcused ? "shield-check" : "x"))"></i>
                            </div>
                        </td>

                        <td class="font-monospace text-muted">#@fine.FineId</td>
                        <td>
                            @if (student != null)
                            {
                                <div style="color: var(--text-strong); font-weight: 600;">@student.FullName</div>
                                <div class="small text-muted" style="font-size: 0.75rem;">@student.StudentNum</div>
                            }
                            else
                            {
                                <span class="text-danger">Unknown Student</span>
                            }
                        </td>
                        <td><span class="badge bg-secondary">@(student?.YearLevelSection ?? "-")</span></td>
                        <td>
                            @if (!isEventFine)
                            {
                                <span class="text-gold"><i class="bi bi-pencil-fill me-1" style="font-size: 0.7rem;"></i> @description</span>
                            }
                            else
                            {
                                <span>@description</span>
                            }
                        </td>
                        <td style="color: var(--gold-primary); font-weight: bold;">₱@fine.Amount?.ToString("N2")</td>
                        <td class="amount-paid" style="color: #10b981; font-weight: 600;">₱@fine.AmountPaid.ToString("N2")</td>
                        <td class="balance" style="color: @(remainingBalance > 0 ? "#ef4444" : "#10b981"); font-weight: 600;">₱@remainingBalance.ToString("N2")</td>
                        
                        <!-- Status Badge (No Partial - Full Payment Only) -->
                        <td>
                            @if (isPaid)
                            {
                                <span class="status-badge status-paid"><i class="bi bi-check-circle-fill"></i> Paid</span>
                            }
                            else if (isExcused)
                            {
                                <span class="status-badge status-excused"><i class="bi bi-shield-check"></i> Excused</span>
                            }
                            else
                            {
                                <span class="status-badge status-unpaid"><i class="bi bi-x-circle-fill"></i> Unpaid</span>
                            }
                        </td>
                        
                        <!-- Actions Dropdown (Admin: No Payment Status Changes) -->
                        <td class="text-center">
                            @if (!isPaid && !isExcused)
                            {
                                <div class="dropdown">
                                    <button class="action-dropdown-btn" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end glass-dropdown">
                                        <li>
                                            <a href="#" class="dropdown-item text-danger" onclick="openDeleteModal(@fine.FineId, '@student?.FullName?.Replace("'", "\\'")', @(fine.Amount ?? 0))">
                                                <i class="bi bi-trash me-2"></i> Delete Fine
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else if (isPaid)
                            {
                                <span class="text-success" title="Paid - Cannot modify"><i class="bi bi-lock-fill"></i></span>
                            }
                            else if (isExcused)
                            {
                                <span class="text-info" title="Excused - Cannot modify"><i class="bi bi-shield-lock-fill"></i></span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- REMOVED: Fine Payment/Revoke/Excuse Modals - Admin cannot change payment status -->
<!-- Payment status changes are handled by Treasurers only -->
<!-- Excused status is handled by Org Secretary only -->

<!-- ================= MODALS ================= -->
<!-- Create Fine Modal -->
<div class="modal fade" id="createFineModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-modal">
            <div class="modal-header">
                <h5 class="modal-title text-gold"><i class="bi bi-exclamation-circle me-2"></i> Create Manual Fine</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateFine" method="post" id="createFineForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <!-- Fine Details Section -->
                    <div class="fee-section">
                        <div class="fee-section-header">
                            <i class="bi bi-info-circle me-2"></i> Fine Details
                        </div>

                        <!-- Row 1: Reason + Amount -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label">Fine Reason / Event <span class="text-danger">*</span></label>
                                <input type="text" name="FineReason" class="form-control" placeholder="e.g., Uniform Violation, Late Attendance" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Amount (₱) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0.01" name="Amount" class="form-control" placeholder="0.00" required />
                            </div>
                        </div>

                        <!-- Row 2: Due Date -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Due Date</label>
                                <input type="date" name="FinesDueDate" class="form-control" />
                                <small class="text-muted">Leave blank for default (15 days)</small>
                            </div>
                        </div>
                    </div>

                    <!-- Apply To Students Section -->
                    <div class="fee-section mt-4">
                        <div class="fee-section-header">
                            <i class="bi bi-people me-2"></i> Apply To Students
                        </div>

                        <!-- Program Filter -->
                        <div class="mb-3">
                            <label class="form-label">Program <span class="text-danger">*</span></label>
                            <div class="filter-options" id="programFilter">
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programAll" value="all" checked>
                                    <label for="programAll">
                                        <i class="bi bi-grid-3x3-gap"></i>
                                        <span>All Programs</span>
                                        <small>BSIT & DIT</small>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programBSIT" value="bsit">
                                    <label for="programBSIT">
                                        <i class="bi bi-laptop"></i>
                                        <span>BSIT Only</span>
                                        <small>4-Year Program</small>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="programFilter" id="programDIT" value="dit">
                                    <label for="programDIT">
                                        <i class="bi bi-hdd-network"></i>
                                        <span>DIT Only</span>
                                        <small>3-Year Program</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Year Level Filter -->
                        <div class="mb-3">
                            <label class="form-label">Year Level <span class="text-danger">*</span></label>
                            <div class="filter-options year-filter" id="yearFilter">
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="yearAll" value="all" checked>
                                    <label for="yearAll">
                                        <span>All Years</span>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year1" value="1">
                                    <label for="year1">
                                        <span>1st Year</span>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year2" value="2">
                                    <label for="year2">
                                        <span>2nd Year</span>
                                    </label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" name="yearFilter" id="year3" value="3">
                                    <label for="year3">
                                        <span>3rd Year</span>
                                    </label>
                                </div>
                                <div class="filter-option" id="year4Option">
                                    <input type="radio" name="yearFilter" id="year4" value="4">
                                    <label for="year4">
                                        <span>4th Year</span>
                                        <small class="bsit-only-badge">BSIT only</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Preview Section -->
                        <div class="fee-preview" id="feePreview">
                            <div class="preview-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="preview-content">
                                <div class="preview-title">This fine will be applied to:</div>
                                <div class="preview-count">
                                    <span id="previewTotal">0</span> students
                                </div>
                                <div class="preview-breakdown">
                                    <span class="preview-bsit"><i class="bi bi-circle-fill"></i> BSIT: <span id="previewBSIT">0</span></span>
                                    <span class="preview-dit"><i class="bi bi-circle-fill"></i> DIT: <span id="previewDIT">0</span></span>
                                </div>
                            </div>
                            <div class="preview-loading" id="previewLoading" style="display: none;">
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold" id="submitFineBtn">
                        <i class="bi bi-check-lg me-1"></i> Create and Assign Fine
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- REMOVED: Mark as Paid, Waive Fine, and Adjust Fine Modals -->
<!-- Admin cannot change payment status - handled by Treasurers only -->
<!-- Excused status is handled by Org Secretary only -->

<!-- Delete Fine Modal -->
<div class="modal fade" id="deleteFineModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <form asp-action="DeleteFine" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="fineId" id="deleteFineId" />
                <div class="modal-header">
                    <h5 class="modal-title text-danger"><i class="bi bi-trash me-2"></i> Delete Fine</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                    <p class="mt-3 text-danger fw-bold">Warning: This action cannot be undone!</p>
                    <p>You are about to delete the fine for:</p>
                    <div class="fee-section p-3 d-inline-block text-start" style="min-width: 250px;">
                        <div><strong>Student:</strong> <span id="deleteStudentName"></span></div>
                        <div><strong>Amount:</strong> ₱<span id="deleteFineAmount"></span></div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill me-1"></i> Delete Permanently</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- REMOVED: Record Fine Payment Modal - Admin cannot change payment status -->

@section Scripts {
    <!-- Include Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        // Data passed from Controller
        window.finesChartsData = {
            paid: @Html.Raw(Json.Serialize(ViewBag.PaidBreakdown ?? new { })),
            unpaid: @Html.Raw(Json.Serialize(ViewBag.UnpaidBreakdown ?? new { }))
        };

        // REMOVED: Admin Fine Payment Modal functions - Admin cannot change payment status
        // openWaiveModal and openAdjustModal removed - Admin cannot modify payment status

        // Modal Helper - Delete only (Admin can delete unpaid fines)
        function openDeleteModal(id, name, amount) {
            document.getElementById('deleteFineId').value = id;
            document.getElementById('deleteStudentName').innerText = name;
            document.getElementById('deleteFineAmount').innerText = amount.toFixed(2);
            new bootstrap.Modal(document.getElementById('deleteFineModal')).show();
        }

        // Export Function
        function exportFines() {
            window.location.href = '/Admin/ExportFinesToExcel';
        }

        // ============================================================
        // DYNAMIC FILTER TOGGLE
        // ============================================================
        $(document).ready(function () {
            const fineTypeSelect = $('#filterFineType');
            const eventContainer = $('#eventFilterContainer');
            const reasonContainer = $('#reasonFilterContainer');

            function toggleFilters() {
                const selected = fineTypeSelect.val();
                if (selected === 'event') {
                    eventContainer.show();
                    reasonContainer.hide();
                } else if (selected === 'manual') {
                    eventContainer.hide();
                    reasonContainer.show();
                } else {
                    eventContainer.hide();
                    reasonContainer.hide();
                }
            }

            fineTypeSelect.on('change', toggleFilters);
            toggleFilters();
        });

        // ============================================================
        // REMOVED: CHECKBOX-BASED FINE PAYMENT SYSTEM
        // Admin cannot change payment status - handled by Treasurers only
        // Excused status is handled by Org Secretary only
        // ============================================================

        // Toast notification
        function showToast(type, message) {
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }

    </script>
    <script src="~/js/fines.js" asp-append-version="true"></script>
}