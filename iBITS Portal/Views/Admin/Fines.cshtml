@* Views/Admin/Fines.cshtml *@

@model IEnumerable<iBITS_Portal.Models.Fine>
@{
    ViewData["Title"] = "Fines Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Calculate financial summaries
    var allFines = Model?.ToList() ?? new List<iBITS_Portal.Models.Fine>();
    var totalExp = allFines.Sum(f => f.Amount ?? 0);
    var totalCol = allFines.Where(f => f.FinesStatus?.ToLower() == "paid").Sum(f => f.Amount ?? 0);
    var totalPending = totalExp - totalCol;
    var paidCount = allFines.Count(f => f.FinesStatus?.ToLower() == "paid");
    var unpaidCount = allFines.Count(f => f.FinesStatus?.ToLower() == "unpaid");
    var waivedCount = allFines.Count(f => f.FinesStatus?.ToLower() == "waived");

    <style>
        /* No Data state in Charts */
        .chart-no-data {
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            min-height: 250px;
            color: rgba(255, 255, 255, 0.4);
            text-align: center;
        }

            .chart-no-data i {
                font-size: 4rem;
                margin-bottom: 1rem;
                color: rgba(212, 175, 55, 0.2);
            }

            .chart-no-data p {
                font-size: 1.1rem;
                font-weight: 600;
                margin: 0;
            }

        .summary-card {
            height: 100%;
            min-height: 110px;
        }
    </style>
}

<link rel="stylesheet" href="~/css/fines.css" asp-append-version="true" />

<!-- HEADER -->
<div class="glass-panel d-flex justify-content-between align-items-center mb-4 mt-2 p-4">
    <div>
        <h3 style="color: var(--text-strong); font-weight: 700; margin:0;"><i class="bi bi-exclamation-triangle me-2"></i> Fines Management</h3>
        <p class="text-muted small mb-0">Manage student fines, absences, and penalties.</p>
    </div>
</div>

<!-- ALERT MESSAGES -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #10b981; background: rgba(16, 185, 129, 0.2); color: #34d399;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #ef4444; background: rgba(239, 68, 68, 0.2); color: #f87171;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show glass-alert" role="alert" style="border-left: 5px solid #f59e0b; background: rgba(245, 158, 11, 0.2); color: #fbbf24;">
        <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FINANCIAL OVERVIEW -->
<div class="glass-panel p-4 mb-4">
    <h5 style="color: var(--text-strong); font-weight: 700; margin-bottom: 1.5rem;">
        <i class="bi bi-graph-up me-2"></i> Fines Overview
    </h5>

    <!-- Row 1: Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Expected -->
        <div class="col-md-3">
            <div class="summary-card total">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-exclamation-triangle fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalExpected">@totalExp.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Expected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Collected -->
        <div class="col-md-3">
            <div class="summary-card collected">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(16, 185, 129, 0.15); color: #10b981; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-check-circle fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalCollected">@totalCol.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Total Collected</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Outstanding -->
        <div class="col-md-3">
            <div class="summary-card pending">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(251, 191, 36, 0.15); color: #fbbf24; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white">₱<span id="totalPending">@totalPending.ToString("N2")</span></div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Outstanding</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Collection Rate -->
        <div class="col-md-3">
            <div class="summary-card rate">
                <div class="d-flex align-items-center">
                    <div class="card-icon me-3" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                        <i class="bi bi-percent fs-3"></i>
                    </div>
                    <div>
                        <div class="card-value fs-3 fw-bold text-white"><span id="collectionRate">@ViewBag.CollectionRate</span>%</div>
                        <div class="card-label text-muted small text-uppercase fw-bold">Collection Rate</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Charts -->
    <div class="row g-4">
        <!-- Paid Fines Chart -->
        <div class="col-md-6">
            <div class="chart-container">
                <h6 class="chart-title">Paid Fines by Program</h6>
                <canvas id="paidChart"></canvas>
                <div class="chart-no-data" id="paidNoData">
                    <i class="bi bi-inbox"></i>
                    <p>No paid fines data available</p>
                </div>
            </div>
        </div>

        <!-- Unpaid Fines Chart -->
        <div class="col-md-6">
            <div class="chart-container">
                <h6 class="chart-title">Unpaid Fines by Program</h6>
                <canvas id="unpaidChart"></canvas>
                <div class="chart-no-data" id="unpaidNoData">
                    <i class="bi bi-inbox"></i>
                    <p>No unpaid fines data available</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FINES TABLE -->
<div class="glass-panel p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 style="color: var(--text-strong); font-weight: 700; margin: 0;">
            <i class="bi bi-table me-2"></i> Fines Records
        </h5>
        <button class="btn btn-gold" onclick="exportFines()">
            <i class="bi bi-download me-1"></i> Export to Excel
        </button>
    </div>

    <!-- Filters -->
    <div class="filters-container mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <input type="text" id="filterSearch" class="form-control glass-input" placeholder="Search student name or ID...">
            </div>
            <div class="col-md-2">
                <select id="filterEvent" class="form-select glass-input">
                    <option value="">All Events</option>
                    @if (ViewBag.Events != null)
                    {
                        foreach (var evt in ViewBag.Events)
                        {
                            <option value="@evt.EventId">@evt.EventName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select id="filterStatus" class="form-select glass-input">
                    <option value="">All Status</option>
                    <option value="Unpaid">Unpaid</option>
                    <option value="Paid">Paid</option>
                    <option value="Waived">Waived</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="filterProgram" class="form-select glass-input">
                    <option value="">All Programs</option>
                    <option value="BSIT">BSIT</option>
                    <option value="DIT">DIT</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="filterOverdue" class="form-select glass-input">
                    <option value="">All Fines</option>
                    <option value="overdue">Overdue Only</option>
                    <option value="upcoming">Due Soon</option>
                </select>
            </div>
            <div class="col-md-1">
                <button class="btn btn-glass w-100" onclick="clearFilters()">
                    <i class="bi bi-x-lg"></i> Clear
                </button>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table glass-table" id="finesTable">
            <thead>
                <tr>
                    <th>Fine ID</th>
                    <th>Student</th>
                    <th>Event</th>
                    <th>Event Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Due Date</th>
                    <th>Days Overdue</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fine in Model)
                {
                    var student = fine.Attendance?.StudentNumNavigation;
                    var eventRecord = fine.Attendance?.Event;
                    var isOverdue = fine.FinesStatus?.ToLower() == "unpaid" && 
                                   fine.FinesDueDate.HasValue && 
                                   fine.FinesDueDate.Value < DateOnly.FromDateTime(DateTime.Now);
                    var daysOverdue = 0;
                    if (isOverdue)
                    {
                        var today = DateOnly.FromDateTime(DateTime.Now);
                        daysOverdue = today.DayNumber - fine.FinesDueDate!.Value.DayNumber;
                    }

                    <tr data-student="@student?.FullName" 
                        data-studentnum="@student?.StudentNum"
                        data-event="@fine.Attendance?.EventId"
                        data-status="@fine.FinesStatus"
                        data-program="@student?.Course"
                        data-overdue="@(isOverdue ? "true" : "false")"
                        data-daysoverdue="@daysOverdue">
                        <td>@fine.FineId</td>
                        <td>
                            <div class="student-info">
                                <strong>@student?.FullName</strong>
                                <div class="text-muted small">@student?.StudentNum</div>
                                <span class="badge bg-secondary">@student?.YearLevelSection</span>
                            </div>
                        </td>
                        <td>@eventRecord?.EventName</td>
                        <td>@eventRecord?.EventDate?.ToString("MM/dd/yyyy")</td>
                        <td class="fw-bold">₱@fine.Amount?.ToString("N2")</td>
                        <td>
                            @if (fine.FinesStatus?.ToLower() == "paid")
                            {
                                <span class="badge badge-success">Paid</span>
                            }
                            else if (fine.FinesStatus?.ToLower() == "waived")
                            {
                                <span class="badge badge-info">Waived</span>
                            }
                            else if (isOverdue)
                            {
                                <span class="badge badge-danger">Overdue</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">Unpaid</span>
                            }
                        </td>
                        <td>@fine.FinesDueDate?.ToString("MM/dd/yyyy")</td>
                        <td>
                            @if (isOverdue)
                            {
                                <span class="text-danger fw-bold">@daysOverdue days</span>
                            }
                            else if (fine.FinesStatus?.ToLower() == "paid")
                            {
                                <span class="text-success">Paid</span>
                            }
                            else if (fine.FinesStatus?.ToLower() == "waived")
                            {
                                <span class="text-info">Waived</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                @if (fine.FinesStatus?.ToLower() == "unpaid")
                                {
                                    <button class="btn btn-sm btn-success" onclick="markAsPaid(@fine.FineId)" title="Mark as Paid">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-sm btn-info" onclick="waiveFine(@fine.FineId, '@student?.FullName', @fine.Amount)" title="Waive Fine">
                                        <i class="bi bi-hand-thumbs-up"></i>
                                    </button>
                                    <button class="btn btn-sm btn-warning" onclick="adjustFine(@fine.FineId, '@student?.FullName', @fine.Amount)" title="Adjust Amount">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                <button class="btn btn-sm btn-danger" onclick="deleteFine(@fine.FineId, '@student?.FullName', @fine.Amount)" title="Delete Fine">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODALS -->

<!-- Waive Fine Modal -->
<div class="modal fade" id="waiveFineModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content glass-modal">
            <form asp-action="WaiveFine" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="fineId" id="waiveFineId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-hand-thumbs-up me-2"></i> Waive Fine</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to waive this fine?</p>
                    <div class="alert alert-info">
                        <strong>Student:</strong> <span id="waiveStudentName"></span><br>
                        <strong>Amount:</strong> ₱<span id="waiveFineAmount"></span>
                    </div>
                    <div class="mb-3">
                        <label for="waiveReason" class="form-label">Reason for Waiving (Optional)</label>
                        <textarea class="form-control glass-input" name="reason" id="waiveReason" rows="3" placeholder="e.g., Legitimate excuse, Medical emergency, etc."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info"><i class="bi bi-check-lg me-1"></i> Waive Fine</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Adjust Fine Modal -->
<div class="modal fade" id="adjustFineModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content glass-modal">
            <form asp-action="AdjustFineAmount" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="fineId" id="adjustFineId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil me-2"></i> Adjust Fine Amount</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <strong>Student:</strong> <span id="adjustStudentName"></span><br>
                        <strong>Current Amount:</strong> ₱<span id="adjustCurrentAmount"></span>
                    </div>
                    <div class="mb-3">
                        <label for="newAmount" class="form-label">New Amount</label>
                        <input type="number" class="form-control glass-input" name="newAmount" id="newAmount" step="0.01" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label for="adjustReason" class="form-label">Reason for Adjustment (Optional)</label>
                        <textarea class="form-control glass-input" name="reason" id="adjustReason" rows="3" placeholder="e.g., Partial waiver, Correction, etc."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i> Adjust Amount</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Fine Modal -->
<div class="modal fade" id="deleteFineModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content glass-modal">
            <form asp-action="DeleteFine" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="fineId" id="deleteFineId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-trash me-2"></i> Delete Fine</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i> This action cannot be undone!
                    </div>
                    <p>Are you sure you want to permanently delete this fine?</p>
                    <div class="alert alert-info">
                        <strong>Student:</strong> <span id="deleteStudentName"></span><br>
                        <strong>Amount:</strong> ₱<span id="deleteFineAmount"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete Fine</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Mark as Paid Modal -->
<div class="modal fade" id="markPaidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content glass-modal">
            <form asp-action="MarkFineAsPaidAdmin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="fineId" id="markPaidFineId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-check-circle me-2"></i> Mark Fine as Paid</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Confirm that this fine has been paid.</p>
                    <div class="alert alert-success">
                        <strong>Fine ID:</strong> <span id="markPaidFineIdDisplay"></span><br>
                        <strong>This will mark the fine as PAID.</strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-1"></i> Mark as Paid</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        window.finesChartsData = {
            paid: @Html.Raw(Json.Serialize(ViewBag.PaidBreakdown ?? new {})),
            unpaid: @Html.Raw(Json.Serialize(ViewBag.UnpaidBreakdown ?? new {}))
        };

        // Export Function
        function exportFines() {
            window.location.href = '/Admin/ExportFinesToExcel';
        }
    </script>
    <script src="~/js/fines.js" asp-append-version="true"></script>
}
