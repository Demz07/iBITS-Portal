@section Scripts {
    <!-- Include Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        // Data passed from Controller
        window.finesChartsData = {
            paid: @Html.Raw(Json.Serialize(ViewBag.PaidBreakdown ?? new { })),
            unpaid: @Html.Raw(Json.Serialize(ViewBag.UnpaidBreakdown ?? new { }))
        };

        // Admin Fine Payment Modal
        var adminFineBalance = 0;
        function openAdminFinePaymentModal(fineId, studentName, description, total, paid, balance) {
            document.getElementById('adminFineFineId').value = fineId;
            document.getElementById('adminFineStudentName').textContent = studentName;
            document.getElementById('adminFineDescription').textContent = description;
            document.getElementById('adminFineTotal').textContent = total.toFixed(2);
            document.getElementById('adminFinePaid').textContent = paid.toFixed(2);
            document.getElementById('adminFineBalance').textContent = balance.toFixed(2);
            document.getElementById('adminFineMaxAmount').textContent = balance.toFixed(2);
            document.getElementById('adminFinePaymentAmount').max = balance;
            document.getElementById('adminFinePaymentAmount').value = balance.toFixed(2);
            document.getElementById('adminFinePaymentMethod').value = '';
            adminFineBalance = balance;
            new bootstrap.Modal(document.getElementById('adminFinePaymentModal')).show();
        }
        function setAdminFineAmount(pct) {
            document.getElementById('adminFinePaymentAmount').value = (adminFineBalance * pct).toFixed(2);
        }

        // Modal Helpers
        function openMarkPaidModal(id) {
            document.getElementById('markPaidFineId').value = id;
            document.getElementById('markPaidFineIdDisplay').innerText = id;
            new bootstrap.Modal(document.getElementById('markPaidModal')).show();
        }

        function openWaiveModal(id, name, amount) {
            document.getElementById('waiveFineId').value = id;
            document.getElementById('waiveStudentName').innerText = name;
            document.getElementById('waiveFineAmount').innerText = amount.toFixed(2);
            new bootstrap.Modal(document.getElementById('waiveFineModal')).show();
        }

        function openAdjustModal(id, name, amount) {
            document.getElementById('adjustFineId').value = id;
            document.getElementById('adjustStudentName').innerText = name;
            document.getElementById('adjustCurrentAmount').innerText = amount.toFixed(2);
            document.getElementById('newAmount').value = amount;
            new bootstrap.Modal(document.getElementById('adjustFineModal')).show();
        }

        function openDeleteModal(id, name, amount) {
            document.getElementById('deleteFineId').value = id;
            document.getElementById('deleteStudentName').innerText = name;
            document.getElementById('deleteFineAmount').innerText = amount.toFixed(2);
            new bootstrap.Modal(document.getElementById('deleteFineModal')).show();
        }

        // Export Function
        function exportFines() {
            window.location.href = '/Admin/ExportFinesToExcel';
        }

        // ============================================================
        // DYNAMIC FILTER TOGGLE
        // ============================================================
        $(document).ready(function () {
            const fineTypeSelect = $('#filterFineType');
            const eventContainer = $('#eventFilterContainer');
            const reasonContainer = $('#reasonFilterContainer');

            function toggleFilters() {
                const selected = fineTypeSelect.val();
                if (selected === 'event') {
                    eventContainer.show();
                    reasonContainer.hide();
                } else if (selected === 'manual') {
                    eventContainer.hide();
                    reasonContainer.show();
                } else {
                    eventContainer.hide();
                    reasonContainer.hide();
                }
            }

            fineTypeSelect.on('change', toggleFilters);
            toggleFilters();
        });

        // ============================================================
        // CHECKBOX-BASED FINE PAYMENT SYSTEM
        // ============================================================
        var currentFineData = {};

        // Handle checkbox click
        function handleFineCheckboxClick(checkbox) {
            const fineId = checkbox.dataset.fineId;
            const status = checkbox.dataset.status;
            const studentName = checkbox.dataset.studentName;
            const description = checkbox.dataset.description;
            const amount = parseFloat(checkbox.dataset.amount);
            const balance = parseFloat(checkbox.dataset.balance);

            currentFineData = { fineId, studentName, description, amount, balance, checkbox };

            if (status === 'paid') {
                confirmRevokeFinePayment(fineId, studentName, amount);
            } else if (status === 'excused') {
                return; // Cannot modify excused fines via checkbox
            } else {
                document.getElementById('confirmFinePayStudentName').textContent = studentName;
                document.getElementById('confirmFinePayDescription').textContent = description;
                document.getElementById('confirmFinePayAmount').textContent = balance.toFixed(2);
                new bootstrap.Modal(document.getElementById('confirmFinePaymentModal')).show();
            }
        }

        // Execute toggle fine payment
        async function executeToggleFinePayment() {
            const btn = document.getElementById('confirmFinePaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Admin/ToggleFinePayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `fineId=${currentFineData.fineId}&markAsPaid=true`
                });

                const result = await response.json();
                
                if (result.success) {
                    updateFineRowUI(currentFineData.fineId, result.newStatus, result.amountPaid, result.balance);
                    bootstrap.Modal.getInstance(document.getElementById('confirmFinePaymentModal')).hide();
                    showToast('success', result.message);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm Payment';
            }
        }

        // Confirm revoke fine payment
        function confirmRevokeFinePayment(fineId, studentName, amountPaid) {
            currentFineData.fineId = fineId;
            document.getElementById('revokeFineStudentName').textContent = studentName;
            document.getElementById('revokeFineAmountPaid').textContent = amountPaid.toFixed(2);
            new bootstrap.Modal(document.getElementById('revokeFinePaymentModal')).show();
        }

        // Execute revoke fine payment
        async function executeRevokeFinePayment() {
            const btn = document.getElementById('revokeFinePaymentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Admin/RevokeFinePayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `fineId=${currentFineData.fineId}`
                });

                const result = await response.json();
                
                if (result.success) {
                    updateFineRowUI(currentFineData.fineId, result.newStatus, result.amountPaid, result.balance);
                    bootstrap.Modal.getInstance(document.getElementById('revokeFinePaymentModal')).hide();
                    showToast('success', result.message);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i> Revoke Payment';
            }
        }

        // Open excuse modal
        function openExcuseModal(fineId, studentName, amount) {
            currentFineData.fineId = fineId;
            document.getElementById('excuseStudentName').textContent = studentName;
            document.getElementById('excuseFineAmount').textContent = amount.toFixed(2);
            document.getElementById('excuseReason').value = '';
            new bootstrap.Modal(document.getElementById('excuseFineModal')).show();
        }

        // Execute excuse fine
        async function executeExcuseFine() {
            const reason = document.getElementById('excuseReason').value.trim();
            if (!reason) {
                showToast('error', 'Please provide a reason for excusing this fine.');
                return;
            }

            const btn = document.getElementById('excuseFineBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Admin/MarkFineExcused', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `fineId=${currentFineData.fineId}&reason=${encodeURIComponent(reason)}`
                });

                const result = await response.json();
                
                if (result.success) {
                    updateFineRowUI(currentFineData.fineId, result.newStatus, 0, 0);
                    bootstrap.Modal.getInstance(document.getElementById('excuseFineModal')).hide();
                    showToast('success', result.message);
                } else {
                    showToast('error', result.message);
                }
            } catch (error) {
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-shield-check me-1"></i> Mark as Excused';
            }
        }

        // Update fine row UI after status change
        function updateFineRowUI(fineId, newStatus, amountPaid, balance) {
            const row = document.querySelector(`tr[data-fine-id="${fineId}"]`);
            if (!row) return;

            const checkbox = row.querySelector('.payment-checkbox');
            const statusBadge = row.querySelector('.status-badge');
            const amountPaidCell = row.querySelector('.amount-paid');
            const balanceCell = row.querySelector('.balance');

            // Update row class
            row.classList.remove('row-paid', 'row-partial', 'row-excused');
            if (newStatus === 'Paid') row.classList.add('row-paid');
            else if (newStatus === 'Partial') row.classList.add('row-partial');
            else if (newStatus === 'Excused') row.classList.add('row-excused');

            // Update checkbox
            checkbox.classList.remove('status-paid', 'status-partial', 'status-unpaid', 'status-excused');
            checkbox.dataset.status = newStatus.toLowerCase();
            
            if (newStatus === 'Paid') {
                checkbox.classList.add('status-paid');
                checkbox.title = 'Click to revoke payment';
                checkbox.onclick = function() { handleFineCheckboxClick(this); };
            } else if (newStatus === 'Partial') {
                checkbox.classList.add('status-partial');
                checkbox.title = 'Click to complete payment';
                checkbox.onclick = function() { handleFineCheckboxClick(this); };
            } else if (newStatus === 'Excused') {
                checkbox.classList.add('status-excused');
                checkbox.title = 'This fine is excused';
                checkbox.onclick = null;
            } else {
                checkbox.classList.add('status-unpaid');
                checkbox.title = 'Click to mark as paid';
                checkbox.onclick = function() { handleFineCheckboxClick(this); };
            }
            checkbox.dataset.balance = balance;

            // Update status badge
            if (newStatus === 'Paid') {
                statusBadge.className = 'status-badge status-paid';
                statusBadge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Paid';
            } else if (newStatus === 'Partial') {
                statusBadge.className = 'status-badge status-partial';
                statusBadge.innerHTML = '<i class="bi bi-pie-chart-fill"></i> Partial';
            } else if (newStatus === 'Excused') {
                statusBadge.className = 'status-badge status-excused';
                statusBadge.innerHTML = '<i class="bi bi-shield-check"></i> Excused';
            } else {
                statusBadge.className = 'status-badge status-unpaid';
                statusBadge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Unpaid';
            }

            // Update amounts
            if (amountPaidCell) amountPaidCell.textContent = '₱' + amountPaid.toFixed(2);
            if (balanceCell) {
                balanceCell.textContent = '₱' + balance.toFixed(2);
                balanceCell.style.color = balance > 0 ? '#ef4444' : '#10b981';
            }

            // Update data attributes
            row.dataset.status = newStatus.toLowerCase();
            row.dataset.paid = amountPaid;
            row.dataset.balance = balance;
        }

        // Toast notification
        function showToast(type, message) {
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            
            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = container.lastElementChild;
            const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
            bsToast.show();
            toast.addEventListener('hidden.bs.toast', () => toast.remove());
        }

    </script>
    <script src="~/js/fines.js" asp-append-version="true"></script>
}