@model IEnumerable<iBITS_Portal.Models.Semester>
@{
    ViewData["Title"] = "Semester Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h2 class="mb-4">
        <i class="fas fa-calendar-alt"></i> Semester Management
    </h2>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-list"></i> Academic Semesters</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No semesters configured yet.
                            <a href="/Admin/CreateSemester" class="btn btn-primary ml-2">
                                <i class="fas fa-plus"></i> Create First Semester
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                        <thead>
                                                <tr>
                                                        <th>Academic Year</th>
                                                        <th>Semester Name</th>
                                                        <th>Start Date</th>
                                                        <th>End Date</th>
                                                        <th>Status</th>
                                                        <th>Current</th>
                                                        <th>Actions</th>
                                                </tr>
                                        </thead>
                                        <tbody>
                                                @foreach (var semester in Model)
                                                {
                                                    <tr>
                                                                <td>@semester.AcademicYear?.YearName</td>
                                                                <td>@semester.SemesterName</td>
                                                                <td>@semester.StartDate.ToString("yyyy-MM-dd")</td>
                                                                <td>@semester.EndDate.ToString("yyyy-MM-dd")</td>
                                                                <td>
                                                                        @if (semester.IsActive)
                                                                        {
                                                                            <span class="badge bg-success">Active</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-secondary">Inactive</span>
                                                                        }
                                                                </td>
                                                                <td>
                                                                        @if (semester.IsCurrent)
                                                                        {
                                                                            <span class="badge bg-primary text-white">Current</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <a href="/Admin/SetCurrentSemester/@semester.SemesterId" 
                                                                               class="btn btn-sm btn-warning"
                                                                               onclick="return confirm('Set @semester.SemesterName as current semester?')">
                                                                                        <i class="fas fa-star"></i> Set Current
                                                                                    </a>
                                                                        }
                                                                </td>
                                                    </tr>
                                                }
                                        </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <a href="/Admin/CreateSemester" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Create New Semester
                            </a>
                            <a href="/Admin/ImportSemesters" class="btn btn-secondary">
                                <i class="fas fa-upload"></i> Import Academic Calendar
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5><i class="fas fa-info-circle"></i> Quick Stats</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                                <div class="col-12 mb-3">
                                                <h4 class="text-primary">@Model.Count()</h4>
                                                <small>Total Semesters</small>
                                </div>
                                <div class="col-12 mb-3">
                                                <h4 class="text-success">@Model.Count(s => s.IsActive)</h4>
                                                <small>Active Semesters</small>
                                </div>
                                <div class="col-12 mb-3">
                                                <h4 class="text-warning">@Model.Count(s => s.IsCurrent)</h4>
                                                <small>Current Semester</small>
                                </div>
                                <div class="col-12">
                                                <h6 class="text-muted">
                                                        @{
                                                                var currentSemester = Model.FirstOrDefault(s => s.IsCurrent);
                                                                if (currentSemester != null)
                                                                {
                                                                    <span>Current: @currentSemester.SemesterName</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>No current semester set</span>
                                                                }
                                                        }
                                                </h6>
                                </div>
                    </div>

                    <div class="alert alert-info mt-3">
                            <i class="fas fa-lightbulb"></i>
                            <strong>Semester Management Tips:</strong><br>
                            • Only one semester can be marked as "Current"<br>
                            • Students are automatically enrolled in the current semester<br>
                            • Past semesters maintain historical data<br>
                            • Use Set Current to change the active semester
                        </div>
                </div>
            </div>
        </div>
    </div>
</div>