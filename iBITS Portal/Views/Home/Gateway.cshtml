@{
    //Gateway.cshtml(Gateway)
}

@{
    ViewData["Title"] = "Gateway";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>iBITS Portal Gateway</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;700;800&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/gateway.css" asp-append-version="true" />
</head>
<body>

    <div class="ambient-bg"></div>
    <canvas id="matrixCanvas"></canvas>

    <!-- Floating Navigation -->
    <nav class="floating-nav visible" id="floatingNav">
        <div class="nav-container">
            <div class="hero-header">
                <img src="~/images/pup-logo.png" alt="PUP Logo" class="pup-logo">
                <div class="header-text">
                    <span class="uni-name">POLYTECHNIC UNIVERSITY OF THE PHILIPPINES</span>
                    <span class="campus-name">LOPEZ, QUEZON CAMPUS</span>
                </div>
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/Home/LandingPageAbout">Organization</a></li>
                <li><a href="/Home/LandingPagePeople">System</a></li>
                <li><a href="/Home/LandingDevelopers">Developers</a></li>
                <a href="/" class="btn-return-home">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Return to Home</span>
                </a>
            </ul>
            <!-- Mobile Hamburger -->
            <button class="landing-hamburger" id="landingHamburger" aria-label="Toggle navigation">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <!-- Mobile Menu Overlay (Sidebar) -->
    <div class="menu-backdrop" id="menuBackdrop"></div>
    <div class="landing-mobile-menu" id="landingMobileMenu">
        <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Close menu">&times;</button>
        <a href="/" onclick="closeMobileMenu()">Home</a>
        <a href="/Home/LandingPageAbout" onclick="closeMobileMenu()">Organization</a>
        <a href="/Home/LandingPagePeople" onclick="closeMobileMenu()">System</a>
        <a href="/Home/LandingDevelopers" onclick="closeMobileMenu()">Developers</a>
        <a href="/" class="mobile-enter-btn" onclick="closeMobileMenu()">Return to Home</a>
    </div>

    <div class="split-layout">

        <!-- LEFT SIDE -->
        <div class="left-brand">
            <div class="logo-wrapper">
                <!-- Ensure this path is correct in your project -->
                <img src="~/images/logo.png" alt="iBITS Logo" class="logo-img">
            </div>
            <div class="brand-text">
                <h1>iBITS PORTAL</h1>
                <span class="gold-accent">Unified Attendance & Payment System</span>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        <div class="right-controls">
            <div class="glass-panel">
                <div class="panel-header">
                    <h3>Secure Access</h3>
                    <p>Select your access type to continue</p>
                </div>

                <!-- MEMBER BUTTON -->
                <a href="/Identity/Account/Login?userType=Member" class="nav-btn">
                    <div class="btn-icon-box">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                    <div class="btn-content">
                        <h4>Member Access</h4>
                        <span>For Students & Officers</span>
                    </div>
                    <i class="bi bi-chevron-right arrow-icon"></i>
                </a>

                <!-- ADMIN BUTTON -->
                <a href="/Identity/Account/Login?userType=Admin" class="nav-btn">
                    <div class="btn-icon-box">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <div class="btn-content">
                        <h4>Admin Console</h4>
                        <span>For Administrators Only</span>
                    </div>
                    <i class="bi bi-chevron-right arrow-icon"></i>
                </a>

            </div>
        </div>
    </div>

    <!-- Custom JS -->
    <script src="~/js/gateway.js" asp-append-version="true"></script>

</body>
</html>