@* C:\Users\Dave\OneDrive\Desktop\copies of code bases from the iBITS Portal\StudentDashboard.cshtml *@
@* FILE PATH: Views/Home/Index.cshtml (Student Dashboard) *@
@{
    ViewData["Title"] = "Command Center";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    // ==========================================
    // 1. GET DATA & MODELS
    // ==========================================
    var student = ViewBag.Student as iBITS_Portal.Models.Student;
    var nextEvent = ViewBag.NextEvent as iBITS_Portal.Models.Event;
    var upcomingEvents = ViewBag.UpcomingEvents as List<iBITS_Portal.Models.Event> ?? new List<iBITS_Portal.Models.Event>();
    var announcements = ViewBag.Announcements as List<iBITS_Portal.Models.Announcement> ?? new List<iBITS_Portal.Models.Announcement>();

    // Separate payment reminders from regular announcements
    var paymentReminders = announcements.Where(a => a.Title.Contains("Payment Reminder")).ToList();
    var regularAnnouncements = announcements.Where(a => !a.Title.Contains("Payment Reminder")).ToList();

    // ==========================================
    // 2. BADGE LOGIC (Connects to CSS)
    // ==========================================
    string displayRole = "Member";
    string badgeClass = "badge-role-member";
    string badgeIcon = "bi-person-fill";

    // A. ADMIN CHECK
    if (User.IsInRole("Admin"))
    {
        displayRole = "System Admin";
        badgeClass = "badge-role-admin";
        badgeIcon = "bi-shield-lock-fill";
    }
    // B. DATABASE CHECK (Prioritize Linked Officer Data)
    else if (student?.Officer != null)
    {
        string pos = student.Officer.Position ?? "Officer";
        string posLower = pos.ToLower();

        if (posLower.Contains("class") && posLower.Contains("secretary"))
        {
            displayRole = "Class Secretary";
            badgeClass = "badge-role-classsecretary";
            badgeIcon = "bi-journal-check";
        }
        else if (posLower.Contains("class") && posLower.Contains("treasurer"))
        {
            displayRole = "Class Treasurer";
            badgeClass = "badge-role-classtreasurer";
            badgeIcon = "bi-wallet2";
        }
        else if (posLower.Contains("org") && posLower.Contains("secretary"))
        {
            displayRole = "Org. Secretary";
            badgeClass = "badge-role-orgsecretary";
            badgeIcon = "bi-pen-fill";
        }
        else if (posLower.Contains("org") && posLower.Contains("treasurer"))
        {
            displayRole = "Org. Treasurer";
            badgeClass = "badge-role-orgtreasurer";
            badgeIcon = "bi-bank2";
        }
        else
        {
            displayRole = pos; // Generic Officer
            badgeClass = "badge-role-officer";
            badgeIcon = "bi-star-fill";
        }
    }
    // C. IDENTITY ROLE FALLBACK
    else if (User.IsInRole("Org Secretary"))
    {
        displayRole = "Org. Secretary";
        badgeClass = "badge-role-orgsecretary";
        badgeIcon = "bi-pen-fill";
    }
    else if (User.IsInRole("Org Treasurer"))
    {
        displayRole = "Org. Treasurer";
        badgeClass = "badge-role-orgtreasurer";
        badgeIcon = "bi-bank2";
    }
    else if (User.IsInRole("Class Secretary"))
    {
        displayRole = "Class Secretary";
        badgeClass = "badge-role-classsecretary";
        badgeIcon = "bi-journal-check";
    }
    else if (User.IsInRole("Class Treasurer"))
    {
        displayRole = "Class Treasurer";
        badgeClass = "badge-role-classtreasurer";
        badgeIcon = "bi-wallet2";
    }
    else if (User.IsInRole("Officer"))
    {
        displayRole = "Officer";
        badgeClass = "badge-role-officer";
        badgeIcon = "bi-star-fill";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-dashboard.css" asp-append-version="true" />
    <style>
        .payment-reminder-card {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(217, 119, 6, 0.1) 100%);
            border-left: 4px solid #f59e0b;
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 12px;
            transition: transform 0.2s ease;
        }

            .payment-reminder-card:hover {
                transform: translateX(5px);
                background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.15) 100%);
            }

        .payment-reminder-icon {
            font-size: 2rem;
            color: #f59e0b;
        }
    </style>
}

<!-- Hidden Data for JS -->
<input type="hidden" id="hiddenStudentId" value="@student?.StudentNum" />
@if (nextEvent != null && nextEvent.EventDate.HasValue)
{
    <input type="hidden" id="eventDate" value="@nextEvent.EventDate.Value.ToString("yyyy-MM-dd")" />
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- LEFT MAIN COLUMN -->
    <div class="col-lg-8">

        <!-- ========================================== -->
        <!--        WELCOME HEADER                      -->
        <!-- ========================================== -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <h2 class="fw-bold text-white mb-0">Hello, @(student?.StudentFn)! ðŸ‘‹</h2>

            <!-- This Span uses the C# variables calculated at the top -->
            <span class="role-badge @badgeClass">
                <i class="bi @badgeIcon"></i> @displayRole
            </span>
        </div>

        <p class="text-muted mb-4" style="margin-top:-15px;">Welcome to your iBITS Command Center.</p>

        <!-- PAYMENT REMINDERS (Priority Display) -->
        @if (paymentReminders.Any())
        {
            <div class="glass-card mb-4">
                <h5 class="card-header">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i> Payment Reminders
                </h5>
                <div class="card-body">
                    @foreach (var reminder in paymentReminders.Take(3))
                    {
                        <div class="payment-reminder-card">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-cash-coin payment-reminder-icon me-3"></i>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="text-warning mb-0">@reminder.Title</h6>
                                        <small class="text-muted">@reminder.Timestamp.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <p class="mb-2 text-white">@reminder.Content</p>
                                    <small class="text-muted">
                                        <i class="bi bi-person-badge me-1"></i> From: @reminder.PostedBy
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="text-center mt-3">
                        <a href="@Url.Action("Financials", "Student")" class="btn btn-warning btn-sm">
                            <i class="bi bi-wallet2 me-1"></i> View My Financials
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- Next Activity Card -->
        <div class="glass-card mb-4">
            <h5 class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar-event me-2"></i> Next Activity</span>
                <a href="@Url.Action("Events", "Student")" class="btn btn-sm btn-outline-warning">View All Events</a>
            </h5>
            <div class="card-body">
                @if (nextEvent != null)
                {
                    <div id="countdown-active">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="fw-bold text-white mb-0">@nextEvent.EventName</h3>
                            <span class="badge bg-primary">@(nextEvent.EventDate?.ToString("MMM dd") ?? "TBA")</span>
                        </div>
                        <p class="text-muted small"><i class="bi bi-geo-alt"></i> @nextEvent.EventLocation</p>

                        <div class="countdown-container mt-4">
                            <div class="time-box"><span id="days">00</span><small>Days</small></div>
                            <div class="time-box"><span id="hours">00</span><small>Hours</small></div>
                            <div class="time-box"><span id="minutes">00</span><small>Mins</small></div>
                            <div class="time-box"><span id="seconds">00</span><small>Secs</small></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-x fs-1"></i>
                        <p class="mt-2 mb-0">No upcoming events scheduled.</p>
                    </div>
                }
            </div>
        </div>

        <!-- More Upcoming Events -->
        @if (upcomingEvents.Any() && upcomingEvents.Count > 1)
        {
            <div class="glass-card mb-4">
                <h5 class="card-header"><i class="bi bi-calendar3 me-2"></i> More Upcoming Events</h5>
                <div class="card-body">
                    @foreach (var evt in upcomingEvents.Skip(1).Take(2))
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
                            <div>
                                <h6 class="text-white mb-1">@evt.EventName</h6>
                                <p class="text-muted small mb-0">
                                    <i class="bi bi-calendar"></i> @evt.EventDate?.ToString("MMM dd, yyyy")
                                    @if (!string.IsNullOrEmpty(evt.EventLocation))
                                    {
                                        <span class="ms-2"><i class="bi bi-geo-alt"></i> @evt.EventLocation</span>
                                    }
                                </p>
                            </div>
                            <span class="badge bg-warning text-dark">Upcoming</span>
                        </div>
                    }
                    <div class="text-center mt-3">
                        <a href="@Url.Action("Events", "Student")" class="btn btn-outline-warning btn-sm">See All Events</a>
                    </div>
                </div>
            </div>
        }

        <!-- Announcements Card -->
        <div class="glass-card">
            <h5 class="card-header"><i class="bi bi-megaphone me-2"></i> Announcements</h5>
            <div class="card-body">
                @if (regularAnnouncements.Any())
                {
                    foreach (var announcement in regularAnnouncements.Take(5))
                    {
                        <div class="announcement-item">
                            <small class="text-gold">@announcement.Timestamp.ToString("MMM dd") â€¢ Posted by @announcement.PostedBy</small>
                            <p class="mb-0 mt-1 text-white">@announcement.Content</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center mb-0">No announcements yet.</p>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT PROFILE COLUMN -->
    <div class="col-lg-4">
        <div class="profile-card">
            <div class="profile-pic-wrapper">
                <img src="@(string.IsNullOrEmpty(student?.StudentImage) ? "/images/default-avatar.png" : student.StudentImage)" alt="Profile Picture" id="profilePic">
                <button class="btn-change-pic" data-bs-toggle="modal" data-bs-target="#profilePicModal"><i class="bi bi-camera-fill"></i></button>
            </div>
            <h4 class="text-white fw-bold mt-3 mb-1">@student?.StudentFn @student?.StudentLn</h4>
            <p class="text-gold mono-font">@student?.StudentNum</p>
            <p class="text-muted small">@student?.Course | @student?.YearLevelSection</p>

            <hr class="my-4" style="border-color: var(--border-color);" />

            <h6 class="text-uppercase small fw-bold text-muted">iBITS Digital ID</h6>
            <div class="qr-container my-3">
                <div id="qrcode"></div>
            </div>
            <div class="d-grid gap-2">
                <button class="btn-action-outline" id="btnExpandQr"><i class="bi bi-arrows-fullscreen"></i> Expand ID</button>
                <button class="btn-action-outline" id="btnDownloadQr"><i class="bi bi-download"></i> Download ID</button>
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn-action-dark"><i class="bi bi-gear-fill"></i> Account Settings</a>
            </div>
        </div>
    </div>
</div>

<!-- MODAL for Profile Picture Upload -->
<div class="modal fade" id="profilePicModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header">
                <h5 class="modal-title">Update Profile Picture</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateProfilePicture" asp-controller="Student" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="file" class="form-control" name="profileImage" accept="image/*" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="~/js/student-dashboard.js" asp-append-version="true"></script>
}

