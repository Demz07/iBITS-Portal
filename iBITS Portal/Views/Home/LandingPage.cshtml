@* 
    FILE PATH: Views/Home/LandingPage.cshtml
    Professional Landing Page for iBITS Portal
*@

@{
    ViewData["Title"] = "iBITS Portal - Unified Attendance & Payment System";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="iBITS Portal - Unified Attendance and Payment Management System for PUP Lopez, Quezon Campus">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/landing-page.css" asp-append-version="true" />
</head>
<body>

    <!-- Background Effects -->
    <div class="ambient-bg"></div>
    <canvas id="matrixCanvas"></canvas>



    <!-- Floating Navigation (appears on scroll) -->
    <nav class="floating-nav visible" id="floatingNav">
        <div class="nav-container">
            <div class="hero-header">
                <img src="~/images/pup-logo.png" alt="PUP Logo" class="pup-logo">
                <div class="header-text">
                    <span class="uni-name">POLYTECHNIC UNIVERSITY OF THE PHILIPPINES</span>
                    <span class="campus-name">LOPEZ, QUEZON CAMPUS</span>
                </div>
            </div>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a asp-controller="Home" asp-action="LandingPageAbout">Organization</a></li>
                <li><a asp-controller="Home" asp-action="LandingPagePeople">System</a></li>
                <li><a asp-controller="Home" asp-action="LandingDevelopers">Developers</a></li>
                @* <li><a href="#statistics">Enter Portal</a></li> *@
                <a asp-controller="Home" asp-action="Gateway" class="btn-enter">
                    <span>Enter Portal</span>
                    @* <i class="bi bi-arrow-right-circle"></i> *@
                </a>
            </ul>

            <!-- Mobile Hamburger -->
            <button class="landing-hamburger" id="landingHamburger" aria-label="Toggle navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>

        </div>

    </nav>

    <!-- Mobile Menu Overlay (Sidebar) -->
    <div class="menu-backdrop" id="menuBackdrop"></div>
    <div class="landing-mobile-menu" id="landingMobileMenu">
        <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Close menu">&times;</button>
        <a href="#home" onclick="closeMobileMenu()">Home</a>
        <a href="/Home/LandingPageAbout" onclick="closeMobileMenu()">Organization</a>
        <a href="/Home/LandingPagePeople" onclick="closeMobileMenu()">System</a>
        <a href="/Home/LandingDevelopers" onclick="closeMobileMenu()">Developers</a>
        <a href="/Home/Gateway" class="mobile-enter-btn" onclick="closeMobileMenu()">Enter Portal</a>
    </div>

    <!-- Hero Section -->
    <section id="home" class="hero-section">


        <div class="hero-content">
            <div class="hero-logo-wrapper">
                <div class="logo-glow"></div>
                <img src="~/images/logo.png" alt="iBITS Logo" class="hero-logo">
            </div>
            <h1 class="hero-title">
                Welcome to <span class="gradient-text">iBITS Portal</span>
            </h1>
            <p class="hero-subtitle">Unified Attendance & Payment Management System</p>
            <p class="hero-description">
                The iBITS Portal is a comprehensive digital platform developed specifically for student
                organizations at the PUP Lopez, Quezon Branch. Created by the Institute of Brilliant
                Information Technology Students (iBITS), this system is designed to modernize campus
                administrative tasks through three core pillars.
            </p>
            <div class="hero-cta">
                @* <a asp-action="Gateway" asp-controller="Home" class="btn-primary-cta">
                    <span>Enter Portal</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a> *@
                @* class="bi bi-chevron-down *@
                <a asp-action="Gateway" asp-controller="Home" class="btn-secondary-cta">
                    <span>Enter Portal</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>

        @* <div class="scroll-indicator">
            <span>Scroll to explore</span>
            <i class="bi bi-mouse"></i>
        </div> *@
    </section>

    @* Streamlining student organization operations with cutting-edge technology,
    <br>
    real-time tracking, and seamless financial management. *@

    <!-- About Section -->
    <section id="about" class="about-section section-spacing">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <span class="section-label">About the System</span>
                <h2 class="section-title">iBITS Portal: Unified Attendance and Payment System</h2>
                <p class="section-description">
                    The iBITS Portal is a comprehensive digital platform developed specifically for student
                    organizations at the PUP Lopez, Quezon Branch. Created by the Institute of Brilliant
                    Information Technology Students (iBITS), this system is designed to modernize campus
                    administrative tasks through three core pillars.
                </p>
            </div>

            <!-- Three Core Pillars -->
            <div class="pillars-grid" data-aos="fade-up">
                <div class="pillar-card" data-aos="flip-left" data-aos-delay="0">
                    <div class="pillar-icon">
                        <i class="bi bi-qr-code-scan"></i>
                    </div>
                    <h3>Unified Attendance Tracking</h3>
                    <p>Streamlines the check-in process through high-speed QR code scanning.</p>
                </div>

                <div class="pillar-card" data-aos="flip-left" data-aos-delay="100">
                    <div class="pillar-icon">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <h3>Financial Management</h3>
                    <p>Automates the recording and management of payments, ensuring transparency in student organization funds.</p>
                </div>

                <div class="pillar-card" data-aos="flip-left" data-aos-delay="200">
                    <div class="pillar-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h3>Data Insights</h3>
                    <p>Provides real-time analytics to help student leaders make informed decisions for better organization management.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Call-to-Action Section -->
    <section class="cta-section section-spacing">
        <div class="container">
            <div class="cta-content" data-aos="fade-up">
                <div class="cta-glow"></div>
                <h2>Ready to Get Started?</h2>
                <p>Join hundreds of students already using iBITS Portal to streamline their organization management</p>
                <a asp-action="Gateway" asp-controller="Home" class="btn-cta-large">
                    <span>Enter Portal Now</span>
                    <i class="bi bi-arrow-right-circle-fill"></i>
                </a>
                <p class="cta-note">
                    <i class="bi bi-info-circle"></i>
                    Secure login required. Contact your organization admin for access.
                </p>
            </div>
        </div>
    </section>

    <footer class="footer">
        <div class="footer-container">

            <!-- Left Section: Logo and Title -->
            <div class="footer-section left">
                <div class="footer-brand">
                    <div class="footer-logo-circle">
                        <img src="~/images/logo.png" alt="Portal Logo">
                    </div>
                    <h3>iBITS Portal</h3>
                </div>
            </div>

            <!-- Center Section: Copyright -->
            <div class="footer-section center">
                <p>&copy; 2025 All rights reserved.</p>
            </div>

            <!-- Right Section: Contact -->
            <div class="footer-section right">
                <h4>Connect with Us</h4>
                <div class="social-icons">
                    <!-- Facebook Icon -->
                    <a href="https://www.facebook.com/Ibits16" target="_blank" class="icon fb" aria-label="Facebook">
                        <i class="fa-brands fa-facebook"></i>
                    </a>
                    <!-- Email/Mail Icon -->
                    <a href="mailto:ibits16official@gmail.com" target="_blank" class="icon mail" aria-label="Email">
                        <i class="fa-solid fa-envelope"></i>
                    </a>
                </div>
            </div>

        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AOS Animation Library -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <!-- Custom JS -->
    <script src="~/js/landing-page.js" asp-append-version="true"></script>

    <script>
// Landing page mobile hamburger menu
const hamburger = document.getElementById('landingHamburger');
const mobileMenu = document.getElementById('landingMobileMenu');
const menuClose = document.getElementById('mobileMenuClose');
const menuBackdrop = document.getElementById('menuBackdrop');

function openMobileMenu() {
    hamburger.classList.add('active');
    mobileMenu.classList.add('active');
    menuBackdrop.classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closeMobileMenu() {
    hamburger.classList.remove('active');
    mobileMenu.classList.remove('active');
    menuBackdrop.classList.remove('active');
    document.body.style.overflow = '';
}

if (hamburger) hamburger.addEventListener('click', openMobileMenu);
if (menuClose) menuClose.addEventListener('click', closeMobileMenu);
if (menuBackdrop) menuBackdrop.addEventListener('click', closeMobileMenu);

// Close on escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeMobileMenu();
});
    </script>

</body>
</html>


