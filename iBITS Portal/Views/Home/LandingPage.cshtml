@* 
    FILE PATH: Views/Home/LandingPage.cshtml
    Professional Landing Page for iBITS Portal
*@

@{
    ViewData["Title"] = "iBITS Portal - Unified Attendance & Payment System";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="iBITS Portal - Unified Attendance and Payment Management System for PUP Lopez, Quezon Campus">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/landing-page.css" asp-append-version="true" />
</head>
<body>

    <!-- Background Effects -->
    <div class="ambient-bg"></div>
    <canvas id="matrixCanvas"></canvas>

    <!-- Floating Navigation (appears on scroll) -->
    <nav class="floating-nav" id="floatingNav">
        <div class="nav-container">
            <div class="nav-brand">
                <img src="~/images/logo.png" alt="iBITS Logo" class="nav-logo">
                <span>iBITS</span>
            </div>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#features">Features</a></li>
                <li><a href="#statistics">Impact</a></li>
            </ul>
            <a asp-action="Gateway" asp-controller="Home" class="btn-nav-cta">
                <i class="bi bi-box-arrow-in-right me-2"></i>Enter Portal
            </a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero-section">
        <div class="hero-header">
            <img src="~/images/pup-logo.png" alt="PUP Logo" class="pup-logo">
            <div class="header-text">
                <span class="uni-name">POLYTECHNIC UNIVERSITY OF THE PHILIPPINES</span>
                <span class="campus-name">LOPEZ, QUEZON CAMPUS</span>
            </div>
        </div>

        <div class="hero-content">
            <div class="hero-logo-wrapper">
                <div class="logo-glow"></div>
                <img src="~/images/logo.png" alt="iBITS Logo" class="hero-logo">
            </div>
            <h1 class="hero-title">
                Welcome to <span class="gradient-text">iBITS Portal</span>
            </h1>
            <p class="hero-subtitle">Unified Attendance & Payment Management System</p>
            <p class="hero-description">
                Streamlining student organization operations with cutting-edge technology,<br>
                real-time tracking, and seamless financial management.
            </p>
            <div class="hero-cta">
                <a asp-action="Gateway" asp-controller="Home" class="btn-primary-cta">
                    <span>Enter Portal</span>
                    <i class="bi bi-arrow-right-circle"></i>
                </a>
                <a href="#about" class="btn-secondary-cta">
                    <span>Learn More</span>
                    <i class="bi bi-chevron-down"></i>
                </a>
            </div>
        </div>

        <div class="scroll-indicator">
            <span>Scroll to explore</span>
            <i class="bi bi-mouse"></i>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about-section section-spacing">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <span class="section-label">About the System</span>
                <h2 class="section-title">iBITS Portal: Unified Attendance and Payment System</h2>
                <p class="section-description">
                    The iBITS Portal is a comprehensive digital platform developed specifically for student
                    organizations at the PUP Lopez, Quezon Branch. Created by the Institute of Brilliant
                    Information Technology Students (iBITS), this system is designed to modernize campus
                    administrative tasks through three core pillars.
                </p>
            </div>

            <!-- Three Core Pillars -->
            <div class="pillars-grid" data-aos="fade-up">
                <div class="pillar-card" data-aos="flip-left" data-aos-delay="0">
                    <div class="pillar-icon">
                        <i class="bi bi-qr-code-scan"></i>
                    </div>
                    <h3>Unified Attendance Tracking</h3>
                    <p>Streamlines the check-in process through high-speed QR code scanning.</p>
                </div>

                <div class="pillar-card" data-aos="flip-left" data-aos-delay="100">
                    <div class="pillar-icon">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <h3>Financial Management</h3>
                    <p>Automates the recording and management of payments, ensuring transparency in student organization funds.</p>
                </div>

                <div class="pillar-card" data-aos="flip-left" data-aos-delay="200">
                    <div class="pillar-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h3>Data Insights</h3>
                    <p>Provides real-time analytics to help student leaders make informed decisions for better organization management.</p>
                </div>
            </div>

            <!-- Development Team Section -->
            <div class="team-section" data-aos="fade-up">
                <div class="team-header">
                    <h3 class="team-title">The Development Team (BSIT 3-1)</h3>
                    <p class="team-description">
                        This system was engineered and implemented by the following 3rd Year BSIT students:
                    </p>
                </div>

                <!-- Project Manager -->
                <div class="role-group" data-aos="fade-up">
                    <div class="role-header">
                        <i class="bi bi-person-badge"></i>
                        <h4>Project Manager</h4>
                    </div>
                    <div class="role-members">
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Convento, Pauleen Jesareth L.</span>
                        </div>
                    </div>
                </div>

                <!-- Data Administrator -->
                <div class="role-group" data-aos="fade-up" data-aos-delay="50">
                    <div class="role-header">
                        <i class="bi bi-database-fill-gear"></i>
                        <h4>Data Administrator (DA)</h4>
                    </div>
                    <div class="role-members">
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Marzan, Micaella R.</span>
                        </div>
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Rejano, Jenelyn F.</span>
                        </div>
                    </div>
                </div>

                <!-- Database Administrator -->
                <div class="role-group" data-aos="fade-up" data-aos-delay="100">
                    <div class="role-header">
                        <i class="bi bi-hdd-rack"></i>
                        <h4>Database Administrator (DBA)</h4>
                    </div>
                    <div class="role-members">
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Basco, Jazmyne Cozette S.</span>
                        </div>
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Palaya, Mariel G.</span>
                        </div>
                    </div>
                </div>

                <!-- Programmer -->
                <div class="role-group" data-aos="fade-up" data-aos-delay="150">
                    <div class="role-header">
                        <i class="bi bi-code-slash"></i>
                        <h4>Programmer</h4>
                    </div>
                    <div class="role-members">
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Yap, Elaija Jasmin C.</span>
                        </div>
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Petallano, Dave Q.</span>
                        </div>
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Vilan, Sofia Angela T.</span>
                        </div>
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Malabuyoc, Princess Kaye E.</span>
                        </div>
                    </div>
                </div>

                <!-- Documentation -->
                <div class="role-group" data-aos="fade-up" data-aos-delay="200">
                    <div class="role-header">
                        <i class="bi bi-file-earmark-text"></i>
                        <h4>Documentation</h4>
                    </div>
                    <div class="role-members">
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Lagsa, Jess Lorenz P.</span>
                        </div>
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Manadan, Shane Ashly M.</span>
                        </div>
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Poblete, Ruth A.</span>
                        </div>
                    </div>
                </div>

                <!-- Quality Assurance -->
                <div class="role-group" data-aos="fade-up" data-aos-delay="250">
                    <div class="role-header">
                        <i class="bi bi-shield-check"></i>
                        <h4>Quality Assurance</h4>
                    </div>
                    <div class="role-members">
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Barroa, Lynnel E.</span>
                        </div>
                    </div>
                </div>

                <!-- User Interface -->
                <div class="role-group" data-aos="fade-up" data-aos-delay="300">
                    <div class="role-header">
                        <i class="bi bi-palette"></i>
                        <h4>User Interface (UI)</h4>
                    </div>
                    <div class="role-members">
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Navera, Lovely Gift R.</span>
                        </div>
                    </div>
                </div>

                <!-- User Experience -->
                <div class="role-group" data-aos="fade-up" data-aos-delay="350">
                    <div class="role-header">
                        <i class="bi bi-emoji-smile"></i>
                        <h4>User Experience (UX)</h4>
                    </div>
                    <div class="role-members">
                        <div class="team-member-role">
                            <i class="bi bi-person-circle"></i>
                            <span>Caralian, Camille C.</span>
                        </div>
                    </div>
                </div>

                <div class="team-footer" data-aos="fade-up">
                    <div class="tech-info">
                        <span class="tech-badge-large">ASP.NET Core MVC</span>
                        <span class="tech-badge-large">SQL Server</span>
                        <span class="tech-badge-large">Bootstrap 5</span>
                        <span class="tech-badge-large">QR Code Technology</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="features-section section-spacing">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <span class="section-label">Key Features</span>
                <h2 class="section-title">Everything You Need, All in One Place</h2>
                <p class="section-description">
                    Powerful tools designed to simplify operations and enhance productivity
                </p>
            </div>

            <div class="features-grid">
                <!-- Feature 1 -->
                <div class="feature-card interactive-hover" data-aos="fade-up" data-aos-delay="0">
                    <div class="feature-icon qr-code">
                        <i class="bi bi-qr-code-scan"></i>
                    </div>
                    <h3>QR Code Attendance</h3>
                    <p>
                        Each student has a unique QR code. Officers use the scanner to verify attendance
                        at events in real-time. The system automatically records Present/Late/Absent status,
                        and generates fines based on student classification (Member, Class Officer, Org Officer).
                    </p>
                    <div class="feature-tags">
                        <span class="tag">Real-time</span>
                        <span class="tag">Contactless</span>
                    </div>
                    <div class="feature-stat">
                        <i class="bi bi-lightning-fill"></i>
                        <span>Instant attendance logging</span>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="feature-card interactive-hover" data-aos="fade-up" data-aos-delay="100">
                    <div class="feature-icon payment">
                        <i class="bi bi-credit-card"></i>
                    </div>
                    <h3>Fee & Fine Management</h3>
                    <p>
                        Track membership fees and attendance-based fines with complete payment history.
                        Officers/treasurers record payment confirmations with method, reference number, and notes.
                        Students view their balance, due dates, and paid/unpaid status in real-time.
                    </p>
                    <div class="feature-tags">
                        <span class="tag">Transparent</span>
                        <span class="tag">Organized</span>
                    </div>
                    <div class="feature-stat">
                        <i class="bi bi-graph-up"></i>
                        <span>Complete audit trail</span>
                    </div>
                </div>

                <!-- Feature 3 -->
                <div class="feature-card interactive-hover" data-aos="fade-up" data-aos-delay="200">
                    <div class="feature-icon analytics">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h3>Admin Dashboard & Reports</h3>
                    <p>
                        Comprehensive admin dashboard showing total students, events, fees, and fines at a glance.
                        View detailed attendance reports, payment summaries, and activity logs.
                        Track member participation rates and financial status across academic years.
                    </p>
                    <div class="feature-tags">
                        <span class="tag">Insights</span>
                        <span class="tag">Data-driven</span>
                    </div>
                    <div class="feature-stat">
                        <i class="bi bi-clock-history"></i>
                        <span>Real-time statistics</span>
                    </div>
                </div>

                <!-- Feature 4 -->
                <div class="feature-card interactive-hover" data-aos="fade-up" data-aos-delay="300">
                    <div class="feature-icon events">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <h3>Event Management System</h3>
                    <p>
                        Create events with name, date, time, location, and duration. Set different fine amounts
                        for each classification (Member, Class Officer, Org Officer) for iBITS and Non-iBITS events.
                        Officers can scan QR codes during the event for instant attendance tracking.
                    </p>
                    <div class="feature-tags">
                        <span class="tag">Flexible</span>
                        <span class="tag">Efficient</span>
                    </div>
                    <div class="feature-stat">
                        <i class="bi bi-calendar-check"></i>
                        <span>Multi-type events</span>
                    </div>
                </div>

                <!-- Feature 5 -->
                <div class="feature-card interactive-hover" data-aos="fade-up" data-aos-delay="400">
                    <div class="feature-icon records">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                    <h3>Student Records & Archive</h3>
                    <p>
                        Complete student profiles with photo, student number, course, year level, and classification.
                        Track enrollment by school year, mark students as graduated or continuing.
                        View individual attendance history, financial records, and balance summaries.
                    </p>
                    <div class="feature-tags">
                        <span class="tag">Organized</span>
                        <span class="tag">Complete</span>
                    </div>
                    <div class="feature-stat">
                        <i class="bi bi-cloud-check"></i>
                        <span>Centralized database</span>
                    </div>
                </div>

                <!-- Feature 6 -->
                <div class="feature-card interactive-hover" data-aos="fade-up" data-aos-delay="500">
                    <div class="feature-icon security">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h3>3-Tier Role-Based Access</h3>
                    <p>
                        Admin: Manage students, events, fees, fines, view activity logs, and generate reports.
                        Officer: Create events, scan QR codes, record payments, and manage announcements.
                        Student: View personal attendance, financials, upcoming events, and organization timeline.
                    </p>
                    <div class="feature-tags">
                        <span class="tag">Secure</span>
                        <span class="tag">Controlled</span>
                    </div>
                    <div class="feature-stat">
                        <i class="bi bi-shield-fill-check"></i>
                        <span>3 user roles</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Statistics Section -->
    <section id="statistics" class="statistics-section section-spacing">
        <div class="container">
            <div class="section-header" data-aos="fade-up">
                <span class="section-label">Our Impact</span>
                <h2 class="section-title">Making a Difference</h2>
                <p class="section-description">
                    Real numbers from real organizations using iBITS Portal
                </p>
            </div>

            <div class="stats-grid">
                <div class="stat-card interactive-stat" data-aos="zoom-in" data-aos-delay="0">
                    <div class="stat-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="stat-number" data-target="@ViewBag.TotalStudents">0</div>
                    <div class="stat-label">Active Members</div>
                    <div class="stat-description">Student organization members registered</div>
                    <div class="stat-trend">
                        <i class="bi bi-database-fill"></i>
                        <span>Live from database</span>
                    </div>
                </div>

                <div class="stat-card interactive-stat" data-aos="zoom-in" data-aos-delay="100">
                    <div class="stat-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="stat-number" data-target="@ViewBag.TotalEvents">0</div>
                    <div class="stat-label">Events Managed</div>
                    <div class="stat-description">Meetings, seminars, and activities tracked</div>
                    <div class="stat-trend">
                        <i class="bi bi-database-fill"></i>
                        <span>Live from database</span>
                    </div>
                </div>

                <div class="stat-card interactive-stat" data-aos="zoom-in" data-aos-delay="200">
                    <div class="stat-icon">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="stat-number" data-target="@ViewBag.TotalTransactions">0</div>
                    <div class="stat-label">Transactions</div>
                    <div class="stat-description">Fees, fines, and payments recorded</div>
                    <div class="stat-trend">
                        <i class="bi bi-check-circle"></i>
                        <span>100% accuracy</span>
                    </div>
                </div>

                <div class="stat-card interactive-stat" data-aos="zoom-in" data-aos-delay="300">
                    <div class="stat-icon">
                        <i class="bi bi-qr-code"></i>
                    </div>
                    <div class="stat-number" data-target="@ViewBag.TotalScans">0</div>
                    <div class="stat-label">QR Scans</div>
                    <div class="stat-description">Successful attendance verifications</div>
                    <div class="stat-trend">
                        <i class="bi bi-lightning-fill"></i>
                        <span>Instant scanning</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call-to-Action Section -->
    <section class="cta-section section-spacing">
        <div class="container">
            <div class="cta-content" data-aos="fade-up">
                <div class="cta-glow"></div>
                <h2>Ready to Get Started?</h2>
                <p>Join hundreds of students already using iBITS Portal to streamline their organization management</p>
                <a asp-action="Gateway" asp-controller="Home" class="btn-cta-large">
                    <span>Enter Portal Now</span>
                    <i class="bi bi-arrow-right-circle-fill"></i>
                </a>
                <p class="cta-note">
                    <i class="bi bi-info-circle"></i>
                    Secure login required. Contact your organization admin for access.
                </p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer-section">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <img src="~/images/logo.png" alt="iBITS Logo" class="footer-logo">
                    <h4>iBITS Portal</h4>
                    <p>Unified Attendance & Payment Management System</p>
                </div>

                <div class="footer-links">
                    <h5>Quick Links</h5>
                    <ul>
                        <li><a asp-action="Gateway" asp-controller="Home">Enter Portal</a></li>
                        <li><a href="#about">About System</a></li>
                        <li><a href="#features">Features</a></li>
                        <li><a asp-action="Privacy" asp-controller="Home">Privacy Policy</a></li>
                    </ul>
                </div>

                <div class="footer-contact">
                    <h5>Contact</h5>
                    <ul>
                        <li>
                            <i class="bi bi-geo-alt-fill"></i>
                            <span>PUP Lopez, Quezon Campus</span>
                        </li>
                        <li>
                            <i class="bi bi-envelope-fill"></i>
                            <span>support@ibitsportal.edu.ph</span>
                        </li>
                        <li>
                            <i class="bi bi-telephone-fill"></i>
                            <span>Contact your admin</span>
                        </li>
                    </ul>
                </div>

                <div class="footer-social">
                    <h5>Connect With Us</h5>
                    <div class="social-icons">
                        <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2025 iBITS Portal. All rights reserved. | Polytechnic University of the Philippines - Lopez, Quezon Campus</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AOS Animation Library -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <!-- Custom JS -->
    <script src="~/js/landing-page.js" asp-append-version="true"></script>

</body>
</html>
