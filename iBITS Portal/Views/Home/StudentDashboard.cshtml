        (function () {
            const form = document.getElementById('ajaxEmailForm');
            const btn = document.getElementById('btnUpdateEmail');
            const currentEmailInput = document.getElementById('currentStudentEmail');

            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    
                    const formData = new FormData(form);
                    const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenInput ? tokenInput.value : '';

                    const oldBtnHtml = btn ? btn.innerHTML : '';
                    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Updating...'; }

                    fetch('@Url.Action("UpdateEmailAjax", "Account")', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: new URLSearchParams(formData)
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            showPortalToast('success', 'Success', data.message || 'Email updated successfully!');
                            if (currentEmailInput && formData.get('NewEmail')) {
                                currentEmailInput.value = formData.get('NewEmail');
                            }
                            form.reset();
                        } else {
                            showPortalToast('danger', 'Update Failed', data.message || 'Unable to update email.');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        showPortalToast('danger', 'Network Error', 'Something went wrong.');
                    })
                    .finally(() => { if (btn) { btn.disabled = false; btn.innerHTML = oldBtnHtml; } });
                });
            }
        })();

        // ===========================
        // PASSWORD UPDATE: AJAX
        // ===========================
        (function () {
            const form = document.getElementById('ajaxPasswordForm');
            const btn = document.getElementById('btnUpdatePass');
            const alertDiv = document.getElementById('passwordAlert');

            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    
                    const formData = new FormData(form);
                    const newPass = formData.get('NewPassword');
                    const confirmPass = formData.get('ConfirmPassword');

                    if (newPass !== confirmPass) {
                        showPortalToast('danger', 'Mismatch', 'New passwords do not match.');
                        return;
                    }

                    const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenInput ? tokenInput.value : '';

                    const oldBtnHtml = btn ? btn.innerHTML : '';
                    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Updating...'; }

                    fetch('@Url.Action("ChangePasswordAjax", "Account")', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: new URLSearchParams(formData)
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            showPortalToast('success', 'Success', data.message || 'Password updated successfully!');
                            form.reset();
                        } else {
                            showPortalToast('danger', 'Update Failed', data.message || 'Please check your current password.');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        showPortalToast('danger', 'Network Error', 'Something went wrong.');
                    })
                    .finally(() => { if (btn) { btn.disabled = false; btn.innerHTML = oldBtnHtml; } });
                });
            }
        })();


        // sender notice
        let activeNoticeId = null;

        function openAdminNoticeModal(id, title, msg, date, sender) {
            activeNoticeId = id;
            document.getElementById('viewNoticeSubject').innerText = title;
            document.getElementById('viewNoticeMessage').innerText = msg;
            document.getElementById('viewNoticeDate').innerText = date;
            document.getElementById('viewNoticeSender').innerText = "Sent by: " + sender;

            new bootstrap.Modal(document.getElementById('adminNoticeModal')).show();
        }

        // ✅ NEW: Open the nice confirm modal for Admin Notice
        function openAdminDismissConfirm() {
            const modal = new bootstrap.Modal(document.getElementById('adminDismissConfirmModal'));
            modal.show();
        }

        // ✅ NEW: Handle Admin Notice Dismiss (with toast after)
        document.addEventListener('DOMContentLoaded', function () {
            const adminConfirmBtn = document.getElementById('confirmAdminDismissBtn');
            if (!adminConfirmBtn) return;

            adminConfirmBtn.addEventListener('click', function () {
                if (!activeNoticeId) return;

                // Hide confirm modal
                const confirmInst = bootstrap.Modal.getInstance(document.getElementById('adminDismissConfirmModal'));
                if (confirmInst) confirmInst.hide();

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                $.ajax({
                    url: '/Home/DismissNotification',
                    type: 'POST',
                    data: {
                        id: activeNoticeId,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res.success) {
                            // Hide the view modal if open
                            const viewInst = bootstrap.Modal.getInstance(document.getElementById('adminNoticeModal'));
                            if (viewInst) viewInst.hide();

                            // Remove the matching card from the list (if present)
                            const listItems = document.querySelectorAll('.announcement-item.border-start-warning');
                            listItems.forEach(el => {
                                // Find the one that opened this modal by subject text match (safe fallback)
                                const titleEl = el.querySelector('p.mb-0.mt-1.text-white strong');
                                if (titleEl && titleEl.innerText.trim() === document.getElementById('viewNoticeSubject').innerText.trim()) {
                                    el.style.opacity = '0';
                                    setTimeout(() => el.remove(), 260);
                                }
                            });

                            // Show the pretty toast (like your 2nd screenshot)
                            showPortalToast('success', 'Dismissed', 'Admin notice dismissed successfully.');
                            activeNoticeId = null;
                        } else {
                            showPortalToast('danger', 'Error', 'Could not dismiss notice.');
                        }
                    },
                    error: function() {
                        showPortalToast('danger', 'Error', 'Server connection failed.');
                    }
                });
            });
        });
    </script>
}
