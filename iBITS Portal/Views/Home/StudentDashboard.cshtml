@* ============================================================ *@
@* FILE PATH: Views/Home/Index.cshtml (Student Dashboard)       *@
@* UPDATED: Final header adjustments to match reference image.  *@
@* ============================================================ *@
@{
    ViewData["Title"] = "Command Center";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    // --- Data Models & Badge Logic ---
    var student = ViewBag.Student as iBITS_Portal.Models.Student;
    var nextEvent = ViewBag.NextEvent as iBITS_Portal.Models.Event;
    var upcomingEvents = ViewBag.UpcomingEvents as List<iBITS_Portal.Models.Event> ?? new List<iBITS_Portal.Models.Event>();
    var announcements = ViewBag.Announcements as List<iBITS_Portal.Models.Announcement> ?? new List<iBITS_Portal.Models.Announcement>();
    var paymentReminders = announcements.Where(a => a.Title.Contains("Payment Reminder")).ToList();
    var regularAnnouncements = announcements.Where(a => !a.Title.Contains("Payment Reminder")).ToList();

    // Role Badge Logic
    string displayRole = "Member";
    string badgeClass = "badge-role-member";
    string badgeIcon = "bi-person-fill";

    if (User.IsInRole("Admin")) { displayRole = "System Admin"; badgeClass = "badge-role-admin"; badgeIcon = "bi-shield-lock-fill"; }
    else if (student?.Officer != null)
    {
        // This is a placeholder for your complex officer role logic
        string pos = student.Officer.Position ?? "Officer";
        if (pos.ToLower().Contains("class")) { displayRole = "Class Officer"; }
        else { displayRole = "Org Officer"; }
        badgeClass = "badge-role-officer";
        badgeIcon = "bi-star-fill";
    }
    else if (User.IsInRole("Org Secretary")) { displayRole = "Org. Secretary"; badgeClass = "badge-role-orgsecretary"; badgeIcon = "bi-pen-fill"; }
    else if (User.IsInRole("Org Treasurer")) { displayRole = "Org. Treasurer"; badgeClass = "badge-role-orgtreasurer"; badgeIcon = "bi-bank2"; }
    else if (User.IsInRole("Class Secretary")) { displayRole = "Class Secretary"; badgeClass = "badge-role-classsecretary"; badgeIcon = "bi-journal-check"; }
    else if (User.IsInRole("Class Treasurer")) { displayRole = "Class Treasurer"; badgeClass = "badge-role-classtreasurer"; badgeIcon = "bi-wallet2"; }
    else if (User.IsInRole("Officer")) { displayRole = "Officer"; badgeClass = "badge-role-officer"; badgeIcon = "bi-star-fill"; }
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-dashboard.css" asp-append-version="true" />
    <style>
        /* --- Styles for the new layout --- */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .welcome-message {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap; /* Allows badge to wrap on small screens */
        }

        .btn-my-profile {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            color: var(--text-main);
            text-decoration: none;
            transition: color 0.2s;
            flex-shrink: 0;
        }

            .btn-my-profile:hover {
                color: var(--gold-primary);
            }

            .btn-my-profile .profile-icon-img {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                object-fit: cover;
                border: 1px solid var(--border-color);
            }

            .btn-my-profile .profile-icon {
                font-size: 1.8rem;
                width: 44px;
                height: 44px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid var(--border-color);
            }

            .btn-my-profile span {
                font-size: 0.75rem;
                font-weight: 600;
            }
        /* Other styles */
        .upcoming-event-item {
            display: flex;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-color);
        }

            .upcoming-event-item:last-child {
                border-bottom: none;
            }

        .upcoming-event-date {
            text-align: center;
            margin-right: 1rem;
            color: var(--gold-primary);
            min-width: 50px;
        }

            .upcoming-event-date .month {
                font-size: .7rem;
                font-weight: 600;
                text-transform: uppercase;
            }

            .upcoming-event-date .day {
                font-size: 1.5rem;
                font-weight: 700;
                line-height: 1.2;
            }

        .upcoming-event-details h6 {
            color: var(--text-strong);
            margin-bottom: 2px;
        }

        .upcoming-event-details small {
            color: var(--text-main);
        }

        .offcanvas.glass-modal {
            background: var(--bg-glass) !important;
            backdrop-filter: blur(25px) !important;
            border-left: 1px solid var(--border-color) !important;
        }
    </style>
}

<!-- ======================================================= -->
<!--                 FINAL DASHBOARD LAYOUT                  -->
<!-- ======================================================= -->
<!-- 1. HEADER (Hello + Badge + Profile Button) -->
<div class="page-header">
    <div class="welcome-message">
        <h2 class="fw-bold text-white mb-0">Hello, @(student?.StudentFn)! 👋</h2>

        <!-- Role Badge is now here -->
        <span class="role-badge @badgeClass">
            <i class="bi @badgeIcon"></i> @displayRole
        </span>
    </div>

    <!-- My Profile button with dynamic photo -->
    <a href="#profileOffcanvas" data-bs-toggle="offcanvas" class="btn-my-profile">
        @if (!string.IsNullOrEmpty(student?.StudentImage))
        {
            <img src="@student.StudentImage" alt="My Profile" class="profile-icon-img" />
        }
        else
        {
            <i class="bi bi-person-circle profile-icon"></i>
        }
        <span>My Profile</span>
    </a>
</div>

<!-- "Welcome to..." Subtitle is now here -->
<p class="text-muted mb-4" style="margin-top:-1rem;">Welcome to your iBITS Command Center.</p>


<div class="row g-4">
    <!-- TOP ROW: ANNOUNCEMENTS -->
    <div class="col-12">
        <div class="glass-card h-100">
            <h5 class="card-header"><i class="bi bi-megaphone-fill me-2 text-gold"></i> Announcements</h5>
            <div class="card-body">
                @if (!announcements.Any())
                {
                    <p class="text-muted text-center mb-0 py-3">No announcements yet.</p>
                }

                @if (paymentReminders.Any())
                {
                    @foreach (var reminder in paymentReminders)
                    {
                        <div class="announcement-item border-start-warning">
                            <small class="text-warning">@reminder.Timestamp.ToString("MMM dd") • Posted by @reminder.PostedBy</small>
                            <p class="mb-0 mt-1 text-white"><strong>@reminder.Title:</strong> @reminder.Content</p>
                        </div>
                    }
                }

                @if (regularAnnouncements.Any())
                {
                    @foreach (var announcement in regularAnnouncements)
                    {
                        <div class="announcement-item">
                            <small class="text-gold">@announcement.Timestamp.ToString("MMM dd") • Posted by @announcement.PostedBy</small>
                            <p class="mb-0 mt-1 text-white">@announcement.Content</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- BOTTOM ROW: SPLIT -->
    <!-- LEFT: NEXT ACTIVITY -->
    <div class="col-lg-7">
        <div class="glass-card h-100">
            <h5 class="card-header"><i class="bi bi-calendar-event me-2"></i> Next Activity</h5>
            <div class="card-body">
                @if (nextEvent != null)
                {
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="fw-bold text-white mb-0">@nextEvent.EventName</h3>
                            <span class="badge bg-primary">@(nextEvent.EventDate?.ToString("MMM dd") ?? "TBA")</span>
                        </div>
                        <p class="text-muted small"><i class="bi bi-geo-alt"></i> @nextEvent.EventLocation</p>
                        <div class="countdown-container mt-4">
                            <div class="time-box"><span id="days">00</span><small>Days</small></div>
                            <div class="time-box"><span id="hours">00</span><small>Hours</small></div>
                            <div class="time-box"><span id="minutes">00</span><small>Mins</small></div>
                            <div class="time-box"><span id="seconds">00</span><small>Secs</small></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted d-flex flex-column justify-content-center h-100">
                        <i class="bi bi-calendar-x fs-1"></i>
                        <p class="mt-2 mb-0">No upcoming events scheduled.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT: UPCOMING EVENTS LIST -->
    <div class="col-lg-5">
        <div class="glass-card h-100 d-flex flex-column">
            <h5 class="card-header text-gold text-uppercase fw-bold">Upcoming Events</h5>
            <div class="card-body flex-grow-1">
                @if (upcomingEvents.Any())
                {
                    @foreach (var evt in upcomingEvents.Take(4))
                    {
                        <div class="upcoming-event-item">
                            <div class="upcoming-event-date">
                                <div class="month">@evt.EventDate?.ToString("MMM")</div>
                                <div class="day">@evt.EventDate?.ToString("dd")</div>
                            </div>
                            <div class="upcoming-event-details">
                                <h6>@evt.EventName</h6>
                                <small><i class="bi bi-geo-alt"></i> @evt.EventLocation</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center">No other events.</p>
                }
            </div>
            <div class="card-footer text-center border-0 bg-transparent pb-3">
                <button type="button" class="btn btn-gold w-100" data-bs-toggle="modal" data-bs-target="#eventsModal" onclick="loadAllEvents()">
                    See All Events
                </button>
            </div>
        </div>
    </div>
</div>


<!-- ======================================================= -->
<!--                 MODALS & OFF-CANVAS                     -->
<!-- ======================================================= -->
<!-- 1. PROFILE OFF-CANVAS SIDEBAR -->
<div class="offcanvas offcanvas-end glass-modal" tabindex="-1" id="profileOffcanvas">
    <div class="offcanvas-header border-bottom" style="border-color: var(--border-color) !important;">
        <h5 class="offcanvas-title text-white">My Profile</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="profile-card p-0 text-center">
            <div class="profile-pic-wrapper">
                <img src="@(string.IsNullOrEmpty(student?.StudentImage) ? "/images/default-avatar.png" : student.StudentImage)" alt="Profile Picture" id="profilePic">
            </div>
            <h4 class="text-white fw-bold mt-3 mb-1">@student?.StudentFn @student?.StudentLn</h4>
            <p class="text-gold mono-font">@student?.StudentNum</p>
            <p class="text-muted small">@student?.Course | @student?.YearLevelSection</p>
            <hr class="my-4" style="border-color: var(--border-color);" />
            <h6 class="text-uppercase small fw-bold text-muted">iBITS Digital ID</h6>
            <div class="qr-container my-3">
                <div id="qrcode"></div>
            </div>
            <div class="d-grid gap-2 mt-3">
                <button class="btn-action-outline" id="btnExpandQr"><i class="bi bi-arrows-fullscreen"></i> Expand ID</button>
                <button class="btn-action-outline" id="btnDownloadQr"><i class="bi bi-download"></i> Download ID</button>
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn-action-dark"><i class="bi bi-gear-fill"></i> Account Settings</a>
            </div>
        </div>
    </div>
</div>


<!-- 2. All Events Modal -->
<div class="modal fade" id="eventsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title glass-header-title"><i class="bi bi-calendar-event me-2 text-warning"></i> All Events</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4"><div id="eventsModalContent" class="row g-4"></div></div>
        </div>
    </div>
</div>

<!-- Hidden Data -->
<input type="hidden" id="hiddenStudentId" value="@student?.StudentNum" />
@if (nextEvent != null && nextEvent.EventDate.HasValue)
{
    <input type="hidden" id="eventDate" value="@nextEvent.EventDate.Value.ToString("yyyy-MM-dd")" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="~/js/student-dashboard.js" asp-append-version="true"></script>

    <script>
        function loadAllEvents() {
            const container = document.getElementById('eventsModalContent');

            // Show loading spinner
            container.innerHTML = `
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Loading complete event list...</p>
                </div>
            `;

            fetch('/Student/GetAllEventsJson')
                .then(response => response.json())
                .then(data => {
                    container.innerHTML = ''; // Clear loader

                    if (data && data.length > 0) {
                        let html = '';
                        const today = new Date();
                        today.setHours(0,0,0,0);

                        data.forEach(item => {
                            // --- 1. Date & Status Logic ---
                            let eventDate = new Date(item.eventDate);
                            let statusClass = "badge-upcoming";
                            let statusText = "Upcoming";

                            const diffTime = eventDate - today;
                            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                            if (diffDays < 0) { statusClass = "bg-secondary"; statusText = "Finished"; }
                            else if (diffDays === 0) { statusClass = "badge-today"; statusText = "Today"; }
                            else if (diffDays > 0 && diffDays <= 3) { statusClass = "badge-soon"; statusText = "Soon"; }

                            // --- 2. Attendance Badge Logic ---
                            let attendanceBadge = '';

                            // UPDATED CONDITION:
                            // Only show attendance if the event is NOT "Soon" and NOT "Upcoming".
                            // It will only show for "Today" or "Finished" events.
                            if (statusText !== 'Soon' && statusText !== 'Upcoming') {
                                if (item.attendanceStatus) {
                                    let statusLower = item.attendanceStatus.toLowerCase();

                                    // Hide "Not Registered", show others
                                    if (statusLower !== 'not registered') {
                                        let badgeColor = 'bg-secondary';
                                        let icon = 'bi-question-circle';

                                        if(statusLower === 'present') { badgeColor = 'bg-success'; icon = 'bi-check-circle-fill'; }
                                        else if(statusLower === 'absent') { badgeColor = 'bg-danger'; icon = 'bi-x-circle-fill'; }
                                        else if(statusLower === 'excused') { badgeColor = 'bg-info'; icon = 'bi-info-circle-fill'; }

                                        attendanceBadge = `
                                            <div class="mt-3 pt-3 border-top" style="border-color: rgba(255,255,255,0.1) !important;">
                                                <small class="text-muted d-block mb-1">Attendance Status:</small>
                                                <span class="badge ${badgeColor}">
                                                    <i class="bi ${icon} me-1"></i> ${item.attendanceStatus}
                                                </span>
                                            </div>`;
                                    }
                                }
                            }

                            // --- 3. Render Card HTML ---
                            html += `
                            <div class="col-md-6 col-lg-4">
                                <div class="glass-card h-100" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius:12px; overflow:hidden;">

                                    <!-- Image Placeholder / Header -->
                                    <div class="event-img-placeholder text-center py-4 position-relative" style="background: rgba(0,0,0,0.2);">
                                        <span class="status-badge ${statusClass}" style="position:absolute; top:10px; right:10px; padding: 4px 10px; border-radius:4px; color:white; font-size:0.75rem; font-weight:bold;">${statusText}</span>
                                        <i class="bi bi-calendar-week" style="font-size: 3.5rem; opacity: 0.5; color: #D4AF37;"></i>
                                    </div>

                                    <div class="event-body p-4">
                                        <!-- Date & Time -->
                                        <div class="event-date text-gold small fw-bold mb-1 text-uppercase">
                                            ${eventDate.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'})}
                                            ${item.startTime ? ` • ${item.startTime}` : ''}
                                        </div>

                                        <!-- Title -->
                                        <div class="event-title fw-bold text-white mb-2" style="font-size: 1.15rem; line-height:1.3;">${item.eventName}</div>

                                        <!-- Description -->
                                        <div class="event-desc small text-muted mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                            ${item.eventDesc || 'No description provided.'}
                                        </div>

                                        <!-- Location -->
                                        <div class="d-flex align-items-center gap-2 text-muted small">
                                            <i class="bi bi-geo-alt-fill text-warning"></i> ${item.eventLocation || 'TBA'}
                                        </div>

                                        <!-- Attendance Section (Conditional) -->
                                        ${attendanceBadge}
                                    </div>
                                </div>
                            </div>`;
                        });
                        container.innerHTML = html;
                    } else {
                        container.innerHTML = `
                            <div class="col-12 text-center py-5">
                                <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
                                <h5 class="text-muted mt-3">No events found</h5>
                            </div>`;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    container.innerHTML = `<div class="col-12 text-center text-danger py-4">Failed to load events. Please refresh.</div>`;
                });
        }
    </script>
}

