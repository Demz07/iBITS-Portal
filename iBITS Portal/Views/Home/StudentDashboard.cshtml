@* ============================================================ *@
@* FILE PATH: Views/Home/Index.cshtml (Student Dashboard)       *@
@* FINAL VERSION: Complete UI/UX Fixes - Guaranteed Instant Email Update *@@* ============================================================ *@
@{
    ViewData["Title"] = "Command Center";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var student = ViewBag.Student as iBITS_Portal.Models.Student;
    var nextEvent = ViewBag.NextEvent as iBITS_Portal.Models.Event;
    var upcomingEvents = ViewBag.UpcomingEvents as List<iBITS_Portal.Models.Event> ?? new List<iBITS_Portal.Models.Event>();
    var announcements = ViewBag.Announcements as List<iBITS_Portal.Models.Announcement> ?? new List<iBITS_Portal.Models.Announcement>();
    var paymentReminders = announcements.Where(a => a.Title.Contains("Payment Reminder")).ToList();
    var regularAnnouncements = announcements.Where(a => !a.Title.Contains("Payment Reminder")).ToList();

    string displayRole = "Member";
    string badgeClass = "badge-role-member";
    string badgeIcon = "bi-person-fill";

    if (User.IsInRole("Admin")) { displayRole = "System Admin"; badgeClass = "badge-role-admin"; badgeIcon = "bi-shield-lock-fill"; }
    else if (User.IsInRole("Org Treasurer")) { displayRole = "Org Treasurer"; badgeClass = "badge-role-orgtreasurer"; badgeIcon = "bi-bank2"; }
    else if (User.IsInRole("Class Treasurer")) { displayRole = "Class Treasurer"; badgeClass = "badge-role-classtreasurer"; badgeIcon = "bi-wallet2"; }
    else if (User.IsInRole("Org Secretary")) { displayRole = "Org Secretary"; badgeClass = "badge-role-orgsecretary"; badgeIcon = "bi-pen-fill"; }
    else if (User.IsInRole("Class Secretary")) { displayRole = "Class Secretary"; badgeClass = "badge-role-classsecretary"; badgeIcon = "bi-journal-check"; }
    else if (User.IsInRole("Officer")) { displayRole = "Officer"; badgeClass = "badge-role-officer"; badgeIcon = "bi-star-fill"; }
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-dashboard.css" asp-append-version="true" />
    <style>
        /* Fix for Modal Stacking */
        .modal-header .btn-close {
            z-index: 10001 !important;
            position: relative;
            opacity: 1;
        }

        .modal {
            z-index: 1050 !important;
        }

        .modal-backdrop {
            z-index: 1040 !important;
        }

        /* Custom Colors & Borders */
        .text-orange {
            color: #fd7e14 !important;
        }

        .border-start-orange {
            border-left: 4px solid #fd7e14 !important;
        }

        .border-start-danger {
            border-left: 4px solid #dc3545 !important;
        }

        .border-start-warning {
            border-left: 4px solid #ffc107 !important;
        }

        .border-start-info {
            border-left: 4px solid #0dcaf0 !important;
        }

        /* Layout Styles */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .welcome-message {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn-my-profile {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            color: var(--text-main);
            text-decoration: none;
            transition: color 0.2s;
            flex-shrink: 0;
        }

            .btn-my-profile:hover {
                color: var(--gold-primary);
            }

            .btn-my-profile .profile-icon-img {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                object-fit: cover;
                border: 1px solid var(--border-color);
            }

        .announcement-scroll-container {
            max-height: 350px;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 8px;
        }

            .announcement-scroll-container::-webkit-scrollbar {
                width: 5px;
            }

            .announcement-scroll-container::-webkit-scrollbar-thumb {
                background: var(--gold-primary);
                border-radius: 10px;
            }

        .offcanvas.glass-modal {
            background: var(--bg-glass) !important;
            backdrop-filter: blur(25px) !important;
            border-left: 1px solid var(--border-color) !important;
        }

        .profile-pic-wrapper img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 3px solid var(--gold-primary);
            object-fit: cover;
        }

        /* Event Modal Specifics */
        #eventTabs .nav-link {
            color: var(--text-main);
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-right: 5px;
        }

            #eventTabs .nav-link.active {
                background: rgba(212, 175, 55, 0.2);
                border-color: var(--gold-primary);
                color: var(--gold-primary);
            }
    </style>
}

<div class="page-header">
    <div class="welcome-message">
        <h2 class="fw-bold text-white mb-0">Hello, @(student?.StudentFn)! 👋</h2>
        <span class="role-badge @badgeClass"><i class="bi @badgeIcon"></i> @displayRole</span>
    </div>
    <a href="#profileOffcanvas" data-bs-toggle="offcanvas" class="btn-my-profile">
        @if (!string.IsNullOrEmpty(student?.StudentImage))
        {
            <img src="@student.StudentImage" alt="My Profile" class="profile-icon-img" />
        }
        else
        {

            <i class="bi bi-person-circle fs-2"></i>
        }
        <span>My Profile</span>
    </a>
</div>

<p class="text-muted mb-4" style="margin-top:-1rem;">Welcome to your iBITS Command Center.</p>

<div class="row g-4">
    <!-- ANNOUNCEMENTS -->
    <div class="col-12">
        <div class="glass-card h-100">
            <h5 class="card-header"><i class="bi bi-megaphone-fill me-2 text-gold"></i> Announcements</h5>
            <div class="card-body announcement-scroll-container">
                @if (!announcements.Any())
                {
                    <p class="text-muted text-center py-3">No announcements yet.</p>
                }

                @foreach (var reminder in paymentReminders)
                {
                    string colorClass = "text-warning";
                    string borderClass = "border-start-warning";

                    if (reminder.AnnouncementType == "Urgent Notice") { colorClass = "text-danger"; borderClass = "border-start-danger"; }
                    else if (reminder.AnnouncementType == "Final Notice") { colorClass = "text-orange"; borderClass = "border-start-orange"; }
                    else if (reminder.AnnouncementType == "New Fee Posted") { colorClass = "text-info"; borderClass = "border-start-info"; }

                    <div class="announcement-item @borderClass mb-3" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#modal@(reminder.Id)">
                        <small class="@colorClass">@reminder.Timestamp.ToString("MMM dd") • @(reminder.AnnouncementType ?? "Payment Reminder")</small>
                        <p class="mb-0 mt-1 text-white"><strong>@reminder.Title.Replace("Payment Reminder: ", "")</strong></p>
                        <small class="text-muted" style="font-size: 0.7rem;">Click to read full message</small>
                    </div>
                }

                @foreach (var announcement in regularAnnouncements)
                {
                    <div class="announcement-item" id="announcement-@announcement.Id">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <small class="text-gold">@announcement.Timestamp.ToString("MMM dd") · Posted by @announcement.PostedBy</small>
                                <p class="mb-0 mt-1 text-white">@announcement.Content</p>
                            </div>
                            <button class="btn btn-sm btn-link text-muted p-0 ms-2" 
                                    onclick="dismissAnnouncement(@announcement.Id, this)" 
                                    title="Dismiss this announcement">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- NEXT ACTIVITY -->
    <div class="col-lg-7">
        <div class="glass-card h-100">
            <h5 class="card-header"><i class="bi bi-calendar-event me-2"></i> Next Activity</h5>
            <div class="card-body">
                @if (nextEvent != null)
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="fw-bold text-white mb-0">@nextEvent.EventName</h3>
                        <span class="badge bg-primary">@(nextEvent.EventDate?.ToString("MMM dd") ?? "TBA")</span>
                    </div>
                    <p class="text-muted small"><i class="bi bi-geo-alt"></i> @nextEvent.EventLocation</p>
                    <div class="countdown-container mt-4">
                        <div class="time-box"><span id="days">00</span><small>Days</small></div>
                        <div class="time-box"><span id="hours">00</span><small>Hours</small></div>
                        <div class="time-box"><span id="minutes">00</span><small>Mins</small></div>
                        <div class="time-box"><span id="seconds">00</span><small>Secs</small></div>
                    </div>
                }
                else
                {

                    <div class="text-center py-5 text-muted"><i class="bi bi-calendar-x fs-1"></i><p>No upcoming events.</p></div>
                }
            </div>
        </div>
    </div>

    <!-- UPCOMING LIST (Sidebar) -->
    <div class="col-lg-5">
        <div class="glass-card h-100 d-flex flex-column">
            <h5 class="card-header text-gold text-uppercase fw-bold">Upcoming Events</h5>
            <div class="card-body flex-grow-1">
                @if (upcomingEvents.Any())
                {
                    @foreach (var evt in upcomingEvents.Take(4))
                    {
                        <div class="upcoming-event-item">
                            <div class="upcoming-event-date"><div class="month">@evt.EventDate?.ToString("MMM")</div><div class="day">@evt.EventDate?.ToString("dd")</div></div>
                            <div class="upcoming-event-details"><h6>@evt.EventName</h6><small>@evt.EventLocation</small></div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center py-4 text-muted">No upcoming events.</p>
                }
            </div>
            <div class="card-footer border-0 bg-transparent pb-3">
                <button class="btn btn-gold w-100" data-bs-toggle="modal" data-bs-target="#eventsModal" onclick="loadAllEvents()">View All Events</button>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================= -->
<!--                 MODALS & SIDEBARS                       -->
<!-- ======================================================= -->
@* 1. PAYMENT REMINDER MODALS *@
@foreach (var reminder in paymentReminders)
{
    string titleColor = "text-gold";
    if (reminder.AnnouncementType == "Urgent Notice") { titleColor = "text-danger"; }
    else if (reminder.AnnouncementType == "Final Notice") { titleColor = "text-orange"; }
    else if (reminder.AnnouncementType == "New Fee Posted") { titleColor = "text-info"; }

    <div class="modal fade" id="modal@(reminder.Id)" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal" style="background: rgba(20, 20, 20, 0.98); border: 1px solid var(--gold-primary); backdrop-filter: blur(20px);">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title @titleColor">@reminder.AnnouncementType</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-white">
                    <h4 class="fw-bold mb-3">@reminder.Title.Replace("Payment Reminder: ", "")</h4>
                    <div style="white-space: pre-line; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px;">@reminder.Content</div>
                    <div class="mt-3 opacity-50 small text-end">Posted by: @reminder.PostedBy</div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Close
                    </button>
                    <button type="button" class="btn btn-outline-warning" onclick="dismissAnnouncement(@reminder.Id, this)" data-reminder-id="@reminder.Id">
                        <i class="bi bi-eye-slash me-1"></i> Dismiss This Reminder
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* 2. PROFILE SIDEBAR *@
<div class="offcanvas offcanvas-end glass-modal" tabindex="-1" id="profileOffcanvas">
    <div class="offcanvas-header border-bottom" style="border-color: var(--border-color) !important;">
        <h5 class="offcanvas-title text-white">My Profile</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body text-center">
        <div class="profile-pic-wrapper">
            <img src="@(string.IsNullOrEmpty(student?.StudentImage) ? "/images/default-avatar.png" : student.StudentImage)" alt="Profile" class="profile-icon-img">
        </div>
        <h4 class="text-white fw-bold mt-3">@student?.StudentFn @student?.StudentLn</h4>
        <p class="text-gold mono-font mb-1">@student?.StudentNum</p>
        <p class="text-muted small">@student?.Course | @student?.YearLevelSection</p>
        <hr class="my-4" style="border-color: var(--border-color);" />
        <h6 class="text-uppercase small fw-bold text-muted mb-3">iBITS Digital ID</h6>
        <div id="qrcode" class="my-3 d-flex justify-content-center"></div>
        <div class="d-grid gap-2 mt-4">
            <button class="btn-action-outline" id="btnExpandQr"><i class="bi bi-arrows-fullscreen me-2"></i>Expand ID</button>
            <button class="btn-action-outline" id="btnDownloadQr"><i class="bi bi-download me-2"></i>Download ID</button>
            <button type="button" class="btn-action-dark mt-2" data-bs-toggle="modal" data-bs-target="#settingsModal">
                <i class="bi bi-gear-fill me-2"></i>Account Settings
            </button>
        </div>
    </div>
</div>

@* 3. EVENTS MODAL (Restored Full Layout) *@
<div class="modal fade" id="eventsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0">
                <h5 class="modal-title glass-header-title"><i class="bi bi-calendar-event me-2 text-warning"></i> Events</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <ul class="nav nav-tabs mb-4" id="eventTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="upcoming-tab" data-bs-toggle="tab" data-bs-target="#upcoming" type="button">Upcoming Events</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button">Event History</button>
                    </li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="upcoming" role="tabpanel">
                        <div id="upcomingEventsContent" class="row g-4"></div>
                    </div>
                    <div class="tab-pane fade" id="history" role="tabpanel">
                        <div id="eventHistoryContent" class="row g-4"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* 4. ACCOUNT SETTINGS MODAL (Custom Themed UI with Tabbed Layout) *@
<div class="modal fade" id="settingsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content glass-modal p-0" style="background: rgba(15, 15, 15, 0.98); border: 1px solid var(--gold-primary);">

            <div class="d-flex" style="min-height: 600px;">

                @* LEFT COLUMN: Navigation (Themed Menu) *@
                <div class="p-4 flex-shrink-0" style="width: 300px; background: rgba(0,0,0,0.25); border-right: 1px solid rgba(255,255,255,0.05);">
                    <div class="mb-5">
                        <h4 class="fw-bold text-white mb-1">Manage your account</h4>
                        <p class="text-muted small">Change your account settings</p>
                    </div>

                    <ul class="nav nav-pills flex-column" id="accountSettingsTabs" role="tablist">
                        <li class="nav-item mb-2" role="presentation">
                            <button class="nav-link active w-100 text-start" id="profile-tab" data-bs-toggle="pill" data-bs-target="#profile-pane" type="button" role="tab" aria-controls="profile-pane" aria-selected="true" style="background:none; color:white;">
                                <i class="bi bi-person-fill me-2"></i> Profile
                            </button>
                        </li>
                        <li class="nav-item mb-2" role="presentation">
                            <button class="nav-link w-100 text-start" id="email-tab" data-bs-toggle="pill" data-bs-target="#email-pane" type="button" role="tab" aria-controls="email-pane" aria-selected="false" style="background:none; color:white;">
                                <i class="bi bi-envelope-fill me-2"></i> Email
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link w-100 text-start" id="password-tab" data-bs-toggle="pill" data-bs-target="#password-pane" type="button" role="tab" aria-controls="password-pane" aria-selected="false" style="background:none; color:white;">
                                <i class="bi bi-lock-fill me-2"></i> Password
                            </button>
                        </li>
                    </ul>

                    <div class="small text-muted mt-5 opacity-50">
                        &copy; @DateTime.Now.Year - iBITS Portal - <a href="#" class="text-muted">Privacy</a>
                    </div>
                </div>

                @* RIGHT COLUMN: Content Area (Tab Content) *@
                <div class="p-5 flex-grow-1 text-white">
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 mt-3 me-3" data-bs-dismiss="modal" style="z-index:10;"></button>

                    <div class="tab-content" id="accountSettingsTabContent">

                        @* TAB 1: PROFILE *@
                        <div class="tab-pane fade show active" id="profile-pane" role="tabpanel" aria-labelledby="profile-tab">
                            <h4 class="fw-bold mb-4">Manage Profile</h4>

                            <form id="ajaxProfileForm" class="row" enctype="multipart/form-data">
                                @* ADD enctype for file upload *@
                                @Html.AntiForgeryToken()
                                <div id="profileAlert" class="alert d-none small col-12"></div>

                                <div class="col-md-5 text-center mb-4">
                                    <label for="profilePictureInput" style="cursor: pointer;">
                                        @* LINK LABEL TO INPUT *@
                                        <img src="@(student?.StudentImage ?? "/images/default-avatar.png")"
                                             class="rounded-circle border border-warning p-1 mb-2"
                                             style="width: 150px; height: 150px; object-fit: cover;" id="profilePicturePreview">
                                        <p class="small text-muted">Click image to change</p>
                                    </label>
                                    <input type="file" id="profilePictureInput" name="ProfilePicture" class="d-none" accept=".jpg,.jpeg,.png"> @* HIDE ORIGINAL INPUT *@
                                </div>
                                <div class="col-md-7">
                                    <div class="mb-3 p-3 rounded" style="background: rgba(255,255,255,0.05);">
                                        <label class="modal-label">Username</label>
                                        <p class="fw-bold mb-0">@student?.StudentNum</p>
                                    </div>
                                    <div class="mb-3 p-3 rounded" style="background: rgba(255,255,255,0.05);">
                                        <label class="modal-label">Full Name</label>
                                        <p class="fw-bold mb-0">@student?.StudentFn @student?.StudentLn</p>
                                    </div>
                                    <div class="mb-3 p-3 rounded" style="background: rgba(255,255,255,0.05);">
                                        <label class="modal-label">Course</label>
                                        <p class="fw-bold mb-0">@student?.Course | @student?.YearLevelSection</p>
                                    </div>
                                    <button type="submit" class="btn btn-gold w-100 mt-2" id="btnUpdateProfile">Save Profile Changes</button>
                                </div>
                            </form>
                        </div>

                        @* TAB 2: EMAIL *@
                        <div class="tab-pane fade" id="email-pane" role="tabpanel" aria-labelledby="email-tab">
                            <h4 class="fw-bold mb-4">Manage Email</h4>

                            <form id="ajaxEmailForm">
                                @Html.AntiForgeryToken()

                                <div id="emailAlert" class="alert d-none small"></div>

                                <div class="mb-3">
                                    <label class="modal-label text-gold">Current Email</label>
                                    <input type="email"
                                           id="currentStudentEmail"
                                           value="@(student?.StudentEmail)"
                                           class="form-control bg-dark text-white border-secondary"
                                           readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="modal-label text-gold">New Email</label>
                                    <input type="email"
                                           name="NewEmail"
                                           class="form-control bg-dark text-white border-secondary"
                                           required />
                                </div>

                                <button type="submit"
                                        class="btn btn-gold mt-3"
                                        id="btnUpdateEmail">
                                    Save Changes
                                </button>
                            </form>
                        </div>

                        @* TAB 3: PASSWORD *@
                        <div class="tab-pane fade" id="password-pane" role="tabpanel" aria-labelledby="password-tab">
                            <h4 class="fw-bold mb-4">Manage Password</h4>
                            <form id="ajaxPasswordForm">
                                @Html.AntiForgeryToken()
                                <div id="passwordAlert" class="alert d-none small"></div>

                                <div class="mb-3">
                                    <label class="modal-label" style="color:var(--gold-primary);">Current Password</label>
                                    <input type="password" name="OldPassword" class="form-control bg-dark text-white border-secondary" placeholder="Enter current password" required>
                                </div>
                                <div class="mb-3">
                                    <label class="modal-label" style="color:var(--gold-primary);">New Password</label>
                                    <input type="password" name="NewPassword" class="form-control bg-dark text-white border-secondary" placeholder="Minimum 6 characters" required>
                                </div>
                                <div class="mb-3">
                                    <label class="modal-label" style="color:var(--gold-primary);">Confirm New Password</label>
                                    <input type="password" name="ConfirmPassword" class="form-control bg-dark text-white border-secondary" placeholder="Repeat new password" required>
                                </div>
                                <button type="submit" class="btn btn-gold mt-3" id="btnUpdatePass">Update Password</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* 5. VISUALLY APPEALING CONFIRMATION MODAL *@
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content glass-modal" style="background: rgba(20, 20, 20, 0.98); border: 1px solid #ffc107; backdrop-filter: blur(15px);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Changes</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-white text-center">
                <p class="mb-3">Are you sure you want to proceed with these changes?</p>
                <p class="small text-muted">This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary flex-fill" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning flex-fill" id="confirmActionButton">Yes, Save Changes</button>
            </div>
        </div>
    </div>
</div>


<input type="hidden" id="hiddenStudentId" value="@student?.StudentNum" />
@if (nextEvent != null && nextEvent.EventDate.HasValue)
{
    <input type="hidden" id="eventDate" value="@nextEvent.EventDate.Value.ToString("yyyy-MM-dd")" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="~/js/student-dashboard.js" asp-append-version="true"></script>
    <script>
        function loadAllEvents() { loadUpcomingEvents(); loadEventHistory(); }

        function loadUpcomingEvents() {
            const container = document.getElementById('upcomingEventsContent');
            fetch('/Student/GetAllEventsJson').then(r => r.json()).then(data => {
                container.innerHTML = '';
                const today = new Date(); today.setHours(0,0,0,0);
                const upcoming = data.filter(i => new Date(i.eventDate) >= today && !i.isClosed);
                if (upcoming.length > 0) upcoming.forEach(i => container.innerHTML += renderEventCard(i, false));
                else container.innerHTML = '<div class="col-12 text-center py-5 text-muted">No upcoming events.</div>';
            });
        }

        function loadEventHistory() {
            const container = document.getElementById('eventHistoryContent');
            fetch('/Student/GetAllEventsJson').then(r => r.json()).then(data => {
                container.innerHTML = '';
                const today = new Date(); today.setHours(0,0,0,0);
                const past = data.filter(i => new Date(i.eventDate) < today || i.isClosed).sort((a, b) => new Date(b.eventDate) - new Date(a.eventDate));
                if (past.length > 0) past.forEach(i => container.innerHTML += renderEventCard(i, true));
                else container.innerHTML = '<div class="col-12 text-center py-5 text-muted">No event history.</div>';
            });
        }

        // RESTORED: Professional Event Card Layout
        function renderEventCard(item, isPastEvent) {
            const eventDate = new Date(item.eventDate);
            let statusClass = isPastEvent ? (item.isClosed ? "bg-dark" : "bg-secondary") : "badge-upcoming";
            let statusText = isPastEvent ? (item.isClosed ? "Closed" : "Completed") : "Upcoming";

            return `
            <div class="col-md-6 col-lg-4">
                <div class="glass-card h-100" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius:12px; overflow:hidden;">
                    <div class="event-img-placeholder text-center py-4 position-relative" style="background: rgba(0,0,0,0.2);">
                        <span class="status-badge ${statusClass}" style="position:absolute; top:10px; right:10px; padding: 4px 10px; border-radius:4px; color:white; font-size:0.75rem; font-weight:bold;">${statusText}</span>
                        <i class="bi bi-calendar-week" style="font-size: 3rem; color: #D4AF37;"></i>
                    </div>
                    <div class="event-body p-4">
                        <div class="event-date text-gold small fw-bold mb-1 text-uppercase">
                            ${eventDate.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'})}
                        </div>
                        <div class="event-title fw-bold text-white mb-2" style="font-size: 1.1rem;">${item.eventName}</div>
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <i class="bi bi-geo-alt-fill text-warning"></i> ${item.eventLocation || 'TBA'}
                        </div>
                    </div>
                </div>
            </div>`;
        }

        // Universal function to handle the AJAX result and update the UI
        function handleAjaxResult(formId, alertId, btnId, res) {
            const btn = document.getElementById(btnId);
            const alertDiv = document.getElementById(alertId);

            // Revert button immediately
            const originalText = btn.getAttribute('data-original-text');
            btn.innerHTML = originalText;
            btn.disabled = false;


            alertDiv.classList.remove('d-none', 'alert-success', 'alert-danger');

            if (res.success) {
                alertDiv.innerHTML = res.message;
                alertDiv.classList.add('alert-success');

                // --- INSTANT UI UPDATE LOGIC ---
                if (res.imagePath) {
                    const uniqueUrl = res.imagePath + '?t=' + new Date().getTime();
                    document.getElementById('profilePicturePreview').src = uniqueUrl;
                    document.querySelector('.profile-pic-wrapper img').src = uniqueUrl;
                    document.querySelector('.profile-icon-img').src = uniqueUrl;
                }

                // CRITICAL FIX: Update Email Display
                        if (formId === 'ajaxEmailForm') {
            const newEmailInput = document.getElementById('ajaxEmailForm').querySelector('input[name="NewEmail"]');
            // CRITICAL CHANGE: Update ID here
            const currentEmailDisplay = document.getElementById('currentStudentEmail');

            if (newEmailInput && currentEmailDisplay) {
                currentEmailDisplay.value = newEmailInput.value;
            }
        }
                // --- END INSTANT UI UPDATE LOGIC ---

                // Only clear fields that should be cleared (password and new email)
                if (formId === 'ajaxPasswordForm' || formId === 'ajaxEmailForm') {
                     document.getElementById(formId).reset();
                }

            } else {
                alertDiv.innerHTML = res.message;
                alertDiv.classList.add('alert-danger');
            }
        }

        // Core AJAX Submission Handler
        function submitFormAjax(formId, url, btnId, alertId, isFileUpload) {
            const form = document.getElementById(formId);
            const btn = document.getElementById(btnId);
            const alertDiv = document.getElementById(alertId);

            // Set original text on the button once (for handleAjaxResult to read it later)
            if(!btn.hasAttribute('data-original-text')) {
                 btn.setAttribute('data-original-text', btn.textContent.trim()); // Use textContent.trim()
            }

            const formData = isFileUpload ? new FormData(form) : new URLSearchParams(new FormData(form));

            // Set loading state: Show spinner only while fetching
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>Saving...`; // Use simpler saving text
            alertDiv.classList.add('d-none');

            const headers = {};
            if (!isFileUpload) {
                const token = new FormData(form).get('__RequestVerificationToken');
                headers['RequestVerificationToken'] = token;
            }

            fetch(url, {
                method: 'POST',
                headers: isFileUpload ? {} : headers,
                body: formData
            })
            .then(r => r.json())
            .then(res => { handleAjaxResult(formId, alertId, btnId, res); })
            .catch(err => {
                // CRITICAL FIX: Ensure button is re-enabled on network/server error
                handleAjaxResult(formId, alertId, btnId, { success: false, message: "A network or server error occurred. Please check the Console (F12)." });
                console.error(err);
            });
        }

        // Universal function to trigger the custom confirmation modal
        function confirmAndSubmit(e, formId, url, btnId, alertId, isFileUpload = false) {
            e.preventDefault();

            const form = document.getElementById(formId);

            // CRITICAL FIX: Block confirmation modal if browser validation fails
            if (!form.checkValidity()) {
                form.reportValidity(); // Display the "Please fill out this field" tooltips
                return;
            }

            // Store form data to be executed on confirmation
            const confirmButton = document.getElementById('confirmActionButton');

            // Set the onclick logic to submit the form
            confirmButton.onclick = () => {
                // 1. Manually close the confirmation modal
                const confirmModalInstance = bootstrap.Modal.getInstance(document.getElementById('confirmModal'));
                confirmModalInstance.hide();

                // 2. Execute the actual submission
                submitFormAjax(formId, url, btnId, alertId, isFileUpload);
            };

            // Display the visually appealing modal
            const confirmModal = new bootstrap.Modal(document.getElementById('confirmModal'));
            confirmModal.show();
        }

        document.addEventListener('DOMContentLoaded', function () {

            // --- UI/TAB LOGIC FIX: Ensures the correct tab is highlighted ---
            var accountSettingsModal = document.getElementById('settingsModal');
            if(accountSettingsModal) {
                // Set initial active button styling on modal show
                accountSettingsModal.addEventListener('shown.bs.modal', function () {
                    const activeTabButton = document.querySelector('#accountSettingsTabs .nav-link.active');
                    if(activeTabButton) {
                        activeTabButton.style.background = 'var(--gold-primary)';
                        activeTabButton.style.color = 'black';
                    }
                });

                // Add event listener to handle subsequent tab clicks
                document.getElementById('accountSettingsTabs').addEventListener('click', function(e) {
                    if(e.target.classList.contains('nav-link')) {
                        // Reset all tabs
                        document.querySelectorAll('#accountSettingsTabs .nav-link').forEach(link => {
                            link.style.background = 'none';
                            link.style.color = 'white';
                        });
                        // Set active tab
                        e.target.style.background = 'var(--gold-primary)';
                        e.target.style.color = 'black';
                    }
                });
            }
            // --- END UI/TAB LOGIC FIX ---


            // --- IMAGE PREVIEW LOGIC (Profile Tab) ---
            const profilePictureInput = document.getElementById('profilePictureInput');
            const profilePicturePreview = document.getElementById('profilePicturePreview');
            if (profilePictureInput && profilePicturePreview) {
                profilePictureInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        profilePicturePreview.src = URL.createObjectURL(file);
                    }
                });
            }


            // --- PROFILE FORM SUBMISSION ---
            const profileForm = document.getElementById('ajaxProfileForm');
            if (profileForm) {
                profileForm.addEventListener('submit', function (e) {
                    confirmAndSubmit(e, 'ajaxProfileForm', '/Account/UpdateProfileAjax', 'btnUpdateProfile', 'profileAlert', true); // True for File Upload
                });
            }

            // --- EMAIL FORM SUBMISSION ---
            const emailForm = document.getElementById('ajaxEmailForm');
            if (emailForm) {
                emailForm.addEventListener('submit', function (e) {
                    confirmAndSubmit(e, 'ajaxEmailForm', '/Account/UpdateEmailAjax', 'btnUpdateEmail', 'emailAlert', false);
                });
            }

            // --- PASSWORD FORM SUBMISSION ---
            const passwordForm = document.getElementById('ajaxPasswordForm');
            if (passwordForm) {
                passwordForm.addEventListener('submit', function (e) {
                    confirmAndSubmit(e, 'ajaxPasswordForm', '/Account/ChangePasswordAjax', 'btnUpdatePass', 'passwordAlert', false);
                });
            }
        });

        // ============================================================
        // DISMISS ANNOUNCEMENT FUNCTIONALITY
        // ============================================================
        function dismissAnnouncement(announcementId, button) {
            if (!confirm('Are you sure you want to dismiss this announcement? You won\'t see it again.')) {
                return;
            }

            // Disable button to prevent double-clicks
            button.disabled = true;
            button.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Dismissing...';

            // Get CSRF token
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/Home/DismissAnnouncement', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${announcementId}&__RequestVerificationToken=${encodeURIComponent(token)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Close modal if open
                    const modal = bootstrap.Modal.getInstance(document.getElementById('modal' + announcementId));
                    if (modal) {
                        modal.hide();
                    }

                    // Remove announcement from DOM with fade effect
                    const announcementElement = document.getElementById('announcement-' + announcementId);
                    if (announcementElement) {
                        announcementElement.style.transition = 'opacity 0.3s ease';
                        announcementElement.style.opacity = '0';
                        setTimeout(() => {
                            announcementElement.remove();
                            
                            // Check if no announcements left
                            const announcementsContainer = document.querySelector('.announcement-scroll-container');
                            if (announcementsContainer && announcementsContainer.children.length === 0) {
                                announcementsContainer.innerHTML = '<div class="text-center py-4 text-muted"><i class="bi bi-inbox display-4"></i><p class="mt-2">No announcements</p></div>';
                            }
                        }, 300);
                    }

                    // Show success message
                    const alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3';
                    alertDiv.style.zIndex = '9999';
                    alertDiv.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>Announcement dismissed successfully<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
                    document.body.appendChild(alertDiv);
                    setTimeout(() => alertDiv.remove(), 3000);
                } else {
                    alert('Error dismissing announcement: ' + data.message);
                    button.disabled = false;
                    button.innerHTML = '<i class="bi bi-eye-slash me-1"></i> Dismiss This Reminder';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred. Please try again.');
                button.disabled = false;
                button.innerHTML = '<i class="bi bi-eye-slash me-1"></i> Dismiss This Reminder';
            });
        }
    </script>
}


