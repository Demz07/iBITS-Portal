<div id="portalToastContainer"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="~/js/student-dashboard.js" asp-append-version="true"></script>
    <script>
        function saveBirthdate() {
            const input = document.getElementById('studentBirthdateInput');
            const alert = document.getElementById('birthdateAlert');
            const val = input?.value;
            if (!val) { alert.className = 'alert alert-warning small mt-2'; alert.textContent = 'Please select a valid date.'; return; }
            alert.className = 'alert alert-info small mt-2'; alert.textContent = 'Saving...';
            $.post('@Url.Action("UpdateBirthdate", "Student")', { birthday: val }, function(res) {
                if (res.success) { alert.className = 'alert alert-success small mt-2'; alert.textContent = 'Birthdate saved successfully!'; }
                else { alert.className = 'alert alert-danger small mt-2'; alert.textContent = res.message || 'Failed to save.'; }
            }).fail(function() { alert.className = 'alert alert-danger small mt-2'; alert.textContent = 'Server error. Try again.'; });
        }
        function loadAllEvents() { loadUpcomingEvents(); loadEventHistory(); }
        function loadUpcomingEvents() {
            const container = document.getElementById('upcomingEventsContent');
            if(!container) return;
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-warning"></div></div>';
            fetch('/Home/GetAllEventsJson').then(r=>r.json()).then(data=>{
                container.innerHTML = '';
                const events = data.upcoming || [];
                if(events.length > 0) events.forEach(item => container.innerHTML += renderEventCard(item, false));
                else container.innerHTML = '<div class="text-center text-muted py-4">No events.</div>';
            });
        }
        function loadEventHistory() {
            const container = document.getElementById('eventHistoryContent');
            if(!container) return;
            container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-warning"></div></div>';
            fetch('/Home/GetAllEventsJson').then(r=>r.json()).then(data=>{
                container.innerHTML = '';
                const events = data.history || [];
                if(events.length > 0) events.forEach(item => container.innerHTML += renderEventCard(item, true));
                else container.innerHTML = '<div class="text-center text-muted py-4">No history.</div>';
            });
        }
        function renderEventCard(item, isPastEvent) {
            const eventDate = new Date(item.eventDate);
            let statusClass = isPastEvent ? (item.isClosed ? "bg-dark" : "bg-secondary") : "badge-upcoming";
            let statusText = isPastEvent ? (item.isClosed ? "Closed" : "Completed") : "Upcoming";
            return `<div class="col-md-6 col-lg-4"><div class="glass-card h-100" style="background: var(--card-bg-subtle); border: 1px solid var(--border-color); border-radius:12px; overflow:hidden;"><div class="event-img-placeholder text-center py-4 position-relative" style="background: var(--gold-dim);"><span class="status-badge ${statusClass}" style="position:absolute; top:10px; right:10px; padding: 4px 10px; border-radius:4px; color:white; font-size:0.75rem; font-weight:bold;">${statusText}</span><i class="bi bi-calendar-week" style="font-size: 3rem; color: #D4AF37;"></i></div><div class="event-body p-4"><div class="event-date text-gold small fw-bold mb-1 text-uppercase">${eventDate.toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' })}</div><div class="event-title fw-bold text-strong mb-2" style="font-size: 1.1rem;">${item.eventName}</div><div class="d-flex align-items-center gap-2 text-main small"><i class="bi bi-geo-alt-fill text-warning"></i> ${item.eventLocation || 'TBA'}</div></div></div></div>`;
        }
        function showPortalToast(type, title, msg) {
            const container = document.getElementById('portalToastContainer');
            const toast = document.createElement('div');
            toast.className = `portal-toast ${type}`;
            toast.innerHTML = `<div><p class="title">${title}</p><p class="msg">${msg}</p></div><button class="close-btn">&times;</button>`;
            toast.querySelector('.close-btn').onclick = () => toast.remove();
            container.appendChild(toast);
            setTimeout(() => { if(toast.parentNode) toast.remove(); }, 3000);
        }
        // Simplified flash check to avoid Razor syntax errors
        const flashMsg = '@(TempData["Message"]?.ToString() ?? "")';
        if(flashMsg !== '') showPortalToast('success', 'Success', flashMsg);

        // Admin Notice Handlers
        let pendingAdminDismiss = { id: null };
        function openAdminNoticeModal(id, subject, message, date, sender) {
            document.getElementById('viewNoticeSubject').innerText = subject;
            document.getElementById('viewNoticeMessage').innerText = message;
            document.getElementById('viewNoticeDate').innerText = date;
            document.getElementById('viewNoticeSender').innerText = 'Sent by: ' + sender;
            pendingAdminDismiss.id = id;
            new bootstrap.Modal(document.getElementById('adminNoticeModal')).show();
        }

        function openAdminDismissConfirm() {
            // Hide the notice modal first
            const noticeModal = bootstrap.Modal.getInstance(document.getElementById('adminNoticeModal'));
            if(noticeModal) noticeModal.hide();
            new bootstrap.Modal(document.getElementById('adminDismissConfirmModal')).show();
        }

        document.getElementById('confirmAdminDismissBtn').onclick = function() {
            const id = pendingAdminDismiss.id;
            const modal = bootstrap.Modal.getInstance(document.getElementById('adminDismissConfirmModal'));
            modal.hide();
            
            fetch('/Home/DismissNotification', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: `id=${id}`
            }).then(r=>r.json()).then(data=>{
                if(data.success) {
                    location.reload(); // Reload to clear the notice from the list
                }
            });
        };

        let pendingDismiss = { id: null, button: null };
        function dismissAnnouncement(id, btn) {
            pendingDismiss = { id, button: btn };
            new bootstrap.Modal(document.getElementById('dismissConfirmModal')).show();
        }
        document.getElementById('confirmDismissBtn').onclick = function() {
            const id = pendingDismiss.id;
            const btn = pendingDismiss.button;
            const modal = bootstrap.Modal.getInstance(document.getElementById('dismissConfirmModal'));
            modal.hide();
            fetch('/Home/DismissAnnouncement', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: `id=${id}`
            }).then(r=>r.json()).then(data=>{
                if(data.success) {
                    const row = document.getElementById('announcement-'+id);
                    if(row) row.remove();
                    showPortalToast('success', 'Dismissed', 'Announcement removed.');
                }
            });
        };
    </script>
}
