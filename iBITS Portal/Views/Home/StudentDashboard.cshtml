@* ============================================================ *@
@* FILE PATH: Views/Home/StudentDashboard.cshtml                *@
@* ============================================================ *@
@using iBITS_Portal.Models
@{
    ViewData["Title"] = "Command Center";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var student = ViewBag.Student as Student;

    // Expect these from the controller
    var currentEvents = ViewBag.CurrentEvents as List<Event> ?? new List<Event>();
    var upcomingEvents = ViewBag.UpcomingEvents as List<Event> ?? new List<Event>();
    var announcements = ViewBag.Announcements as List<Announcement> ?? new List<Announcement>();

    // Split announcements
    var paymentReminders = announcements.Where(a => (a.Title ?? string.Empty).Contains("Payment Reminder")).ToList();
    var regularAnnouncements = announcements.Where(a =>
      !(a.Title ?? string.Empty).Contains("Payment Reminder") &&
      a.AnnouncementType != "Admin Notice"
  ).ToList();

    var adminNotices = ViewBag.AdminNotices as List<Notification> ?? new List<Notification>();

    // CURRENT ACTIVITY
    var today = DateOnly.FromDateTime(PhTime.Today);
    bool showCurrentActivity = currentEvents.Any();

    // Upcoming (sidebar)
    var upcomingEventsDisplay = upcomingEvents
        .Where(e => (!e.EventDate.HasValue || e.EventDate.Value >= today) && !e.IsClosed)
        .OrderBy(e => e.EventDate ?? DateOnly.MaxValue)
        .ToList();

    // Role badge
    string displayRole = "Member";
    string badgeClass = "badge-role-member";
    string badgeIcon = "bi-person-fill";

    if (User.IsInRole("Admin")) { displayRole = "System Admin"; badgeClass = "badge-role-admin"; badgeIcon = "bi-shield-lock-fill"; }
    else if (User.IsInRole("Org Treasurer")) { displayRole = "Org Treasurer"; badgeClass = "badge-role-orgtreasurer"; badgeIcon = "bi-bank2"; }
    else if (User.IsInRole("Class Treasurer")) { displayRole = "Class Treasurer"; badgeClass = "badge-role-classtreasurer"; badgeIcon = "bi-wallet2"; }
    else if (User.IsInRole("Org Secretary")) { displayRole = "Org Secretary"; badgeClass = "badge-role-orgsecretary"; badgeIcon = "bi-pen-fill"; }
    else if (User.IsInRole("Class Secretary")) { displayRole = "Class Secretary"; badgeClass = "badge-role-classsecretary"; badgeIcon = "bi-journal-check"; }
    else if (User.IsInRole("Officer")) { displayRole = "Officer"; badgeClass = "badge-role-officer"; badgeIcon = "bi-star-fill"; }
}

@section Styles {
    <link rel="stylesheet" href="~/css/student-dashboard.css" asp-append-version="true" />
    <style>
        /* SETTINGS MODAL SIDEBAR TABS */
        #accountSettingsTabs .nav-link {
            color: var(--text-main);
            border-radius: 6px;
            padding: 12px 16px;
            transition: all 0.2s ease;
            font-weight: 500;
            display: flex;
            align-items: center;
        }

            #accountSettingsTabs .nav-link:hover {
                background: var(--gold-dim);
                color: var(--gold-primary);
            }

            /* The Active State (Gold Background, Black Text) */
            #accountSettingsTabs .nav-link.active {
                background-color: var(--gold-primary) !important;
                color: var(--text-inverse) !important;
                font-weight: 700;
                box-shadow: 0 4px 15px rgba(212, 175, 55, 0.2);
            }

        .settings-sidebar-wrap {
            width: 300px;
        }

        /* ACCOUNT SETTINGS MODAL RESPONSIVENESS */
        @@media (max-width: 992px) {
            #settingsModal .modal-dialog {
                margin: 10px;
                max-width: calc(100% - 20px);
            }

            #settingsModal .d-flex {
                flex-direction: column !important;
                min-height: auto !important;
            }

            #settingsModal .flex-shrink-0 {
                width: 100% !important;
                border-right: none !important;
                border-bottom: 1px solid var(--border-color) !important;
                padding: 20px !important;
            }

            #settingsModal .flex-grow-1 {
                padding: 25px 20px !important;
            }

            #accountSettingsTabs {
                flex-direction: row !important;
                overflow-x: auto;
                flex-wrap: nowrap !important;
                gap: 8px !important;
                padding-bottom: 10px;
                scrollbar-width: none; /* Hide scrollbar for clean look */
            }

            #accountSettingsTabs::-webkit-scrollbar {
                display: none;
            }

            #accountSettingsTabs .nav-item {
                flex: 0 0 auto;
                margin-bottom: 0 !important;
            }

            #accountSettingsTabs .nav-link {
                white-space: nowrap;
                padding: 10px 15px;
                font-size: 0.85rem;
                justify-content: center;
            }

            #accountSettingsTabs .nav-link i {
                margin-right: 8px !important;
            }

            .modal-content.glass-modal {
                border-radius: 20px;
            }
            
            #ajaxProfileForm .col-md-5 {
                margin-bottom: 20px;
            }
            
            #profilePicturePreview {
                width: 120px !important;
                height: 120px !important;
            }
        }

        @@media (max-width: 480px) {
            #settingsModal .flex-grow-1 {
                padding: 20px 15px !important;
            }
            
            #settingsModal h4 {
                font-size: 1.2rem;
            }
            
            .modal-label {
                font-size: 0.75rem;
            }
            
            #settingsModal .form-control {
                height: 45px;
                font-size: 0.9rem;
            }
        }

        /* Fix for Modal Stacking */
        .modal-header .btn-close {
            z-index: 10001 !important;
            position: relative;
            opacity: 1;
        }

        .modal {
            z-index: 1050 !important;
        }

        .modal-backdrop {
            z-index: 1040 !important;
        }

        /* Custom Colors & Borders */
        .text-orange {
            color: #fd7e14 !important;
        }

        .border-start-orange {
            border-left: 4px solid #fd7e14 !important;
        }

        .border-start-danger {
            border-left: 4px solid #dc3545 !important;
        }

        .border-start-warning {
            border-left: 4px solid #ffc107 !important;
        }

        .border-start-info {
            border-left: 4px solid #0dcaf0 !important;
        }

        /* Layout Styles */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .welcome-message {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn-my-profile {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            color: var(--text-main);
            text-decoration: none;
            transition: color 0.2s;
            flex-shrink: 0;
        }

            .btn-my-profile:hover {
                color: var(--gold-primary);
            }

            .btn-my-profile .profile-icon-img {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                object-fit: cover;
                border: 1px solid var(--border-color);
            }

        .announcement-scroll-container {
            max-height: 350px;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 8px;
        }

            .announcement-scroll-container::-webkit-scrollbar {
                width: 5px;
            }

            .announcement-scroll-container::-webkit-scrollbar-thumb {
                background: var(--gold-primary);
                border-radius: 10px;
            }

        .offcanvas.glass-modal {
            background: var(--bg-glass) !important;
            backdrop-filter: blur(25px) !important;
            border-left: 1px solid var(--border-color) !important;
        }

        .profile-pic-wrapper img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 3px solid var(--gold-primary);
            object-fit: cover;
        }

        #eventTabs .nav-link {
            color: var(--text-main);
            background: var(--gold-dim);
            border: 1px solid var(--border-color);
            margin-right: 5px;
        }

            #eventTabs .nav-link.active {
                background: var(--gold-primary);
                border-color: var(--gold-primary);
                color: var(--text-inverse);
            }

        /* UPCOMING EVENTS (SIDEBAR) */
        .upcoming-events-wrap {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .upcoming-event-card {
            display: flex;
            gap: 12px;
            padding: 14px 14px;
            border-radius: 14px;
            background: var(--card-bg-subtle, rgba(255, 255, 255, 0.06));
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-soft);
            transition: transform .18s ease, border-color .18s ease, background .18s ease;
        }

            .upcoming-event-card:hover {
                transform: translateY(-2px);
                background: var(--gold-dim);
                border-color: var(--gold-primary);
            }

        .ue-date-badge {
            width: 56px;
            flex-shrink: 0;
            border-radius: 14px;
            background: var(--bg-body);
            border: 1px solid var(--gold-primary);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 8px 6px;
        }

            .ue-date-badge .month {
                font-size: 0.65rem;
                font-weight: 900;
                letter-spacing: 1px;
                color: var(--gold-primary);
                text-transform: uppercase;
                opacity: 0.95;
            }

            .ue-date-badge .day {
                font-size: 1.35rem;
                font-weight: 900;
                line-height: 1.0;
                color: var(--text-strong);
                margin-top: 3px;
            }

        .ue-content {
            min-width: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .ue-title {
            font-weight: 800;
            color: var(--text-strong);
            font-size: 0.95rem;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .ue-meta {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 0.78rem;
            color: var(--text-main);
        }

            .ue-meta i {
                color: var(--gold-primary);
            }

        .ue-sub {
            font-size: 0.72rem;
            margin-top: 4px;
            color: var(--text-main);
            opacity: 0.8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* THEMED TOAST / ALERT */
        #portalToastContainer {
            position: fixed;
            top: 18px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 99999;
            width: min(520px, calc(100% - 24px));
            pointer-events: none;
        }

        .portal-toast {
            pointer-events: auto;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 14px;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            background: var(--bg-glass);
            border: 1px solid var(--gold-primary);
            box-shadow: var(--shadow-soft);
            color: var(--text-strong);
            animation: portalToastIn 0.25s ease both;
        }

            .portal-toast.success {
                border-color: rgba(25, 135, 84, 0.55);
            }

            .portal-toast.danger {
                border-color: rgba(220, 53, 69, 0.55);
            }

            .portal-toast.warning {
                border-color: rgba(255, 193, 7, 0.65);
            }

            .portal-toast .icon {
                font-size: 1.25rem;
                line-height: 1;
                margin-top: 1px;
                color: var(--gold-primary);
            }

            .portal-toast.success .icon {
                color: #28a745;
            }

            .portal-toast.danger .icon {
                color: #dc3545;
            }

            .portal-toast.warning .icon {
                color: #ffc107;
            }

            .portal-toast .title {
                font-weight: 800;
                margin: 0;
                font-size: 0.95rem;
            }

            .portal-toast .msg {
                margin: 2px 0 0 0;
                opacity: 0.9;
                font-size: 0.85rem;
            }

            .portal-toast .close-btn {
                margin-left: auto;
                background: transparent;
                border: none;
                color: rgba(255,255,255,0.75);
                padding: 2px 6px;
                font-size: 1rem;
                line-height: 1;
                cursor: pointer;
            }

        @@keyframes portalToastIn {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* ✅ Make Current Activity scroll inside the card body */
        .current-activity-scroll {
            max-height: 360px;
            overflow-y: auto;
            padding-right: 4px;
        }

            .current-activity-scroll::-webkit-scrollbar {
                width: 6px;
            }

            .current-activity-scroll::-webkit-scrollbar-thumb {
                background: rgba(212,175,55,0.6);
                border-radius: 6px;
            }
    </style>
}

<div class="page-header">
    <div class="welcome-message">
        <h2 class="fw-bold text-strong mb-0">Hello, @(student?.StudentFn)! 👋</h2>
        <span class="role-badge @badgeClass"><i class="bi @badgeIcon"></i> @displayRole</span>
    </div>
    <a href="#profileOffcanvas" data-bs-toggle="offcanvas" class="btn-my-profile">
        <img id="headerMyProfileImg"
             src="@(string.IsNullOrEmpty(student?.StudentImage) ? Url.Content("~/images/default-avatar.png") : student.StudentImage)"
             alt="My Profile"
             class="profile-icon-img" />
        <span>My Profile</span>
    </a>
</div>

<p class="text-muted mb-4" style="margin-top:-1rem;">Welcome to your iBITS Account.</p>

<div class="row g-4">
    <!-- ANNOUNCEMENTS -->
    <div class="col-12">
        <div class="glass-card h-100">
            <h5 class="card-header"><i class="bi bi-megaphone-fill me-2 text-gold"></i> Announcements</h5>
            <div class="card-body announcement-scroll-container">
                @if (!announcements.Any() && !adminNotices.Any(x => !x.IsRead))
                {
                    <p class="text-muted text-center py-3">No announcements yet.</p>
                }

                @* --- START: ADMIN NOTICES (New Section) --- *@
                @foreach (var n in adminNotices.Where(x => !x.IsRead))
                {
                    <div class="announcement-item border-start-warning mb-3"
                         style="cursor: pointer; background: var(--gold-dim);"
                         onclick="openAdminNoticeModal('@n.NotificationId', '@n.Title', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(n.Message))', '@n.NotificationDate?.ToString("MMM dd, yyyy")', '@n.SentBy')">

                        @* Added '?' after NotificationDate below *@
                        <small class="text-gold">@n.NotificationDate?.ToString("MMM dd") • Official Notice</small>

                        <p class="mb-0 mt-1 text-strong">
                            <strong>@n.Title</strong> @* This displays the SUBJECT *@
                        </p>
                        <small class="text-muted" style="font-size: 0.7rem;">Click to read full message</small>
                    </div>
                }

                @foreach (var reminder in paymentReminders)
                {
                    string colorClass = "text-warning";
                    string borderClass = "border-start-warning";

                    if (reminder.AnnouncementType == "Urgent Notice") { colorClass = "text-danger"; borderClass = "border-start-danger"; }
                    else if (reminder.AnnouncementType == "Final Notice") { colorClass = "text-orange"; borderClass = "border-start-orange"; }
                    else if (reminder.AnnouncementType == "New Fee Posted") { colorClass = "text-info"; borderClass = "border-start-info"; }

                    <div class="announcement-item @borderClass mb-3"
                         id="announcement-@reminder.Id"
                         style="cursor: pointer;"
                         data-bs-toggle="modal"
                         data-bs-target="#modal@(reminder.Id)">
                        <small class="@colorClass">@reminder.Timestamp.ToString("MMM dd") • @(reminder.AnnouncementType ?? "Payment Reminder")</small>
                        <p class="mb-0 mt-1 text-strong">
                            <strong>@((reminder.Title ?? string.Empty).Replace("Payment Reminder: ", ""))</strong>
                        </p>
                        <small class="text-muted" style="font-size: 0.7rem;">Click to read full message</small>
                    </div>
                }

                @foreach (var announcement in regularAnnouncements)
                {
                    <div class="announcement-item" id="announcement-@announcement.Id">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <small class="text-gold">@announcement.Timestamp.ToString("MMM dd") · Posted by @announcement.PostedBy</small>
                                <p class="mb-0 mt-1 text-strong">@announcement.Content</p>
                            </div>
                            <button class="btn btn-sm btn-link text-muted p-0 ms-2"
                                    onclick="dismissAnnouncement(@announcement.Id, this)"
                                    title="Dismiss this announcement">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- CURRENT ACTIVITY (All of today's open events, scrollable) -->
    <div class="col-lg-7">
        <div class="glass-card h-100">
            <h5 class="card-header">
                <i class="bi bi-activity me-2 text-warning"></i> Current Activity
            </h5>

            <div class="card-body">
                @if (showCurrentActivity)
                {
                    <div class="current-activity-scroll">
                        @foreach (var currentEvent in currentEvents)
                        {
                            var startTimeIso = currentEvent.StartTime?.ToString(@"HH\:mm\:ss");
                            var endTimeIso = currentEvent.CalculatedEndTime?.ToString("yyyy-MM-ddTHH:mm:ss");
                            var eventDateIso = currentEvent.EventDate?.ToString("yyyy-MM-dd");
                            
                            <div class="mb-4 p-3 rounded current-event-card position-relative"
                                 data-event-id="@currentEvent.EventId"
                                 data-start-time="@startTimeIso"
                                 data-end-time="@endTimeIso"
                                 data-event-date="@eventDateIso"
                                 style="background: var(--card-bg-subtle, rgba(255,255,255,0.03)); border: 1px solid var(--border-color);">
                                
                                <!-- Dismiss Button (Hidden by default, shown when ended) -->
                                <button type="button" class="btn-close btn-close-white dismiss-event-btn" 
                                        onclick="dismissEventCard(this)"
                                        style="display: none; position: absolute; top: 10px; right: 10px; z-index: 10; width: 0.5em; height: 0.5em;" 
                                        aria-label="Close"></button>

                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h4 class="fw-bold text-strong mb-2">@currentEvent.EventName</h4>

                                        <div class="d-flex flex-wrap gap-3 small text-muted">
                                            <div class="event-loc-detail">
                                                <i class="bi bi-geo-alt-fill me-1 text-warning"></i>
                                                <span>@(string.IsNullOrWhiteSpace(currentEvent.EventLocation) ? "Location: TBA" : currentEvent.EventLocation)</span>
                                            </div>

                                            <div class="event-time-details d-flex gap-3">
                                                <div class="start-time-info">
                                                    <i class="bi bi-clock-fill me-1 text-info"></i>
                                                    <span class="text-info fw-bold">Starts: </span>
                                                    <span class="text-strong">@(currentEvent.StartTime?.ToString("h:mm tt") ?? "TBA")</span>
                                                </div>
                                                <div class="end-time-info">
                                                    <i class="bi bi-hourglass-bottom me-1 text-danger"></i>
                                                    <span class="text-danger fw-bold">Ends: </span>
                                                    <span class="text-strong">@(currentEvent.EndTime?.ToString("h:mm tt") ?? "TBA")</span>
                                                </div>
                                            </div>

                                            <div class="live-countdown-wrap" style="display: none;">
                                                <i class="bi bi-stopwatch me-1 text-gold"></i>
                                                <span class="countdown-label text-gold fw-bold">Ends in: </span>
                                                <span class="event-countdown-timer text-strong" id="timer-@currentEvent.EventId">Calculating...</span>
                                            </div>
                                        </div>
                                    </div>

                                    <span class="badge state-badge">CHECKING STATUS...</span>
                                </div>

                                <!-- EVENT DESCRIPTION -->
                                <div class="mt-3 p-3 rounded"
                                     style="background: var(--gold-dim); border: 1px solid var(--border-color);">
                                    <h6 class="fw-bold text-strong mb-2" style="opacity:0.9;">Event Description:</h6>
                                    <p class="mb-0 text-main small" style="white-space: pre-line;">
                                        @(string.IsNullOrWhiteSpace(currentEvent.EventDesc) ? "No description available." : currentEvent.EventDesc)
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1"></i>
                        <p class="mb-0">No current activity.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- UPCOMING LIST (Sidebar) -->
    <div class="col-lg-5">
        <div class="glass-card h-100 d-flex flex-column">
            <h5 class="card-header text-gold text-uppercase fw-bold">Upcoming Events</h5>
            <div class="card-body flex-grow-1">
                @if (upcomingEventsDisplay.Any())
                {
                    <div class="upcoming-events-wrap">
                        @foreach (var evt in upcomingEventsDisplay.Take(4))
                        {
                            <div class="upcoming-event-card">
                                <div class="ue-date-badge">
                                    <div class="month">@evt.EventDate?.ToString("MMM")</div>
                                    <div class="day">@evt.EventDate?.ToString("dd")</div>
                                </div>

                                <div class="ue-content">
                                    <div class="ue-title">@evt.EventName</div>
                                    <div class="ue-meta">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        <span>@(string.IsNullOrWhiteSpace(evt.EventLocation) ? "TBA" : evt.EventLocation)</span>
                                    </div>
                                    <div class="ue-sub">
                                        @(evt.EventDate.HasValue? evt.EventDate.Value.ToString("dddd • MMM dd, yyyy") : "Date: TBA")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center py-4 text-muted">No upcoming events.</p>
                }
            </div>
            <div class="card-footer border-0 bg-transparent pb-3">
                <button class="btn btn-gold w-100" data-bs-toggle="modal" data-bs-target="#eventsModal" onclick="loadAllEvents()">View All Events</button>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================= -->
<!--                 MODALS & SIDEBARS                       -->
<!-- ======================================================= -->
@* 1. PAYMENT REMINDER MODALS *@
@foreach (var reminder in paymentReminders)
{
    string titleColor = "text-gold";
    if (reminder.AnnouncementType == "Urgent Notice") { titleColor = "text-danger"; }
    else if (reminder.AnnouncementType == "Final Notice") { titleColor = "text-orange"; }
    else if (reminder.AnnouncementType == "New Fee Posted") { titleColor = "text-info"; }

    <div class="modal fade" id="modal@(reminder.Id)" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title @titleColor">@reminder.AnnouncementType</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-strong">
                    <h4 class="fw-bold mb-3">@((reminder.Title ?? string.Empty).Replace("Payment Reminder: ", ""))</h4>
                    <div style="white-space: pre-line; background: var(--gold-dim); padding: 15px; border-radius: 8px; border: 1px solid var(--border-color);">@reminder.Content</div>
                    <div class="mt-3 opacity-50 small text-end text-main">Posted by: @reminder.PostedBy</div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Close
                    </button>
                    <button type="button"
                            class="btn btn-outline-warning"
                            onclick="dismissAnnouncement(@reminder.Id, this)"
                            data-reminder-id="@reminder.Id">
                        <i class="bi bi-eye-slash me-1"></i> Dismiss This Reminder
                    </button>
