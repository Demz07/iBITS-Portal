@section Scripts {


    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="~/js/student-dashboard.js" asp-append-version="true"></script>

    <script>
        function loadAllEvents() { loadUpcomingEvents(); loadEventHistory(); }

        // ✅ FIXED: Fetch events correctly instead of checking profile images
        function loadUpcomingEvents() {
            const container = document.getElementById('upcomingEventsContent');
            if(!container) return;

            // Show loading spinner
            container.innerHTML = '<div class="col-12 text-center py-5"><div class="spinner-border text-warning" role="status"></div></div>';

            fetch('/Home/GetAllEventsJson')
                .then(r => r.json())
                .then(data => {
                    container.innerHTML = '';
                    // Check 'upcoming' property
                    const events = data.upcoming || [];

                    if (events.length > 0) {
                        let html = '';
                        events.forEach(item => {
                            // false = Render as upcoming style
                            html += renderEventCard(item, false);
                        });
                        container.innerHTML = html;
                    } else {
                        container.innerHTML = '<div class="col-12 text-center text-muted py-4">No upcoming events found.</div>';
                    }
                })
                .catch(error => {
                    console.error('Error loading events:', error);
                    container.innerHTML = '<div class="col-12 text-center text-danger py-4">Unable to load events.</div>';
                });
        }

        // ✅ FIXED: Fetch history correctly
        function loadEventHistory() {
            const container = document.getElementById('eventHistoryContent');
            if(!container) return;

            container.innerHTML = '<div class="col-12 text-center py-5"><div class="spinner-border text-warning" role="status"></div></div>';

            fetch('/Home/GetAllEventsJson')
                .then(r => r.json())
                .then(data => {
                    container.innerHTML = '';
                    // Check 'history' property
                    const events = data.history || [];

                    if (events.length > 0) {
                        let html = '';
                        events.forEach(item => {
                            // true = Render as history/completed style
                            html += renderEventCard(item, true);
                        });
                        container.innerHTML = html;
                    } else {
                        container.innerHTML = '<div class="col-12 text-center text-muted py-4">No event history found.</div>';
                    }
                })
                .catch(error => {
                    console.error('Error loading history:', error);
                    container.innerHTML = '<div class="col-12 text-center text-danger py-4">Unable to load history.</div>';
                });
        }

        // ✅ Helper to render the cards (uses your design)
        function renderEventCard(item, isPastEvent) {
            // Parse the date safely
            const eventDate = new Date(item.eventDate);

            let statusClass = isPastEvent ? (item.isClosed ? "bg-dark" : "bg-secondary") : "badge-upcoming";
            let statusText = isPastEvent ? (item.isClosed ? "Closed" : "Completed") : "Upcoming";

            return `
            <div class="col-md-6 col-lg-4">
                <div class="glass-card h-100" style="background: var(--card-bg-subtle, rgba(255,255,255,0.05)); border: 1px solid var(--border-color); border-radius:12px; overflow:hidden;">
                    <div class="event-img-placeholder text-center py-4 position-relative" style="background: var(--gold-dim);">
                        <span class="status-badge ${statusClass}" style="position:absolute; top:10px; right:10px; padding: 4px 10px; border-radius:4px; color:white; font-size:0.75rem; font-weight:bold;">${statusText}</span>
                        <i class="bi bi-calendar-week" style="font-size: 3rem; color: #D4AF37;"></i>
                    </div>
                    <div class="event-body p-4">
                        <div class="event-date text-gold small fw-bold mb-1 text-uppercase">
                            ${eventDate.toLocaleDateString('en-PH', { timeZone: 'Asia/Manila', month:'short', day:'numeric', year:'numeric' })}
                        </div>
                        <div class="event-title fw-bold text-strong mb-2" style="font-size: 1.1rem;">${item.eventName}</div>
                        <div class="d-flex align-items-center gap-2 text-main small">
                            <i class="bi bi-geo-alt-fill text-warning"></i> ${item.eventLocation || 'TBA'}
                        </div>
                    </div>
                </div>
            </div>`;
        }

        // TOAST
        function showPortalToast(type, title, message, timeout = 2800) {
            const container = document.getElementById('portalToastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `portal-toast ${type}`;
            const icon = type === 'success' ? 'bi-check-circle-fill' : type === 'danger' ? 'bi-x-circle-fill' : 'bi-exclamation-triangle-fill';

            toast.innerHTML = `
                <div class="icon"><i class="bi ${icon}"></i></div>
                <div><p class="title">${title}</p><p class="msg">${message}</p></div>
                <button class="close-btn" aria-label="Close">&times;</button>
            `;

            toast.querySelector('.close-btn').onclick = () => toast.remove();
            container.appendChild(toast);
            setTimeout(() => { if (toast && toast.parentNode) toast.remove(); }, timeout);
        }

        // TEMP DATA FLASH MESSAGE
        (function () {
            const flashMsg = @System.Text.Json.JsonSerializer.Serialize(TempData["Message"] as string);
            if (flashMsg) { showPortalToast('success', 'Success', flashMsg, 3500); }
        })();

        // DISMISS ANNOUNCEMENT
        let pendingDismiss = { id: null, button: null };
        function dismissAnnouncement(announcementId, button) {
            pendingDismiss.id = announcementId;
            pendingDismiss.button = button;
            const modal = new bootstrap.Modal(document.getElementById('dismissConfirmModal'));
            modal.show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            const confirmDismissBtn = document.getElementById('confirmDismissBtn');
            if (!confirmDismissBtn) return;

            confirmDismissBtn.addEventListener('click', function () {
                const announcementId = pendingDismiss.id;
                const button = pendingDismiss.button;
                const dismissModalInstance = bootstrap.Modal.getInstance(document.getElementById('dismissConfirmModal'));
                if (dismissModalInstance) dismissModalInstance.hide();

                if (!announcementId || !button) return;
                const originalBtnHtml = button.innerHTML;
                button.disabled = true;
                button.innerHTML = '<i class="spinner-border spinner-border-sm"></i>';

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';

                fetch('/Home/DismissAnnouncement', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: `id=${announcementId}&__RequestVerificationToken=${encodeURIComponent(token)}`
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const openedModalEl = document.getElementById('modal' + announcementId);
                        const openedModal = openedModalEl ? bootstrap.Modal.getInstance(openedModalEl) : null;
                        if (openedModal) openedModal.hide();

                        const announcementElement = document.getElementById('announcement-' + announcementId);
                        if (announcementElement) {
                            announcementElement.style.opacity = '0';
                            setTimeout(() => {
                                announcementElement.remove();
                            }, 260);
                        }
                        showPortalToast('success', 'Dismissed', 'Announcement dismissed successfully.');
                    } else {
                        showPortalToast('danger', 'Error', (data.message || 'Error dismissing announcement.'));
                        button.disabled = false;
                        button.innerHTML = originalBtnHtml;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showPortalToast('danger', 'Network Error', 'An error occurred.');
                    button.disabled = false;
                    button.innerHTML = originalBtnHtml;
                })
                .finally(() => { pendingDismiss.id = null; pendingDismiss.button = null; });
            });
        });

        // ===========================
        // PROFILE PICTURE: Preview + AJAX Upload
        // ===========================
        (function () {
            const fileInput = document.getElementById('profilePictureInput');
            const previewImg = document.getElementById('profilePicturePreview');
            const form = document.getElementById('ajaxProfileForm');
            const btn = document.getElementById('btnUpdateProfile');

            // 1. Handle File Selection Preview
            if (fileInput && previewImg) {
                fileInput.addEventListener('change', function () {
                    const file = this.files && this.files[0];
                    if (!file) return;
                    const allowed = ['image/jpeg', 'image/png'];
                    if (!allowed.includes(file.type)) { showPortalToast('danger', 'Invalid file', 'Only JPG and PNG are allowed.'); this.value = ''; return; }
                    if (file.size > 5 * 1024 * 1024) { showPortalToast('danger', 'Too large', 'File must be less than 5MB.'); this.value = ''; return; }
                    const reader = new FileReader();
                    reader.onload = (e) => { previewImg.src = e.target.result; };
                    reader.readAsDataURL(file);
                });
            }

            // 2. Handle Form Submission (AJAX)
            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const formData = new FormData(form);
                    const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenInput ? tokenInput.value : '';

                    const oldBtnHtml = btn ? btn.innerHTML : '';
                    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="spinner-border spinner-border-sm"></i> Saving...'; }

                    fetch('@Url.Action("UpdateProfileAjax", "Account")', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token },
                        body: formData
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            // Cache buster string to force browser to reload image
                            const timestamp = '?t=' + Date.now();

                            // A. Update Modal Preview
                            if (data.imagePath && previewImg) {
                                previewImg.src = data.imagePath + timestamp;
                            }

                            // B. Update Header Avatar (Next to "Hello, Name")
                            const headerMyProfileImg = document.getElementById('headerMyProfileImg');
                            if (headerMyProfileImg && data.imagePath) {
                                headerMyProfileImg.src = data.imagePath + timestamp;
                            }

                            // C. Update Top Navbar Avatar (if present in Layout)
                            const navImg = document.getElementById('navProfileImg');
                            if (navImg && data.imagePath) {
                                navImg.src = data.imagePath + timestamp;
                            }

                            // D. ✅ NEW: Update Right Sidebar (Offcanvas) Avatar
                            const sidebarImg = document.getElementById('offcanvasProfileImg');
                            if (sidebarImg && data.imagePath) {
                                sidebarImg.src = data.imagePath + timestamp;
                            }

                            showPortalToast('success', 'Profile Updated', data.message || 'Profile photo updated successfully!');
                        } else {
                            showPortalToast('danger', 'Upload Failed', data.message || 'Please try again.');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        showPortalToast('danger', 'Network Error', 'Something went wrong.');
                    })
                    .finally(() => { if (btn) { btn.disabled = false; btn.innerHTML = oldBtnHtml; } });
                });
            }
        })();

