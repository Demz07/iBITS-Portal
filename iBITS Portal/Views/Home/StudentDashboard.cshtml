@* 1. PAYMENT REMINDER MODALS *@
@foreach (var reminder in paymentReminders)
{
    string titleColor = "text-gold";
    if (reminder.AnnouncementType == "Urgent Notice") { titleColor = "text-danger"; }
    else if (reminder.AnnouncementType == "Final Notice") { titleColor = "text-orange"; }
    else if (reminder.AnnouncementType == "New Fee Posted") { titleColor = "text-info"; }

    <div class="modal fade" id="modal@(reminder.Id)" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-modal" style="border: 1px solid var(--gold-primary);">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title @titleColor">@reminder.AnnouncementType</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-strong">
                    <h4 class="fw-bold mb-3">@((reminder.Title ?? string.Empty).Replace("Payment Reminder: ", ""))</h4>
                    <div style="white-space: pre-line; background: var(--gold-dim); padding: 15px; border-radius: 8px; border: 1px solid var(--border-color);">@reminder.Content</div>
                    <div class="mt-3 opacity-50 small text-end text-main">Posted by: @reminder.PostedBy</div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-outline-warning" onclick="dismissAnnouncement(@reminder.Id, this)">Dismiss Reminder</button>
                </div>
            </div>
        </div>
    </div>
}

