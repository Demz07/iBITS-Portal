@page
@model LoginModel
@{
    ViewData["Title"] = "Secure Login";
    Layout = null;

    string userType = Model?.UserType ?? "Member";
    string loginType = (userType == "Admin") ? "ADMINISTRATOR" : "MEMBER";
    bool isLockedOut = Model?.IsLockedOut ?? false;
    int lockoutSeconds = Model?.LockoutSecondsRemaining ?? 0;
    int failedAttempts = Model?.FailedAttempts ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - iBITS Portal</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-deep: #030a16;
            --gold-primary: #D4AF37;
            --gold-light: #F9E076;
            --gold-glow: rgba(212, 175, 55, 0.4);
            --text-muted: #94a3b8;
        }

        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-deep);
            color: #fff;
            overflow-x: hidden;
            overflow-y: auto;
        }

        #matrixCanvas {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 0;
            opacity: 0.2;
        }

        /* --- FLOATING NAVIGATION --- */
        .floating-nav {
            display: flex;
            background: rgba(3, 10, 22, 0.95);
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            min-height: 70px;
        }

        .nav-container {
            width: 100%;
            display: flex;
            align-items: center;
            padding: 0 50px;
            box-sizing: border-box;
            gap: 16px;
        }

        .hero-header {
            display: flex;
            align-items: center;
            gap: 15px;
            flex: 1;
        }

        .pup-logo {
            width: 55px;
            height: 55px;
            object-fit: contain;
        }

        .header-text {
            display: flex;
            flex-direction: column;
        }

        .uni-name {
            font-weight: 700;
            font-size: 1.1rem;
            color: #fff;
            letter-spacing: 1px;
        }

        .campus-name {
            font-weight: 400;
            font-size: 0.9rem;
            color: var(--gold-primary);
            letter-spacing: 2px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 2.5rem;
            margin: 0;
            align-items: center;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.1rem;
            transition: 0.3s;
        }

        .nav-links a:hover { color: var(--gold-primary); }

        .btn-return-home {
            padding: 8px 20px;
            background: rgba(212, 175, 55, 0.1);
            border: 1px solid var(--gold-primary);
            border-radius: 20px;
            color: var(--gold-primary);
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.3s;
        }

        .btn-return-home:hover {
            background: var(--gold-primary);
            color: #000;
            box-shadow: 0 0 20px var(--gold-glow);
        }

        /* ===== HAMBURGER BUTTON ===== */
        .landing-hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 8px 10px;
            background: rgba(212, 175, 55, 0.1);
            border: 1px solid #D4AF37;
            border-radius: 8px;
            z-index: 1100;
        }

        .landing-hamburger span {
            display: block; width: 22px; height: 2px; background: #D4AF37; border-radius: 2px;
        }

        /* ===== MOBILE MENU SIDEBAR ===== */
        .landing-mobile-menu {
            position: fixed;
            top: 0;
            right: -300px;
            width: 280px;
            height: 100vh;
            background: rgba(3, 10, 22, 0.98);
            z-index: 1090;
            flex-direction: column;
            align-items: flex-start;
            padding: 80px 20px 60px;
            transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            backdrop-filter: blur(20px);
        }

        .landing-mobile-menu.active { right: 0; }

        .menu-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1085;
            opacity: 0;
            visibility: hidden;
            transition: 0.3s;
        }

        .menu-backdrop.active { opacity: 1; visibility: visible; }

        .landing-mobile-menu a {
            color: #ffffff;
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: 600;
            padding: 15px 10px;
            width: 100%;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .mobile-menu-close {
            position: absolute;
            top: 15px;
            right: 20px;
            background: none;
            border: none;
            color: #ffffff;
            font-size: 1.8rem;
            cursor: pointer;
        }

        .mobile-enter-btn {
            margin-top: 30px;
            padding: 12px 30px !important;
            border: 1px solid #D4AF37 !important;
            border-radius: 50px !important;
            color: #D4AF37 !important;
            align-self: center;
            text-decoration: none;
        }

        .split-layout {
            position: relative;
            z-index: 1;
            display: flex;
            height: 100vh;
            width: 100%;
        }

        .left-brand {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            position: relative;
        }

        .logo-wrapper {
            position: relative;
            margin-bottom: 20px;
            animation: fadeUp 1s ease-out forwards;
            z-index: 1;
        }

        /* Glowing Halo behind Logo */
        .logo-wrapper::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 250px;
            height: 250px;
            background: var(--gold-primary);
            filter: blur(100px);
            opacity: 0.15;
            border-radius: 50%;
            animation: pulseGlow 5s infinite alternate;
        }

        .logo-img {
            width: 420px;
            height: 420px;
            object-fit: contain;
            filter: drop-shadow(0 25px 50px rgba(0,0,0,0.6));
            position: relative;
            z-index: 2;
        }

        .brand-text {
            text-align: center;
            animation: fadeUp 1.2s ease-out forwards;
            max-width: 800px;
            position: relative;
            z-index: 5;
        }

        .brand-text h1 {
            font-size: 4.5rem;
            font-weight: 800;
            line-height: 1;
            margin: 0 0 15px 0;
            background: linear-gradient(180deg, #fff 20%, #b0b0b0 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .brand-text .gold-accent {
            font-size: 1.1rem;
            color: var(--gold-primary);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 600;
            display: block;
            text-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
            opacity: 0.9;
        }

        .right-controls {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative; z-index: 2;
            padding: 2rem;
        }

        .glass-panel {
            width: 100%;
            max-width: 650px;
            padding: 40px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 30px;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.5);
            animation: cardEntrance 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
            opacity: 0;
            transform: translateY(30px);
        }

        .panel-header {
            margin-bottom: 2.5rem;
            border-left: 5px solid var(--gold-primary);
            padding-left: 25px;
        }

        .panel-header h3 {
            font-weight: 800;
            font-size: 2rem;
            color: #fff;
            margin: 0; line-height: 1;
        }

        .panel-header p {
            color: var(--gold-primary);
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-top: 10px;
            opacity: 0.8;
        }

        .form-floating { margin-bottom: 12px; }

        .form-control {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff !important;
            border-radius: 15px;
            height: 56px;
            font-family: 'Outfit', sans-serif;
            letter-spacing: 1px;
            font-size: 1.1rem;
        }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.1) !important;
            border-color: var(--gold-primary);
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.2);
            color: var(--gold-primary) !important;
        }

        .form-floating label { color: #888; padding-top: 20px; }

        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 30px #0b1421 inset !important;
            -webkit-text-fill-color: white !important;
        }

        .password-toggle {
            position: absolute;
            right: 20px; top: 20px;
            color: #666;
            cursor: pointer;
            transition: 0.3s;
            z-index: 10;
            font-size: 1.4rem;
        }

        .password-toggle:hover { color: var(--gold-primary); }

        /* --- BUTTON --- */
        .btn-gold {
            background: var(--gold-primary);
            color: #000;
            font-weight: 800;
            font-size: 1.1rem;
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            margin-top: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            position: relative;
        }

        .btn-gold:hover:not(:disabled) {
            background: #fff;
            transform: translateY(-3px);
            box-shadow: 0 0 25px var(--gold-glow);
        }

        .btn-gold:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

        .btn-gold .btn-spinner {
            display: inline-block;
            width: 18px; height: 18px;
            border: 3px solid rgba(0,0,0,0.3);
            border-top-color: #000;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-right: 10px;
            vertical-align: middle;
        }

        .back-link {
            color: var(--text-muted);
            text-decoration: none;
            display: inline-block;
            margin-top: 30px;
            font-size: 0.9rem;
            transition: 0.3s;
            letter-spacing: 1px;
        }

        .back-link:hover { color: var(--gold-primary); }

        .form-check-input:checked {
            background-color: var(--gold-primary);
            border-color: var(--gold-primary);
        }

        .scrambling {
            color: var(--gold-primary) !important;
            text-shadow: 0 0 8px var(--gold-primary);
            font-family: monospace !important;
        }

        /* --- WARNINGS & LOCKOUT --- */
        .attempt-warning {
            border-radius: 12px;
            padding: 12px 18px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            display: flex; align-items: center; gap: 10px;
        }
        .attempt-warning.warn-yellow { background: rgba(212, 175, 55, 0.15); border: 1px solid rgba(212, 175, 55, 0.5); color: var(--gold-light); }
        .attempt-warning.warn-orange { background: rgba(255, 120, 50, 0.15); border: 1px solid rgba(255, 120, 50, 0.5); color: #ffaa66; }

        .lockout-screen { text-align: center; padding: 10px 0; }
        .lockout-icon { font-size: 5rem; color: #e74c3c; animation: lockPulse 2s ease-in-out infinite; }
        .lockout-title { font-size: 1.8rem; font-weight: 800; color: #e74c3c; margin-bottom: 10px; }
        .countdown-box { background: rgba(231, 76, 60, 0.1); border: 1px solid rgba(231, 76, 60, 0.3); border-radius: 20px; padding: 20px 30px; margin-bottom: 30px; display: inline-block; }
        .countdown-timer { font-size: 3rem; font-weight: 800; color: #e74c3c; font-family: monospace; letter-spacing: 4px; }
        .btn-unlock { background: #2ecc71; color: #000; font-weight: 800; font-size: 1rem; width: 100%; padding: 16px; border: none; border-radius: 15px; text-transform: uppercase; margin-bottom: 15px; display: none; cursor: pointer; }

        .attempts-dots { display: flex; justify-content: center; gap: 8px; margin-bottom: 20px; }
        .attempt-dot { width: 12px; height: 12px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); }
        .attempt-dot.used { background: #e74c3c; border-color: #e74c3c; box-shadow: 0 0 6px rgba(231,76,60,0.6); }

        /* --- ANIMATIONS --- */
        @@keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @@keyframes cardEntrance { from { opacity: 0; transform: translateY(40px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @@keyframes spin { to { transform: rotate(360deg); } }
        @@keyframes lockPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
        @@keyframes pulseGlow { 0% { opacity: 0.1; } 100% { opacity: 0.25; } }

        /* --- RESPONSIVE BREAKPOINTS --- */
        @@media (max-width: 1200px) {
            .logo-img { width: 320px; height: 320px; }
            .brand-text h1 { font-size: 3.5rem; }
            .nav-container { padding: 0 30px; }
        }

        @@media (max-width: 992px) {
            .split-layout { flex-direction: column; height: auto; min-height: 100vh; padding-top: 80px; }
            .left-brand { flex: none; padding: 3rem 1rem 1rem; }
            .right-controls { 
                flex: none; 
                width: 100%; 
                justify-content: center; 
                padding: 1.5rem; 
                align-items: flex-start;
                padding-bottom: 150px; /* Consistently large space for mobile scrolling */
            }
            .logo-img { width: 220px; height: 220px; }
            .brand-text h1 { font-size: 2.8rem; }
            .glass-panel { margin: 0 auto; max-width: 600px; }
            
            .nav-links { display: none !important; }
            .landing-hamburger { display: flex !important; }
        }

        @@media (max-width: 768px) {
            .logo-img { width: 160px; height: 160px; }
            .brand-text h1 { font-size: 2.2rem; }
            .brand-text .gold-accent { font-size: 0.9rem; letter-spacing: 2px; }
            .glass-panel { padding: 30px 20px; }
            .uni-name { font-size: 0.8rem; }
            .campus-name { font-size: 0.7rem; }
        }

        @@media (max-width: 480px) {
            .logo-img { width: 120px; height: 120px; }
            .brand-text h1 { font-size: 1.8rem; }
            .brand-text .gold-accent { font-size: 0.75rem; letter-spacing: 1.5px; }
            .glass-panel { padding: 22px 16px; border-radius: 20px; margin: 0 auto; }
            .panel-header { padding-left: 15px; margin-bottom: 1.5rem; }
            .panel-header h3 { font-size: 1.5rem; }
            .form-control { height: 50px; font-size: 0.9rem; border-radius: 10px; }
            .btn-gold { padding: 11px; font-size: 0.9rem; }
        }
    </style>
</head>
<body>

    <canvas id="matrixCanvas"></canvas>

    <!-- Floating Navigation -->
    <nav class="floating-nav visible" id="floatingNav">
        <div class="nav-container">
            <div class="hero-header">
                <img src="/images/pup-logo.png" alt="PUP Logo" class="pup-logo">
                <div class="header-text">
                    <span class="uni-name">POLYTECHNIC UNIVERSITY OF THE PHILIPPINES</span>
                    <span class="campus-name">LOPEZ, QUEZON CAMPUS</span>
                </div>
            </div>
            <ul class="nav-links">
                <li><a href="/Home/LandingPageAbout">Organization</a></li>
                <li><a href="/Home/LandingPagePeople">System</a></li>
                <li><a href="/Home/LandingDevelopers">Developers</a></li>
                <a href="/" class="btn-return-home">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Return to Home</span>
                </a>
            </ul>
            <!-- Mobile Hamburger -->
            <button class="landing-hamburger" id="landingHamburger" aria-label="Toggle navigation">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <!-- Mobile Menu Overlay (Sidebar) -->
    <div class="menu-backdrop" id="menuBackdrop"></div>
    <div class="landing-mobile-menu" id="landingMobileMenu">
        <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Close menu">&times;</button>
        <a href="/Home/LandingPageAbout" onclick="closeMobileMenu()">Organization</a>
        <a href="/Home/LandingPagePeople" onclick="closeMobileMenu()">System</a>
        <a href="/Home/LandingDevelopers" onclick="closeMobileMenu()">Developers</a>
        <a href="/" class="mobile-enter-btn" onclick="closeMobileMenu()">Return to Home</a>
    </div>

    <div class="split-layout">

        <!-- LEFT SIDE: BRANDING -->
        <div class="left-brand">
            <div class="logo-wrapper">
                <img src="~/images/logo.png" alt="iBITS Logo" class="logo-img">
            </div>
            <div class="brand-text">
                <h1>iBITS PORTAL</h1>
                <span class="gold-accent">Unified Attendance & Payment System</span>
            </div>
        </div>

        <!-- RIGHT SIDE: LOGIN FORM -->
        <div class="right-controls">
            <div class="glass-panel">
                <div class="panel-header">
                    <h3>@loginType</h3>
                    <p>@(isLockedOut ? "Account Temporarily Locked" : "Enter your credentials to proceed")</p>
                </div>

                @if (isLockedOut)
                {
                    <!-- ===================== LOCKOUT SCREEN ===================== -->
                    <div class="lockout-screen">
                        <div class="lockout-icon-wrap">
                            <i class="bi bi-shield-lock-fill lockout-icon" id="lockIcon"></i>
                        </div>

                        <div class="lockout-title">ACCESS LOCKED</div>
                        <div class="lockout-subtitle">
                            Too many failed login attempts.<br>
                            Your account has been temporarily locked for security.
                        </div>

                        <div class="countdown-box">
                            <div class="countdown-label">Try again in</div>
                            <div class="countdown-timer" id="countdownTimer">--:--</div>
                        </div>

                        <button class="btn-unlock" id="btnUnlock" onclick="window.location.reload()">
                            <i class="bi bi-unlock-fill me-2"></i> Try Again
                        </button>

                        <div class="text-center">
                            <a href="@Url.Action("Gateway", "Home")" class="back-link">
                                <i class="bi bi-arrow-left me-1"></i> Return to Gateway
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- ===================== LOGIN FORM ===================== -->

                    @* Attempt warning banners *@
                    @if (failedAttempts == 3)
                    {
                        <div class="attempt-warning warn-yellow">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>⚠️ Warning: <strong>2 attempts remaining</strong> before lockout.</span>
                        </div>
                    }
                    else if (failedAttempts == 4)
                    {
                        <div class="attempt-warning warn-orange">
                            <i class="bi bi-exclamation-octagon-fill"></i>
                            <span>🚨 Final Warning: <strong>1 attempt remaining!</strong> Next failure locks your account.</span>
                        </div>
                    }

                    @* Attempt progress dots (show after first failure) *@
                    @if (failedAttempts > 0)
                    {
                        <div class="attempts-dots mb-3">
                            @for (int i = 0; i < 5; i++)
                            {
                                <div class="attempt-dot @(i < failedAttempts ? "used" : "")"></div>
                            }
                        </div>
                    }

                    <form id="loginForm" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="form-floating">
                            <input asp-for="Input.Email" type="text" class="form-control" id="emailField"
                                   autocomplete="off" placeholder="ID" />
                            <label asp-for="Input.Email">@(userType == "Admin" ? "Admin Username" : "Student ID / Username")</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating position-relative">
                            <input asp-for="Input.Password" type="password" class="form-control"
                                   id="passwordField" placeholder="Password" />
                            <label asp-for="Input.Password">@(userType == "Admin" ? "Admin Password" : "Password")</label>
                            <i class="bi bi-eye password-toggle" id="toggleBtn" onclick="matrixReveal()"></i>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-check-label text-secondary" style="font-size: 0.9rem;">
                                <input class="form-check-input bg-dark border-secondary" asp-for="Input.RememberMe" />
                                Keep Session Active
                            </label>
                        </div>

                        <button type="submit" class="btn-gold" id="submitBtn">
                            Initialize Session
                        </button>

                        <div class="text-center">
                            <a href="@Url.Action("Gateway", "Home")" class="back-link">
                                <i class="bi bi-arrow-left me-1"></i> Return to Gateway
                            </a>
                        </div>
                    </form>
                }

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        const hamburger = document.getElementById('landingHamburger');
        const mobileMenu = document.getElementById('landingMobileMenu');
        const menuClose = document.getElementById('mobileMenuClose');
        const menuBackdrop = document.getElementById('menuBackdrop');

        function openMobileMenu() {
            hamburger.classList.add('active');
            mobileMenu.classList.add('active');
            menuBackdrop.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeMobileMenu() {
            hamburger.classList.remove('active');
            mobileMenu.classList.remove('active');
            menuBackdrop.classList.remove('active');
            document.body.style.overflow = '';
        }

        if (hamburger) hamburger.addEventListener('click', openMobileMenu);
        if (menuClose) menuClose.addEventListener('click', closeMobileMenu);
        if (menuBackdrop) menuBackdrop.addEventListener('click', closeMobileMenu);

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeMobileMenu();
        });
    </script>

    <!-- Matrix Rain -->
    <script>
        const canvas = document.getElementById('matrixCanvas');
        const ctx = canvas.getContext('2d');
        function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        const fontSize = 26;
        const columns = canvas.width / fontSize;
        const drops = [];
        for (let x = 0; x < columns; x++) { drops[x] = 1; }
        const characters = "01";
        function draw() {
            ctx.fillStyle = 'rgba(3, 10, 22, 0.05)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#D4AF37';
            ctx.font = fontSize + 'px monospace';
            for (let i = 0; i < drops.length; i++) {
                const text = characters.charAt(Math.floor(Math.random() * characters.length));
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) { drops[i] = 0; }
                drops[i]++;
            }
        }
        setInterval(draw, 33);
    </script>

    @if (isLockedOut)
    {
        <!-- Countdown Timer Script -->
        <script>
            let secondsLeft = @lockoutSeconds;
            const timerEl = document.getElementById('countdownTimer');
            const unlockBtn = document.getElementById('btnUnlock');
            const lockIcon = document.getElementById('lockIcon');

            function updateTimer() {
                if (secondsLeft <= 0) {
                    timerEl.textContent = '00:00';
                    timerEl.classList.add('countdown-unlocked');
                    unlockBtn.style.display = 'block';
                    lockIcon.style.animationName = 'none';
                    lockIcon.style.color = '#2ecc71';
                    lockIcon.style.filter = 'drop-shadow(0 0 20px rgba(46,204,113,0.6))';
                    lockIcon.classList.remove('bi-shield-lock-fill');
                    lockIcon.classList.add('bi-shield-check-fill');
                    clearInterval(timerInterval);
                    return;
                }
                const mins = Math.floor(secondsLeft / 60);
                const secs = secondsLeft % 60;
                timerEl.textContent = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
                secondsLeft--;
            }

            updateTimer();
            const timerInterval = setInterval(updateTimer, 1000);
        </script>
    }
    else
    {
        <!-- Password Reveal Script -->
        <script>
            function matrixReveal() {
                const input = document.getElementById("passwordField");
                const btn = document.getElementById("toggleBtn");
                const originalValue = input.value;
                if (!originalValue) return;
                if (input.type === "password") {
                    input.type = "text";
                    btn.classList.remove("bi-eye");
                    btn.classList.add("bi-eye-slash");
                    let iterations = 0;
                    const scrambleChars = "0101010101XYZABC#$&";
                    input.classList.add("scrambling");
                    const interval = setInterval(() => {
                        input.value = input.value.split("").map((letter, index) => {
                            if (index < iterations) return originalValue[index];
                            return scrambleChars[Math.floor(Math.random() * 18)];
                        }).join("");
                        if (iterations >= originalValue.length) {
                            clearInterval(interval);
                            input.value = originalValue;
                            input.classList.remove("scrambling");
                        }
                        iterations += 1 / 2;
                    }, 30);
                } else {
                    input.type = "password";
                    btn.classList.remove("bi-eye-slash");
                    btn.classList.add("bi-eye");
                }
            }
        </script>

        <!-- =====================================================
             ENTER KEY LISTENER + LOADING ANIMATION
        ===================================================== -->
        <script>
            const loginForm = document.getElementById('loginForm');
            const submitBtn = document.getElementById('submitBtn');
            const emailField = document.getElementById('emailField');
            const passwordField = document.getElementById('passwordField');

            // --- Enter Key Listener ---
            // Both fields trigger form submit on Enter
            [emailField, passwordField].forEach(function (field) {
                field.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        triggerLogin();
                    }
                });
            });

            // --- Loading Animation on Submit ---
            loginForm.addEventListener('submit', function (e) {
                // Only show loading if form is valid (both fields filled)
                const email = emailField.value.trim();
                const password = passwordField.value;
                if (email && password) {
                    showLoading();
                }
            });

            function triggerLogin() {
                const email = emailField.value.trim();
                const password = passwordField.value;
                if (!email || !password) {
                    // Focus on empty field
                    if (!email) { emailField.focus(); return; }
                    if (!password) { passwordField.focus(); return; }
                }
                showLoading();
                loginForm.submit();
            }

            function showLoading() {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="btn-spinner"></span> Authenticating...';
            }
        </script>
    }

</body>
</html>
