@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery Code Verification";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recovery Access - iBITS Portal</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-deep: #030a16;
            --gold-primary: #D4AF37;
            --gold-light: #F9E076;
            --gold-glow: rgba(212, 175, 55, 0.4);
            --text-muted: #94a3b8;
        }

        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-deep);
            color: #fff;
            overflow-x: hidden;
            overflow-y: auto;
        }

        #matrixCanvas {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 0;
            opacity: 0.15;
        }

        .split-layout {
            position: relative;
            z-index: 1;
            display: flex;
            height: 100vh;
            width: 100%;
            justify-content: center;
            align-items: center;
        }

        .glass-panel {
            width: 100%;
            max-width: 500px;
            padding: 40px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 30px;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        .icon-circle {
            width: 70px;
            height: 70px;
            background: rgba(245, 158, 11, 0.1);
            border: 2px solid #f59e0b;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .icon-circle i {
            font-size: 2rem;
            color: #f59e0b;
        }

        h3 { font-weight: 800; color: #fff; margin-bottom: 10px; }
        p.subtitle { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 30px; }

        .form-floating { margin-bottom: 20px; }

        .form-control {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--gold-primary) !important;
            border-radius: 15px;
            height: 60px;
            font-family: monospace;
            letter-spacing: 2px;
            font-size: 1.2rem;
            text-align: center;
            font-weight: 700;
            text-transform: uppercase;
        }

        .form-control:focus {
            border-color: var(--gold-primary);
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.2);
        }

        .form-floating label { color: #888; width: 100%; text-align: center; }

        .btn-gold {
            background: var(--gold-primary);
            color: #000;
            font-weight: 800;
            font-size: 1.1rem;
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: 0.3s;
        }

        .btn-gold:hover { background: #fff; transform: translateY(-2px); box-shadow: 0 0 25px var(--gold-glow); }

        .alert-info {
            background: rgba(212, 175, 55, 0.05);
            border: 1px solid var(--gold-dim);
            color: var(--gold-primary);
            border-radius: 15px;
            font-size: 0.85rem;
            text-align: left;
        }

        .back-link {
            color: var(--text-muted);
            text-decoration: none;
            display: inline-block;
            margin-top: 20px;
            font-size: 0.9rem;
        }

        .back-link:hover { color: var(--gold-primary); }
    </style>
</head>
<body>

    <canvas id="matrixCanvas"></canvas>

    <div class="split-layout">
        <div class="glass-panel">
            <div class="icon-circle">
                <i class="bi bi-key-fill"></i>
            </div>
            
            <h3>Recovery Access</h3>
            <p class="subtitle">You are logging in with a recovery code. Once used, this code will be deactivated.</p>

            <div class="alert alert-info mb-4">
                <i class="bi bi-info-circle-fill me-2"></i>
                You previously saved these codes during your 2FA setup. Entering a valid code will bypass the authenticator app.
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-floating">
                    <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="XXXXX-XXXXX" />
                    <label asp-for="Input.RecoveryCode">ENTER RECOVERY CODE</label>
                    <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-gold">Verify & Bypass 2FA</button>
            </form>

            <a asp-page="./LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl" class="back-link">
                <i class="bi bi-arrow-left me-1"></i> Back to Authenticator App
            </a>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('matrixCanvas');
        const ctx = canvas.getContext('2d');
        function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        const fontSize = 26;
        const columns = canvas.width / fontSize;
        const drops = [];
        for (let x = 0; x < columns; x++) { drops[x] = 1; }
        function draw() {
            ctx.fillStyle = 'rgba(3, 10, 22, 0.05)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#D4AF37';
            ctx.font = fontSize + 'px monospace';
            for (let i = 0; i < drops.length; i++) {
                const text = Math.random() > 0.5 ? "0" : "1";
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) { drops[i] = 0; }
                drops[i]++;
            }
        }
        setInterval(draw, 33);
    </script>
</body>
</html>
